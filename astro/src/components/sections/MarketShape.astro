---
/**
 * MarketShape — "Four numbers you are already held to".
 *
 * WHAT THIS SECTION IS FOR, AND WHY THE CONTENT CHANGED (OA-27, owner decision
 * 2026-08-02). It used to lead with market statistics: 40,000+ notices a year,
 * 55% stopped at qualification, 44% citing process complexity. Three of those
 * four could not be sourced. Worse than misremembered: CIPS and techUK have
 * published on exactly that subject and neither 55% nor 44% appears anywhere in
 * their data, and 40,000+ was traceable only to commercial tender-alert
 * marketing copy. On a site whose whole argument is that every figure traces to
 * something, that was the worst place on the page to be loose.
 *
 * The replacement is not a better-sourced market statistic. It is a different
 * kind of number: figures the reader is already held to, each resting on statute
 * or a Cabinet Office notice.
 *
 * ── WHY THE SOURCE NOTE IS GONE, AND WHERE IT WENT ──────────────────────────
 *
 * Owner review, 2026-08-02, second pass: "For 'Duties, not estimates' why do we
 * have so much text? If you want to give sources, give one link to a page where
 * we cite all the sources. Why complicate the home page?" Followed by the
 * sharper verdict on the page as a whole: it reads as a research site rather
 * than a product site.
 *
 * That is right, and it was this section's 90-word source note more than
 * anything else. The note is not deleted. It moved to /sources, in FULLER form
 * than it had here: every figure now has a row in a table on that page, each
 * instrument has its dates, its threshold and a link to legislation.gov.uk or
 * gov.uk, and the two Procurement Act duties are two separate records. The
 * accuracy was relocated, not relaxed, and the page it went to is the more
 * rigorous of the two.
 *
 * ONE LINK, ONCE. The homepage links /sources from here and from
 * ReasoningTrace, and from nowhere else. Scattering the citations back into the
 * sections, one "source:" clause at a time, is exactly how the note grew the
 * first time.
 *
 * ── THE STAGE LABEL BECAME THE CITATION TAG ─────────────────────────────────
 *
 * Each stop used to carry a stage word (Evaluation, Threshold, At signature,
 * Every year after) in the mono slot above the numeral. That slot now holds the
 * instrument instead: PPN 002, s.52, s.52, s.71. Same treatment, same position,
 * same accent colour, one fewer thing to read.
 *
 * A MONO TAG NEXT TO A NUMERAL IS A LABEL, NOT A CITATION. It names the
 * instrument in four characters and points at the page that actually cites it.
 * That is the line this section may not cross: the moment a tag grows a date, a
 * threshold or the words "in force", the source note is being rebuilt in place.
 *
 * THE HONEST COST. The four stops used to be ordered IN TIME, and the stage
 * words were what said so. Two things still carry it: the reading order, and the
 * accent ramp running teal to cyan to violet to orchid across the four, which is
 * the brand ramp used for the one thing it is good for, showing that a set has a
 * direction. The labels below are written to imply the same sequence, from how a
 * bid is scored to a duty that repeats for the life of the contract. It is a
 * weaker signal than a printed word and that is a deliberate trade, recorded
 * here rather than glossed.
 *
 * DO NOT MERGE SECTION 52 AND SECTION 71. s.52 sets and publishes the KPIs.
 * s.71 assesses performance against them and publishes the result. Collapsing
 * the two was a live accuracy defect on this site (OA-26). Two stops carry s.52
 * and one carries s.71, and the tags are what keep them apart at a glance.
 *
 * WHY IT IS A SEQUENCE AND NOT A STAT GRID. Four numbers in four equal cards
 * with a coloured accent each is the default answer, and it throws away the one
 * thing this section actually knows: the figures are ordered. The coloured rule
 * above each figure is one continuous line across the four stops.
 *
 * NO COUNT-UP ANIMATION. The legacy version animated these from zero on scroll,
 * which is the hide-then-reveal pattern that left 4 of 9 homepage sections
 * permanently invisible when the observer did not fire. A number that might not
 * arrive is worse than a number that does not animate.
 */
import Section from '../layout/Section.astro';

interface Stop {
  /**
   * The instrument, in the form it is printed on the page. Four characters or
   * so. It is a LABEL: it names what the figure comes from and sends the reader
   * to /sources for the citation itself. It may never grow into one.
   */
  tag: string;
  value: string;
  /** A few words. No full stop, no date, no threshold, no "in force". */
  label: string;
  accent: string;
}

const STOPS: Stop[] = [
  {
    tag: 'PPN 002',
    value: '10%',
    label: 'minimum social value weighting',
    accent: 'var(--c-teal)',
  },
  {
    tag: 's.52',
    value: '£5m',
    label: 'contract value threshold',
    accent: 'var(--c-cyan)',
  },
  {
    tag: 's.52',
    value: '3',
    label: 'KPIs published before signing',
    accent: 'var(--c-violet)',
  },
  {
    tag: 's.71',
    value: '12',
    label: 'months between published assessments',
    accent: 'var(--c-orchid)',
  },
];
---

{/*
  `class="sv-floor"` is the second of the four surface steps in tokens.css, and
  it is on the <section> rather than on anything inside it so it runs the full
  viewport width. specs/ULTRA-PREMIUM-GAP.md §3: sections alternate floor and
  base down the page so a section is one or the other and never ambiguous, and
  so a raised panel always has something to be raised above. This is the first
  floor on the page; the hero directly above it is base.
*/}
<Section
  eyebrow="Duties, not estimates"
  title="Four numbers you are already held to"
  class="sv-floor"
>
  {/*
    `data-lit` is the whole motion contract for this section, and the reason it
    is safe here specifically. The rule above the four stops is drawn at 100%
    from first paint and every figure is authored text. Nothing below is waiting
    to be revealed, so if src/scripts/motion.ts never loads, never runs, or
    throws, this attribute stays unset, no keyframe rule matches, and the
    section is complete. See the header note: that is the ONLY basis on which
    this particular section is allowed to animate at all.
  */}
  <div class="ms" data-spot="off" data-lit data-lit-threshold="0.35">
    {/*
      Ambient, per the lighting rig (Figma `141:2` L03): two fields in
      different corners, teal high-left and orchid low-right, screen-blended so
      they add light rather than painting grey over the page. The vignette on
      ::after is in the PAGE colour and never black.
    */}
    <div class="ms__amb" data-field aria-hidden="true">
      <b class="ms__amb-a"></b>
      <b class="ms__amb-b"></b>
      {/*
        The cursor light and the grain, both mounted INSIDE the ambient wrapper.
        That wrapper is z-index -1 in an isolated stacking context, so neither
        can ever reach the surface a word sits on, and both inherit its radial
        mask so neither can draw its own rectangle at the section edges. <i>
        rather than <b>, so they join neither the drift nor its phase offsets.
      */}
      <i class="sv-spot"></i>
      <i class="sv-grain"></i>
    </div>

    {/*
      THE PANEL IS A <figure> AND THE STOPS ARE STILL AN <ol>.

      A figure, because this is a drawing: one continuous rule with four stops
      hung off it, each stop's tag and label positioned against its own segment
      rather than against the panel. A rule that asked those labels to sit on
      the panel's centre line would take each of them off the segment it names,
      which is why scripts/check-render.js excludes <figure> and why this is
      marked as one rather than added to that gate's allow-list.

      An <ol>, because the four stops are a progression and the list is what
      carries it. A <figure> cannot hold list semantics, so the panel wraps the
      list instead of replacing it.

      IT ALSO FIXES INVALID MARKUP. The travelling-light <span> below was a
      DIRECT CHILD OF THE <ol>, which the HTML content model does not allow (an
      <ol> takes <li>, <script> and <template> and nothing else). It now sits in
      the figure, where it is both valid and still positioned against the
      panel — `.sv-raised` is `position: relative`, so the containing block it
      measures against is unchanged.
    */}
    <figure class="spine__panel sv-raised">
      {/*
        THE TRAVELLING HIGHLIGHT, AND IT IS AN OVERLAY ON A COMPLETE LINE
        RATHER THAN A WIPE OF AN INCOMPLETE ONE. The distinction is the whole
        reason this passes: a wipe needs the rule to start missing, and a rule
        that starts missing is a rule that stays missing when the trigger does
        not fire. This sits ON TOP of the finished spine and adds light to it.
        Sized and positioned entirely in CSS; it holds nothing and says nothing.
      */}
      <span class="spine__track" aria-hidden="true">
        <span class="spine__light"></span>
      </span>

      <ol class="spine">
      {
        STOPS.map((s) => (
          <li class="spine__stop" style={`--accent: ${s.accent}`}>
            <span class="spine__tag">{s.tag}</span>
            {/*
              THE FIGURE IS THE CONTENT HERE, WHICH IS WHY IT TAKES THE NUMERAL
              RECIPE AND THE HEADING ABOVE IT DOES NOT MOVE. specs/
              ULTRA-PREMIUM-GAP.md §2.3 measured these at 57.6px against a
              46.4px heading — a ratio of 1.24, which is no contrast at all in
              the one place on the page where the number outranks the words
              around it. `sv-numeral` is the Better Stack recipe from the craft
              table, defined once in styles/surfaces.css with the solid
              full-contrast fallback FIRST. See --t-numeral in tokens.css for
              why the size is 108px and not the 128px the document proposes.
            */}
            <span class="spine__value sv-numeral">{s.value}</span>
            <span class="spine__label">{s.label}</span>
          </li>
        ))
      }
      </ol>
    </figure>

    <p class="spine__more">
      <a href="/sources#homepage">Every figure, sourced</a>
    </p>
  </div>
</Section>

<style>
  .ms {
    position: relative;
    /* Contains the ambient fields' stacking so a screen-blended blob can never
       climb over the copy, and stops the blur widening the page. */
    isolation: isolate;
  }

  /*
   * THE HORIZONTAL BLEED IS EXACTLY ONE GUTTER, AND THAT NUMBER IS NOT A
   * GUESS. An ambient field has to reach the viewport edge or it draws a
   * visible vertical seam one gutter in from it. It must not reach one pixel
   * further, because the sitewide gate fails any page whose scrollWidth exceeds
   * its clientWidth at 390, 768 or 1440.
   *
   * This element's containing block is the section body, which is the measure
   * inset by --gutter. Bleeding by exactly --gutter therefore lands on the
   * viewport edge at every width below the measure and stays inside it above.
   * A percentage cannot do this: -6% of the content box is 21px at 390 and
   * 41px at 768, neither of which is the gutter, and both of which overflowed.
   */
  .ms__amb {
    position: absolute;
    /* The scroll-driven parallax throw for this rig. Smaller than the hero's
       48px, and deliberately: seven fields all travelling at one speed is one
       sheet moving, which is not parallax. See styles/tokens.css. */
    --par: 26px;
    inset-block: -20%;
    inset-inline: calc(-1 * var(--gutter));
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    /*
     * ALL FOUR EDGES MUST BE MASKED, AND THIS IS NOT OPTIONAL POLISH.
     *
     * `overflow: hidden` is what stops the bleed widening the page, but it cuts
     * a 140px blur off square, and a blurred field ending in a straight line
     * draws a visible lighter RECTANGLE on the page. Measured twice on the
     * built result: first as a hard horizontal band, then, after masking only
     * the block axis, as two faint vertical edges at 1440.
     *
     * THE SECOND ONE IS THE INSTRUCTIVE MISTAKE. The first fix reasoned that
     * the inline edges sit on the viewport edge and need no mask. That is true
     * only BELOW the measure. At 1440 the container is 1256px centred in a
     * 1440px viewport, so both inline cuts land mid-page and both showed.
     *
     * One radial mask fades every edge at once and cannot be got wrong that
     * way: there is no axis for it to miss. It also needs no mask-composite,
     * which is the one part of masking whose syntax still differs between
     * WebKit and everything else.
     */
    /*
     * `closest-side`, NOT `115% 105%`, AND THAT IS A MEASURED CORRECTION.
     *
     * The earlier value was chosen to fade all four edges at once, which it
     * did — but only partly. An ellipse of 115% x 105% has semi-axes of 0.575w
     * and 0.525h, so the middle of the left edge sits at r = 0.5 / 0.575 =
     * 0.87 of the way along a ramp that only reaches transparent at 1.0. About
     * 25% of the field survives there. On a 150px blur whose own falloff is
     * nearly finished, 25% of nearly nothing is nothing, which is why it held.
     *
     * specs/ULTRA-PREMIUM-GAP.md §3 raises the orb stops by roughly 1.5x to
     * 1.9x, and 25% of that is a visible vertical line. Measured on the built
     * result at 1440: a lighter RECTANGLE across this section and the four
     * others sharing this recipe, one gutter in from each side — exactly the
     * defect the original note describes and thought it had closed.
     *
     * `closest-side` gives semi-axes of 0.5w and 0.5h, so the ramp reaches
     * transparent EXACTLY at the middle of every edge and past it at every
     * corner. There is no arithmetic left to get wrong, and it stays correct
     * when a section changes shape.
     */
    -webkit-mask-image: radial-gradient(
      closest-side,
      rgb(0 0 0) 42%,
      transparent 100%
    );
    mask-image: radial-gradient(closest-side, rgb(0 0 0) 42%, transparent 100%);
  }

  .ms__amb b {
    position: absolute;
    border-radius: 50%;
    /* The board specifies 54-58px at the frame's own scale and 140px at full
       width. This band is the full measure, so it takes the wide value. */
    filter: blur(140px);
    mix-blend-mode: screen;
  }

  .ms__amb-a {
    width: 520px;
    height: 380px;
    left: -4%;
    top: -30%;
    background: var(--orb-teal);
    opacity: 0.5;
  }

  /* Orchid low-right. It is a FIELD, not a mark: it names nothing, sits behind
     everything, and carries no shape. The refusal signal is a flat orchid
     stroke with a cross on it, three sections down, and stays unmistakable. */
  .ms__amb-b {
    width: 480px;
    height: 360px;
    right: -4%;
    bottom: -34%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-orchid) 34%, transparent),
      transparent 68%
    );
    opacity: 0.5;
  }

  .ms__amb::after {
    content: '';
    position: absolute;
    inset: 0;
    /* --grad-vignette. Size and centre are this field's geometry; the falloff
       and strength were 46%/82% here against 42%/88% on the hero, and are now
       the token's 44%/85% in both. */
    --vig: 760px 520px at 50% 50%;
    background: var(--grad-vignette);
  }

  /*
   * THE SPINE NOW STANDS ON A RAISED PANEL, AND THE PANEL IS THE THIRD SURFACE
   * STEP RATHER THAN A NEW CARD.
   *
   * specs/ULTRA-PREMIUM-GAP.md §2.4: all seven sections sat on one background
   * plus one 55%-alpha card, against 22 stepped surfaces on the closest dark
   * comparator. The fix is a ladder, not a lighter page — our median background
   * luminance and Better Stack's are the same 0.0055 to three decimal places.
   *
   * `sv-raised` is defined once in styles/surfaces.css: opaque --c-raised under
   * a 5% white wash, the 1px gradient hairline, and the five-layer shadow
   * ladder. It is NOT `.surface`; a card is still a card and this is the
   * surface a card would stand on. Nothing about it is restated here.
   *
   * PADDING RATHER THAN A FLUSH EDGE. The four accent rules are `border-top` on
   * the stops, so with no padding they would land in the same pixel as the
   * panel's own hairline and the two would fight. --blk-pad puts the rail
   * clearly inside the panel, which is also what Figma `214:92` draws.
   */
  /* The raised panel. It holds the travelling-light track and nothing else;
     every pixel of the rail's geometry stays on the list below, so the split
     changes which element is which and changes no measurement. `.sv-raised`
     already supplies `position: relative`, which is what .spine__track measures
     against, and `figure.sv-raised` has its user-agent margin zeroed in
     styles/surfaces.css. */
  .spine__panel { padding-block: var(--blk-pad); }

  .spine {
    /* KEPT, and it is not redundant with the panel's own `position: relative`.
       `.spine__stop::before` is absolutely positioned and `.spine__stop` is
       not positioned, so this element is that pseudo-element's containing
       block. Dropping it here would silently re-resolve it against the panel
       and move it. Whether the pseudo-element's `inset` was ever written for
       this containing block is a separate question and not one this change
       answers: the job here was to move the panel treatment without moving a
       pixel. */
    position: relative;
    list-style: none;
    margin: 0;
    /* `padding: 0`, WHICH IS ALSO A FIX. This rule used to set `padding-block`
       only, and `list-style: none` removes the marker without removing the
       user-agent's 40px `padding-inline-start`. Measured at 1440 before this
       change: the four stops ran 229 to 1252 inside a panel running 188 to
       1252, so the rule they draw with their own border-top started 40px inside
       the panel while .spine__track — which is `inset-inline: 0` on the padding
       box — ran the full width. The travelling light crossed 40px of panel with
       no rule under it. Each stop is now 266px rather than 256px and the two
       agree. The same leak was in `.bs__spine` in BothSides.astro. */
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    /* No column gap. The rules above the stops have to meet to read as one
       continuous line; the padding inside each stop provides the separation. */
    gap: 0;
  }

  /*
   * ── CENTRED, AND IT IS A REPORTED DEFECT RATHER THAN A RESTYLE ────────────
   *
   * Owner review, 2026-08-02: "'Duties, not estimates' — the numbers and text
   * are not centrally aligned." Measured at 1440 before the fix, and they were
   * right twice over:
   *
   *   padding: 28.8px 28.8px 0 0   asymmetric, so a stop's CONTENT BOX centre
   *                                sat at 306.6 while the stop's own column
   *                                centre was 321 — every figure on the row was
   *                                14.4px left of where its column said it was.
   *   text-align: start            inherited, so the tag, the numeral and the
   *                                label all rendered hard against that already
   *                                displaced left edge, under a section heading
   *                                that is itself centred on 720.
   *
   * The rule that settles it is already written down: styles/surfaces.css says
   * a card is scanned so its content centres, and prose is read so it stays
   * left. A mono tag, a numeral and a five-word label are card content by that
   * test — there is no paragraph here to read down a left edge.
   *
   * THE SPINE STILL MEETS ITSELF. The 2px rule is `border-top` on the <li>,
   * which spans the full column whatever the padding inside it does, so making
   * the padding symmetric moves the content and not the line. Four segments,
   * one unbroken rule, unchanged.
   *
   * The label needs `margin-inline: auto` as well as centred text: it carries a
   * 26ch max-width, and a narrower block inside a centred column is still
   * flush-left unless it is told to centre itself.
   */
  .spine__stop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--stack-1);
    /* This is the spine. Four segments, one line. */
    border-top: 2px solid var(--accent);
    /*
     * THE INLINE PADDING CAME DOWN FROM --blk-pad TO 12px, AND IT IS THE
     * NUMERAL THAT REQUIRED IT. At 1440 a column is 266px, and 28.8px of
     * padding each side left 208px of content box — narrower than "10%" set at
     * --t-numeral. The block padding is untouched, so the vertical rhythm the
     * centring fix established is unchanged; only the horizontal squeeze that
     * the old 57.6px figure never noticed has gone.
     */
    padding: var(--blk-pad) 12px 0;
    text-align: center;
    isolation: isolate;
  }

  /* The instrument's name, in the slot the stage word used to occupy. Mono,
     letter-spaced and uppercase, so it reads as a machine label rather than as
     a sentence fragment, which is the whole reason it can be this short. */
  .spine__tag {
    font-family: var(--font-mono);
    line-height: var(--lh-tight);
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .spine__value {
    font-family: var(--font-display);
    font-size: var(--t-numeral);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c-text);
    /* Figures share a width so the four do not visibly jitter against each
       other, which is the whole reason tabular figures exist. */
    font-variant-numeric: tabular-nums;
  }

  .spine__label {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.55;
    color: var(--c-text-sub);
    max-width: 26ch;
    /* A 26ch block inside a centred column is still flush-left without this. */
    margin-inline: auto;
  }

  /* THE ONLY LINK IN THE SECTION, and the only thing left where 90 words of
     source note used to be. Cyan is the interactive colour sitewide. */
  .spine__more {
    margin: var(--sec-gap) 0 0;
    text-align: center;
  }

  .spine__more a {
    /* 44px, WCAG 2.2 target size. A standalone action in its own row does not
       get the inline exception. */
    display: inline-flex;
    align-items: center;
    min-height: var(--btn-h-sm);
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--c-cyan);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .spine__more a:focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* ══ M2 · THE LIGHT ON THE SPINE ══════════════════════════════════════════
   *
   * Figma `144:2`, M2 — "A light travels the spine. The figures never move."
   * TRIGGER IntersectionObserver, threshold 0.35.
   * CADENCE 4 beats, one per spine stop, on the shared --m-cycle.
   * PLAYS: LOOPS, then rests for the other sixteen beats.
   *
   * IT USED TO PLAY ONCE, AND THE REASON IT NOW LOOPS IS NOT THAT THE REASON
   * WENT AWAY. This block previously argued, correctly, that a highlight
   * sweeping past a reader every few seconds while they decide whether to
   * follow the /sources link is the autoplay problem. The owner has asked for
   * continuous play across the homepage, so the answer is the REST rather than
   * the refusal: the light crosses the spine in 2.4s and the spine is then dark
   * for 9.6s. Four passes a minute over a decorative 2px rule is ambient; the
   * thing that was objectionable was a light that never stops.
   *
   * THE PASS IS FOUR BEATS BECAUSE THE SPINE HAS FOUR STOPS. It is not 1,600ms
   * any more because 1,600ms was this section's own number and agreed with
   * nothing else on the page. See the motion grammar in styles/tokens.css: a
   * beat is one station everywhere, so this light and the five-step light two
   * sections down travel at comparable speed and differ only in how far they go.
   *
   * STILL NO COUNT-UP, AND THE BOARD AGREES. Frame `144:158` records the
   * proposal being REFUSED by name: the legacy build animated these four
   * figures from zero on scroll, which is the hide-then-reveal pattern that
   * left four of nine homepage sections permanently invisible when the observer
   * did not fire. A number that might not arrive is worse than a number that
   * does not animate. Nothing in this section changes a figure, a label or a
   * tag at any point.
   *
   * LINEAR, NOT THE BOARD'S EASE CURVE, AND THAT IS DELIBERATE. `144:2` names
   * cubic-bezier(0.22, 1, 0.36, 1) while its own keyframe columns sit at t = 0,
   * 520, 1,040 and 1,600ms — four even quarters. Those two disagree: that curve
   * would put all four segment flashes inside the first 640ms and then crawl.
   * Even spacing is what makes each stop light as the highlight actually
   * reaches it, so the travel is linear and the delays are its quarters.
   */
  /*
   * THE TRACK EXISTS TO CLIP, AND THE CLIP IS NOT COSMETIC.
   *
   * The light is a full-width element that translates from -50% to +50%, which
   * is how the band scales with the measure instead of being a fixed 100px.
   * That means it is HALF THE MEASURE OUTSIDE ITS PARENT at each end of the
   * travel. Without this wrapper the page's scrollWidth grew by 344px at 1440
   * for the duration of the animation, which is a horizontal-overflow failure
   * that only exists while the light is moving and is therefore invisible to
   * any check that measures a settled page. Measured, not guessed.
   *
   * Every travelling light on this page needs the same treatment. The hero's
   * pulse and the integrations arrows already had it (their rails clip), and
   * FinalCta's sweep is inside a card that already sets overflow: hidden.
   */
  .spine__track {
    display: block;
    position: absolute;
    /* 24px tall and centred on the 2px rule, which occupies y = 0..2 of the
       spine because the stops draw it with their own border-top. The height is
       headroom for the underglow: a track clipped to 2px would cut the 12px
       pool off flat and leave a bare white line. */
    /* The rail is now --blk-pad below the panel top rather than on the
       section's own top edge, so the track that clips the travelling light
       moves with it. Expressed against the same token the padding uses, so the
       two cannot come apart. */
    top: calc(var(--blk-pad) - 11px);
    inset-inline: 0;
    height: 24px;
    overflow: hidden;
    pointer-events: none;
  }

  .spine__light {
    /* No animation and no trigger: zero pixels. The element exists so the
       stylesheet has something to move, and it is invisible until it does. */
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .spine__light {
      display: block;
      position: absolute;
      inset-inline: 0;
      top: 11px;
      height: 2px;
      /* WHITE CORE, HUE FROM THE SEGMENT BENEATH. `color` is what the gradient
         and the underglow both read, and it is animated through the same four
         accents the stops carry, so the light takes the colour of whatever it
         is currently over rather than having a colour of its own. */
      color: var(--c-teal);
      /* --grad-beam, hue taken from `color` so the light takes the colour of
         whatever segment it is currently over. --beam-w is 6% and not the
         default 16% because this element is the full 1160px spine rather than
         one cell of a rail; 16% would make the light 370px wide. The bloom stop
         sat at half the half-width here and at 0.375 of it elsewhere, which is
         the drift the token ends. */
      --beam-hue: currentColor;
      --beam-w: 6%;
      background: var(--grad-beam);
      /* THE UNDERGLOW. A soft pool that travels with the highlight and takes
         its hue from the same `color`, so it has no independent timing and
         cannot drift out of step with the thing casting it. */
      box-shadow: 0 0 12px currentColor;
      opacity: 0;
    }

    [data-lit='on'] .spine__light {
      animation:
        ms-travel var(--m-cycle) var(--m-ease-travel) infinite,
        ms-hue var(--m-cycle) var(--m-ease-travel) infinite;
    }

    /* Each stop's rule lifts to a specular white as the highlight passes and
       falls back to its own accent. The figure, the label and the tag are not
       touched: this is light on a stroke, which is the only surface on the page
       it is safe to put light on. */
    [data-lit='on'] .spine__stop {
      animation: ms-segment var(--m-cycle) var(--m-ease-land) infinite;
    }

    /* THE DELAYS ARE WHERE EACH STOP ACTUALLY IS, not four round numbers. The
       band is drawn at the middle of a full-width element translating from
       -50% to +50%, so its position is exactly t/pass across the spine; four
       equal stops have their centres at 1/8, 3/8, 5/8 and 7/8 of that, which is
       0.5, 1.5, 2.5 and 3.5 beats.

       THESE WERE nth-child 2 TO 5 AND ARE NOW 1 TO 4, and the reason is worth
       recording because it is the trap in counting positions rather than
       things. The track used to be the <ol>'s first child, which was invalid
       markup and also silently made every stop's index one higher than its
       ordinal. The track now sits in the .spine__panel <figure> alongside the
       list, so a stop's index is its ordinal again. Anything that moves a
       non-<li> into or out of this list must re-check these four lines. */
    [data-lit='on'] .spine__stop:nth-child(1) { animation-delay: calc(var(--m-beat) * 0.5); }
    [data-lit='on'] .spine__stop:nth-child(2) { animation-delay: calc(var(--m-beat) * 1.5); }
    [data-lit='on'] .spine__stop:nth-child(3) { animation-delay: calc(var(--m-beat) * 2.5); }
    [data-lit='on'] .spine__stop:nth-child(4) { animation-delay: calc(var(--m-beat) * 3.5); }
  }

  /* The band is drawn at the middle of a full-width element and the element
     translates, so the travel is one transform on the compositor and the band
     scales with the measure instead of being a fixed 100px that reads wide on a
     phone and narrow on a monitor. */
  /* FOUR BEATS OF TRAVEL IN A TWENTY-BEAT CYCLE, so everything happens between
     0% and 20% and the rest of the block is the rest state held flat. One beat
     is 5%. Same arithmetic in all seven sections; see styles/tokens.css. */
  @keyframes ms-travel {
    0% {
      transform: translateX(-50%);
      opacity: 0;
    }
    2% {
      opacity: 1;
    }
    18% {
      opacity: 1;
    }
    20% {
      transform: translateX(50%);
      opacity: 0;
    }
    /* Nine and a half beats of dark. The band is parked off the right-hand end
       at zero opacity, which is the state it holds with no animation at all. */
    100% {
      transform: translateX(50%);
      opacity: 0;
    }
  }

  /* The four accents are a DIRECTION ramp that is already approved and already
     shipped on the stops. The light rides them rather than replacing them. The
     ramp is spent across the 20% the light is visible for; after that the value
     is held, and nothing is looking at it because the band is at opacity 0. */
  @keyframes ms-hue {
    0%          { color: var(--c-teal); }
    6.6%        { color: var(--c-cyan); }
    13.3%       { color: var(--c-violet); }
    20%, 100%   { color: var(--c-orchid); }
  }

  /* Border colour only, and it opens and closes on --accent, so the rule is
     byte-identical to its rest state for nineteen of every twenty beats. The
     flash is 240ms, which is 2% of the cycle. */
  @keyframes ms-segment {
    0%        { border-top-color: var(--accent); }
    0.9%      { border-top-color: var(--c-text); }
    2%, 100%  { border-top-color: var(--accent); }
  }

  /* ══ THE STOP ANSWERS A CURSOR ════════════════════════════════════════════
   *
   * This section had ZERO :hover rules. specs/ULTRA-PREMIUM-GAP.md §2.6 names
   * it as one of the four sections where nothing on screen answers a pointer,
   * and puts the whole page at 2.7% of elements carrying a transition against
   * 16.2% on the dark comparator.
   *
   * WHAT A STOP DOES WHEN THE POINTER IS ON IT: the column stands up onto the
   * fourth surface step, its accent rule goes specular white, the instrument
   * tag brightens, the figure's cast deepens, and the label comes up from
   * --c-text-sub to --c-text. Five things, one event.
   *
   * THE BACKGROUND CHANGE IS THE ONE THING TO CHECK IF THIS IS EVER EDITED.
   * It is a ::before, so nothing about the stop reflows, and it sits at
   * z-index -1 inside the stop's own isolated stacking context, so it is behind
   * the tag, the figure and the label rather than over them. Both ENDPOINTS
   * clear the contrast floor with room: --c-text on --c-lit is about 19:1 and
   * --c-text-sub on --c-lit about 12:1, so every intermediate frame of the
   * transition does too, which is what the axe gate samples for. This section
   * is two below the one that has already failed that gate once.
   *
   * NOTHING TRANSLATES. A stop is a figure and a label, not a control, and
   * styles/surfaces.css is explicit that lifting text under a pointer
   * advertises an affordance that is not there.
   *
   * THE ACCENT NEVER CHANGES HUE. It goes to white and back, which is the same
   * thing the travelling light already does to it four times a minute. Teal,
   * cyan, violet and orchid stay exactly where the direction ramp put them.
   */
  .spine__stop,
  .spine__tag,
  .spine__value,
  .spine__label {
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      filter var(--dur) var(--ease);
  }

  .spine__stop::before {
    content: '';
    position: absolute;
    z-index: -1;
    /* Reaches up over the 2px rule so the lit surface starts AT the rail rather
       than below it, and stops short of the bottom so the panel underneath
       still reads through. */
    inset: -2px 0 12%;
    border-radius: var(--radius-panel);
    /* --grad-ramp from the fourth surface step down to nothing, so the panel
       underneath still reads through. `transparent` written plainly: the old
       `color-mix(in srgb, var(--c-lit) 0%, transparent)` resolves to exactly
       the same rgba(0,0,0,0) and only looked like it meant something. */
    --ramp-from: var(--c-lit);
    --ramp-to: transparent;
      /* Written here, not var(--grad-ramp). A custom property's var()s are
         substituted where it is DECLARED, so a knob token on :root bakes in its
         fallbacks and inherits finished. Measured: --grad-ramp computes to
         `linear-gradient(180deg, #161B2F, #0E1220 100%)` on every element,
         whatever knobs it sets. It hid every blog hero photo behind an opaque
         rectangle before this was found. Colours still come from tokens. */
    background: linear-gradient(180deg, var(--c-lit), transparent 100%);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  @media (hover: hover) {
    .spine__stop:hover::before { opacity: 1; }

    .spine__stop:hover { border-top-color: var(--c-text); }

    .spine__stop:hover .spine__tag {
      filter: brightness(1.35);
      text-shadow: 0 0 14px color-mix(in srgb, var(--accent) 55%, transparent);
    }

    /* The numeral is painted through a gradient clipped to the glyph, so its
       shadow has to come off the paint rather than off the text: a
       text-shadow on a transparent fill draws nothing. Same reason
       `sv-numeral` uses a filter for its rest shadow. */
    .spine__stop:hover .spine__value {
      filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.9))
        drop-shadow(0 0 26px color-mix(in srgb, var(--c-text) 30%, transparent));
    }

    .spine__stop:hover .spine__label { color: var(--c-text); }

    .spine__more a:hover { color: var(--c-text); }
  }

  /* Four columns need roughly 240px each before the labels start breaking
     badly. Two, then one. */
  @media (max-width: 1023px) {
    .spine { grid-template-columns: repeat(2, 1fr); row-gap: var(--stack-2); }

    /* Two columns are far wider than four, so the figure can take the top of
       its clamp again rather than being held down by a 266px column. */
    .spine__value { font-size: clamp(3.5rem, 11vw, 7.5rem); }

    /* THE SPINE STOPS BEING ONE LINE HERE, so the light has nothing to travel.
       Two rows of rules cannot be crossed by one horizontal highlight, and a
       light that runs along the top row and ignores the bottom one is worse
       than no light. The per-segment flash stays: it is per-stop and needs no
       geometry. */
    .spine__track { display: none; }
  }

  @media (max-width: 639px) {
    .spine { grid-template-columns: 1fr; }
    .spine__label { max-width: none; }
  }
</style>
