---
/**
 * BothSides — homepage section 3, "Both sides of the table".
 *
 * WHY IT WAS NOT PORTED UNTIL NOW. This section was gated on OA-01. It led
 * with "The only engine that sits on both sides" and closed with "almost
 * nothing else in this market does both" — an absolute uniqueness claim about
 * a competitive market, stated twice, with nothing behind it. Porting it would
 * have moved that claim onto the new homepage by default, which is exactly
 * what the gate existed to prevent. Both are now softened at source and this
 * carries the softened wording, not the original.
 *
 * ONE FURTHER HEDGE APPLIED HERE. The supplier column said social value is
 * "priced at the published proxy values" without qualification. CrowMark does
 * monetise against National TOMs proxy values, so this is not the methodology
 * page's problem of describing a thing that does not exist — but the site has
 * settled on one form of words for it, published on /crowmark, on
 * /crowmark-buyers, on the calculator and in the lifecycle section: aligned to
 * National TOMs conventions rather than a full National TOMs implementation.
 * One engine should be described one way everywhere, so it is used here too.
 *
 * THE THREE GROUPS ARE A SEQUENCE, and numbering them would be wrong: they are
 * the same contract seen at three moments, not three steps a user takes. The
 * labels carry that; a 01/02/03 rail would assert an order the reader has to
 * follow.
 */
import Section from '../layout/Section.astro';

interface Side {
  badge: string;
  heading: string;
  body: string;
  cta: { label: string; href: string };
}

const SIDES: Side[] = [
  {
    badge: 'Suppliers',
    heading: 'Answer the question, once',
    body: 'Live tenders from Contracts Finder and Find a Tender, selection questionnaires answered from your own approved library, and PPN 002 social value priced against National TOMs proxy values, aligned to National TOMs conventions rather than a full National TOMs implementation.',
    cta: { label: 'CrowMark for suppliers', href: '/crowmark' },
  },
  {
    badge: 'Public sector',
    heading: 'Find the evidence across every response',
    body: 'Publish a requirement with a deterministic social value rubric, then have every response searched for the evidence behind each measure. Quotes are located word for word, or dropped, never invented.',
    cta: { label: 'CrowMark for buyers', href: '/crowmark-buyers' },
  },
];

const GROUPS: { label: string; items: string[] }[] = [
  {
    label: 'Requirement',
    items: ['Contract type and value', 'Local priorities', 'National TOMs measures', 'Weighting and rubric'],
  },
  {
    label: 'Evaluation',
    items: ['Evidence located', 'Consistency checks', 'Panel scoring', 'Clarifications'],
  },
  {
    label: 'After award',
    items: ['Committed measures', 'Delivery tracking', 'KPI reporting', 'Transparency pack'],
  },
];
---

<Section
  eyebrow="Both sides of the table"
  title="Supplier and authority, one rulebook"
  standfirst="The supplier answering and the authority evaluating work from the same rulebook and the same measures, so a commitment means the same thing whichever chair you are sitting in."
  id="both-sides"
>
  <div class="bs">
    <div class="bs__sides">
      {
        SIDES.map((s) => (
          <article class="bs__side">
            <p class="bs__badge">{s.badge}</p>
            <h3 class="bs__h">{s.heading}</h3>
            <p class="bs__body">{s.body}</p>
            <p class="bs__cta">
              <a href={s.cta.href}>
                {s.cta.label}
                <span class="visually-hidden"> — {s.heading}</span>
              </a>
            </p>
          </article>
        ))
      }
    </div>

    {/* The shared spine: the same contract at three moments. A <dl> because
        each label defines the set of measures beneath it. */}
    <dl class="bs__groups">
      {
        GROUPS.map((g) => (
          <div class="bs__group">
            <dt class="bs__group-label">{g.label}</dt>
            <dd class="bs__group-items">
              <ul>
                {g.items.map((i) => (
                  <li class="bs__chip">{i}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>

    <p class="bs__foot">
      One engine, both sides of the table: the rubric an authority builds and the answer a supplier
      writes come from the same measures.
    </p>
  </div>
</Section>

<style>
  .bs__sides {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--stack-2);
  }

  .bs__side {
    padding: var(--blk-pad);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-card);
    background: var(--c-card);
    /* The two bodies are different lengths — four lines against three — so
       without this the links sit at different heights and the pair reads as
       misaligned rather than as a matched set. Column flex plus margin-top:auto
       on the link pins both to the bottom edge whatever the copy does. */
    display: flex;
    flex-direction: column;
  }

  .bs__badge {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  .bs__h {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 700;
    line-height: 1.25;
    color: var(--c-text);
  }

  .bs__body {
    margin: 0 0 var(--stack-2);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text-sub);
  }

  .bs__cta { margin: auto 0 0; }

  .bs__cta a {
    color: var(--c-teal);
    font-size: var(--t-body);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .bs__cta a:hover { color: var(--c-teal-dark); }
  .bs__cta a:focus-visible { outline: 3px solid var(--c-teal); outline-offset: 3px; border-radius: 2px; }

  /* ── The shared spine ─────────────────────────────────────────────────── */
  .bs__groups {
    margin: var(--sec-gap) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--stack-2);
  }

  .bs__group {
    padding-top: var(--stack-2);
    border-top: 1px solid var(--c-border);
  }

  .bs__group-label {
    margin-bottom: var(--stack-1);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .bs__group-items { margin: 0; }

  .bs__group-items ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--stack-1);
  }

  .bs__chip {
    font-size: var(--t-body);
    line-height: 1.5;
    color: var(--c-text-sub);
  }

  .bs__foot {
    margin: var(--sec-gap) 0 0;
    padding-top: var(--stack-2);
    border-top: 1px solid var(--c-border);
    max-width: 68ch;
    font-size: var(--t-lede);
    line-height: 1.65;
    color: var(--c-text);
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
