  /* ── THE RUN, SCRUBBED BY THE SCROLL ─────────────────────────────────
   *
   * It was a timed choreography on `data-lit`: one pass, on a clock, started
   * when a fraction of the section was in view. On a phone and a tablet the
   * screen sits a viewport or more below the steps, so the pass had finished
   * before the reader arrived and the demo looked static. Owner, 2026-09-06:
   * no animation in Run the real engine on mobile, and the same on tablet.
   *
   * TWO REELS, AND NOTHING IS ON A CLOCK. scripts/reel.ts writes `--reel` from
   * 0 to 1 across a block's travel through the viewport: one on the steps, one
   * on the screen. Every value below is a function of it, so the reader is the
   * projectionist: the scan runs the draft as they scroll it, each claim's rule
   * draws as the scan reaches it, the refusal strikes, the stamp lands. Scroll
   * back and it rewinds.
   *
   * REST IS 1, WHICH IS THE FINISHED TRACE. `--reel: 1` is declared on both
   * blocks, so with no script, under reduced motion, in print and on any engine
   * that never runs the file, the screen is complete and merely still. Nothing
   * here can leave a word unread.
   *
   * `k(t, w)` below is written out per element rather than as a helper because
   * CSS has none: `clamp(0, (reel - t) / w, 1)` is a ramp from 0 to 1 that
   * starts at t and takes w of the reel to complete.
   */

  /* The steps. Each lights as the reel passes its fifth. */
  .h2rt__step {
    --on: clamp(0, calc((var(--reel) - var(--step-i, 0) * 0.16) * 6), 1);
  }

  .h2rt__dot {
    background-color: color-mix(in srgb, var(--dot-ink) calc(var(--on) * 100%), var(--c-border));
    box-shadow: 0 0 calc(var(--on) * 16px) color-mix(in srgb, var(--dot-ink) calc(var(--on) * 70%), transparent);
  }

  .h2rt__name {
    color: color-mix(in srgb, var(--c-text) calc(var(--on) * 100%), var(--c-text-muted));
  }

  [data-drop='on'] .h2rt__name {
    color: color-mix(in srgb, var(--c-refused) calc(var(--on) * 100%), var(--c-text-muted));
  }

  .h2rt__detail {
    color: color-mix(in srgb, var(--c-text-sub) calc(var(--on) * 100%), var(--c-text-muted));
  }

  /* The scan reads down the draft as the screen travels. */
  .h2rt__scan {
    inset-block-start: calc(-2em + var(--reel) * (100% + 2em));
  }

  /* Each traced rule draws as the scan reaches its claim. */
  .h2rt__claim[data-claim='traced'] {
    --on: clamp(0, calc((var(--reel) - 0.18 - var(--claim-i, 0) * 0.1) * 10), 1);
  }

  .h2rt__claim[data-claim='traced']::after {
    transform: scaleX(var(--on));
  }

  /* The refusal strikes last, and its highlight comes up with the strike. */
  .h2rt__claim[data-claim='refused'] {
    --on: clamp(0, calc((var(--reel) - 0.52) * 10), 1);
    background-color: color-mix(in srgb, var(--app-refused) calc(var(--on) * 14%), transparent);
    text-decoration-color: color-mix(in srgb, var(--app-refused) calc(var(--on) * 100%), transparent);
  }

  /* Each grounding row's mark grows as its claim is settled. */
  .h2rt__row {
    --on: clamp(0, calc((var(--reel) - 0.22 - var(--row-i, 0) * 0.1) * 10), 1);
  }

  .h2rt__mark {
    scale: calc(0.55 + var(--on) * 0.45);
  }

  /* The verdict is stamped as the refusal lands. */
  .h2rt__badge {
    --on: clamp(0, calc((var(--reel) - 0.6) * 8), 1);
    scale: calc(0.82 + var(--on) * 0.18);
  }

  /* The ledger beside it settles on the same reel. */
  .h2rt__sum b {
    scale: calc(0.9 + clamp(0, calc((var(--reel) - 0.66) * 8), 1) * 0.1);
  }

  .h2rt__cell--refused dd {
    --on: clamp(0, calc((var(--reel) - 0.74) * 8), 1);
    text-shadow: 0 0 calc(var(--on) * 18px) color-mix(in srgb, var(--c-refused) calc(var(--on) * 70%), transparent);
  }

  /* The drawn rail is the steps' reel, scaled from the start edge. */
  @media (min-width: 62rem) {
    .h2rt__rail-lit {
      transform-origin: 0 50%;
      transform: scaleX(var(--reel));
    }
  }

  /* The one loop that is not the reader's: a status light breathing. */
  @media (prefers-reduced-motion: no-preference) {
    .h2rt__live i {
      animation: h2rt-breathe calc(var(--m-beat) * 3) var(--m-ease-breath) infinite;
    }
  }

  @keyframes h2rt-breathe {
    0%, 100% { box-shadow: 0 0 6px var(--c-verified-glow); }
    50%      { box-shadow: 0 0 14px var(--c-verified-glow); }
  }
