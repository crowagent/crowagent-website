---
/**
 * Every metadata concern on the site, in one place.
 *
 * On the legacy tree this markup was copy-pasted into 45 separate <head>
 * blocks: 44 pages repeated the OG tags, 40 repeated an identical
 * Organization JSON-LD, and the heads of index.html and crowmark.html had
 * drifted 427 lines apart. A single missing canonical or a stale og:image was
 * invisible until something downstream broke.
 *
 * Defaults come from src/data/site.ts. A page overrides only what is genuinely
 * different about it, which in practice is title, description and image.
 */
import { SITE } from '../../data/site';
import { routeUrl } from '../../lib/route-url';

interface Props {
  title: string;
  description: string;
  /** Route path, e.g. "/crowmark". The canonical is derived, never hand-written. */
  path: string;
  image?: string;
  /**
   * Alt text for the social card, used for BOTH og:image:alt and
   * twitter:image:alt. Defaults to `description`, which is what every page
   * emitted before this prop existed.
   *
   * It exists because /compare, /glossary and /sectors each author an
   * `ogImageAlt` in their frontmatter, their layouts destructured it, and
   * nothing read it: this component emitted the description instead, so the
   * authored text was discarded on all ten of those routes (A-59). A prop that
   * is written, typed and validated but never reaches the markup is worse than
   * no prop at all, because the author has every reason to believe it worked.
   *
   * Named for the image rather than for og:, because the alt describes the
   * picture and both networks ask for the same sentence about it.
   */
  imageAlt?: string;
  /** article for blog posts, website for everything else. Drives og:type. */
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /** noindex is opt-in and must be deliberate. */
  noindex?: boolean;
  /** Page-specific JSON-LD, merged into the shared graph rather than replacing it. */
  schema?: Record<string, unknown>[];
  /**
   * Some legacy pages (compare/*, sectors/*, glossary/*) hand-wrote a
   * different og:title/og:description than their <title>/meta description.
   * These default to `title`/`description` so every existing caller is
   * unaffected; pass them only where the source page genuinely diverged.
   */
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
}

const {
  title,
  description,
  path,
  image = SITE.defaultOgImage,
  imageAlt = description,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  schema = [],
  ogTitle = title,
  ogDescription = description,
  twitterTitle = ogTitle,
  twitterDescription = ogDescription,
} = Astro.props;

// Canonical is derived from the route so it cannot drift from where the page
// actually lives. The legacy tree hand-wrote these and one page ended up
// claiming a URL that no longer existed.
/*
 * ── THE CANONICAL IS THE FORM THE SERVER ANSWERS 200 ON ─────────────────────
 *
 * WHAT THIS USED TO DO, AND WHY IT WAS RIGHT WHEN IT WAS WRITTEN. It stripped
 * the trailing slash from every route except the root:
 *
 *     path === '/' ? `${SITE.origin}/` : new URL(path, SITE.origin).href.replace(/\/$/, '')
 *
 * The site then deployed from the repository root, where every page was a flat
 * `about.html`, and Cloudflare Pages canonicalises towards whichever form is
 * backed by a file: with a flat file present, `/about/` answered 308 and
 * `/about` answered 200. Stripping the slash pointed the canonical at the 200.
 *
 * WHAT CHANGED UNDERNEATH IT. On 2026-08-05 the deploy source moved to
 * `astro/dist`, built with `build.format: 'directory'`, so every route became an
 * `about/index.html` and Cloudflare reversed direction: it now ADDS the slash.
 * Not one URL was edited, and from that deploy until 2026-08-12 all 44 non-root
 * routes declared a canonical that answers 308. scripts/build-sitemap.js reads
 * these canonicals, so the sitemap advertised the same 44 redirects, which
 * Search Console reports as "Page with redirect" and does not index.
 *
 * THE DERIVATION LIVES IN lib/route-url.ts, not here, because lib/schema.ts had
 * its own copy of it for BreadcrumbList items and BlogPosting @ids. Two
 * expressions that must agree about one page's address is the drift this
 * component was created to end for metadata; that file ends it for the address
 * itself, and carries the full measurement and the redirect-loop reasoning.
 *
 * THE ROOT NEEDS NO SPECIAL CASE ANY MORE. `/` already ends in a slash, so
 * `https://crowagent.ai/` falls out of the same rule that gives `/about/`, and
 * that is the value the homepage has always declared. It does not move.
 */
const canonical = routeUrl(path);
const ogImage = new URL(image, SITE.origin).href;

// The Organization node appeared verbatim on 40 pages. It is defined once in
// site.ts and emitted here, with page-specific nodes appended rather than
// overwriting it.
/*
 * ── A WebPage NODE, EMITTED ONLY WHEN A PAGE CAN PROVE WHEN IT CHANGED ──────
 *
 * WHY THIS EXISTS. scripts/build-sitemap.js reads <lastmod> out of THIS emitted
 * JSON-LD rather than stamping it at build time, and its header states the
 * reason: "a lastmod stamped at build time would claim every page changed
 * today, every deploy", which Google discounts. The consequence was that only
 * the twelve routes carrying a date in their own structured data got a lastmod
 * at all, and the thirty that could not prove a date stayed silent.
 *
 * THAT SILENCE BECAME A PROBLEM ON 2026-08-05. The deploy source moved to the
 * Astro tree and the pages a reader most needs re-indexed - /pricing with the
 * restored trial, / with the new statutory figures - changed materially while
 * carrying NO dateModified, so a crawler had no reason to come back for them.
 *
 * THE FIX KEEPS THE RULE RATHER THAN BREAKING IT. `updatedAt` is passed by a
 * page that genuinely changed, so the date is TRUE. It was already threaded
 * through Base for `article:modified_time`; this puts the same value into the
 * graph, from which the sitemap reads it. Sitemap and structured data cannot
 * disagree because they are one value, which is the property the sitemap's own
 * header says makes it safe.
 *
 * A PAGE THAT PASSES NOTHING STILL SAYS NOTHING. No node is emitted, no lastmod
 * appears, and the "never guess a date" rule is intact.
 */
const webPage = updatedAt
  ? [
      {
        '@type': 'WebPage',
        '@id': `${canonical}#webpage`,
        url: canonical,
        name: title,
        dateModified: updatedAt.toISOString().slice(0, 10),
        isPartOf: { '@id': `${SITE.origin}/#organization` },
      },
    ]
  : [];

const graph = [SITE.organizationSchema, ...webPage, ...schema];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_GB" />
<meta property="og:type" content={type} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:title" content={twitterTitle} />
<meta name="twitter:description" content={twitterDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<script
  type="application/ld+json"
  set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
/>
