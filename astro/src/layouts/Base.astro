---
/**
 * Base.astro — the html shell every page renders through.
 *
 * Metadata is entirely delegated to Seo.astro (title, canonical, OG,
 * Twitter, JSON-LD @graph). This layout only owns the document skeleton
 * and the sitewide design tokens.
 */
import Seo from '../components/seo/Seo.astro';
import Nav from '../components/nav/Nav.astro';
import Footer from '../components/footer/Footer.astro';
import CommandPalette from '../components/nav/CommandPalette.astro';
/* FIRST, before tokens.css. A face has to be declared before anything asks for
   it — and until 2026-08-03 nothing declared one at all, so every family in
   tokens.css silently resolved to system-ui. See the note in fonts.css. */
import '../styles/fonts.css';
import '../styles/tokens.css';
/* The shared card treatment. Loaded here rather than per page so a card looks
   the same on every route by default and has to be argued with to differ. */
import '../styles/surfaces.css';
/* The shared button row. Loaded here for the same reason as surfaces.css: two
   buttons side by side should be equal width on every route by default, rather
   than in whichever fourteen containers happened to be written that way. */
import '../styles/button-row.css';
/* The arrival. Loaded here, after surfaces.css, because it is bound to <main>
   below and to `.surface` above, and because it must apply to every route with
   no page opting in. Zero JavaScript; see the header of the file. */
import '../styles/motion.css';
/* The three premium micro-animations, restored 2026-08-03. Loaded here for the
   opposite reason to the four above: they must NOT apply to every route. It is
   in the layout so the recipes are defined in one place and the list of what
   carries them can be counted, which is the only defence against the effect
   that appears on one more element per week until it means nothing. Each rule
   names its carriers above itself. */
import '../styles/effects.css';

interface Props {
  title: string;
  description: string;
  /** Route path, e.g. "/blog/some-post". Passed straight through to Seo.astro. */
  path: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
}

const {
  title,
  description,
  path,
  image,
  type,
  publishedAt,
  updatedAt,
  noindex,
  schema,
  ogTitle,
  ogDescription,
  twitterTitle,
  twitterDescription,
} = Astro.props;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title={title}
      description={description}
      path={path}
      image={image}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      noindex={noindex}
      schema={schema}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      twitterTitle={twitterTitle}
      twitterDescription={twitterDescription}
    />
    <script is:inline>
      // Platform-aware Ctrl/Cmd-K badge (nav search affordance): stamp the OS
      // family on <html> synchronously, before <body> — and the nav's kbd
      // badge inside it — are parsed. Fixes a legacy bug where nav-inject.js
      // hardcoded a Mac "⌘K" badge for every visitor regardless of platform.
      // Running here (blocking, in <head>, before first paint) means the
      // correct label is already selected the first time the nav paints, so
      // there is no flash of the wrong label and no layout shift when it
      // "corrects" — CSS in Nav.astro shows only the matching span.
      (function () {
        try {
          var platform =
            (navigator.userAgentData && navigator.userAgentData.platform) ||
            navigator.platform ||
            navigator.userAgent ||
            '';
          if (/Mac|iPhone|iPad|iPod/.test(platform)) {
            document.documentElement.setAttribute('data-kbd-os', 'mac');
          }
        } catch (e) {
          /* default (no attribute) reads as "Ctrl K" — a safe fallback */
        }
      })();
    </script>
  </head>
  <body>
    {/* The page grain. One element, in the layout, so every route gets it and
        no page can forget it. See the .sv-page-grain note below for why the
        glass needs it. aria-hidden and pointer-events: none — it is texture. */}
    {/* The scroll progress indicator, owner decision 2026-08-03. One element,
        no script, and every rule that governs it is in styles/motion.css —
        which is not a preference: check-motion rule 1 permits a scroll-driven
        timeline in that file and nowhere else. aria-hidden because it says
        nothing a reader cannot already see from the scrollbar; it is chrome
        about the content, not content. */}
    <i class="sv-progress" aria-hidden="true"></i>
    <i class="sv-page-grain" aria-hidden="true"></i>
    {/* The starfield. Live carries one and this build had nothing; see the
        .sv-stars note below. Texture, so aria-hidden. */}
    <i class="sv-stars" aria-hidden="true"></i>
    {/*
      Skip link and <main> are BOTH required, and they are a pair. A parity run
      against the legacy site found every legacy page carries a skip link and a
      <main>, while all 8 ported blog posts had neither: the article rendered as
      a bare <article> with no landmark. A keyboard or screen-reader user had no
      way past the navigation, and a skip link without a <main> to target is
      worse than none because it silently goes nowhere.

      They live here rather than in each page layout so no future route can be
      added without them. That is the whole point of owning the shell.
    */}
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Nav currentPath={path} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
  </body>
</html>

{/*
  THE MAGNET, MOUNTED IN THE LAYOUT AND NOWHERE ELSE.

  Restored 2026-08-03 on the owner's instruction. It sits here rather than in a
  page for the reason the ambient layer does: the visual layer went missing in
  the first place because every ported section dropped it independently and no
  single omission looked wrong. A route cannot forget an effect the shell owns.

  It is also the difference between this and the legacy version. There the
  behaviour was a `<script defer>` that pages carried one at a time, so
  /about got one magnetic control and /contact got three, and nobody decided
  either number. Button.astro now emits `data-magnetic` for every primary, and
  this line is what makes those attributes mean something on all 43 routes.

  Astro bundles and hashes this; it is not a second request per page. If it
  fails to load, every button keeps its hover, press and focus states, because
  --mag-x and --mag-y fall back to 0px in Button.astro. Rest state is final
  state, which is the same contract motion.ts states in its own header.
*/}
<script>
  import { initMagnetic } from '../scripts/magnetic';
  initMagnetic();
</script>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--c-bg);
    color-scheme: dark;
    /*
     * THE HEADER IS STICKY, SO EVERY ANCHOR JUMP LANDS UNDERNEATH IT.
     * Measured: header 73px, and following the skip link put #main-content at
     * top: 0 — the first 73px of the page's own content sitting behind the
     * bar. The skip link is the one control whose entire purpose is to move a
     * keyboard user to the content, so it was the worst possible target.
     * WCAG 2.2 SC 2.4.11 Focus Not Obscured, which axe cannot detect: the
     * element is in the DOM, visible, focusable and correctly labelled, and it
     * is behind something.
     *
     * scroll-padding-top on the scroll container fixes EVERY jump at once —
     * skip link, fragment URLs arriving from search results, :target, the
     * command palette, and any anchor added later by someone who never reads
     * this file. It was previously handled by hand-written scroll-margin-top
     * on five specific selectors in three files, which covered prose headings
     * and nothing else.
     *
     * 96px is 73px of header plus 23px of breathing room, and matches the
     * value those five rules had already arrived at independently.
     */
    scroll-padding-top: 96px;
  }
  body {
    margin: 0;
    background: var(--c-bg);
    color: var(--c-text);
    font-family: var(--font-body);
    /* The orbs are positioned against the page, not the viewport. */
    position: relative;
    isolation: isolate;
  }

  /*
   * AMBIENT LAYER. Two soft colour fields behind the whole document, which is
   * what makes --c-card's translucency mean anything — until this existed the
   * cards were translucent over flat black, so the drift the token comment
   * describes had nothing to drift over.
   *
   * GLOBAL RATHER THAN PER-SECTION, on purpose. The visual layer went missing
   * in the first place because every ported section dropped it independently
   * and no single change looked wrong. Anchoring it to the layout means a new
   * page cannot forget it.
   *
   * pointer-events: none and z-index: -1 keep it entirely out of the way: it
   * cannot intercept a click, cannot take focus, and cannot cover content.
   * It carries no information, so it is invisible to assistive tech by being
   * a pseudo-element with no content.
   *
   * FIXED, NOT ABSOLUTE, and that is a bug fix rather than a preference. The
   * first version positioned these absolutely with `right: -20vw`, which
   * extended the scrollable width of the document and put horizontal overflow
   * on every page at 768 and 1440 — a defect the sitewide gate checks for at
   * three widths, caught before it shipped. Fixed positioning takes them out of
   * the layout entirely, so they cannot influence scrollWidth at any viewport,
   * and the field stays put while the content moves over it.
   *
   * (Editing note: the Tailwind parser pairs quote characters across this
   * stylesheet INCLUDING inside comments, so an odd number of apostrophes
   * fails the build with "Unterminated string" and a message quoting the text
   * that follows the stray one. Apostrophes are fine in pairs — there are
   * others above — but a single new one will break it. This paragraph is
   * worded without one for that reason.
   *
   * A second hazard, found 2026-08-02: a stray comment terminator had been left
   * immediately above this paragraph, closing the block early so every line
   * below it was handed to the CSS parser as declarations. That surfaced only
   * as an esbuild "Expected identifier but found whitespace" WARNING during
   * minification, and a warning does not fail the build, so it shipped. After
   * editing any comment in this file, check the build output for a
   * css-syntax-error rather than trusting the exit code.)
   */
  /*
   * ON, AND OWNER-CONFIRMED 2026-08-02. Worth recording how it got here, because
   * it will look like an unreviewed change to the next person reading the diff.
   *
   * Commit ca2be8ae added this layer AND, in the same change, the stray comment
   * terminator repaired above. The broken comment meant the CSS parser never
   * reached these rules, so the layer did not render on any build between then
   * and 2026-08-02. Repairing the comment switched it on for the first time. The
   * owner saw the result, asked whether the full-page gradient was a mistake,
   * and on being shown the history said it was fine to keep.
   *
   * So this is deliberate now, where before it was only intended. Both fields
   * are position: fixed, so they do not scroll away and the tint is constant
   * down the page. That is the effect the owner approved; do not "fix" it into
   * an absolutely positioned layer without asking, and note that absolute
   * positioning is exactly what caused the horizontal-overflow defect described
   * above.
   */
  /* ══ THE PAGE WASH — LIVE'S STRUCTURE, NOT OURS ═══════════════════════════
   *
   * This was two fixed circles, 1100px and 900px, at 0.82 and 0.78 alpha with a
   * 40px blur. Measured against the deployed site, live does something quite
   * different: ONE fixed full-viewport layer carrying three very wide radial
   * gradients at 0.08 to 0.10 alpha, with no blur at all.
   *
   * That is why the two never matched. Turning our orbs off and back on again
   * could not close a structural difference, and three attempts at it compared
   * against the legacy copy in this repo rather than against the deployed page.
   *
   * Very low alpha over a very wide area is the whole trick: it reads as depth
   * in the page rather than as two coloured blobs sitting on it. Blur is not
   * needed because nothing has a hard edge to begin with, which also removes
   * the paint cost that made the old version too expensive for phones.
   *
   * z-index -1 keeps it above the canvas and below every piece of content.
   * pointer-events: none so it can never intercept anything. No content, so it
   * is invisible to assistive technology by construction. */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: var(--grad-page-wash);
  }

  /* ══ THE WASH DRIFTS ══════════════════════════════════════════════════════
   *
   * Owner instruction, 2026-08-03: *"Ambient Background Motion. Enhance subtle
   * animated lighting and background movement."*
   *
   * The layer above existed and was completely still. The starfield breathed,
   * the section fields drifted, and the one element covering the whole page did
   * not move at all — so on /pricing, /about, /sources and every legal route,
   * which carry no section field, nothing on the page moved except the text
   * arriving.
   *
   * IT MOVES THE THREE LAYERS INDEPENDENTLY, which is the difference between
   * lighting and a sliding rectangle. --grad-page-wash is three radials: violet
   * top left, cyan top right, teal bottom centre. `background-position` takes
   * one value per layer, so each drifts its own distance in its own direction
   * and the three never hold the same relative arrangement twice inside a pass.
   * Moving them as one would read as the page being dragged.
   *
   * THE TRAVEL IS UNDER 3%, AND THAT IS THE ENTIRE DESIGN. These are 1000px+
   * ellipses at 0.08 to 0.10 alpha with no hard edge anywhere. At this size a
   * 2% shift is tens of pixels of very soft light — a reader never sees it
   * move, they see the page not being flat. Anything visible enough to notice
   * on a marketing page is something to look at instead of the words.
   *
   * 70s, AND THE NUMBER IS CHOSEN THE SAME WAY tokens.css CHOOSES --m-drift.
   * That comment sets the ambient field to 18s against a 12s section cycle
   * *"deliberately NOT a multiple ... so the page never repeats itself
   * exactly"*. 70s is 3.89 x 18 and 5.83 x 12, so it is harmonic with neither
   * and the three periods only realign after several minutes. It is a local
   * value rather than a token because exactly one element uses it; the moment a
   * second wants it, it becomes --m-wash and moves to tokens.css.
   *
   * IT COSTS NOTHING TO COMPOSITE. `background-position` on a fixed,
   * pointer-events: none, z-index: -1 layer touches no layout and no other
   * element. There is nothing above it that can be forced to repaint, because
   * it is behind the whole document by construction.
   *
   * NOT AN ENTRANCE, and check-motion.js rule 2 agrees for the right reason:
   * it reads `opacity` and `transform`, and this animates neither. There is no
   * hidden state anywhere in it — the wash is fully painted at 0%, at 100% and
   * at every frame between, so a browser that ignores the animation shows the
   * layer exactly as it shipped before today.
   *
   * ── THE FIRST VERSION OF THIS ANIMATED NOTHING AT ALL ─────────────────────
   *
   * It ran, its computed `background-position` moved from `0% 0%` to
   * `2.4% 1.2%` exactly on cue, and the rendered page did not change by a
   * single pixel. Caught by seeking the animation and diffing the frames, with
   * every other animation on the page frozen; nothing in the CSS looked wrong
   * and no gate could have seen it.
   *
   * THE REASON IS A CSS RULE THAT IS EASY TO FORGET. A PERCENTAGE background
   * position resolves to `(container - image) x percentage`. With
   * `background-size: auto`, a gradient image is exactly the size of its
   * container, that term is ZERO, and every percentage resolves to no offset.
   * Percentages in background-position are a no-op on a full-bleed gradient.
   *
   * The fix is both declarations below.
   *
   * `background-size: 112%` gives the image somewhere to move. It also means the
   * three radials render 12% larger, which is not a visual change worth
   * defending against: these are 1000px+ ellipses at 0.08 alpha with no hard
   * edge, so a 12% larger one is a marginally softer falloff and nothing else.
   *
   * `no-repeat` AND AN OVERSIZED IMAGE ARE A PAIR, and the alternative is worse
   * in a specific way. Left tiling, a shifted layer wraps — and the second
   * radial is centred `at 100% 4%`, ON the right edge, so its BRIGHTEST point
   * would reappear as a vertical band down the opposite side. Left at 100% with
   * no-repeat, that same bright edge would instead be cut off by a hard
   * transparent strip. Only an image larger than the box avoids both, because
   * every edge that moves into view was already painted.
   *
   * The positions below are therefore in `vw`/`vh` rather than percentages.
   * They are LENGTHS, so they offset the image directly and do not go through
   * the `(container - image)` term at all. On a fixed, inset: 0 element the
   * viewport IS the box, so 1vw is 1% of it and the numbers still read as the
   * percentages they were written as. `-6vw -6vh` centres the oversized image;
   * the drift is the wander around that. */
  @media (prefers-reduced-motion: no-preference) {
    body::after {
      background-size: 112% 112%;
      background-repeat: no-repeat;
      animation: sv-wash-drift 70s var(--m-ease-breath) infinite;
    }
  }

  /* Four stops rather than two, so the layers wander instead of sliding out and
     straight back along the same line. The violet and the teal move against
     each other on the horizontal; the cyan carries most of the vertical.
     Every value is an offset from the centred `-6vw -6vh` baseline, and the
     swing is held inside that 6vw so no layer edge can ever reach the viewport.

     ── THE TRAVEL WAS TRIPLED AFTER MEASURING IT, AND THE NUMBER IS THE POINT ──

     The first working version moved each layer about 35px and was measured at a
     MAXIMUM CHANNEL DELTA OF 2/255, across 539,291 pixels. That is real in the
     compositor and invisible to a person: under 1% of a channel, well beneath
     what anyone can see, on a display that dithers it away anyway. An effect
     nobody can perceive is not subtle, it is a layer being animated for nothing.

     It is inherent to what this wash is. Three radials at 0.08 to 0.10 alpha
     over near-black contribute at most ~12 units of colour in total, so moving
     them can only ever redistribute a fraction of that. Getting to a delta a
     person can actually register means moving them properly, which is why the
     swing is now ~5vw rather than ~2vw.

     STILL WELL UNDER THE THRESHOLD WHERE IT COMPETES WITH THE PAGE, and that is
     asserted rather than hoped: verify-effects-paint.mjs measures the delta on
     every run and fails if it drops back below visibility OR rises past the
     point where the wash is something you look at instead of the words. */
  @keyframes sv-wash-drift {
    0%,
    100% {
      background-position:
        -1.2vw -1.4vh,
        -10.6vw -1.6vh,
        -6vw -10.4vh;
    }
    33% {
      background-position:
        -9.8vw -4.6vh,
        -1.6vw -9.4vh,
        -10.8vw -3.2vh;
    }
    66% {
      background-position:
        -5.4vw -10.2vh,
        -6.2vw -3.4vh,
        -1.4vw -6.8vh;
    }
  }

  /* ══ THE STARFIELD ════════════════════════════════════════════════════════
   *
   * Live has one and we had nothing. Eight single-pixel dots at 0.5 to 0.9
   * alpha over the whole viewport, the layer held at 0.35, breathing on a 7
   * second cycle.
   *
   * IT COSTS ALMOST NOTHING. Eight radial gradients on one fixed element, no
   * blur, no repeat, and the only animated property is opacity, which the
   * compositor handles without touching layout or paint.
   *
   * KEPT ON MOBILE, unlike the blurred orbs it replaces. The reason those were
   * dropped below 767px was the cost of blurring an 1100px field; there is no
   * blur here to pay for.
   *
   * The twinkle sits inside prefers-reduced-motion: no-preference, so a reader
   * who has asked for stillness gets the field at rest rather than no field. */
  .sv-stars {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.35;
    background-image: var(--grad-stars);
    background-repeat: no-repeat;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sv-stars { animation: sv-twinkle 7s var(--m-ease-drift, ease-in-out) infinite; }
  }

  @keyframes sv-twinkle {
    0%, 100% { opacity: 0.35; }
    50%      { opacity: 0.22; }
  }

  /* ══ THE PAGE GRAIN — what makes the glass read as glass ══════════════════
   *
   * Owner decision, 2026-08-03, from "where is glassmorphism?".
   *
   * The glass was never missing. `backdrop-filter: blur(22px) saturate(1.5)`
   * was computed and applied on every card — measured, 21 of 21 on /pricing,
   * 14 of 14 on /about, 10 of 10 on /sources. What was missing was anything
   * BEHIND it. A backdrop filter blurs what it is over, and blurring a flat
   * fill produces a flat fill. The site was paying for the effect on every card
   * and drawing a plain panel.
   *
   * WHY THIS IS NOT SOLVED BY BRINGING THE ORBS BACK, even though they are
   * back. The two orbs are fixed and sized to the hero, so they light the top
   * of the page and nothing else. /pricing, /about, /sources and every legal
   * page carry 45 glass cards between them and no ambient field at all. Grain
   * is page-wide and tiled, so every card on every route has texture to refract
   * regardless of where the orbs sit.
   *
   * IT REUSES --grain, NOT A SECOND NOISE. That token is 260 bytes of inline
   * feTurbulence on a 160px tile — no request, no third-party origin, and
   * rasterised once at tile size rather than at viewport size, which is the
   * whole reason it is cheap. `.sv-grain` already mounts it INSIDE ambient
   * wrappers on seven sections; this is the same texture at page level, which
   * is a different job rather than a duplicate: that one sits over a field so
   * it does not band, this one sits under the cards so they have something to
   * blur.
   *
   * BEHIND CONTENT, NEVER OVER IT. `z-index: -1` puts it in the same layer as
   * the two orbs, above the canvas and below everything in the document. Grain
   * over a word is a legibility cost with no benefit; grain under a card is the
   * effect.
   *
   * IT STAYS ON MOBILE, where the orbs do not. The reason the orbs are dropped
   * below 767px is the cost of blurring an 1100px field. A repeating 160px tile
   * costs nothing comparable, and a phone is exactly where a flat panel looks
   * cheapest. */
  .sv-page-grain {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: var(--grain);
    background-size: 160px 160px;
    /* Under glass rather than over content, so it can sit above .sv-grain's
       0.035 without reading as dirt. */
    opacity: 0.06;
  }
  img,
  picture {
    max-width: 100%;
    height: auto;
  }

  /* Off-screen until focused, then a real, visible, high-contrast target.
     NOT display:none and NOT visibility:hidden — either removes it from the
     focus order entirely, which is the usual way this control is broken while
     appearing to be present in the markup. */
  .skip-link {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 999;
    transform: translateY(-120%);
    padding: 0.75rem 1.25rem;
    background: var(--c-teal);
    color: var(--c-bg);
    font-family: var(--font-body);
    font-weight: 700;
    text-decoration: none;
    border-bottom-right-radius: var(--radius-panel);
    transition: transform var(--dur) var(--ease);
  }
  .skip-link:focus-visible {
    transform: translateY(0);
    outline: 3px solid var(--c-text);
    outline-offset: 2px;
  }
  /* The target is programmatically focusable so focus actually lands there,
     but it must never draw a focus ring when reached by mouse or by scroll. */
  main:focus {
    outline: none;
  }
</style>
