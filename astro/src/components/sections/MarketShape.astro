---
/**
 * MarketShape — "Four numbers you are already held to".
 *
 * WHAT THIS SECTION IS FOR, AND WHY THE CONTENT CHANGED (OA-27, owner decision
 * 2026-08-02). It used to lead with market statistics: 40,000+ notices a year,
 * 55% stopped at qualification, 44% citing process complexity. Three of those
 * four could not be sourced. Worse than misremembered: CIPS and techUK have
 * published on exactly that subject and neither 55% nor 44% appears anywhere in
 * their data, and 40,000+ was traceable only to commercial tender-alert
 * marketing copy. On a site whose whole argument is that every figure traces to
 * something, that was the worst place on the page to be loose.
 *
 * The replacement is not a better-sourced market statistic. It is a different
 * kind of number: figures the reader is already held to, each citing statute or
 * a Cabinet Office notice, with a date and a threshold that can be checked. A
 * number a reader is bound by beats a number about a market they already work
 * in, and it removes this entire class of defect rather than re-sourcing it.
 *
 * DO NOT MERGE SECTION 52 AND SECTION 71. s.52 sets and publishes the KPIs.
 * s.71 assesses performance against them and publishes the result. Collapsing
 * the two was a live accuracy defect on this site (OA-26), and s.52's own text
 * cross-references s.71. The two figures that come from them sit in different
 * stops for that reason.
 *
 * MARKET-NEUTRAL, WITH UK PUBLIC AS THE PROOF POINT (owner decision, OA-25).
 * These duties are UK public and are presented as the worked example. The
 * heading and standfirst must not read as though UK public is the whole market.
 *
 * WHY IT IS A SEQUENCE AND NOT A STAT GRID. Four numbers in four equal cards
 * with a coloured accent each is the default answer, and it throws away the one
 * thing this section actually knows: the figures are ordered in time. They sit
 * on the bid in the order a supplier meets them, from how the bid is scored to
 * the duty that repeats for the life of the contract.
 *
 * So the structure is a spine, not a grid. The coloured rule above each figure
 * is one continuous line across the four stops, moving teal to cyan to violet
 * to orchid, which is the brand ramp used for the one thing it is good for:
 * showing that a set of things has a direction.
 *
 * EVERY FIGURE HERE IS CITED, and the source note maps figure to source one by
 * one rather than pooling them, because pooled attribution is how the old
 * unsourced numbers survived so long behind a plausible-looking list. The note
 * is part of the content, not a footnote to be tidied away, and it carries the
 * disclaimer that these are duties rather than this product's performance. Do
 * not drop it, do not shrink it into illegibility, and do not add a fifth
 * figure without a source.
 *
 * NO COUNT-UP ANIMATION. The legacy version animated these from zero on scroll,
 * which is the hide-then-reveal pattern that left 4 of 9 homepage sections
 * permanently invisible when the observer did not fire. A number that might not
 * arrive is worse than a number that does not animate.
 */
import Section from '../layout/Section.astro';

interface Stop {
  /** The moment in the bid at which this figure starts to bind. */
  stage: string;
  value: string;
  /** Continues the sentence the value starts. No full stop, as on the live page. */
  label: string;
  accent: string;
}

const STOPS: Stop[] = [
  {
    stage: 'Evaluation',
    value: '10%',
    label:
      'the minimum share of the award score that social value must carry on in-scope central government contracts',
    accent: 'var(--c-teal)',
  },
  {
    stage: 'Threshold',
    value: '£5m',
    label: 'the contract value above which the key performance indicator duties apply',
    accent: 'var(--c-cyan)',
  },
  {
    stage: 'At signature',
    value: '3',
    label:
      'key performance indicators, at least, set and published before the contract is entered',
    accent: 'var(--c-violet)',
  },
  {
    stage: 'Every year after',
    value: '12',
    label:
      'months, at most, between published assessments of performance against those indicators, and again on termination',
    accent: 'var(--c-orchid)',
  },
];
---

<Section
  eyebrow="Duties, not estimates"
  title="Four numbers you are already held to"
  standfirst="These are not estimates about a market. They are duties, each written into UK statute or a Cabinet Office notice, with a date and a threshold you can check. UK public procurement is the worked example because its duties are published; promising something and then evidencing it is the same work wherever you bid."
>
  <ol class="spine">
    {
      STOPS.map((s) => (
        <li class="spine__stop" style={`--accent: ${s.accent}`}>
          <span class="spine__stage">{s.stage}</span>
          <span class="spine__value">{s.value}</span>
          <span class="spine__label">{s.label}</span>
        </li>
      ))
    }
  </ol>

  <p class="spine__source">
    Sources, figure by figure. 10%: Procurement Policy Note 002, published 13 February
    2025, mandatory from 1 October 2025. £5m and 3: Procurement Act 2023, section 52, in
    force 24 February 2025. 12 months: Procurement Act 2023, section 71, in force 1
    January 2026. Section 52 sets and publishes the indicators; section 71 assesses
    performance against them and publishes the result, so a five year contract carries 3
    indicators across 5 published assessments. These are duties that apply to UK public
    contracts, used here as the worked example. They are not claims about this product’s
    performance, and they are advisory rather than legal advice.
  </p>
</Section>

<style>
  .spine {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    /* No column gap. The rules above the stops have to meet to read as one
       continuous line; the padding inside each stop provides the separation. */
    gap: 0;
  }

  .spine__stop {
    display: flex;
    flex-direction: column;
    gap: var(--stack-1);
    /* This is the spine. Four segments, one line. */
    border-top: 2px solid var(--accent);
    padding: var(--blk-pad) var(--blk-pad) 0 0;
  }

  .spine__stage {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .spine__value {
    font-family: var(--font-display);
    font-size: var(--t-stat);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c-text);
    /* Figures share a width so the four do not visibly jitter against each
       other, which is the whole reason tabular figures exist. */
    font-variant-numeric: tabular-nums;
  }

  .spine__label {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.55;
    color: var(--c-text-sub);
    max-width: 26ch;
  }

  .spine__source {
    margin: var(--sec-gap) 0 0;
    padding-top: var(--stack-2);
    border-top: 1px solid var(--c-border);
    font-family: var(--font-body);
    /* Small, because it is provenance. Not faint: --c-text-muted is 9.88:1 on
       the page background, and a source that cannot be read is not a source. */
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--c-text-muted);
    max-width: 78ch;
  }

  /* Four columns need roughly 240px each before the labels start breaking
     badly. Two, then one. */
  @media (max-width: 1023px) {
    .spine { grid-template-columns: repeat(2, 1fr); row-gap: var(--stack-2); }
  }

  @media (max-width: 639px) {
    .spine { grid-template-columns: 1fr; }
    .spine__label { max-width: none; }
  }
</style>
