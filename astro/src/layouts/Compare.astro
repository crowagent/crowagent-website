---
/**
 * Compare.astro — layout for /compare/crowmark-vs-*.
 *
 * The legacy pages rendered the article on a white band inside an otherwise
 * dark page. tokens.css is a single dark palette (see its header comment;
 * `color-scheme: dark` is set once, sitewide, in Base.astro), so there is no
 * light-surface token to reproduce that band with. The article renders on
 * the same dark surfaces as everywhere else in this rebuild (blog included)
 * rather than hardcoding a one-off light palette that would duplicate no
 * token and drift the moment tokens.css changes. This is a visual choice
 * only: no wording below is altered by it.
 */
import Base from './Base.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { SITE } from '../data/site';
import Button from '../components/ui/Button.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { breadcrumbs } from '../lib/schema';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  ogDescription: string;
  articleDescription: string;
  path: string;
  publishedAt: Date;
  updatedAt?: Date;
  competitor: string;
  eyebrow: string;
  heroDescription: string;
  ogImage: string;
  ogImageAlt: string;
  ctaHeadline: string;
  ctaSubLine1: string;
  ctaSubLine2: string;
  faq: FaqItem[];
}

const {
  title,
  description,
  ogDescription,
  articleDescription,
  path,
  publishedAt,
  updatedAt,
  competitor,
  eyebrow,
  heroDescription,
  ogImage,
  ogImageAlt,
  ctaHeadline,
  ctaSubLine1,
  ctaSubLine2,
  faq,
} = Astro.props;

const canonical = new URL(path, SITE.origin).href;
const breadcrumbLabel = `CrowMark vs ${competitor}`;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const updatedLabel = `Updated ${dateFormatter.format(updatedAt ?? publishedAt)}`;
const isoDate = (d: Date) => d.toISOString().slice(0, 10);

/*
 * THE ANCESTORS, DECLARED ONCE AND USED TWICE.
 *
 * The BreadcrumbList below was hand-written here, item by item, while the <nav>
 * further down was hand-written separately — and the two disagreed. The graph
 * said "Home > Compare > CrowMark vs X"; the page showed "Compare › CrowMark vs
 * X". Four routes, both statements maintained by hand, no reason for them to
 * agree, and /compare itself showing the Home root its own children dropped.
 *
 * One array now, through lib/schema.ts's breadcrumbs() helper — which this file
 * had not been using at all, which is the reason the shapes could differ in the
 * first place. scripts/check-breadcrumbs.js fails the build if they diverge.
 */
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Compare', path: '/compare' },
];

const schema: Record<string, unknown>[] = [
  breadcrumbs([...trail, { name: breadcrumbLabel, path }]),
  {
    '@type': 'Article',
    headline: title,
    description: articleDescription,
    datePublished: isoDate(publishedAt),
    dateModified: isoDate(updatedAt ?? publishedAt),
    image: new URL(ogImage, SITE.origin).href,
    author: { '@type': 'Organization', name: SITE.legalName, url: `${SITE.origin}/` },
    publisher: {
      '@type': 'Organization',
      name: SITE.legalName,
      logo: {
        '@type': 'ImageObject',
        url: 'https://crowagent.ai/Assets/brand/crowagent_wordmark_transparent_560x140.png?v=20260730',
      },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  },
];

if (faq.length) {
  schema.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}
---

<Base
  title={`${title} | CrowAgent`}
  description={description}
  ogTitle={title}
  ogDescription={ogDescription}
  twitterTitle={title}
  twitterDescription={ogDescription}
  path={path}
  image={ogImage}
  imageAlt={ogImageAlt}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  schema={schema}
>
  {/* A DIV, NOT A SECOND <main>. A-66: this wrapper was <main> on all four
      comparison routes and on /compare, nested inside the one Base.astro owns —
      three axe rules at once (landmark-no-duplicate-main, landmark-main-is-top-level,
      landmark-unique) and an undefined content landmark for anyone navigating by
      one. It stays as an element because styles/motion.css unwraps a single
      wrapper through `main > *:only-child > *`, so deleting it would change the
      arrival stagger; a div keeps the shape and drops the landmark. */}
  <div>
    <header class="cmp-hero">
      <div class="cmp-hero-inner">
        {/* Wrapped in an element this template owns; Breadcrumb.astro records
            why it takes no class of its own. */}
        <div class="cmp-breadcrumb"><Breadcrumb trail={trail} current={breadcrumbLabel} /></div>
        {/*
          THE SHARED HEAD BLOCK. Was `.cmp-eyebrow` + `.cmp-h1` + a
          `.cmp-hero-desc` lede, a hand-rolled copy of Section's head that never
          received Section's scoped heading treatment — which is why the four
          comparison routes this layout draws rendered a flat white title.

          THE FIFTH `.cmp-h1` LIVED IN pages/compare/index.astro, which built
          its own hero from a separate scoped copy of the very same rules. It
          has been converted too, so /compare and its four children now share
          one head block instead of maintaining two identical ones.

          THE BREADCRUMB STAYS OUTSIDE, above. PageHeader can put an eyebrow
          before the title and anything at all after it, but it has no slot
          ahead of the eyebrow, and inventing one would let any page push
          arbitrary markup into the shared block. A breadcrumb is page
          furniture that happens to sit above the head, not part of it.

          THE TWO-TONE SPLIT IS GONE. The words are unchanged — "CrowMark vs
          {competitor}" — but the `<span class="accent">` that painted half of
          them teal has been dropped: the owner asked for one heading treatment
          on every page, and a half-teal heading is a second one.

          THE "UPDATED" STAMP GOES IN THE SLOT, because on a comparison page it
          is a claim about the content's freshness and belongs under the lede
          rather than being dropped.

          IT ALSO TAKES `.meta`, FROM 2026-08-04. A-30. The words this emits are
          "Updated 26 July 2026" and the words a blog post emits under its title
          are "Updated 2 August 2026" — the same fact, built by the same
          `Intl.DateTimeFormat('en-GB')` recipe, one line apart in two layouts.
          /privacy, /cookies, /terms and /roadmap all state it as `.meta`, the
          bare mono micro-label in styles/labels.css, and so does the blog byline
          via `.meta art__meta`. These four routes were the only ones left
          rendering it in the proportional body face at body size, which made one
          fact read four ways on ten instances — and the fork was invisible
          because no two of those pages are ever on screen together.

          The class goes on the <p>. `.cmp-updated` keeps only what is this
          layout's own business: where the stamp sits under the head block, and
          its colour, which styles/labels.css leaves to the call site on purpose
          because hue carries meaning on this site and a shared label recipe that
          asserted one would force an override at every call site.
        */}
        <PageHeader
          title={`CrowMark vs ${competitor}`}
          eyebrow={eyebrow}
          standfirst={heroDescription}
        >
          <p class="meta cmp-updated">{updatedLabel}</p>
        </PageHeader>
      </div>
    </header>

    <section class="cmp-article-section">
      <div class="cmp-body">
        <slot />
      </div>
    </section>

    <section class="cmp-cta">
      <div class="cmp-cta-inner">
        <h2>{ctaHeadline}</h2>
        <p class="cmp-cta-sub">{ctaSubLine1}<br /> <span class="accent">{ctaSubLine2}</span></p>
        <div class="btn-row">
          <Button href="/pricing?product=mark" size="md">See pricing</Button>
          <Button href="/crowmark" variant="secondary" size="md">Explore CrowMark</Button>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /*
   * CENTRED HEAD BLOCK, GRADIENT EYEBROW — owner decision, 2026-08-02. The
   * head block itself is components/layout/PageHeader.astro now, styled by
   * styles/headings.css; this rule only centres the breadcrumb that sits above
   * it, which is the one piece of the hero this layout still draws.
   *
   * The centring is on .cmp-hero and stops there. It must not reach
   * .cmp-article-section: that slot holds the comparison prose, the feature
   * tables and the "who should choose which" cards, all of which read left to
   * right and are styled in the is:global block below.
   */
  .cmp-hero {
    position: relative;
    padding: var(--sec-pad-y-hero) var(--gutter) var(--sec-pad-y-sm);
    text-align: center;
    overflow: hidden;
  }
  .cmp-hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 60%;
    z-index: -1;
    background: var(--grad-hero-glow);
    filter: blur(30px);
    opacity: 0.5;
  }
  .cmp-hero-inner {
    max-width: var(--measure);
    margin-inline: auto;
  }
  /*
   * ONLY THE SPACING BELOW THE TRAIL IS LEFT HERE, 2026-08-04.
   *
   * The type, the separator, the colours, the hover, the focus ring and the SC
   * 2.5.8 target floor have all moved to components/ui/Breadcrumb.astro, which is
   * now the only breadcrumb on the site. Two copies of these rules existed — this
   * one and a hand copy in pages/compare/index.astro whose own comment said "both
   * should move to one place" — and a THIRD, in layouts/Article.astro, that had
   * been written without the target floor and shipped a 15px link on eight
   * routes as a result.
   *
   * Where the block sits in this hero is still this layout's business. What it
   * looks like is not.
   */
  .cmp-breadcrumb {
    margin: 0 0 var(--stack-2);
  }
  /*
   * THE EYEBROW, THE TITLE AND THE LEDE ARE ALL GONE FROM HERE.
   *
   * `.cmp-eyebrow` and its @supports guard, `.cmp-h1`, `.cmp-h1 .accent` and
   * `.cmp-hero-desc` were a hand-copy of Section's head block. They now come
   * from styles/headings.css by way of PageHeader, which is the only way the
   * treatment could ever reach a layout that does not use Section: it lived in
   * Section's SCOPED styles, so copying the markup was the one thing that could
   * not copy the look.
   *
   * `.cmp-hero-desc` capped at --measure-prose where every other standfirst on
   * the site sits at 62ch, which is now what it gets. `.cmp-h1 .accent` painted
   * "vs {competitor}" teal; that span is gone with the rule.
   *
   * .cmp-hero keeps its text-align, because the breadcrumb above the head block
   * is still this layout's own and still has to centre.
   */
  /* A-30, 2026-08-04: `font-size: var(--t-body)` is gone from here. The size,
     the face, the casing, the weight, the leading and the tracking are all
     `.meta` in styles/labels.css now — see the note at the call site. What is
     left is the two things that are genuinely this layout's: the colour, which
     labels.css leaves to the call site, and the spacing below the head block. */
  .cmp-updated {
    color: var(--c-text-muted);
    /* The space the deleted `.cmp-hero-desc` used to carry as its own bottom
       margin. `.section__standfirst` in headings.css sets a TOP margin only,
       because a shared block cannot know what a page will hang beneath it — so
       the gap under it belongs to this layout's slot content. */
    margin: var(--stack-2) 0 0;
  }

  .cmp-article-section {
    padding: var(--sec-pad-y-sm) var(--gutter) var(--sec-pad-y);
  }
  .cmp-body {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .cmp-cta {
    padding: var(--sec-pad-y) var(--gutter);
    text-align: center;
    background: var(--c-panel);
    border-top: 1px solid var(--c-border);
  }
  .cmp-cta-inner {
    max-width: var(--measure-prose);
    margin-inline: auto;
  }
  /* --t-h1 is "the hero, and nothing else" (tokens.css) and 900 is in no
     weight scale. The homepage's own closing CTA renders through Section, so
     it is --t-h2 at --t-w-h2; five copies of this band across compare, sectors
     and glossary were the only places on the site rendering an h2 at 83px. */
  .cmp-cta h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin: 0 0 var(--sec-gap);
  }
  .cmp-cta-sub {
    font-size: var(--t-h4);
    font-weight: 500;
    line-height: 1.4;
    color: var(--c-text-muted);
    margin: 0 0 var(--sec-gap);
  }
  .cmp-cta-sub .accent {
    color: var(--c-text);
  }
</style>

<style is:global>
  /* Targets markup rendered inside the <slot/> above (the compare article
     body, sourced verbatim from the legacy .cmp-body article-body block),
     which Astro scoped styles cannot reach because it is not written
     directly in this component's template. Same pattern as
     `.article-body :global(h2)` in Article.astro, just declared with
     is:global since there are many more selectors here. */
  .cmp-body .cmp-lead {
    font-size: var(--t-h4);
    line-height: 1.6;
    font-weight: 500;
    color: var(--c-text);
    margin: 0 0 var(--sec-gap);
  }
  .cmp-body h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--c-text);
    margin: 3rem 0 1.25rem;
    scroll-margin-top: 6rem;
  }
  /* --t-h3, not --t-h4. An h3 in the article body is a heading INSIDE a section
     (tokens.css), which is what --t-h3 is for; --t-h4 is the card tier and is
     kept for the choose cards and the FAQ rows below. Sizing a body h3 at the
     card tier is the same one-tier slip that styles/prose.css carried. */
  .cmp-body h3 {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: var(--t-w-h3);
    line-height: 1.25;
    color: var(--c-text);
    margin: 2.25rem 0 1rem;
  }
  .cmp-body p {
    font-size: var(--t-lede);
    line-height: 1.75;
    color: var(--c-text-sub);
    margin: 0 0 1.5rem;
  }
  .cmp-body ul,
  .cmp-body ol {
    font-size: var(--t-lede);
    line-height: 1.7;
    color: var(--c-text-sub);
    margin: 0 0 1.5rem;
    padding-inline-start: 1.4rem;
  }
  .cmp-body li {
    margin: 0 0 0.6rem;
  }
  .cmp-body a {
    color: var(--c-interactive);
    font-weight: 700;
  }
  .cmp-body a.cmp-relcard {
    text-decoration: none;
  }
  .cmp-body strong {
    color: var(--c-text);
    font-weight: 800;
  }
  .cmp-body .rt-hint {
    font-size: var(--t-micro);
    color: var(--c-text-muted);
    margin: 0 0 0.5rem;
  }

  .cmp-body .cmp-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 0 0 2.5rem;
    border: 1px solid var(--c-border);
    /* One radius for every bounded block in this column. The table scroller sat
       at 16px beside 20px cards. */
    border-radius: var(--radius-card);
  }
  .cmp-body .cmp-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 620px;
  }
  .cmp-body .cmp-table th,
  .cmp-body .cmp-table td {
    /* Padding and alignment are styles/blocks.css — one cell recipe sitewide. */
    border-bottom: 1px solid var(--c-border);
  }
  /* ── THE COLUMN HEADER IS NOT SIZED HERE ANY MORE. A-61, 2026-08-04 ───────
   *
   * `thead th` used to carry a full label recipe in this file — display face,
   * --t-micro, weight 800, 0.08em, uppercase — which was the fourth declaration
   * of the column-header treatment that styles/labels.css had already
   * consolidated from prose.css, /pricing and /sources. That file names bare
   * `thead th` among the selectors a class cannot reach, precisely so a table
   * this site builds by hand gets the shared values; this block was overriding
   * it, because a component's scoped selector outranks a bare tag pair.
   *
   * SO /compare's COLUMN HEADERS HAVE CHANGED, and that is the intended
   * outcome rather than a side effect: they are now the mono label at 0.1em and
   * weight 500, which is what a column header looks like everywhere else on the
   * site. Two typefaces for one object was the defect labels.css was written to
   * end and it had ended it in three files out of four.
   *
   * font-size AND line-height MOVED OFF THE `th, td` RULE ABOVE for the same
   * reason. A body-sized declaration reaching every cell reaches the header
   * cells too, and would have beaten labels.css just as surely as the block
   * this replaces — the same defect surviving as one property instead of five.
   * Row headers keep them: a `tbody th` is a row LABEL in flowing text, not a
   * column header, and this file already sizes it with the rows it belongs to. */
  .cmp-body .cmp-table td,
  .cmp-body .cmp-table tbody th {
    font-size: var(--t-body);
    line-height: 1.5;
  }
  .cmp-body .cmp-table thead th {
    color: var(--c-text);
  }
  .cmp-body .cmp-table thead th.cmp-us-col {
    color: var(--c-verified);
  }
  .cmp-body .cmp-table tbody th {
    font-weight: 700;
    color: var(--c-text);
    white-space: normal;
  }
  .cmp-body .cmp-table td {
    color: var(--c-text-sub);
  }
  .cmp-body .cmp-table td.cmp-us {
    color: var(--c-text);
    font-weight: 600;
  }
  .cmp-body .cmp-table tbody tr:last-child th,
  .cmp-body .cmp-table tbody tr:last-child td {
    border-bottom: 0;
  }
  .cmp-body .cmp-yes {
    color: var(--c-verified);
    font-weight: 800;
  }
  .cmp-body .cmp-no {
    color: var(--c-text-muted);
  }

  .cmp-body .cmp-choose {
    display: grid;
    gap: 1.25rem;
    margin: 2rem 0 1rem;
  }
  @media (min-width: 768px) {
    .cmp-body .cmp-choose {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* NOTHING OF THE CARD IS STATED HERE ANY MORE. `rehypeContentCards` in
     astro.config.mjs attaches `surface surface--pad` to this class as the
     markdown is compiled, so border, radius, background, gloss, padding, hover
     and the centred content all come from the one recipe in
     styles/surfaces.css. The teal edge below is the only thing that is genuinely
     this card's own, and it wins because an `is:global` block is unlayered. */
  .cmp-body .cmp-choose-card.is-us {
    border-color: var(--c-verified);
  }
  .cmp-body .cmp-choose-card h3 {
    margin: 0 0 0.85rem;
    font-size: var(--t-h4);
  }
  .cmp-body .cmp-choose-card ul {
    margin: 0;
    font-size: var(--t-body);
  }
  .cmp-body .cmp-choose-card li {
    margin: 0 0 0.55rem;
  }

  /* Spacing only; `surface surface--pad` supplies the rest (see above). */
  .cmp-body .cmp-sources {
    margin: var(--sec-gap) 0 0;
  }
  .cmp-body .cmp-sources h2 {
    margin: 0 0 1rem;
    font-size: var(--t-h4);
  }
  .cmp-body .cmp-sources ol {
    margin: 0;
    font-size: var(--t-body);
  }
  .cmp-body .cmp-sources li {
    margin: 0 0 0.7rem;
  }
  .cmp-body .cmp-sources a {
    font-weight: 600;
    word-break: break-word;
  }

  .cmp-body .cmp-shot {
    margin: 2rem 0 2.75rem;
  }
  .cmp-body .cmp-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--c-border);
  }
  .cmp-body .cmp-shot figcaption {
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--c-text-sub);
    margin-top: 0.9rem;
  }

  .cmp-body .cmp-relgrid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-top: 1.5rem;
  }
  @media (min-width: 640px) {
    .cmp-body .cmp-relgrid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  /* Type and display only; `surface surface--pad` supplies the rest (see
     above), including the hover lift, which this link gets because it is an
     <a> carrying `surface`. */
  .cmp-body .cmp-relcard {
    display: block;
    color: var(--c-text);
    font-family: var(--font-display);
    font-weight: var(--t-w-h3);
    font-size: var(--t-body);
  }

  .cmp-body .cfaq {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  /* Border, radius and background come from `surface` in styles/surfaces.css,
     which names .cfaq details. The local --radius-panel override is gone: this
     is a glass card, not an opaque panel, and it was the only 16px block in the
     compare column. */
  .cmp-body .cfaq summary {
    cursor: pointer;
    list-style: none;
    padding: 1.35rem 1.5rem;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .cmp-body .cfaq summary::-webkit-details-marker {
    display: none;
  }
  /* --t-h4, the card tier. A question in an FAQ row is the row's heading; at
     --t-body it was the same size as the answer underneath it, which is the one
     thing a heading may never be. Eight of them on every compare page. */
  .cmp-body .cfaq summary h3 {
    margin: 0;
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
  }
  .cmp-body .cfaq summary::after {
    content: '+';
    font-weight: 800;
    color: var(--c-interactive);
    transition: transform var(--dur) var(--ease);
  }
  .cmp-body .cfaq details[open] summary::after {
    transform: rotate(45deg);
  }
  .cmp-body .cfaq-a {
    padding: 0 1.5rem 1.35rem;
  }
  .cmp-body .cfaq-a p {
    margin: 0;
    font-size: var(--t-body);
  }

  @media (prefers-reduced-motion: reduce) {
    .cmp-body .cfaq summary::after { transition: none; }
  }
</style>
