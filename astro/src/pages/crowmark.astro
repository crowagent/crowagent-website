  .duty__barlbl {
    margin: var(--stack-2) 0 var(--stack-1);
    font-family: var(--font-body);
    font-size: var(--t-micro);
    font-weight: 700;
    color: var(--c-text);
  }

  .duty__bar {
    position: relative;
    height: 10px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c-text) 8%, transparent);
    overflow: hidden;
  }

  /*
   * ── M-P1 · THE 10% FILLS ─────────────────────────────────────────────────
   *
   * TRIGGER   page load, CSS only, no observer. The hero is above the fold at
   *           every viewport, so asking an IntersectionObserver whether it is
   *           visible is a question with a known answer and a failure mode.
   * DURATION  1.5 beats = 900ms, which is the board's figure expressed in the
   *           shared grammar rather than as a number this file invented.
   * EASING    --m-ease-land, the site's expo-out. The board writes
   *           cubic-bezier(.16, 1, .3, 1), which is character-for-character the
   *           value of --ease, so this is the token and not an approximation.
   * REDUCED   the segment renders at its final 10% width with no transition.
   *           That is the base rule below; the animation only exists inside
   *           prefers-reduced-motion: no-preference.
   *
   * THE REST STATE IS THE FINAL STATE. With no CSS animation at all the bar is
   * a correct 10% segment. Nothing is hidden waiting for motion.
   */
  .duty__fill {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 10%;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, var(--c-teal), var(--c-cyan));
    box-shadow: 0 0 10px var(--c-teal-glow), 0 0 26px var(--c-teal-glow);
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .duty__fill {
      animation: cw-fill calc(var(--m-beat) * 1.5) var(--m-ease-land) 1 both;
    }
  }

  /* Scale, not width: a width animation relayouts every frame, a scaleX stays
     on the compositor. The glow rises with it and never falls below the rest
     value, which is binding rule 02 on the motion board — motion may only add
     light. */
  @keyframes cw-fill {
    from {
      transform: scaleX(0);
      box-shadow: 0 0 0 rgba(0, 0, 0, 0), 0 0 0 rgba(0, 0, 0, 0);
    }
    to {
      transform: scaleX(1);
      box-shadow: 0 0 10px var(--c-teal-glow), 0 0 26px var(--c-teal-glow);
    }
  }

  .duty__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px var(--stack-2);
    margin: var(--stack-1) 0 0;
    font-family: var(--font-body);
    font-size: var(--t-micro);
    line-height: 1.5;
  }

  .duty__legend b { color: var(--c-teal); }
  .duty__legend span { color: var(--c-text-muted); }

