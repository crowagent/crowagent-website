---
/**
 * HeroStack — the homepage hero. Direction B, "the receding tender stack".
 *
 * THE IDEA. The hero is the product, not a claim about it. Four commitments
 * recede into depth like pages in a bid; three carry a citation, and the fourth
 * has nothing behind it and is struck out. That is the gate, shown rather than
 * described, and it is the one thing a competitor cannot paste onto their own
 * site because they cannot do it.
 *
 * WHY DEPTH, AND WHY THIS DEPTH. The depth is made of the subject's own
 * material rather than generic 3D: tender pages, receding. It is faked with
 * scale, offset, opacity and a progressive blur, so it costs no 3D engine, no
 * canvas and no library. On a page whose measured problem is payload, that
 * matters more than fidelity.
 *
 * WHAT IT DELIBERATELY IS NOT. A near-black canvas with one bright accent and a
 * big number is the default look AI reaches for on any brief. The palette here
 * is frozen and correct, so the distinctiveness has to come from structure: a
 * citation gutter that aligns on one axis, mono used as the auditor's voice
 * rather than as a label font, and exactly one animated moment.
 *
 * MOTION. One orchestrated sequence, not scattered effects. Every element is
 * VISIBLE BY DEFAULT and motion only refines it, so if the script never runs
 * the hero still reads correctly. See src/scripts/motion.ts.
 */
import Button from '../ui/Button.astro';

interface Claim {
  cite: string;
  text: string;
  traced: boolean;
}

/**
 * AN ILLUSTRATIVE WORKED EXAMPLE, AND LABELLED AS ONE ON THE PAGE.
 *
 * An earlier version of this comment said these were "the Oxford proxy
 * constants the methodology screen prints". That was wrong twice over. The
 * Oxford Social Value Bank is a framework this site had to strip from 54 places
 * because it does not exist; the site cites the National TOMs 2023-24 proxy
 * values, and nothing else. And the numbers below are not national constants at
 * all, so citing any framework for them would be a second invention on top of
 * the first.
 *
 * What these values ARE: an internally consistent example of the check the
 * product performs. £108,000 is 4 x £27,000 because the example bid recorded
 * £27,000, not because £27,000 is a published rate. That is precisely the
 * product's claim, which is that your figures are checked against YOUR recorded
 * commitments, so the example is stronger stated honestly than dressed up as an
 * authority it does not have.
 *
 * The tender reference was removed for the same reason. "ITT CF-2026-0417"
 * reads as a real live procurement and is not one, and this site has already
 * taken a credibility hit from placeholder data that looked real.
 *
 * RULE FOR ANYONE EDITING THIS: a number on this page is either cited to a
 * named source or visibly marked as an example. There is no third option.
 */
const CLAIMS: Claim[] = [
  { cite: 'T1M1 · recorded 12 Mar', text: '4 new jobs for local residents', traced: true },
  { cite: 'T1M2 · 4 × £27,000 recorded', text: '£108,000 of measurable social value', traced: true },
  { cite: 'T1M3 · s.52 KPI', text: 'Quarterly reporting to the authority', traced: true },
  { cite: 'no recorded commitment', text: 'Local supply chain spend', traced: false },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__wash" aria-hidden="true"></div>

  <div class="hero__inner">
    {/* The provenance line, and the place the worked-example label belongs. */}
    <p class="hero__eyebrow">Worked example · award question 4.2 · social value weighting 10%</p>

    {/* Two spans rather than a bare <br />. A <br /> gives the visual line break
        but leaves the accessible name as "Four claims.Three survive." with no
        separator, so a screen reader runs the two sentences together. Block
        spans break the line visually AND leave a word boundary in the text. */}
    <h1 class="hero__title" id="hero-title"><span>Four claims.</span> <span>Three survive.</span></h1>

    <p class="hero__lede">
      Every figure is checked against a commitment you recorded. The one that is not
      does not ship. That is the whole product.
    </p>

    <div class="hero__actions">
      <Button href="/contact?enquiry=limited-access#contact-form">Request access</Button>
      <Button href="/crowmark" variant="secondary">How the drafter works</Button>
    </div>
  </div>

  {/*
    The stack. `--i` drives depth so the recession is arithmetic rather than
    four hand-tuned rules: one formula, four cards, and adding a fifth needs no
    new CSS. Marked aria-hidden because the same claims are read out in the
    visually-hidden list below, where a screen reader gets them as text rather
    than as a depth illusion.
  */}
  <ol class="stack" aria-hidden="true">
    {CLAIMS.map((c, i) => (
      <li
        class:list={['stack__card', { 'stack__card--dropped': !c.traced }]}
        style={`--i:${i}; --n:${CLAIMS.length}`}
        data-motion="reveal"
      >
        <span class="stack__cite">{c.cite}</span>
        <span class="stack__text">{c.text}</span>
      </li>
    ))}
  </ol>

  <p class="visually-hidden">
    Four commitments are assessed. Three are traced to a recorded commitment:
    {CLAIMS.filter((c) => c.traced).map((c) => `${c.text}, cited ${c.cite}`).join('; ')}.
    One is not: {CLAIMS.find((c) => !c.traced)?.text}, which has no recorded
    commitment and is removed from the draft.
  </p>

  <p class="hero__foot">The engine cannot clear its own gate. A named person approves.</p>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--sec-pad-y) 0;
  }

  /* No filter: blur() here.
     It was suspected of freezing the renderer and removed on that basis. The
     suspicion was WRONG: an A/B that forced blur(90px) back on and timed a full
     rasterise measured 287ms against 474ms without it, so the blur was never
     the cost. (The frozen tab was the browser extension's, not the page's.)
     The gradient version is kept because a radial gradient already falls off
     smoothly and blurring one buys nothing, not because it is faster. */
  .hero__wash {
    position: absolute;
    inset: -30% -20% auto -20%;
    height: 90%;
    background:
      radial-gradient(closest-side at 32% 34%, rgb(167 139 250 / 0.30), rgb(167 139 250 / 0.10) 45%, transparent 78%),
      radial-gradient(closest-side at 78% 22%, rgb(34 211 238 / 0.22), rgb(34 211 238 / 0.07) 48%, transparent 80%);
    pointer-events: none;
  }

  /* The shared measure, from tokens. Hardcoding 1160px and clamp(20px,5vw,48px)
     here is how the legacy page ended up with six different max-widths: each
     component knew the number, so no component could be corrected centrally.
     See components/layout/Section.astro, which owns the same two values for
     every other section on the page. */
  .hero__inner,
  .stack,
  .hero__foot {
    position: relative;
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    margin: 0 0 var(--stack-2);
  }

  .hero__title span { display: block; }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--t-h1);
    font-weight: var(--t-w-h1);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin: 0 0 var(--stack-2);
  }

  .hero__lede {
    font-family: var(--font-body);
    font-size: var(--t-lede);
    line-height: 1.65;
    color: var(--c-text-sub);
    max-width: 54ch;
    margin: 0 0 var(--sec-gap);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: var(--sec-gap);
  }

  /* ── The stack ──────────────────────────────────────────────────────────
     TWO DEFECTS THIS REPLACES, both caught by screenshotting the built page.

     1. IT HID ITS OWN ARGUMENT. The first version overlapped all four cards in
        one grid cell and offset them by 46px, which is less than one card is
        tall. The front card therefore covered the other three almost entirely.
        The hero reads "Four claims. Three survive." and the only claim you could
        actually read was the one that did NOT survive. The illusion was working
        and the page was saying the opposite of what it meant.

     2. THE DEPTH CUE FAILED CONTRAST. Depth was carried by opacity down to 0.38
        and blur up to 2.4px, applied to the elements holding the text. Blurred
        4-point-contrast body text is not a style choice, it is a WCAG 1.4.3
        failure, and no visual metaphor is worth making the content unreadable.

     WHAT DEPTH IS MADE OF NOW: width and elevation, never legibility. Cards
     recede by getting NARROWER and flatter toward the back, overlapping just
     enough to read as stacked paper, which is what a pile of tender pages
     actually looks like from slightly above. Every line stays at full contrast
     and full opacity, so the stack can be read top to bottom and the struck-out
     fourth row lands as the conclusion of an argument you were able to follow.  */
  .stack {
    list-style: none;
    /* padding-block only. A blanket `padding: 0` here also cancelled the
       padding-inline set by the shared .hero__inner/.stack/.hero__foot rule,
       which started the cards 48px to the LEFT of the headline they belong to.
       The <ol> default padding-inline-start is already overridden by that
       shared rule, so there is nothing left to zero on the inline axis. */
    padding-block: 0;
    margin-block: var(--sec-gap) 0;
    display: flex;
    flex-direction: column;
  }

  .stack__card {
    /* `--d` is 1 for the furthest card and 0 for the front one. Every depth
       property below is a function of it, so a fifth card needs no new CSS. */
    --d: calc((var(--n) - 1 - var(--i)) / (var(--n) - 1));

    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    /* Extra top padding on the overlapped area so text never sits under the
       lip of the card above it. */
    padding: clamp(20px, 2.4vw, 28px) clamp(20px, 3vw, 34px);

    /* THE RECESSION, AND WHY IT IS ONE-SIDED. Back cards are inset from the
       RIGHT ONLY, never centred. Centring them staggered the left edge too,
       which put the citation gutter at four different x-positions: the single
       axis the whole layout exists to align was the one thing not aligned.
       Insetting from one side leaves every citation and every claim on a shared
       vertical, and the recession reads as pages fanned from a bound edge,
       which is how a tender actually sits on a desk. */
    width: calc(100% - var(--d) * 88px);
    margin-inline: 0 auto;

    border: 1px solid var(--c-border);
    border-radius: var(--radius-card);
    /* Back cards sit flatter and darker, as a page further from the light. */
    background: color-mix(in srgb, var(--c-panel) calc(100% - var(--d) * 45%), var(--c-bg));
    box-shadow: var(--shadow-card);
    z-index: calc(10 - var(--d) * 10);
  }

  /* Stacked paper: a small overlap, not a covering. 14px against a card that is
     at least 60px tall, so no row is ever obscured. */
  .stack__card + .stack__card { margin-top: -14px; }

  /* The front card is the one being decided, so it gets the light. */
  .stack__card:last-child {
    border-color: var(--c-border-glow);
    box-shadow: var(--shadow-panel);
  }

  .stack__cite {
    flex: 0 0 auto;
    width: clamp(140px, 18vw, 230px);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  .stack__text {
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 700;
    color: var(--c-text);
  }

  .stack__card--dropped .stack__cite { color: var(--c-orchid); }
  .stack__card--dropped .stack__text {
    /* Muted, but still AA against the panel. The claim is rejected, not hidden. */
    color: var(--c-text-sub);
    text-decoration: line-through;
    text-decoration-color: var(--c-orchid);
    text-decoration-thickness: 2px;
  }


  .hero__foot {
    margin: var(--sec-gap) auto 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  /* On a phone the inset silhouette costs more than it earns: an 88px inset on
     a 360px screen is a quarter of the card gone. Flatten to full width and let
     the citation stack above its claim. */
  @media (max-width: 719px) {
    .stack__card {
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .stack__card + .stack__card { margin-top: 8px; }
    .stack__cite { width: auto; }
  }

  /* Motion refines an already-correct hero. It never creates one: the stack is
     fully readable with no script and no transition. */
  @media (prefers-reduced-motion: no-preference) {
    .stack__card {
      transition:
        width var(--dur-slow) var(--ease),
        background var(--dur-slow) var(--ease);
      transition-delay: calc((var(--n) - 1 - var(--i)) * 90ms);
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
