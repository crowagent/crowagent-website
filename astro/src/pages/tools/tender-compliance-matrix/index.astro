    <template id="matrix-row">
      <li class="matrix__row">
        <p class="meta matrix__ref">
          <span class="matrix__no"></span><span class="matrix__line"></span>
        </p>
        <div class="matrix__main">
          <p class="matrix__req"></p>
          <p class="matrix__quote"><q></q></p>
        </div>
        <p class="matrix__tags"></p>
      </li>
    </template>

    <p class="basis">
      The rules are published in full below. They read wording, not meaning, so a requirement
      written without obligation language, a number or a reference is invisible to them. This tool
      records what a document says. It does not decide whether anything is compliant, and it is not
      legal or procurement advice.
    </p>

    {/* RE-POINTED 2026-08-04. This recommended the free PPN 002 calculator,
        which the owner removed the same day. The sentence is kept rather than
        deleted because the QUESTION a reader arrives with is real: this tool
        reads what a tender says, and a reader who wants the social value rule
        itself needs somewhere to go. That somewhere is the glossary entry, which
        states the 10% minimum and the dates it binds from, and it is also where
        both removed URLs now 301. */}
    <p class="more">
      Looking for the social value rule itself?
      <a href="/glossary/ppn-026/">Read PPN 026 in full</a>, the next edition of the Social Value Model
      social-value weighting and the dates it applies from.
    </p>
  </Section>

  {/* THE COUNT IS READ FROM THE LIST. It said "Four rules" above eleven of
      them, and had since the section was written, which is the one factual
      correction in this pass. A number typed beside a list it describes is a
      number that goes stale the first time somebody adds a rule. */}
  <Section
    eyebrow="Published in full"
    title="What the rules look for."
    standfirst={`${RULES.length} rules, all deterministic. There is no model, no network call and nothing guessed. Every row the tool produces can be traced back to the characters that triggered it.`}
    id="rules"
  >
    {/* A NUMBERED SPECIFICATION, NOT A DEFINITION LIST. `.deflist` is the
        site's recipe for a term above its prose description, and it stays
        exactly as it is for the five pages that want that. This is a different
        object: eleven numbered rules a reader scans to find one, on the shared
        card recipe so the box, the border and the hover are the site's own.

        <ol>, because the numbers are the point: a rule is cited by its number
        in the tool's own output, and a reader who has been given "rule 7"
        should be able to count to it. */}
    <ol class="rulespec" data-cascade>
      {
        RULES.map((r, i) => (
          <li class="surface surface--pad surface--row rulespec__rule">
            <p class="meta rulespec__n">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="card-h rulespec__h">{r.term}</h3>
            <p class="rulespec__body">
              {/* Odd indices are the quoted runs. See `tokens` in the
                  frontmatter for why that is a property of the split rather
                  than an assumption about the text. */}
              {tokens(r.detail).map((part, j) =>
                j % 2 ? <code class="rulespec__tok">{part}</code> : part,
              )}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section
    eyebrow="Stated plainly"
    title="What this tool does not do."
    standfirst="Written down because a free tool that overstates itself costs more credibility than it earns attention."
    id="limits"
  >
    {/* THE CLAIM IS THE HEADING AND THE REASONING IS THE BODY. Six disc
        bullets running the full column meant a reader had to read all six to
        find out what the tool will not do. Each entry already opens with that
        sentence, so the split costs no rewriting and the six claims can now be
        taken in one pass.

        The mark is the site's refusal ink, which is the same colour the tool
        itself uses for a figure it will not stand behind. It is decorative and
        says so: the list is a list, and a screen reader announces it as one
        without being told about a drawn dash. */}
    <ul class="limits" data-cascade>
      {
        LIMITS.map((l) => {
          const c = claim(l);
          return (
            <li class="surface surface--pad surface--row limits__item">
              <span class="limits__mark" aria-hidden="true"></span>
              <p class="limits__h">{c.head}</p>
              {c.body && <p class="limits__body">{c.body}</p>}
            </li>
          );
        })
      }
    </ul>
  </Section>

  <FinalCta
    eyebrow="Go further"
    title="Need the whole bid read, not one section?"
    standfirst="CrowMark reads a full tender pack, drafts answers from your own submitted bids with the source beside each one, and tracks what you promised after the contract is awarded."
    id="product"
    links={[
      { label: 'All free tools', href: '/tools/' },
      { label: 'PPN 026 explained', href: '/glossary/ppn-026/' },
    ]}
  >
    <Button href="/contact/?enquiry=limited-access#contact-form">Request access</Button>
    <Button href="/crowmark/" variant="secondary">Explore CrowMark</Button>
  </FinalCta>
</Base>

<script>
  import {
    analyse,
    problems,
    pct,
    num,
    buildCsv,
    buildMarkdown,
    exportFilename,
  } from '../../../lib/tender-matrix';
  import type { MatrixRow, TenderMatrix } from '../../../lib/tender-matrix';

  /*
   * Read once, the same way scripts/motion.ts and the calculator read it. A user
   * who changes the setting mid-visit gets the new behaviour on reload; a user
   * who has it set never sees this page move under them.
   */
  const REDUCED =
    typeof window.matchMedia === 'function' &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initMatrix() {
    const byId = (id: string) => document.getElementById(id);

    const form = byId('matrix-form') as HTMLFormElement | null;
    const input = byId('tenderText') as HTMLTextAreaElement | null;
    const panel = byId('matrix-result');
    const list = byId('matrix-rows');
    const err = byId('matrix-err');
    const tpl = byId('matrix-row') as HTMLTemplateElement | null;
    if (!form || !input || !panel || !list || !err || !tpl) return;

    const put = (id: string, text: string) => {
      const node = byId(id);
      if (node) node.textContent = text;
    };

    const show = (id: string, on: boolean) => {
      const node = byId(id);
      if (node) node.hidden = !on;
    };

    /*
     * THE MEASURED SCROLL FIX, carried over from the PPN 002 calculator page
     * before it was deleted. The geometry it recorded: at 1440x900 the button
     * sits above the fold, the result lands below it, and without this the page
     * does not move, so pressing the button looks like pressing a dead control.
     *
     * IT SCROLLS ONLY WHEN IT HAS TO, so running the tool twice with the panel
     * already on screen does not yank the page.
     *
     * THE THRESHOLD IS THE HEADER, NOT THE SCROLL PADDING. <html> carries
     * scroll-padding-top: 96px, but a settled panel MEASURES at 76, because the
     * section's arrival transform is still resolving when the scroll is issued.
     * The sticky header is 73px, so 76 clears it. Testing against 96 would call
     * a visible panel hidden and re-scroll on every submit.
     *
     * TWO FRAMES, NOT ONE. The element is unhidden immediately before this runs
     * and its box is not final until the frame after the one that lays it out.
     */
    const HEADER = 73;
    const reveal = (el: HTMLElement) =>
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          const r = el.getBoundingClientRect();
          if (r.top >= HEADER && r.bottom <= window.innerHeight) return;
          el.scrollIntoView({ behavior: REDUCED ? 'auto' : 'smooth', block: 'start' });
        })
      );

    /* Every sentence hidden, not just the one that was shown. `role="alert"`
       announces a CHANGE, so a sentence left in the tree means the same mistake
       made twice in a row is silent the second time.

       IT ASKS THE REGION WHAT IT HOLDS rather than carrying a list of codes. A
       list here would be a second place to remember, and the failure it allows
       is silent: a code added to lib/tender-matrix.ts and not added here leaves
       its sentence on screen under the next answer. */
    const clearError = () => {
      for (const p of err.querySelectorAll('p')) p.hidden = true;
      input.removeAttribute('aria-invalid');
    };

    /*
     * ── THE FILTER OVER THE RESULT ──────────────────────────────────────────
     *
     * It reads the rendered rows and hides some of them. It never re-analyses,
     * never re-orders and never touches `currentMatrix`, so the CSV and the
     * Markdown carry every row the rules matched whatever is on screen. That is
     * stated to the reader in the empty-state paragraph as well as here, because
     * an export that quietly followed the filter is the one way this feature
     * could change what the tool reports.
     *
     * EACH ROW IS MEASURED ONCE, WHEN IT IS BUILT. The alternative is reading
     * `textContent` off up to 300 <li> elements on every keystroke, which is
     * work the row already knows the answer to. `hay` is the whole rendered row
     * lower-cased, so the word filter reaches the reference, the requirement,
     * the verbatim quote and the chips, which is everything the reader can see.
     */
    interface FilterRow {
      li: HTMLElement;
      hay: string;
      sigs: string[];
    }

    const bar = byId('matrix-filter');
    const query = byId('matrix-q') as HTMLInputElement | null;
    const shownLine = byId('matrix-shown');
    const noneLine = byId('matrix-none');
    const chips = Array.from(document.querySelectorAll<HTMLElement>('.tmxf__chip'));
    let filterRows: FilterRow[] = [];
    let activeSig = 'all';

    const applyFilter = () => {
      const q = query ? query.value.trim().toLowerCase() : '';

      /* Counts are taken against the WORD filter only and never against the
         pressed chip, so each chip states what pressing it would show rather
         than what is showing now. Counted against the pressed chip instead,
         every chip but one would read 0 the moment a filter was on, which is
         true and useless. */
      const counts: Record<string, number> = { all: 0 };
      let visible = 0;
      for (const row of filterRows) {
        const hit = q === '' || row.hay.indexOf(q) !== -1;
        if (hit) {
          counts.all++;
          for (const s of row.sigs) counts[s] = (counts[s] || 0) + 1;
        }
        const on = hit && (activeSig === 'all' || row.sigs.indexOf(activeSig) !== -1);
        row.li.hidden = !on;
        if (on) visible++;
      }

      for (const c of chips) {
        const n = c.querySelector('.tmxf__n');
        if (n) n.textContent = num(counts[c.dataset.sig || 'all'] || 0);
      }
      /* `filterRows.length === 0` is a matrix with no rows at all, which the
         panel already explains in `r-none`. Saying "no rows match that filter"
         over it would blame the reader's filter for a result the rules produced
         before any filter existed. */
      if (noneLine) noneLine.hidden = visible !== 0 || filterRows.length === 0;
      if (shownLine) {
        shownLine.textContent =
          visible === filterRows.length
            ? `${num(visible)} ${visible === 1 ? 'row' : 'rows'}`
            : `${num(visible)} of ${num(filterRows.length)} rows`;
      }
    };

    /* Back to All rows and an empty box. Called by every path that replaces the
       result, because a second document analysed under the first one's filter
       would hide rows the reader never chose to hide. */
    const resetFilter = () => {
      activeSig = 'all';
      if (query) query.value = '';
      for (const c of chips) c.setAttribute('aria-pressed', String((c.dataset.sig || '') === 'all'));
    };

    for (const c of chips) {
      /* `click` covers the keyboard: a <button> fires it on Enter and on Space,
         so there is no key handler here and no second path to keep in step. */
      c.addEventListener('click', () => {
        activeSig = c.dataset.sig || 'all';
        for (const other of chips) {
          other.setAttribute('aria-pressed', String(other === c));
        }
        applyFilter();
      });
    }

    if (query) {
      query.addEventListener('input', applyFilter);
      query.addEventListener('keydown', (e) => {
        /* Safari and Firefox draw no clear glyph inside a search field, so
           Escape is the one way out that every browser has. */
        if (e.key === 'Escape') {
          query.value = '';
          applyFilter();
        }
      });
    }

    /* THE LAST MATRIX ANALYSED, WHICH IS WHAT THE TWO EXPORT BUTTONS EXPORT.
       Declared beside the thing that clears it rather than beside the buttons
       that read it, because forgetting to clear it is the failure that matters:
       an export button that hands over the PREVIOUS document's requirements is
       worse than one that does nothing. Null until the first successful parse,
       which is why both buttons check it. */
    let currentMatrix: TenderMatrix | null = null;

    const clearResult = () => {
      panel.hidden = true;
      list.hidden = true;
      list.replaceChildren();
      currentMatrix = null;
      /* The bar goes with the rows it filters. Left up over an empty list it is
         a control with nothing under it, which is the fault this page's own
         "what it does not do" section is written against. */
      if (bar) bar.hidden = true;
      if (noneLine) noneLine.hidden = true;
      filterRows = [];
      resetFilter();
      /* THE CLIPBOARD FALLBACK IS A SIBLING OF THE PANEL, NOT A CHILD OF IT, so
         hiding the panel leaves it on screen holding the whole of the previous
         matrix. That is the exact failure the note on the reset handler below
         describes: a reset that leaves the answer up under an empty box reads as
         the tool having ignored the reset. */
      byId('copy-fallback')?.remove();
    };

    /** `obligation` reads as "Obligation". Derived rather than tabulated: a map
        of the five signal names would be script saying what the union members
        already say. */
    const label = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

    const rowOf = (r: MatrixRow) => {
      const li = (tpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      const at = (sel: string) => li.querySelector(sel) as HTMLElement;

      /* The reference column carries the document's own reference when the line
         has one, and the line number either way, so a reader can find the row in
         their own paste. Both are facts read from the input. */
      at('.matrix__no').textContent = r.requirement_ref ?? '';
      at('.matrix__line').textContent = `Line ${num(r.source_line)}`;
      at('.matrix__req').textContent = r.requirement_text;
      /* THE EVIDENCE, AND IT IS THE POINT OF THE ROW. `<q>` rather than a styled
         paragraph: the quotation marks come from the user agent, so the fact
         that this is quoted material is carried by the markup rather than by a
         colour. A <blockquote> would be more emphatic and would pull in the
         panelled card recipe in styles/blocks.css, which is right for one
         citation in an article and unreadable stacked three hundred deep. */
      at('q').textContent = r.source_quote ?? '';

      /*
       * Chips: what was seen in the line, and nothing about what it means.
       *
       * NO MARK TOKEN IS USED ON ANY OF THEM, and that is a decision rather than
       * an omission. --c-verified, --c-refused and --c-at-risk mean verified,
       * refused and at risk; a signal is none of those, and painting one teal
       * would assert that something had been checked. Every chip inherits its
       * colour, which is what styles/labels.css asks a call site to do when it
       * has no meaning to add.
       *
       * There is no category chip. See the note above `CATEGORY` in
       * lib/tender-matrix.ts: a keyword classifier is the one part of this tool
       * that would state a conclusion the text does not contain.
       */
      const tags = at('.matrix__tags');
      const chip = (text: string) => {
        const span = document.createElement('span');
        span.className = 'chip';
        span.textContent = text;
        tags.append(span);
      };

      /* WHO THE LINE IS ABOUT, FIRST, because it changes how the rest of the
         row is read: an obligation on the Buyer is a dependency rather than a
         task. Prefixed rather than bare, so "Buyer" cannot be mistaken for the
         name of a rule that fired. Absent when the line does not open with a
         party, which is not a claim that the requirement is yours. */
      if (r.subject) chip(`Subject: ${r.subject}`);

      for (const signal of r.signals) {
        /* Both of these are redundant with the value chips below them: the
           limit signal with "500 words", the deadline signal with the date
           itself. A chip reading "Deadline" beside a chip reading "14 March
           2026" says the same thing twice and crowds the row. */
        if (signal === 'limit' || signal === 'deadline') continue;
        chip(
          signal === 'weighting' && r.weight !== null
            ? `Weighting ${pct(r.weight)}`
            : label(signal)
        );
      }
      for (const limit of r.limits) chip(`${num(limit.value)} ${limit.unit}`);
      for (const when of r.deadlines) chip(when.text);

      return li;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      clearError();

      /*
       * The offending field is NAMED, marked and focused. `.field__input
       * [aria-invalid='true']` has been in styles/forms.css since the contact
       * form shipped. Colour is the second signal; the message is the first.
       */
      const bad = problems(input.value);
      if (bad.length > 0) {
        clearResult();
        input.setAttribute('aria-invalid', 'true');
        show(`e-${bad[0].code}`, true);
        /* WCAG 3.3.1: put the user at the thing they have to change. */
        input.focus();
        return;
      }

      const m = analyse(input.value);
      /* Unreachable while `analyse()` refuses exactly what `problems()` reports,
         which it does by calling it. Stated rather than assumed, because the one
         thing this page must never do is render a matrix built from nothing. */
      if (!m) {
        clearResult();
        show('e-unread', true);
        return;
      }

      put('r-total', num(m.summary.total));
      put('r-lines', num(m.lines));
      put('r-obligations', num(m.obligationCount));
      put('r-directives', num(m.directiveCount));
      put('r-references', num(m.referenceCount));
      put('r-tables', num(m.tableCount));
      put('r-mandatory', num(m.mandatoryCount));
      put('r-deadlines', num(m.deadlineCount));
      put('r-limits', num(m.limitCount));
      put('r-wcount', num(m.weightingCount));
      put('r-wtotal', pct(m.weightingTotal));
      put('r-dupes', num(m.duplicates));
      show('r-found', m.summary.total > 0);
      show('r-none', m.summary.total === 0);
      show('r-wcomplete', m.weightingConfidence === 'complete');
      show('r-wnote', m.weightingConfidence === 'sub_criteria');
      show('r-wnocontext', m.weightingConfidence === 'no_context_found');
      show('r-dupe', m.duplicates > 0);
      show('r-trunc', m.truncated);
      show('r-actions', m.rows.length > 0);

      currentMatrix = m;
      /* A SECOND ANALYSIS MUST NOT LEAVE THE FIRST ONE'S EXPORT BELOW IT. The
         clipboard fallback is a sibling of the panel, so nothing that repaints
         the panel touches it, and analysing a second document would put the new
         matrix directly above a textarea holding the old one's requirements. */
      byId('copy-fallback')?.remove();

      const frag = document.createDocumentFragment();
      /* Built and measured in the same pass. `textContent` is read off the row
         while it is still in the fragment, which is before it is laid out, so
         none of this costs a reflow. */
      filterRows = [];
      const present = new Set<string>();
      for (const r of m.rows) {
        const li = rowOf(r);
        /* The filter's contract, written where it can be inspected rather than
           held only in the array below. /glossary states the same thing on its
           cards as `data-cat`. It is `data-sig` and a space-separated LIST here
           because a row genuinely carries several signals at once, so equality
           against a single category would be the wrong shape. */
        li.dataset.sig = r.signals.join(' ');
        filterRows.push({
          li,
          hay: (li.textContent || '').toLowerCase(),
          sigs: r.signals,
        });
        for (const s of r.signals) present.add(s);
        frag.append(li);
      }
      list.replaceChildren(frag);
      list.hidden = m.rows.length === 0;

      /* Chip visibility is decided from the WHOLE matrix, once per analysis, so
         typing in the word filter cannot make the row of chips reflow under the
         pointer. What moves with the typing is the numbers on them. */
      for (const c of chips) {
        const sig = c.dataset.sig || '';
        c.hidden = sig !== 'all' && !present.has(sig);
      }
      resetFilter();
      if (bar) bar.hidden = m.rows.length === 0;
      applyFilter();

      panel.hidden = false;
      reveal(panel);
    });

    /*
     * THE SAMPLE PILLS. Each fills the box and submits, rather than filling the
     * box and leaving the reader to find the button: the whole point is to show
     * someone with no tender pack to hand what the tool returns, and a second
     * required click is where that intent gets lost.
     *
     * `requestSubmit` and NOT `submit`, which is the difference between the two
     * that matters here. `form.submit()` bypasses submit event handlers
     * entirely, so the page would reload and show nothing. `requestSubmit()`
     * fires the handler above exactly as pressing the button does, which means
     * a pill takes the same validation, the same error region and the same
     * scroll as a paste. There is no second code path for a sample to drift on.
     *
     * THE BUTTON NAMES ITS TEMPLATE RATHER THAN CARRYING ITS TEXT. `load-x` and
     * `sample-x` are the two halves of one key, so adding a fourth sample is a
     * <template> and a <Button> and no script change at all. The key is read
     * from the id rather than from a `data-` attribute for the reason recorded
     * beside the buttons: Button.astro forwards `id` and does not forward
     * `data-sample`.
     */
    for (const pill of form.querySelectorAll<HTMLElement>('[id^="load-"]')) {
      const tpl = byId(`sample-${pill.id.slice(5)}`) as HTMLTemplateElement | null;
      /* A pill pointing at a template that is not there would otherwise wipe the
         textarea and submit an empty form, which reports a validation error the
         reader did nothing to cause. */
      if (!tpl) continue;
      pill.addEventListener('click', () => {
        /* `.content.textContent`, NOT `.innerHTML`. The template holds plain
           text, so the parsed fragment already carries it decoded. Reading the
           markup instead would mean hand-unescaping &amp;, &lt; and &gt;, which
           is three entities today and a bug the first time a sample gains a
           fourth. It also keeps the whole tool free of any innerHTML read. */
        input.value = (tpl.content.textContent || '').trim();
        form.requestSubmit();
      });
    }

    const btnCsv = byId('btn-csv');
    const btnCopy = byId('btn-copy');

    /*
     * WHAT THE PAGE STILL OWNS, AND IT IS ONLY THE BROWSER PARTS. `buildCsv` and
     * `buildMarkdown` decide what a row means once it leaves the page, so they
     * live in lib/tender-matrix.ts where a fixture can drive them; the Blob, the
     * object URL and the clipboard call are browser plumbing and cannot. That
     * split is also what took this island back under the JavaScript budget: the
     * two exceptions opened for it on 2026-08-06 are deleted rather than raised.
     */
    if (btnCsv) {
      btnCsv.addEventListener('click', () => {
        if (!currentMatrix || !currentMatrix.rows.length) return;
        const blob = new Blob([buildCsv(currentMatrix)], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = exportFilename(new Date());
        document.body.append(a);
        a.click();
        a.remove();
        /* REVOKED ON THE NEXT TICK, NOT ON THIS ONE. WebKit reads the object URL
           after the click handler returns, so revoking synchronously cancels the
           download on Safari while working everywhere else, which is the kind of
           fault that only ever shows up on somebody else's machine. */
        setTimeout(() => URL.revokeObjectURL(url), 0);
      });
    }

    if (btnCopy) {
      btnCopy.addEventListener('click', async () => {
        if (!currentMatrix || !currentMatrix.rows.length) return;
        const markdown = buildMarkdown(currentMatrix);
        const said = btnCopy.textContent;
        try {
          await navigator.clipboard.writeText(markdown);
          btnCopy.textContent = 'Copied';
          setTimeout(() => {
            btnCopy.textContent = said;
          }, 2000);
        } catch {
          /* THE CLIPBOARD IS NOT AVAILABLE ON EVERY ORIGIN, and a button that
             does nothing is worse than no button. navigator.clipboard is absent
             over plain HTTP and can be refused by permission policy, so the
             table goes into a read only textarea the visitor can select and
             copy by hand. An empty catch here would swallow the one failure
             this feature actually has. */
          const existing = byId('copy-fallback');
          if (existing) existing.remove();
          const fb = document.createElement('textarea');
          fb.id = 'copy-fallback';
          fb.className = 'field__input field__input--area';
          fb.rows = 6;
          fb.readOnly = true;
          fb.value = markdown;
          fb.setAttribute('aria-label', 'Markdown table: select all and copy');
          panel.after(fb);
          fb.focus();
          fb.select();
        }
      });
    }

    form.addEventListener('reset', () => {
      /* The browser clears the field; this clears everything the browser does
         not know about. A reset that leaves the matrix on screen under an empty
         box reads as the tool having ignored the reset. */
      clearResult();
      clearError();
    });
  }

  initMatrix();
</script>

<style>
  /* ── THE FORM BLOCK IS CENTRED, LIKE EVERYTHING ABOVE AND BELOW IT ────────
   *
   * Same rule the calculator applies to `.calc`, and the same reason: a capped
   * column in a full-measure container hugs the left edge and reads as a second
   * layout stacked on the first. The FIELDS stay left-aligned, because a form is
   * read and filled in down a left edge. What moves is the block.
   *
   * THE CAP IS A TOKEN, NOT A NUMBER. `.calc` uses `max-width: 560px` and needed
   * an entry in check-design-system.js to say so. --measure-prose is a fraction
   * of --measure, so this column stays in proportion if the measure ever moves,
   * and no allow-list entry is spent. */
  .matrix-form {
    max-width: var(--measure-prose);
    margin-inline: auto;
  }

  /* Taller than the shared 140px floor, because the thing being pasted is a
     section of a document rather than a message. `.field__input--area` in
     styles/forms.css owns everything else about the control: the border, the
     radius, the fill, the focus ring and the resize handle. */
  .matrix-form__area {
    min-height: 15rem;
  }

  /* The alert region holds its sentences as paragraphs rather than as one text
     node, so the user agent's paragraph margin has to go. `.field__err` in
     styles/forms.css owns the face, size, weight and colour, all of which these
     inherit; this states nothing about how an error looks. */
  .field__err p {
    margin: 0;
  }

  /* ── THE SUMMARY PANEL ────────────────────────────────────────────────────
   *
   * `surface surface--pad` and nothing else. The card, its border, its radius,
   * its padding, its specular highlight and its shadow all come from
   * styles/surfaces.css, and the ledger inside it from styles/blocks.css, which
   * calls that shape what it is: a two-column form for a run of short scalar
   * values. What is declared here is where the block sits and how its own
   * paragraphs are spaced. */
  .result {
    margin-top: var(--sec-gap);
  }

  .result__kicker {
    margin: 0 0 var(--stack-1);
    color: var(--c-ambient-start);
  }

  .result__lead {
    margin: 0 0 var(--stack-2);
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text);
  }

  .result__note {
    margin: var(--stack-1) 0 0;
    font-family: var(--font-body);
    font-size: var(--t-micro);
    line-height: 1.7;
    color: var(--c-text-muted);
  }

  /* Export actions row sits below the ledger notes with the same stack gap.
     The pair of buttons share equal width via .btn-row's 1fr grid tracks. */
  .result__actions {
    margin-top: var(--stack-2);
  }

  /* The sentence under the button row explaining what the sample is. Same
     treatment as .field__help, which is the other explanatory line in this
     form, so the two do not read as different kinds of note. */
  .matrix-form__sample {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-micro);
    color: var(--c-text-muted);
  }

  /* ── THE FILTER CHIPS ─────────────────────────────────────────────────────
   *
   * Nothing about how a chip looks is written here: `.chip` in styles/labels.css
   * owns the box, the hairline, the radius and the tracking, and `.control` in
   * styles/controls.css owns the wash, the hairline, the ink under a pointer and
   * the focus ring. The sample buttons above take `.btn-row` and Button.astro
   * and so need no rule at all. */
  .tmxf__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--stack-1);
  }

  /* THE ONE LOCAL THING IS THE TARGET, and it is behaviour rather than look, so
     it is stated once on every control that has to be hit rather than per block.
     `.chip` grows a control to 36px, which clears the WCAG 2.2 SC 2.5.8 floor of
     24 but not the 44 this site's own rule asks for, and /glossary's filter chips
     already take 44 on the argument that a control you have to aim at is not a
     date. The search field is on the same line because `.field__input` is sized
     for a form field on its own row rather than for a control in a bar. */
  .tmx-hit {
    min-height: 44px;
  }

  /* ── THE FILTER BAR ───────────────────────────────────────────────────────
   *
   * STICKY FROM 48rem UP AND STATIC BELOW IT, which is the one decision in this
   * block that is not obvious. A filter that scrolls away is no use over two
   * hundred rows, and that is the whole argument for docking it. Against it:
   * Nav.astro is `position: sticky; top: 0` and 73px tall at every width, so a
   * second docked bar is a second band of furniture the reader cannot get rid
   * of. scripts/check-sticky-budget.js measured that stack on /pricing at 189px
   * on a 390x844 phone, 22.4 percent of the window against its 18 percent
   * budget, and its second rule is that at most ONE bar may dock below 767px.
   * That gate covers /pricing and not this route, so those figures are not a
   * measurement of THIS bar. They are the reason not to find out the hard way:
   * this bar wraps to three rows on a phone, where /pricing's wrapped to two.
   *
   * `top` IS THE NAV HEIGHT, NOT 0. A second sticky at 0 parks in the same band
   * and the nav paints over it. pricing.astro records the same 73px and the same
   * reason, and notes there is no token for it because it was the first
   * component outside the nav that needed to know. It is the second. */
  .tmxf {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--stack-1) var(--stack-2);
    margin-top: var(--sec-gap);
    padding: var(--stack-1) 0;
    border-block: 1px solid var(--c-border);
    /* Opaque, because rows scroll under a docked bar. pricing.astro's own note
       records a translucent bar bleeding page text through it (P1-002). */
    background-color: var(--c-bg);
  }

  @media (min-width: 48rem) {
    .tmxf {
      position: sticky;
      top: 73px;
      /* Above the rows and below the nav, which is 100. */
      z-index: 20;
    }
  }

  /* The selected state, and it is the same one /glossary's chips take: the
     interactive token as a fill with the page ground as ink. Written here
     because Astro scopes a page's styles to that page, so there is no selector
     either file could share. `.control` still owns the hover and the focus
     ring, which is why neither appears in this block. */
  /* Tabular figures so a chip does not change width as its count goes 9 to 10.
     It sits on the chip rather than on the number, see the note on .tmxf__n. */
  .tmxf__chip {
    font-variant-numeric: tabular-nums;
  }

  .tmxf__chip[aria-pressed='true'] {
    background-color: var(--c-interactive);
    border-color: var(--c-interactive);
    color: var(--c-bg);
  }

  /* The count rides inside the chip and must stay readable against BOTH of the
     chip's two grounds, so it steps back with opacity rather than with a muted
     ink token: --c-text-muted on the filled state would be a mid grey on the
     interactive fill. Tabular figures so the chip does not change width as its
     number goes from 9 to 10. */
  /* [2026-09-08] THE COUNT CARRIES NO TYPOGRAPHY OF ITS OWN, and that is a
     check-treatments requirement rather than a preference. The chip is already
     `control chip tmx-hit tmxf__chip`, so it takes the shared `.chip` micro
     label recipe from styles/labels.css. When this span stated its own
     `font-variant-numeric` and `opacity` it rendered a FIFTH fingerprint on a
     site whose rule is four, and check-treatments failed with `span.tmxf__n`
     named. The tabular figures moved up to the chip, where they change nothing
     for the label text because it has no digits, and the count now inherits the
     chip exactly. Only the gap is left here, which is spacing and not a
     treatment. */
  .tmxf__n {
    margin-inline-start: 0.4em;
  }

  /* Takes the slack on a wide screen and drops to its own full row on a narrow
     one, which is what the 14rem basis buys: below roughly 30rem of bar there is
     no room for chips and a field side by side. */
  .tmxf__find {
    flex: 1 1 14rem;
  }

  /* Everything about the search field is `.field__input` from styles/forms.css
     and its target height is `.tmx-hit` above, so nothing is written for it
     here. The empty-state paragraph takes `.basis`, which is this page's own
     closing-note recipe and already sets the measure, the face and the muted
     ink it wants. Both are recorded because an absence is otherwise read as an
     omission. */
  .tmxf__count {
    margin: 0;
    color: var(--c-text-muted);
  }

  /* ── THE MATRIX ───────────────────────────────────────────────────────────
   *
   * A RULED REGISTER, NOT THREE HUNDRED CARDS. The obvious build is one
   * `.surface` per row, and it is wrong at this length: styles/surfaces.css says
   * so itself about "a dense stack where two hundred shadows would read as mud".
   * A hairline between rows is what every other register on this site uses and
   * it costs one border declaration.
   *
   * IT IS AN <ol> OF <li>, WHICH IS ALSO WHY ITS ALIGNMENT IS FREE.
   * styles/alignment.css sets `main :is(ul, ol) > li { text-align: left }` for
   * the document, because a list is read down a left edge. No opt-out is spent
   * here, and scripts/check-render.js excuses an LI inside a list by the same
   * rule. `role="list"` is on the element because `list-style: none` removes
   * list semantics in Safari.
   *
   * THE ROW RULES ARE :global BECAUSE THE ROWS ARE CLONED FROM A <template>.
   * Astro scopes a component's selectors by adding a class to the elements it
   * compiles, and whether that reaches inside a <template> is an implementation
   * detail this page should not depend on. Written as `:global` under the
   * scoped `.matrix` ancestor, the rules match a cloned row either way, which
   * is the same pattern the calculator uses for its script-built result card. */
  .matrix {
    list-style: none;
    margin: var(--sec-gap) 0 0;
    padding: 0;
    display: grid;
  }

  .matrix :global(.matrix__row) {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 13rem;
    gap: var(--stack-1) clamp(16px, 2.5vw, 32px);
    padding: var(--stack-2) 0;
    border-bottom: 1px solid var(--c-border);
    align-items: start;
  }

  .matrix :global(.matrix__row:first-child) {
    border-top: 1px solid var(--c-border);
  }

  /* `.meta` from styles/labels.css carries the face, size, case and tracking.
     Colour is deliberately not part of that recipe, so the call site states it,
     and this one takes the near end of the ambient ramp for the same reason the
     calculator's reference column does: it is provenance, not a verdict. */
  .matrix :global(.matrix__ref) {
    color: var(--c-ambient-start);
  }

  /* Both parts of the reference cell sit on their own line. The spans inherit
     every part of the `.meta` recipe from their parent, so they are the same
     micro-label rather than a fifth one; what is stated here is only that they
     stack and which ink the second one takes. */
  .matrix :global(.matrix__no),
  .matrix :global(.matrix__line) {
    display: block;
  }

  .matrix :global(.matrix__line) {
    margin-top: 4px;
    color: var(--c-text-muted);
  }

  .matrix :global(.matrix__req) {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text);
  }

  /* The verbatim source, one step back in the ink ladder so the requirement
     reads first and the evidence second, which is the order a reader wants them
     in. The quotation marks come from `<q>` and the user agent, so the fact that
     this is quoted material survives with every pixel of colour removed. */
  .matrix :global(.matrix__quote) {
    margin: var(--stack-1) 0 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text-sub);
  }

  .matrix :global(.matrix__tags) {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.4rem;
  }

  /* ── THE TWO CLOSING PARAGRAPHS ───────────────────────────────────────────
     Same treatment the calculator gives its basis line and its onward link. The
     link takes no rule of its own: styles/links.css owns the underline for every
     link inside a paragraph on this site, and a second offset here would be one
     of the seven recipes that file was written to end. */
  .basis,
  .more {
    margin: var(--sec-gap) auto 0;
    max-width: var(--measure-prose);
    font-family: var(--font-body);
    font-size: var(--t-micro);
    line-height: 1.7;
    color: var(--c-text-muted);
  }

  .more {
    font-size: var(--t-body);
  }

  /* ── THE LIMITS LIST ──────────────────────────────────────────────────────
     A plain list of statements. It states its own indent because the user
     agent's 40px is set for a nested outline rather than for a register, and
     nothing else, so it is one page's content layout rather than a treatment
     anything else could want. */
  .notes {
    margin: 0;
    padding-inline-start: 1.2rem;
    display: grid;
    gap: var(--stack-2);
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text-sub);
  }

  @media (max-width: 767px) {
    .matrix :global(.matrix__row) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── THE RULE SPECIFICATION ─────────────────────────────────────────────
   *
   * Eleven rules a reader scans to find one, so: a two-column grid of cards on
   * a wide screen, one column below it, each card numbered.
   *
   * THE BOX IS `.surface` AND NOTHING HERE RESTATES IT. No background, no
   * border, no radius, no shadow and no hover: styles/surfaces.css owns all
   * six, and its instructions say a component that restates them is how the
   * count got to twenty-one. What is local is the grid, the number, and the
   * measure on the body.
   *
   * THE HEADING IS `.card-h`, the recipe in styles/blocks.css that five other
   * pages take. A rule's name is a card heading like any other. */
  .rulespec {
    display: grid;
    gap: var(--stack-2);
    margin: var(--stack-3) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 62rem) {
    .rulespec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--stack-2) var(--space-6);
    }
  }

  /* LEFT COMES FROM `surface--row`, NOT FROM A LOCAL DECLARATION.
     surfaces.css names that modifier as "the one opt-out from the centring
     rule" for a card whose content is columns read down a left edge, and
     scripts/check-render.js measures for it by name: written locally, the same
     result is reported as eleven blocks with content off the centre line. The
     reason still holds either way. The section head is centred and these cards
     inherited it, which set eleven paragraphs of dense reference prose on a
     ragged left edge, and a reader tracking a return sweep needs the next line
     to start where the last one did. */
  .rulespec__rule {
    display: grid;
    /* `start`, for the reason recorded in home2/HowItRuns2.astro: two cards in
       one grid row are stretched to the taller, and a grid with auto rows
       spreads that slack EQUALLY ACROSS ITS ROWS by default, which pushes the
       heading of the shorter card away from its number. */
    align-content: start;
    row-gap: 2px;
  }

  .rulespec__n {
    margin: 0;
    letter-spacing: 0.1em;
    color: var(--c-text-muted);
  }

  .rulespec__h {
    /* The shared heading owns the face, the size and the weight. What is local
       is the space under it, which is tighter here than on a plan card because
       the number above already separates this from the card edge. */
    margin-block-end: var(--stack-1);
  }

  .rulespec__body {
    margin: 0;
    /* A MEASURE, WHICH IS THE HALF OF THIS THAT ACTUALLY MADE IT READABLE.
       These paragraphs set at about 140 characters a line in the previous
       full-column layout, against the 65 to 75 a reader can track without
       losing the return sweep. */
    max-width: 68ch;
    font-family: var(--font-body);
    font-size: var(--t-caption);
    line-height: 1.75;
    color: var(--c-text-sub);
  }

  /* QUOTED DOCUMENT TEXT, SET AS WHAT IT IS. Every double-quoted run in these
     rules is a literal from a tender pack, and forty of them inside one
     paragraph of prose quotation marks is what made the section unreadable.
     Mono, on a faint ground, with no quotation marks left to draw: the marks
     were doing the job this treatment does, and keeping both would say it
     twice. `word-break` because some of these are long clause patterns that
     must not push the card wider than its column. */
  .rulespec__tok {
    font-family: var(--font-mono);
    font-size: var(--t-code);
    padding: 0.1em 0.36em;
    border-radius: var(--radius-chip);
    background-color: color-mix(in srgb, var(--c-text) 7%, transparent);
    color: var(--c-text);
    overflow-wrap: anywhere;
  }

  /* ── WHAT IT DOES NOT DO ────────────────────────────────────────────────
   *
   * The same card, carrying a claim and its reasoning. Two columns on a wide
   * screen because six of these read as a set to be taken in rather than a
   * sequence to be followed. */
  .limits {
    display: grid;
    gap: var(--stack-2);
    margin: var(--stack-3) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 62rem) {
