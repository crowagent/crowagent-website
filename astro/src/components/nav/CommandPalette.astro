---
/**
 * CommandPalette — the ⌘K / Ctrl+K search the nav button has always promised.
 *
 * WHY IT EXISTS. `[data-cmdk-open]` shipped in Nav.astro with no handler
 * anywhere in the rebuild: the search button was a dead control. On the live
 * site nav-inject.js wires it to a palette in sovereign-features.js, which was
 * never ported. The choice was to remove the button or honour it, and on a site
 * with 40-odd routes a palette is the single highest-leverage navigation
 * affordance there is.
 *
 * ACCESSIBILITY IS THE HARD PART OF THIS PATTERN, so it follows the APG
 * combobox-with-listbox pattern rather than being approximated:
 *   - the input is role="combobox", owning the list via aria-controls
 *   - the ACTIVE option is tracked with aria-activedescendant, so focus never
 *     leaves the input and typing continues to work while arrowing the list
 *   - options are role="option" with aria-selected, inside role="listbox"
 *   - the dialog is aria-modal with a focus trap and returns focus on close
 *   - result count is announced through a polite live region, because a sighted
 *     user sees the list shrink as they type and a screen reader user must be
 *     told
 *
 * NO DEPENDENCY. The obvious move is a headless combobox library; on a site
 * whose entire measured problem was payload, ~200 lines is cheaper than any of
 * them and there is nothing here that needs abstracting.
 *
 * The index is built from the real routes at build time. See lib/search-index.ts.
 * It is FETCHED rather than written into this markup — see the note on the
 * loader in the script below, and src/pages/search-index.json.ts.
 */
---

<div class="cmdk" id="cmdk" hidden>
  {/* The scrim is a sibling, not a parent, so a click on it cannot land inside
      the dialog and be misread as an interaction with it. */}
  <div class="cmdk__scrim" data-cmdk-scrim></div>

  <div
    class="cmdk__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cmdk-label"
  >
    <h2 class="visually-hidden" id="cmdk-label">Search CrowAgent</h2>

    <div class="cmdk__field">
      <svg class="cmdk__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
      </svg>
      <input
        class="cmdk__input"
        id="cmdk-input"
        type="text"
        role="combobox"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="Search pages, guides and tools"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
        aria-labelledby="cmdk-label"
      />
      <kbd class="cmdk__esc">Esc</kbd>
    </div>

      {/* A div, not a <ul>. The options ARE the anchors (see the render function),
        and an <a> is not valid content for a <ul> outside an <li>. */}
    <div class="cmdk__list" id="cmdk-list" role="listbox" aria-labelledby="cmdk-label"></div>

    {/* Three states share this line: the index arriving, the index having
        failed to arrive, and a query that matched nothing. They are three
        different facts and the script says which one it is, because an index
        that never loaded is not "no matches". */}
    <p class="cmdk__empty" hidden>No matches. Try a product name, a sector, or "PPN".</p>

    <p class="visually-hidden" role="status" aria-live="polite" data-cmdk-status></p>
  </div>
</div>

<script>
  interface Entry {
    title: string;
    href: string;
    section: string;
    hint?: string;
  }

  function initCommandPalette() {
    const root = document.getElementById('cmdk');
    const panel = root?.querySelector<HTMLElement>('.cmdk__panel');
    const input = document.getElementById('cmdk-input') as HTMLInputElement | null;
    const list = document.getElementById('cmdk-list');
    const empty = root?.querySelector<HTMLElement>('.cmdk__empty');
    const status = root?.querySelector<HTMLElement>('[data-cmdk-status]');
    if (!root || !panel || !input || !list || !empty || !status) return;

    let entries: Entry[] = [];
    let results: Entry[] = [];
    let active = 0;
    let lastFocused: HTMLElement | null = null;

    /**
     * THE INDEX IS FETCHED, ONCE, THE FIRST TIME THE PALETTE OPENS.
     *
     * It used to be a <script type="application/json"> beside this one, which
     * meant an identical 7.1 KB in all 44 documents — 313 KB of build, paid in
     * critical HTML by every reader on every page whether or not they ever
     * pressed ⌘K, and one of the two things holding /crowmark over the 100 KB
     * per-route budget in scripts/check-budgets.js. See search-index.json.ts.
     *
     * `wanted` is a promise rather than a boolean so that opening, closing and
     * reopening during the request cannot start a second one.
     */
    const NO_MATCH = empty.textContent ?? '';
    const LOADING = 'Loading the search index…';
    const UNAVAILABLE = 'Search is unavailable: the index did not load. Try reloading the page.';
    let state: 'idle' | 'loading' | 'ready' | 'failed' = 'idle';
    let wanted: Promise<void> | null = null;

    function loadIndex(): Promise<void> {
      if (wanted) return wanted;
      state = 'loading';
      wanted = fetch('/search-index.json', { headers: { accept: 'application/json' } })
        .then((res) => {
          if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
          return res.json();
        })
        .then((data: Entry[]) => {
          entries = data;
          state = 'ready';
        })
        .catch((error: unknown) => {
          // Not swallowed and not silent: the reader is told in the panel and
          // through the live region, and the reason is left in the console for
          // whoever is looking at why. The rest of the nav is unaffected.
          state = 'failed';
          console.error(
            'command palette: /search-index.json did not load',
            error instanceof Error ? error.message : String(error)
          );
        })
        .then(render);
      return wanted;
    }

    /**
     * Subsequence match, not substring: "ppn" finds "PPN 002 Calculator" and
     * "crowbuy" finds "CrowMark for Buyers". Scored so that a title match beats
     * a match that only landed in the section or the description, and an
     * earlier match beats a later one.
     */
    function score(entry: Entry, q: string): number {
      const title = entry.title.toLowerCase();
      const hay = `${title} ${entry.section} ${entry.hint ?? ''}`.toLowerCase();
      if (title.startsWith(q)) return 1000;
      const inTitle = title.indexOf(q);
      if (inTitle > -1) return 800 - inTitle;
      const inHay = hay.indexOf(q);
      if (inHay > -1) return 500 - Math.min(inHay, 400);
      // Subsequence fallback: every character of the query, in order.
      let i = 0;
      for (const ch of hay) if (ch === q[i]) i++;
      return i === q.length ? 100 : -1;
    }

    function render() {
      if (state !== 'ready') {
        results = [];
        list!.innerHTML = '';
        input!.removeAttribute('aria-activedescendant');
        empty!.textContent = state === 'failed' ? UNAVAILABLE : LOADING;
        empty!.hidden = false;
        status!.textContent = empty!.textContent;
        return;
      }
      empty!.textContent = NO_MATCH;

      const q = input!.value.trim().toLowerCase();
      results = q
        ? entries
            .map((e) => ({ e, s: score(e, q) }))
            .filter((r) => r.s > -1)
            .sort((a, b) => b.s - a.s)
            .slice(0, 12)
            .map((r) => r.e)
        : entries.slice(0, 8);

      active = 0;
      /*
       * The ANCHOR carries role="option". The first version nested an <a>
       * inside <li role="option">, which is two interactive elements inside one
       * another: axe reported nested-interactive on all 8 rows, and a screen
       * reader gets a link inside an option with no way to tell which it is on.
       *
       * Putting the role on the anchor keeps exactly one interactive element
       * per row while preserving the href, so middle-click, "open in new tab"
       * and "copy link address" all still work. Dropping to plain <span> rows
       * would have been the easy fix and would have quietly removed all three.
       *
       * tabindex="-1" because focus stays in the input; the active row is
       * communicated by aria-activedescendant, not by focus.
       */
      list!.innerHTML = results
        .map(
          (e, i) =>
            `<a role="option" id="cmdk-opt-${i}" aria-selected="${i === 0}" data-i="${i}" ` +
            `href="${escapeHtml(e.href)}" tabindex="-1">` +
            `<span class="cmdk__t">${escapeHtml(e.title)}</span>` +
            `<span class="meta cmdk__s">${escapeHtml(e.section)}</span></a>`
        )
        .join('');

      empty!.hidden = results.length > 0;
      syncActive();
      status!.textContent = q
        ? `${results.length} result${results.length === 1 ? '' : 's'} for ${q}`
        : `${results.length} suggestions`;
    }

    function escapeHtml(s: string) {
      return s.replace(
        /[&<>"']/g,
        (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string
      );
    }

    /**
     * aria-activedescendant rather than moving focus. Moving DOM focus into the
     * list would stop the user typing, which is the entire point of a palette.
     */
    function syncActive() {
      const items = list!.querySelectorAll<HTMLElement>('[role="option"]');
      items.forEach((li, i) => {
        const on = i === active;
        li.setAttribute('aria-selected', on ? 'true' : 'false');
        if (on) {
          input!.setAttribute('aria-activedescendant', li.id);
          li.scrollIntoView({ block: 'nearest' });
        }
      });
      if (!items.length) input!.removeAttribute('aria-activedescendant');
    }

    function open() {
      if (!root!.hidden) return;
      lastFocused = document.activeElement as HTMLElement;
      root!.hidden = false;
      document.body.style.overflow = 'hidden';
      input!.value = '';
      loadIndex();
      render();
      // preventScroll so opening the palette never jumps the page behind it.
      input!.focus({ preventScroll: true });
    }

    function close() {
      if (root!.hidden) return;
      root!.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus({ preventScroll: true });
    }

    function go(i: number) {
      const entry = results[i];
      if (entry) window.location.href = entry.href;
    }

    input.addEventListener('input', render);

    input.addEventListener('keydown', (e) => {
      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          if (results.length) active = (active + 1) % results.length;
          syncActive();
          break;
        case 'ArrowUp':
          e.preventDefault();
          if (results.length) active = (active - 1 + results.length) % results.length;
          syncActive();
          break;
        case 'Home':
          e.preventDefault();
          active = 0;
          syncActive();
          break;
        case 'End':
          e.preventDefault();
          active = Math.max(0, results.length - 1);
          syncActive();
          break;
        case 'Enter':
          e.preventDefault();
          go(active);
          break;
        case 'Escape':
          e.preventDefault();
          close();
          break;
      }
    });

    // Pointer selection. Delegated so it survives every re-render.
    list.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      if (!li) return;
      e.preventDefault();
      go(Number(li.dataset.i));
    });
    list.addEventListener('mousemove', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      if (!li) return;
      const i = Number(li.dataset.i);
      if (i !== active) {
        active = i;
        syncActive();
      }
    });

    root.querySelector('[data-cmdk-scrim]')?.addEventListener('click', close);

    /*
     * The focus trap. Only the input is focusable inside the dialog — options
     * are driven by aria-activedescendant — so the trap reduces to keeping Tab
     * on the input. Simpler than a general trap, and it cannot be escaped into
     * the page behind, which would be WCAG 2.4.3 and 2.1.2 trouble.
     */
    panel.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Tab') {
        e.preventDefault();
        input!.focus();
      }
    });

    document.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if ((ke.metaKey || ke.ctrlKey) && ke.key.toLowerCase() === 'k') {
        ke.preventDefault();
        root!.hidden ? open() : close();
      }
    });

    // Delegated so it also catches the mobile menu's search entry point.
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-cmdk-open]');
      if (!btn) return;
      e.preventDefault();
      open();
    });
  }

  initCommandPalette();
</script>

<style>
  .cmdk {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    /* Sits high rather than centred: the results grow downward, and a centred
       panel that grows in both directions makes the first result move while
       the reader is aiming at it. */
    align-content: start;
    justify-items: center;
    padding-top: clamp(60px, 12vh, 140px);
    padding-inline: var(--gutter);
  }

  .cmdk[hidden] { display: none; }

  .cmdk__scrim {
    position: fixed;
    inset: 0;
    /* `rgb(2 4 10 / 0.72)`, which was --c-floor (#03040A) written out by hand
       and one unit off it. The same idiom Nav.astro's sticky bar uses for the
       same job, and the same correction: the scrim is the page's own ground at
       72%, so it is written against the token that names the ground and moves
       when the ground moves. */
    background: color-mix(in srgb, var(--c-floor) 72%, transparent);
    backdrop-filter: blur(4px);
  }

  .cmdk__panel {
    position: relative;
    width: min(620px, 100%);
    background: var(--c-panel);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
  }

  /* ── FROSTED, 2026-08-03 ────────────────────────────────────────────────
   *
   * Owner instruction: increase glass only where it enhances depth. This is
   * the strongest case on the site — the palette floats over the whole
   * document, and it is the one surface a reader summons ON TOP of something
   * they were already reading. Frosting it keeps the page they came from
   * legible as context underneath rather than replacing it with a slab.
   *
   * BOTH PROPERTIES, ALWAYS, because a filter over an opaque fill is the
   * non-change documented at length on `.ca-mega` in Nav.astro. --c-panel is
   * opaque; the translucency is what makes the filter mean anything.
   *
   * IT COMPOSES WITH THE SCRIM RATHER THAN DUPLICATING IT. `.cmdk__scrim`
   * already carries blur(4px) over the page, which dims and softens
   * EVERYTHING behind the dialog. This blurs what is behind the PANEL
   * specifically, at the much stronger --blur-glass, so the two read as two
   * depths — a dimmed page, and a lit sheet standing off it — instead of one
   * flat overlay. That is the depth the instruction asks for.
   *
   * 88%, HIGHER THAN THE NAV OR THE MEGA MENU, and the reason is what sits on
   * it: a text input the reader is typing into and a list they are arrowing
   * through. Legibility outranks the effect wherever the two disagree, and
   * this is the surface where they come closest to disagreeing.
   *
   * @supports KEEPS THE OPAQUE PANEL where there is no backdrop-filter, so the
   * failure mode is the dialog exactly as it shipped, never a see-through one.
   */
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .cmdk__panel {
      background: color-mix(in srgb, var(--c-panel) 88%, transparent);
      -webkit-backdrop-filter: var(--blur-glass);
      backdrop-filter: var(--blur-glass);
    }
  }

  /*
   * TWO SURFACES DELIBERATELY LEFT SOLID, recorded here because "why is this
   * one not glass" is the question this pass will otherwise be asked twice.
   *
   * `.ca-mob-menu` in Nav.astro is a FULL-VIEWPORT overlay on --c-bg. There is
   * nothing beside it to see, so a backdrop filter has nothing to refract and
   * translucency would only put page text under a menu on the smallest screens
   * and the weakest GPUs on the site. Glass there is cost with no effect.
   *
   * `.pcar__frame` in ui/Carousel.astro is a device bezel wrapped around an
   * opaque screenshot. The legacy showcase frame carried backdrop-blur-3xl and
   * it was decoration: the viewport fills the frame, so there is no part of
   * that element with anything behind it. A blur that cannot be seen is the
   * exact defect the 2026-08-03 glass round was about, and repeating it here
   * would be doing so knowingly.
   */

  .cmdk__field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--c-border);
  }

  .cmdk__icon {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--c-text-muted);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .cmdk__input {
    flex: 1;
    min-width: 0;
    /* 56px, comfortably over the 44px target floor. */
    height: 56px;
    border: 0;
    background: transparent;
    color: var(--c-text);
    font-family: var(--font-body);
    font-size: var(--t-lede);
  }

  .cmdk__input::placeholder { color: var(--c-text-muted); }
  /* The panel itself carries the visible boundary; a second ring inside it
     reads as an error state. Focus is never ambiguous here because the input
     is the only focusable thing in the dialog. */
  .cmdk__input:focus { outline: none; }

  .cmdk__esc {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    line-height: var(--lh-tight);
    font-size: var(--t-micro);
    color: var(--c-text-muted);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-chip);
    padding: 3px 7px;
  }

  .cmdk__list {
    list-style: none;
    margin: 0;
    padding: 6px;
    max-height: min(52vh, 440px);
    overflow-y: auto;
  }

  .cmdk__list :global([role='option']) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* 44px minimum target, WCAG 2.2 2.5.8. */
    min-height: 44px;
    padding: 0 0.75rem;
    border-radius: var(--radius-chip);
    text-decoration: none;
    color: var(--c-text-sub);
  }

  .cmdk__list :global([aria-selected='true']) {
    background: var(--c-card-hover);
    color: var(--c-text);
  }

  .cmdk__list :global(.cmdk__t) {
    font-family: var(--font-body);
    font-size: var(--t-body);
  }

  /* THE RECIPE IS GONE FROM HERE, 2026-08-04, A-48. The span this styles has
     carried `class="meta"` since it was written — see the row template above —
     and this block restated the recipe on top of it at a HIGHER specificity,
     because an Astro scoped selector carries an attribute the shared class does
     not. So the element asked for the shared meta line and was quietly given a
     private one at 0.08em instead of 0.1em.
     THE RENDERED RULE COULD NOT HAVE FOUND THIS. The palette is `display: none`
     until somebody presses Cmd-K, and rule 2 of check-treatments.js skips
     anything not displayed — correctly, since it measures what a reader sees.
     A hidden fork is still a fork the moment the dialog opens, and reading the
     source is the only way to see it. That is what rule 8 is for.
     What stays is the flex behaviour and the colour, neither of which is the
     recipe. */
  .cmdk__list :global(.cmdk__s) {
    flex: 0 0 auto;
    color: var(--c-text-muted);
  }

  .cmdk__empty {
    margin: 0;
    padding: 1rem 1.25rem 1.25rem;
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--c-text-muted);
  }

</style>
