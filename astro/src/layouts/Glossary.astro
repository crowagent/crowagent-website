---
/**
 * Glossary.astro — layout for /glossary/ppn-002 and /glossary/toms-framework.
 *
 * The main definition (TL;DR box, lead paragraphs, the facts list, "How
 * CrowAgent uses this term") is the <slot/>, sourced verbatim as HTML from
 * the term's Markdown file. The two sidebar cards and the "Read more" link
 * are structured props instead, because their shape (kicker + title + body
 * + CTA) repeats identically across both pages and typing it catches a
 * missing field at build time rather than a silent blank card.
 */
import Base from './Base.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { SITE } from '../data/site';
import Button from '../components/ui/Button.astro';

interface Props {
  title: string;
  description: string;
  ogTitle: string;
  ogDescription: string;
  ogImage: string;
  ogImageAlt: string;
  path: string;
  termName: string;
  termTagline: string;
  heroDescription: string;
  definedTermDescription: string;
  sidebarKicker: string;
  sidebarTitle: string;
  sidebarBody: string;
  sidebarHref: string;
  sidebarCta: string;
  productCardBody: string;
  readMoreHref: string;
  readMoreLabel: string;
  readMoreBody: string;
  ctaHeading: string;
  ctaSub: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  ogImageAlt,
  path,
  termName,
  termTagline,
  heroDescription,
  definedTermDescription,
  sidebarKicker,
  sidebarTitle,
  sidebarBody,
  sidebarHref,
  sidebarCta,
  productCardBody,
  readMoreHref,
  readMoreLabel,
  readMoreBody,
  ctaHeading,
  ctaSub,
} = Astro.props;

const canonical = new URL(path, SITE.origin).href;

const schema: Record<string, unknown>[] = [
  {
    '@type': 'DefinedTerm',
    name: termName,
    description: definedTermDescription,
    url: canonical,
    inDefinedTermSet: {
      '@type': 'DefinedTermSet',
      name: 'CrowAgent UK Public Procurement and Bid Glossary',
      url: `${SITE.origin}/glossary`,
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Glossary', item: `${SITE.origin}/glossary` },
      { '@type': 'ListItem', position: 3, name: termName, item: canonical },
    ],
  },
];
---

<Base
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  twitterTitle={ogTitle}
  twitterDescription={ogDescription}
  path={path}
  image={ogImage}
  imageAlt={ogImageAlt}
  type="article"
  schema={schema}
>
  {/* A DIV, NOT A SECOND <main> — A-66, same as Compare.astro and Sector.astro.
      Nested inside the landmark Base.astro owns, it made three axe rules fire and
      left "the" main region undefined. Kept as an element rather than deleted
      because styles/motion.css unwraps one wrapper via `main > *:only-child > *`. */}
  <div>
    <header class="gl-hero">
      <div class="gl-wrap">
        {/*
          THE "BACK TO GLOSSARY" LINK STAYS OUTSIDE THE HEAD BLOCK, and it is
          not the eyebrow prop. It is a LINK, and the note on .gl-hero below
          explains at length why it must not be given the gradient capsule
          treatment: clipping a gradient to it means a transparent text fill on
          an interactive element that already carries no underline. Passing it
          as `eyebrow` would do exactly that, so it stays a sibling.

          THE SHARED HEAD BLOCK. Was `.gl-h1` plus a `.gl-hero-desc` lede.

          THE TAGLINE IS THE EYEBROW, NOT PART OF THE TITLE, and that is a
          correction to the first pass of this conversion. `.gl-h1` held both,
          split by a `<span class="accent">` carrying `display: block` — so the
          LINE BREAK between the term and its tagline came from a display
          property on a span that existed to paint the tagline teal. Dropping
          the span for the sitewide one-treatment rule therefore also dropped
          the break, and concatenating the two into one title produced
          "PPN 002 Procurement Policy Note 002." and "TOMs Framework Themes,
          Outcomes, Measures." — run-on headings, and the accessible name of the
          h1 with them.

          Read the two records and the tagline is plainly not part of the name:
          it is the EXPANSION of the abbreviation the title states. PPN 002 is
          the term; "Procurement Policy Note 002." is what those letters stand
          for. That is a kicker qualifying a title, which is exactly what an
          eyebrow is, so the break now comes from two separate elements in the
          document rather than from a `display` value on a span inside one.

          THE h1 TEXT DOES CHANGE HERE, on these two routes only, and
          deliberately: it becomes the term alone. The expansion is still on the
          page, still above the title, and `termName` was already what the
          DefinedTerm JSON-LD published, so the structured data is unmoved.
        */}
        <a href="/glossary" class="meta gl-back">Back to glossary</a>
        <PageHeader title={termName} eyebrow={termTagline} standfirst={heroDescription} />
      </div>
    </header>

    <section class="gl-content">
      <div class="gl-wrap gl-grid">
        <article class="gl-article">
          <slot />
          <h2>Read more</h2>
          <p><a href={readMoreHref}>{readMoreLabel} &rarr;</a> {readMoreBody}</p>
        </article>

        <aside class="gl-rail" aria-label="Related links">
          <div class="gl-card surface">
            <p class="eyebrow gl-card-kicker">{sidebarKicker}</p>
            <h3>{sidebarTitle}</h3>
            <p>{sidebarBody}</p>
            <Button href={sidebarHref} size="sm" class="gl-card-cta">{sidebarCta}</Button>
          </div>
          <div class="gl-card surface">
            <p class="eyebrow gl-card-kicker">Full product</p>
            <h3>CrowMark</h3>
            <p>{productCardBody}</p>
            <Button href="/crowmark" variant="secondary" size="sm" class="gl-card-cta">
              See how CrowMark works
            </Button>
          </div>
        </aside>
      </div>
    </section>

    <section class="gl-cta">
      <div class="gl-wrap">
        <h2>{ctaHeading}</h2>
        <p class="gl-cta-sub">{ctaSub}</p>
        <div class="btn-row">
          <Button href="/contact?enquiry=limited-access#contact-form" target="_blank">
            Request access
          </Button>
          <Button href="/crowmark" variant="secondary" size="md">See how CrowMark works</Button>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .gl-wrap {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  /*
   * CENTRED HEAD BLOCK — owner decision, 2026-08-02. The head block itself is
   * components/layout/PageHeader.astro now; this rule centres the "Back to
   * glossary" link that sits above it, which is all this layout still draws of
   * its own hero.
   *
   * .gl-back IS NOT THE EYEBROW, and that is deliberate. It is a "Back to
   * glossary" LINK, not a label. Clipping a gradient to it means a transparent
   * text fill on an interactive element that already carries no underline,
   * which would leave it with no remaining affordance and puts an anchor inside
   * the exact mechanism that caused this site's invisible-text P0. It stays a
   * teal link, outside the head block.
   *
   * THERE IS A GRADIENT CAPSULE ON THIS PAGE NOW, and it is the right element
   * for one: the term's tagline, the expansion of the abbreviation in the
   * title, passed to PageHeader as `eyebrow`. A label, not a control — so the
   * objection above does not reach it. This note used to read "no gradient
   * capsule on this page"; that was true only while the page had no label to
   * put in one.
   *
   * The centring stops at .gl-hero: .gl-content holds the definition prose,
   * the TL;DR box, the facts list and the sidebar cards, all of which stay
   * left-aligned.
   */
  .gl-hero {
    position: relative;
    padding: var(--sec-pad-y-hero) 0 var(--sec-pad-y-sm);
    text-align: center;
    overflow: hidden;
  }
  .gl-hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 60%;
    z-index: -1;
    background: var(--grad-hero-glow);
    filter: blur(30px);
    opacity: 0.5;
  }
  .gl-back {
    /* WCAG 2.2 SC 2.5.8. Standalone navigation, not a link inside a sentence,
       so the inline exemption does not reach it. inline-flex so the box grows
       without moving the text or changing where the row wraps. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    display: block;
    margin-bottom: var(--stack-2);
    /* The label recipe is `.meta` in styles/labels.css. The display face here
       was one of the four labels on the site set in Plus Jakarta Sans. */
    color: var(--c-interactive);
    text-decoration: none;
  }
  /*
   * `.gl-h1`, `.gl-h1 .accent` AND `.gl-hero-desc` MOVED TO styles/headings.css.
   *
   * They were a hand-copy of Section's head block, which is the reason both
   * glossary term pages rendered a flat white title: the treatment lived in
   * Section's SCOPED styles, so copying the markup copied everything except the
   * look. PageHeader now emits the same `.section__head > h1.section__title`
   * Section does, and neither component owns the styling.
   *
   * The 62ch measure this file had already reconciled to Section's standfirst
   * is now simply Section's standfirst, so the two cannot drift apart again.
   */

  .gl-content {
    padding: 0 0 var(--sec-pad-y);
  }
  .gl-grid {
    display: grid;
    gap: var(--sec-gap);
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) {
    .gl-grid {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
  }

  /* --t-h2. These are the definition's own sections ("Key facts", "How
     CrowAgent uses this term", "Read more") and the page's closing CTA renders
     an h2 at --t-h2 a few hundred pixels below them. Two h2 sizes on one page
     was the visible half of the sitewide heading drift. */
  .gl-article :global(h2) {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--c-text);
    margin: var(--sec-gap) 0 var(--stack-2);
  }
  .gl-article :global(p) {
    font-size: var(--t-lede);
    line-height: 1.7;
    color: var(--c-text-sub);
    margin: 0 0 1.25rem;
  }
  .gl-article :global(ul) {
    margin: 0 0 1.25rem;
    padding-inline-start: 1.4rem;
  }
  .gl-article :global(li) {
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--c-text-sub);
    margin: 0 0 0.6rem;
  }
  .gl-article :global(a) {
    color: var(--c-interactive);
    font-weight: 700;
  }
  .gl-article :global(strong) {
    color: var(--c-text);
    font-weight: 800;
  }
  /* THE FILL AND THE EDGE COME FROM styles/surfaces.css, WHICH ALREADY GIVES
     THIS BLOCK A CARD.
     They were `rgba(45, 212, 191, 0.08)` and `rgba(45, 212, 191, 0.2)` — raw
     teal, written twice, and the only two colour literals left in a layout on
     this site. check-palette-roles.js could not see them: it read hue-named
     TOKENS, and a hex or an rgb() is the same decision written one step closer
     to the pixel. check-design-system.js rule 4 could not see them either — it
     matches `#hex` and these were rgb(). Two gates about colour, one blind spot
     between them, which is the shape every finding in this pass had. Rule 3 of
     the palette gate now reads literals, and it fails on this line if it comes
     back.
     THE FIX IS NOT A TOKEN, IT IS DELETING THE FORK. surfaces.css already sets
     `border: 1px solid var(--c-border)` and `background: var(--c-card)` on
     .gl-tldr alongside .prose-card, .gl-fact and the rest, and this rule was
     overriding both from an unlayered scoped block. What the tint claimed is
     also wrong now: teal on this site is --c-verified, evidence, and a summary
     of a definition is not evidence of anything. Under V6 the owner moved even
     the lit edge off teal for the same reason. So the block keeps its padding,
     its radius and its margin, which are its own, and takes its surface from
     the one place a surface is decided. */
  .gl-article :global(.gl-tldr) {
    padding: var(--blk-pad);
    border-radius: var(--radius-card);
    margin: 0 0 2.5rem;
  }
  /* THE TL;DR BOX IS A CARD, SO ITS HEADING IS A CARD HEADING: --t-h4, the
     tier tokens.css defines as "a heading inside a card".
     It was --t-micro, a 13px h2 — the smallest heading on the site and half
     the size of the body text under it. That is a label wearing a heading tag,
     and the treatment said so: uppercase, letter-spaced, muted.
     The <h2> tag itself is correct and stays. "TL;DR" is a top-level section of
     the definition, alongside "Key facts" and "Read more", so demoting it to h3
     would skip a level; and its structural depth is not what decides its size.
     See the report note about retagging it in src/content/glossary/*.md — that
     is not needed, and would be wrong. */
  .gl-article :global(.gl-tldr h2) {
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--c-text);
    margin: 0 0 var(--stack-2);
  }
  .gl-article :global(.gl-tldr ul) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .gl-article :global(.gl-tldr li) {
    display: flex;
    gap: 0.75rem;
    font-size: var(--t-body);
    font-weight: 600;
    color: var(--c-text);
    margin: 0;
  }
  .gl-article :global(.gl-tldr li::before) {
    content: '\2192';
    color: var(--c-verified);
    font-weight: 800;
  }
  .gl-article :global(.gl-lead) {
    font-size: var(--t-h4);
    font-weight: 700;
    color: var(--c-text);
    line-height: 1.5;
  }
  /* Card treatment from `surface`, which names .gl-fact because this markup is
     authored in src/content/glossary and cannot carry the class. */
  .gl-article :global(.gl-fact) {
    padding: var(--blk-pad);
    margin: 0 0 var(--sec-gap);
  }
  .gl-article :global(.gl-fact ul) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .gl-article :global(.gl-fact li) {
    margin: 0;
  }

  .gl-rail {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 6rem;
  }
  .gl-card { padding: var(--blk-pad); }
  /* The kicker takes the shared label SIZE AND LEADING, not the card body's.
     `.gl-card p` above is a scoped rule at (0,2,0) and `.eyebrow` in
     styles/labels.css is a single class at (0,1,0), so the card wins both — and
     it won silently. Without the font-size the aside rendered its label at 17px
     against 13px everywhere else; without the line-height it rendered at 1.6
     against --lh-tight, measured on 2026-08-04 as 20.8px of leading in a capsule
     that is 16.25px everywhere else on 43 routes, which makes the pill 4.5px
     taller. That is one recipe becoming two, twice, from the same cause.

     Both lines restate the shared value rather than adding one, and they are
     here rather than in labels.css because raising the specificity of a shared
     recipe to beat a page is how a design system starts an arms race with its
     own consumers. */
  .gl-card .eyebrow {
    font-size: var(--t-micro);
    line-height: var(--lh-tight);
  }
  /* The label recipe is `.eyebrow` in styles/labels.css. */
  .gl-card-kicker {
    color: var(--c-text-muted);
    margin: 0 0 0.75rem;
  }
  .gl-card h3 {
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
    color: var(--c-text);
    margin: 0 0 0.75rem;
  }
  .gl-card p {
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--c-text-sub);
    margin: 0 0 1.25rem;
  }

  /* WIDTH ONLY. These two sit alone in a narrow sidebar card, where a
     shrink-wrapped control looks stranded. Everything else about them comes
     from Button.astro.

     They used to be `.gl-btn`, a SECOND button system: the display font rather
     than the body one, no shadow, no gradient, and a hover that faded to 0.85
     opacity while every other button on the site lifts and glows. Button's own
     header lists Glossary among the layouts that hand-typed
     `background: var(--c-teal)`, so this layout was meant to be converted in
     that pass and three controls survived it. One of them stood directly beside
     a real Button in the closing CTA. */
  .gl-card-cta {
    width: 100%;
  }

  .gl-cta {
    padding: var(--sec-pad-y) 0;
    text-align: center;
    background: var(--c-panel);
    border-top: 1px solid var(--c-border);
  }
  /* --t-h1 is reserved for the hero (tokens.css); the homepage's own closing
     CTA renders through Section at --t-h2 / --t-w-h2. Matched to it. */
  .gl-cta h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin: 0 0 var(--stack-2);
  }
  .gl-cta-sub {
    max-width: 62ch;
    margin: 0 auto var(--sec-gap);
    color: var(--c-text-muted);
    font-size: var(--t-lede);
    line-height: 1.6;
  }
</style>
