---
/**
 * Article.astro — the blog post layout.
 *
 * A1 "Dark hero to light reading pane", Figma `183:3` on page
 * `Page — Blog article` (`183:2`), chosen by the owner from the six article
 * renders on 2026-08-02. See specs/DESIGN-DECISIONS.md section 6.
 *
 * THE HARD CUT IS THE WHOLE IDEA. A dark band carries the breadcrumb, the
 * headline and the byline; at a fixed point it stops dead and a light reading
 * pane begins, with a 1px teal hairline on the seam so the change reads as an
 * edit rather than as a rendering fault. It is not a gradient and must never
 * become one: a soft transition is what a mistake looks like.
 *
 * WHY A LIGHT PANE AT ALL, quoting the frame: long-form prose on a near-black
 * ground is the one place the dark theme costs the reader real comprehension,
 * and a light pane is the honest fix. The cost is that the page stops matching
 * the rest of the site below the fold, which is the trade the owner judged
 * from the render.
 *
 * THE BAND REVERSES AT THE FOOT. The related-articles rail below the pane is
 * dark, so the light pane is bracketed by the site rather than terminating it.
 * That reversal is what stops the pane reading as a different website; it is
 * load-bearing, not decoration.
 *
 * THE HERO STRADDLES THE CUT. 1000 x 562, a true 16:9, with 200px of it in the
 * dark band and 362px in the light pane. Bridging the cut is what ties the two
 * grounds together, and a hero that sits entirely inside either one loses the
 * effect. The straddle is expressed as a proportion of the hero's own width
 * (20%), so it holds at every viewport instead of only at 1440.
 *
 * ONE H1, the article headline. Heading hierarchy is h1 here, h2/h3 inside the
 * rendered Markdown body, and h2/h3 in the related rail, so no post emits two
 * h1s or skips a level.
 */
import Base from './Base.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import ShareRow from '../components/blog/ShareRow.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import PostImage from '../components/blog/PostImage.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { blogPosting, breadcrumbs, faqPage } from '../lib/schema';
import type { FaqEntry } from '../lib/schema';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: string;
  readingTime?: number;
  /*
   * Question/answer pairs from the post's frontmatter. Optional because only
   * 5 of the 8 posts carry them; faqPage() returns an empty array for the
   * rest rather than an FAQPage with zero questions, which is a structured
   * data error rather than a neutral omission.
   */
  faq?: FaqEntry[];
}

const {
  title,
  description,
  path,
  image,
  publishedAt,
  updatedAt,
  category,
  readingTime,
  faq,
} = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

/*
 * Structured data is DERIVED here, not passed in by each route.
 *
 * This layout is the thing that knows a page is an article, so it is the thing
 * that should say so in JSON-LD. Every /blog entry gets BlogPosting and a
 * breadcrumb trail with no per-post work and nothing for an author to remember.
 *
 * A parity run against the legacy site caught all 8 ported posts emitting only
 * an Organization node where legacy emitted BlogPosting. That is live SEO
 * surface which would have been destroyed silently at cutover. Fixing it in the
 * layout rather than in 8 files is the difference between closing the gap and
 * closing it in a way that cannot reopen.
 */
/*
 * THE ANCESTORS, DECLARED ONCE AND USED TWICE.
 *
 * This array feeds both the BreadcrumbList below and the <Breadcrumb> a reader
 * sees. Before 2026-08-04 there were two lists: this one said "Home > Blog >
 * <title>" and the markup below said "Blog / <category>", so eight routes showed
 * a reader a trail that started one level in from the one they published. Nobody
 * changed anything; there was simply no reason for two hand-maintained lists to
 * agree. scripts/check-breadcrumbs.js now fails the build if they ever do not.
 */
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
];

const schema = [
  blogPosting({ title, description, path, publishDate: publishedAt, updatedDate: updatedAt, image }),
  breadcrumbs([
    ...trail,
    { name: title, path },
  ]),
  /*
   * FAQPage. Five legacy posts published one and the port dropped all five,
   * which a structured-data parity run caught (OA-24). The helper and the
   * frontmatter field both already existed; nothing ever connected them, so
   * the site kept passing every check while losing five rich results.
   */
  ...faqPage(faq),
];

/*
 * The share row and the related-articles rail are OWNED BY THIS LAYOUT, not by
 * the eight markdown files. Both existed on every legacy post and both were
 * lost by the port (OA-28); putting them here is what stops the next post from
 * shipping without them, and it is the same reasoning as the JSON-LD above.
 *
 * `path` is the route ("/blog/some-post"), so the slug is its last segment and
 * the canonical URL is the origin plus the path. Neither is passed in
 * separately: two sources for one identity is how a share link ends up
 * pointing at the wrong post.
 */
const slug = path.replace(/^\/blog\//, '').replace(/\/$/, '');
const canonicalUrl = `${SITE.origin}${path}`;
---

<Base
  title={`${title} | CrowAgent`}
  description={description}
  path={path}
  image={image}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  schema={schema}
>
  <article class="art">
    {/* ── The dark band ────────────────────────────────────────────────── */}
    <div class="art__band">
      <div class="art__glow" aria-hidden="true"></div>
      {/*
        THE TWO CONSTRUCTION RAILS WERE REMOVED ON 2026-08-04, on the owner's
        instruction about /blog/: "can we remove vertical lines". `.art__rails`
        drew a vertical hairline down each edge of the measure, the same
        decoration `.bl__rails` drew on the blog index. Those two were the only
        places on the site it existed and both are under /blog/, so taking it
        out of one and leaving it in the other would have put the same lines
        back one click later. Nothing was positioned against them: the element
        was `position: absolute` with `pointer-events: none` and no layout role.
      */}

      <div class="art__band-inner">
        <div class="art__nav">
          {/*
            BACK TO BLOG PILL. On every legacy post and missing from the
            rebuild. The chevron is a drawn vector rather than a character:
            JetBrains Mono has no arrow glyphs, and an arrow character renders
            in it as a stray plus sign.
          */}
          <a class="control chip art__pill" href="/blog">
            <svg
              class="art__chev"
              viewBox="0 0 6 10"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M5 1 1 5l4 4" />
            </svg>
            All guides
          </a>

          {/*
            Also on legacy and also missing. The BreadcrumbList JSON-LD above has
            been correct since the port; nothing on the page said the same thing
            to a reader — and when this layout did start drawing one, it drew a
            DIFFERENT trail from the one it published, and did it in a hand-rolled
            <nav> that never received the 24px target floor the two breadcrumbs on
            /compare had both argued for in writing. One component now, fed the
            same ancestors as the JSON-LD.

            THE LEAF IS THE CATEGORY, NOT THE HEADLINE, and that is the one place
            the two lists are allowed to differ. The published leaf must NAME THE
            PAGE, so it is the full headline; this trail is set in the uppercase
            mono micro-label, where a 45-character headline is a shout and the
            category is what a reader wants. Both are right about different
            things, which is why check-breadcrumbs.js compares the LINKS and says
            so at length.
          */}
          {/*
            WRAPPED IN A DIV THIS FILE OWNS, and that is not a stylistic choice.
            Astro scopes a <style> block by rewriting each selector to require a
            `data-astro-cid` attribute it stamps onto the elements in THIS
            template. A child component's root element is not one of those, so
            `class="art__crumb"` passed to <Breadcrumb> arrived as a plain class
            with no scope token and every rule in this file addressed to it
            matched nothing.

            MEASURED, not reasoned: at 390 the crumb rendered display:block, 24px
            tall, when the rule below says display:none under 720px. So the first
            version of this consolidation silently un-hid the breadcrumb on every
            phone — a regression introduced by a fix, and exactly the kind that
            reads as correct in the diff.

            The wrapper is an element this template does own, so the scope lands
            and the rule applies. It also keeps the ownership honest: WHERE the
            trail sits, and whether this layout shows one at all on a phone, is
            this file's decision; what it looks like belongs to the component.
          */}
          <div class="art__crumb">
            <Breadcrumb trail={trail} current={category} />
          </div>
        </div>

        {/*
          THE SHARED HEAD BLOCK. The category label and the headline used to be
          a hand-rolled `.art__eyebrow` + bare `<h1>` pair, which is why every
          blog post rendered a flat white title while pages built from Section
          rendered the shiny one. Both now come from the one component, and the
          treatment itself from styles/headings.css.

          THE BYLINE GOES IN THE SLOT because that is exactly what the slot is
          for: it is this layout's own furniture, it belongs under the title
          rather than under the standfirst of some other page, and there is no
          standfirst here to displace it. A post has no lede — the first
          paragraph of the body does that job, styled in the prose block below.
        */}
        <PageHeader title={title} eyebrow={category}>
          <p class="meta art__meta">
            <time datetime={publishedAt.toISOString()}>{dateFormatter.format(publishedAt)}</time>
            {readingTime && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>{readingTime} min read</span>
              </>
            )}
            {updatedAt && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>Updated {dateFormatter.format(updatedAt)}</span>
              </>
            )}
          </p>
        </PageHeader>
      </div>
    </div>

    {/* ── The light reading pane ───────────────────────────────────────── */}
    <div class="art__pane">
      <div class="art__hero">
        {/* `credit` was passed here until 2026-08-04. The prop is gone: the
            Pexels Licence does not require attribution, the owner asked for
            none, and the caption was the only thing the picture's type scrim
            existed to keep legible. Provenance stays in blog/PHOTO-CREDITS.md. */}
        <PostImage
          slug={slug}
          priority
          sizes="(min-width: 1100px) 1000px, calc(100vw - 2.5rem)"
        />
      </div>

      <div class="art__col">
        {/* Under the byline and again at the foot, which is where both rows sit
            on the live post. Both are inside the pane, so both inherit its
            rebound colours; see the palette block in the stylesheet below. */}
        <ShareRow title={title} url={canonicalUrl} position="top" />
        <div class="article-body">
          <slot />
        </div>
        <ShareRow title={title} url={canonicalUrl} position="end" />
      </div>
    </div>
  </article>

  <RelatedPosts slug={slug} />
</Base>

<style>
  .art {
    /*
     * THE HERO GEOMETRY, ONCE. 1000px at 1440 is --measure x 25/29, and the
     * straddle is 20% of the hero's own width, which at that size is the 200px
     * the frame specifies. Both are proportions rather than fixed pixels, so
     * the hero keeps sitting exactly one fifth of its width above the cut at
     * every viewport.
     *
     * The 100% in --art-hero-w resolves against .art's width, and both places
     * it is used (the band's bottom padding, the hero's negative top margin)
     * have .art's width as their containing block, so the two cannot drift.
     * That is why .art__pane carries no inline padding of its own.
     */
    --art-hero-w: min(100% - 2 * var(--gutter), calc(var(--measure) * 25 / 29));
    --art-rise: calc(var(--art-hero-w) * 0.2);

    /*
     * THE SEAM COLOUR IS CAPTURED HERE, ON THE DARK SIDE, AND INHERITED DOWN.
     * The pane rebinds --c-teal to a darkened teal that is readable as a link
     * on #F5F6FA, so a seam written as var(--c-interactive) inside the pane resolves
     * to that darker value and the hairline goes grey. A custom property is
     * substituted where it is DECLARED, so declaring it out here freezes the
     * brand teal and carries it through the rebind untouched.
     */
    --art-seam: var(--c-ambient-start);
  }

  /* ── Dark band ────────────────────────────────────────────────────────── */
  .art__band {
    position: relative;
    z-index: 0;
    /* The bottom padding is the straddle plus the gap the frame leaves between
       the byline and the top of the hero. */
    padding-block: var(--sec-pad-y-hero) calc(var(--art-rise) + var(--sec-gap));
  }

  .art__glow {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    /* Absolute px, not vh: a glow measured in viewport height is a different
       piece of light on every screen. */
    height: 820px;
    background-image: var(--grad-stage);
    pointer-events: none;
  }

  .art__band-inner {
    position: relative;
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* Pill left, breadcrumb centred on the page. Three tracks rather than two so
     the breadcrumb centres on the MEASURE and not on the space the pill leaves
     behind it. */
  .art__nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--stack-1);
    margin-bottom: var(--sec-gap);
  }

  /* The wash, the hairline and the hover are `.control` in styles/controls.css
     (A-52). The 36px target comes from `:where(a, button, …).chip` in
     styles/labels.css and is untouched by that move, which is the point: the
     shared response owns no geometry, so consolidating a hover cannot shrink a
     control. */
  .art__pill {
    justify-self: start;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    box-shadow: var(--gloss-inset);
    text-decoration: none;
  }

  /*
   * WCAG 2.2 target size without changing the drawn capsule. The frame's pill
   * is 158 x 38; growing it to 44 would break the composition, so the HIT AREA
   * is extended past the visible box instead. The pseudo-element is the target,
   * the capsule is the picture of it.
   */
  .art__pill::after {
    content: '';
    position: absolute;
    top: 50%;
    inset-inline: 0;
    height: 44px;
    transform: translateY(-50%);
  }

  .art__chev {
    width: 6px;
    height: 10px;
    flex: none;
  }

  /*
   * THE BREADCRUMB'S OWN RULES ARE GONE FROM HERE, 2026-08-04. Nine declarations
   * — the flex row, the generated "/" separator, the link colour, the hover and
   * the focus ring — were a hand-copy of what layouts/Compare.astro and
   * pages/compare/index.astro each also held, and the copy that landed here was
   * missing the one rule the other two had argued for in writing: the WCAG 2.2
   * SC 2.5.8 target floor. That is how this layout shipped a 33.8 x 15 crumb link
   * at 1440 on eight routes while /compare shipped a 24px one, from the same
   * idea, on four.
   *
   * They now live once, in components/ui/Breadcrumb.astro. `.art__crumb` survives
   * as a POSITIONING hook only — where the block sits in this layout's hero grid —
   * which is the one thing about a breadcrumb that genuinely is this file's
   * business. Anything about how it LOOKS belongs to the component.
   */
  .art__crumb {
    /* Grid placement only; see the note above. A grid item defaults to
       min-width:auto and refuses to shrink below its widest content, which a
       wrapping trail of crumbs would otherwise force this column to honour. */
    min-width: 0;
  }

  /*
   * THE HEAD BLOCK IS NO LONGER THIS LAYOUT'S BUSINESS.
   *
   * Four rules used to live here: the centring of the eyebrow, headline and
   * byline; the gradient capsule for `.art__eyebrow`; its @supports guard; and
   * a bare `h1` rule at --t-h1 with a 20ch measure. All four were a hand-copy
   * of components/layout/Section.astro, and the copy is why every blog post
   * rendered a FLAT WHITE headline: the shiny treatment lived inside Section's
   * SCOPED styles, so it could only ever reach the routes Section drew.
   *
   * The whole block now comes from styles/headings.css by way of PageHeader,
   * which emits `.section__head > h1.section__title` exactly as Section does.
   * The centring comes with it, so the `text-align` rule went too; the prose
   * column below is untouched and keeps its own left edge, which was the point
   * of scoping that rule element by element rather than putting it on a shared
   * ancestor.
   *
   * The old headline ran at 20ch against Section's 16ch, and at a slightly
   * tighter tracking. Those differences were the defect, not a decision.
   */

  .art__meta {
    /* The gap the deleted `h1` rule used to hold as its own bottom margin.
       h1.section__title is `margin: 0` in headings.css, because a shared head
       block cannot know what follows it — so the space belongs to whatever
       this layout puts in the slot, which is this byline. */
    margin: var(--stack-2) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    /* The byline sits in the head block, where a standfirst would, so it
       centres with it. text-align cannot do this on a flex container. */
    justify-content: center;
    align-items: center;
    color: var(--c-text-muted);
  }

  /* ══════════════════════════════════════════════════════════════════════
     THE LIGHT READING PANE, AND ITS PALETTE.

     The palette is applied by REBINDING the site's own token names on this one
     element rather than by writing a second set of rules. Custom properties
     inherit, so everything inside the pane — the prose, the share rows, the
     callouts — picks the light values up without knowing anything about the
     pane and without a single component being edited. ShareRow.astro in
     particular is untouched: it asks for --c-card and --c-border as it always
     did and gets white and a light rule.

     The four surface values are quoted from the approved frame. The link teal
     is not: brand --c-teal (#2DD4BF) on #F5F6FA measures 1.6:1 and is
     unreadable, so the pane uses a darkened teal from the same family at
     5.1:1. Body 11.8:1, muted 4.9:1, headings 19:1, all against #F5F6FA.

     WHERE THESE BELONG is styles/tokens.css, as a named light scope. They are
     literal here because the token file has no light palette at all and this
     pass does not own styles/. Reported to the owner.
     ══════════════════════════════════════════════════════════════════════ */
  .art__pane {
    --c-bg: #f5f6fa;
    --c-panel: #ffffff;
    --c-card: #ffffff;
    /* Bound, not restated, for the reason A-63 gives at the :root pair in
       styles/tokens.css: the pane's hover fill IS its card fill, and two
       literals sitting side by side is how they come apart later. It stays
       listed because this block is deliberately an exhaustive list — see the
       note below on tokens added to :root after it was written. */
    --c-card-hover: var(--c-card);
    --c-text: #0b0e19;
    --c-text-sub: #2b3245;
    --c-text-muted: #626c82;
    --c-border: rgba(11, 14, 25, 0.12);
    --c-border-glow: rgba(15, 118, 110, 0.4);
    --c-teal: #0f766e;
    --c-teal-glow: rgba(15, 118, 110, 0.25);

    /* ── EVERY TOKEN THAT CAN CARRY TEXT, REBOUND ────────────────────────
     *
     * Added 2026-08-03. This pane rebinds the palette so dark-surface values
     * cannot leak onto a light one, and it is a LIST — so a token added to
     * :root after it was written is missing by default, silently, until
     * somebody writes `color: var(--the-new-one)` in here and gets text nobody
     * can read. This codebase has shipped invisible text twice.
     *
     * --c-interactive was created earlier the SAME DAY and was already missing.
     * Checking the whole set then found five. Measured on #F5F6FA:
     *
     *   interactive  (was --c-cyan #22D3EE)  1.67:1  ->  #0e7490  4.96:1
     *   cyan         #22D3EE                 1.67:1  ->  #0e7490  4.96:1
     *   orchid       #C77DFF                 2.49:1  ->  #7e22ce  6.47:1
     *   violet       #A78BFA                 2.52:1  ->  #6d28d9  6.58:1
     *   pink         #F472B6                 2.45:1  ->  #be185d  5.59:1
     *   teal-dark    #0CC9A8                 1.96:1  ->  #115e59  7.02:1
     *
     * None renders as text in here today, so these are traps rather than
     * defects. The HUES are preserved: a refusal is still violet, it is simply
     * a violet that can be read on paper.
     *
     * interactive and cyan take the same value on purpose — at :root
     * --c-interactive resolves to --c-cyan, and the two must not disagree on
     * one surface. interactive is deliberately NOT the pane's --c-teal, even
     * though that also passes: ADR 0005 separates interactive from verified.
     *
     * Rule 8 of check-design-system.js now asserts this list is complete. */
    --c-interactive: #0e7490;
    --c-cyan: #0e7490;
    --c-orchid: #7e22ce;
    --c-violet: #6d28d9;
    --c-pink: #be185d;
    --c-teal-dark: #115e59;
    /* ── AND THE LIST FELL BEHIND AGAIN, EXACTLY AS PREDICTED ─────────────
     *
     * Added 2026-08-04, and it is the sixth token to arrive here late. The PPN
     * 002 calculator's "below the floor" tag had `#E8B84B` hand-typed into it,
     * which is --c-amber's value spelled out; replacing the literal with the
     * token made --c-amber a colour that carries text, and rule 8 immediately
     * reported it missing from this list. Unbound it resolves to #E8B84B, which
     * is 1.71:1 on this pane's #F5F6FA — the worst ratio any of the eleven has
     * had, and the token whose entire job is to say "this value is at risk".
     *
     * #886311 is the same hue (41.6deg, measured off #E8B84B in HSL) taken down
     * to L 30%: 5.06:1 on the pane and 5.47:1 on its white cards. The hue is
     * preserved for the same reason orchid stayed violet — an at-risk marker
     * that changes colour between surfaces stops being a marker.
     *
     * Nothing renders it as text in here today, so this is a trap rather than a
     * defect, which is precisely what the previous five were. */
    --c-amber: #886311;
    /* ── --c-interactive HAS TO BE REBOUND TOO, AND IT WAS NOT ────────────
     *
     * Added 2026-08-03. The pane rebinds eleven tokens so dark-surface values
     * cannot leak onto a light one, and --c-interactive was created LATER, on
     * the same day, when the interactive role was finally given a name. It was
     * not in the list because it did not exist when the list was written.
     *
     * Measured: unbound, it resolves to --c-cyan #22D3EE, which is 1.67:1 on
     * this pane's #F5F6FA. Nothing renders it as text in here today, so this is
     * a trap rather than a defect — the next person to write
     * `color: var(--c-interactive)` inside the pane gets text nobody can read,
     * and this codebase has shipped invisible text twice already.
     *
     * #0e7490 is 4.96:1 here. NOT the pane's --c-teal, even though that would
     * also pass at 5.07:1: ADR 0005 separates interactive from verified, and
     * collapsing them on one surface would put the separation back exactly
     * where it was before the token existed.
     *
     * THE GENERAL PROBLEM, worth stating because it will recur: a scoped
     * palette is a list, and a new token added anywhere else is missing from it
     * by default. Any token added to :root that can carry TEXT needs a line
     * here. */
    --c-interactive: #0e7490;

    /* ── AND THE WHOLE ROLE LAYER, WHICH ARRIVED 2026-08-04 ───────────────
     *
     * The V6 pass took every colour outside tokens.css off a HUE name and on to
     * a ROLE name — --c-teal became --c-verified where it meant verified and
     * --c-ambient-start where it was decoration — and it created fourteen
     * tokens that did not exist when the list above was written. Rule 8 of
     * check-design-system.js reported eight of them missing here on the first
     * build after the sweep, which is the third time that rule has caught this
     * list falling behind and is exactly why it exists.
     *
     * IT IS NOT ENOUGH THAT THE HUE THEY POINT AT IS ALREADY REBOUND, and this
     * is the trap worth writing down. `--c-verified: var(--c-teal)` is declared
     * at :root, so its var() is substituted THERE, at computed-value time on the
     * root element, and what inherits into this pane is the finished #2DD4BF —
     * not a live reference that would pick up the pane's own --c-teal. Rebinding
     * --c-teal here therefore does nothing for --c-verified. Every role needs
     * its own line, and the same mechanism is what tokens.css records for
     * --grad-ramp resolving to `none` in the built output.
     *
     * Measured on this pane's #F5F6FA, and the HUES are preserved for the reason
     * the amber note above gives — a marker that changes colour between surfaces
     * stops being a marker:
     *
     *   verified       #2DD4BF  1.60:1  ->  #0f766e  5.07:1
     *   refused        #B39DFB  1.99:1  ->  #7e22ce  6.47:1
     *   at risk        #E8B84B  1.71:1  ->  #886311  5.06:1
     *   ambient start  #2DD4BF  1.60:1  ->  #0f766e  5.07:1
     *   ambient mid    #22D3EE  1.67:1  ->  #0e7490  4.96:1
     *   ambient end    #A78BFA  2.52:1  ->  #6d28d9  6.58:1
     *   ambient far    #B39DFB  1.99:1  ->  #7e22ce  6.47:1
     *
     * The ambient set takes the same values as the hues it is bound to at :root,
     * because on this pane it is still decoration and decoration that changed
     * hue between the dark page and the light pane would read as two brands.
     *
     * THE FILLED-CONTROL SET INVERTS ON THIS SURFACE, and it has to. At :root
     * --c-interactive-fill is #FFFFFF on a near-black page and its label is the
     * page; a white fill on #F5F6FA is invisible and its label would be 3.73:1.
     * So the fill takes the pane's interactive value and the label goes white:
     * 5.36:1 at rest and 8.23:1 on the pressed state, against 4.5:1 for a button
     * label. The glows follow their marks, and the control glow drops from the
     * root's 60% to 30% on purpose: a glow reads by adding light, and adding a
     * saturated dark to a near-white pane subtracts it. Six of these carry no
     * text today and are listed anyway, because every previous entry in this
     * block was a trap before it was a defect. */
    --c-verified:      #0f766e;
    --c-verified-glow: rgba(15, 118, 110, 0.25);
    --c-refused:       #7e22ce;
    --c-at-risk:       #886311;
    --c-ambient-start: #0f766e;
    --c-ambient-mid:   #0e7490;
    --c-ambient-end:   #6d28d9;
    --c-ambient-far:   #7e22ce;
    --c-ambient-deep:  #6d28d9;
    --c-ambient-glow:  rgba(15, 118, 110, 0.25);
    --c-interactive-fill:      #0e7490;
    --c-interactive-fill-lit:  #0a566a;
    --c-interactive-fill-text: #ffffff;
    --c-interactive-glow:      rgba(14, 116, 144, 0.30);

    /*
     * A four-step ladder at 4 to 7 percent, not the dark six-step ladder,
     * because a shadow on a light ground needs far less alpha to read. Same
     * fingerprint as the dark ladder: blur is 0.8 x Y, and Y roughly doubles
     * each step.
     */
    --gloss-inset: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    --shadow-card:
      0 3px 2.4px rgba(11, 14, 25, 0.04), 0 6px 4.8px rgba(11, 14, 25, 0.05),
      0 12px 9.6px rgba(11, 14, 25, 0.06), 0 24px 19.2px rgba(11, 14, 25, 0.07);
    --shadow-panel: var(--shadow-card);
    --blur-glass: none;

    position: relative;
    z-index: 1;
    background-color: var(--c-bg);
    color: var(--c-text-sub);
    padding-bottom: var(--sec-pad-y);
    /*
     * flow-root, and the whole straddle depends on it. The hero is this
     * element's first in-flow child and carries a negative top margin; without
     * a block formatting context that margin COLLAPSES OUT through the parent
     * and drags the pane up with it, so the picture and the cut move together
     * and the hero ends up sitting exactly on the seam with nothing above it.
     * Measured before the fix: 0px of the hero in the dark band against the
     * 200px the frame specifies. flow-root contains the margin without
     * clipping, which `overflow: hidden` would not — that would cut the top of
     * the hero off instead.
     */
    display: flow-root;
  }

  /*
   * THE SEAM. 1px of teal on the cut, top and bottom, so the change of ground
   * reads as an edit. It is a hard line by design; softening it into a
   * gradient is what a rendering fault looks like, and it is the one thing
   * about this layout that must not be "tidied".
   */
  .art__pane::before,
  .art__pane::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 1px;
    /*
     * Effectively flat, which is what the frame draws: full teal across the
     * measure with only the last few percent at each end fading out, so the
     * line does not butt hard into the window edge. An earlier version ramped
     * from 12% to 50% and, measured at the left of a 1440 viewport, the seam
     * was a pale grey line rather than a teal one for the first 170px.
     */
    background-image: linear-gradient(
      90deg,
      transparent,
      var(--art-seam) 4%,
      var(--art-seam) 96%,
      transparent
    );
  }
  .art__pane::before {
    top: 0;
  }
  .art__pane::after {
    bottom: 0;
  }

  /* The straddle. z-index puts the picture over the seam, which is the order
     the frame draws them in. */
  .art__hero {
    position: relative;
    z-index: 1;
    width: var(--art-hero-w);
    margin-inline: auto;
    margin-top: calc(var(--art-rise) * -1);
    margin-bottom: var(--sec-gap);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  /*
   * THE READING MEASURE: 684px, which is Vercel's long-form measure and the
   * one written on the approved frame. The alternative in the research was
   * Better Stack's 616px at 17/27.2; 684 was chosen because the frame chose
   * it, and because the pane's own type sits at 17px, where 684 gives roughly
   * 68 characters a line.
   *
   * Derived from --measure rather than written as a pixel value, the same way
   * tokens.css derives --measure-mid, --measure-band and --measure-prose, so
   * it scales with the page grid. The scale has no 684 stop of its own;
   * adding one means editing styles/tokens.css, which this pass does not own.
   * The gutter is added on top because on this site "the measure" is the outer
   * box, so 684 has to be the CONTENT width for the frame's figure to hold.
   */
  .art__col {
    max-width: calc(var(--measure) * 0.59 + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ── Prose ────────────────────────────────────────────────────────────── */

  /*
   * TAG MATCHES TIER. These ran one step below their own level — h2 at --t-h3,
   * h3 at --t-h4 — which is why the site had two different h2 sizes and, on
   * pages carrying both prose and a section heading, two on one page. An
   * article h2 is a section of the document and takes the section size.
   */
  .article-body :global(h2) {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 2.5rem 0 1rem;
    color: var(--c-text);
    scroll-margin-top: 6rem;
  }

  .article-body :global(h3) {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: var(--t-w-h3);
    line-height: 1.25;
    margin: 2rem 0 0.85rem;
    color: var(--c-text);
    scroll-margin-top: 6rem;
  }

  .article-body :global(p) {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.65;
    color: var(--c-text-sub);
    margin: 0 0 1.5rem;
  }

  /*
   * THE REVIEW-DATE LINE. Five of the eight posts open with an italic
   * "Last reviewed: 26 July 2026", which is metadata wearing a paragraph's
   * clothes. Set as a mono meta line it stops competing with the standfirst
   * below it, and nothing in the markdown had to change to say so.
   *
   * THE RECIPE IS GONE FROM HERE, 2026-08-04, A-48. It is a `.meta` line, but
   * it is a markdown paragraph so it cannot be given the class — which is why
   * this exact selector is now NAMED IN styles/labels.css, beside `caption` and
   * `thead th`, as one of the four places on the site a class cannot reach.
   * The values are declared once, there; the argument for putting the selector
   * in that file rather than an exception in the gate is written above the
   * shared floor there.
   *
   * WHAT STAYS HERE IS THIS LAYOUT'S BUSINESS: the colour, and the 2rem that
   * separates the date from the standfirst under it. Neither is part of any of
   * the four label recipes — labels.css sets no colour at all, deliberately,
   * and where a label sits is not what a label is. (Three until A-61 added
   * `.grouplabel` on 2026-08-04.)
   */
  .article-body > :global(p:first-child:has(> em:only-child)) {
    color: var(--c-text-muted);
    margin-bottom: 2rem;
  }
  .article-body > :global(p:first-child:has(> em:only-child)) em {
    font-style: normal;
  }

  /*
   * THE STANDFIRST. 21/34 on the frame, which is --t-lede at desktop. It is
   * the first paragraph of real prose: either the body's first child, or the
   * one immediately after the review-date line. `regulatory-updates-2026`
   * opens on an h2 and matches neither, which is the correct outcome — it has
   * no standfirst to set.
   *
   * Where :has() is unsupported both selectors are invalid and dropped, so the
   * body sets at one size throughout. Unstyled, not mis-styled.
   */
  .article-body > :global(p:first-child:not(:has(> em:only-child))),
  .article-body > :global(p:first-child:has(> em:only-child) + p) {
    font-size: var(--t-lede);
    line-height: 1.62;
    color: var(--c-text);
    margin-bottom: 1.75rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.65;
    color: var(--c-text-sub);
    margin: 0 0 1.5rem;
    padding-inline-start: 1.5rem;
  }

  .article-body :global(li) {
    margin: 0 0 0.65rem;
  }

  .article-body :global(a) {
    color: var(--c-interactive);
    font-weight: 600;
    /*
     * A URL used as its own link text has no spaces, so it cannot wrap and it
     * pushes the whole page sideways. Measured on /blog/ppn-002-social-value-guide
     * at 390px: a gov.uk collections URL ran to 396.8px against a 390px viewport,
     * taking document scrollWidth to 397 and giving mobile Safari a horizontal
     * scrollbar. WebKit only — Chromium's font metrics happened to fit, which is
     * exactly why one engine is not a test.
     *
     * `anywhere` rather than `break-word`: it also reduces the element's
     * min-content contribution, so the link cannot force its container wider in
     * the first place.
     */
    overflow-wrap: anywhere;
  }

  /*
   * THE CALLOUT. A raised white surface with a teal spine, which is how the
   * frame draws the £5 million block. It is a blockquote because that is what
   * the eight markdown files already write; nothing in the content had to
   * change for it to get this treatment, and nothing will have to change in
   * the next post either.
   */
  /* THE CALLOUT MOVED to styles/blocks.css, 2026-08-04, value for value. The
     treatment was right and its home was wrong: stated here it reached the eight
     posts and nothing else, so /crowmark and /crowmark-buyers each drew their own
     quote and one of the three ended up with no rule at all. What is left here is
     the colour, which is a call-site decision on this site by design. */
  .article-body :global(blockquote) {
    color: var(--c-text-sub);
  }

  .article-body :global(pre) {
    margin: 1.5rem 0;
    padding: 1.25rem 1.5rem;
    background: var(--c-panel);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-panel);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.6;
    color: var(--c-text-sub);
  }

  .article-body :global(code) {
    font-family: var(--font-mono);
    line-height: var(--lh-tight);
    font-size: 0.92em;
  }

  .article-body :global(strong) {
    color: var(--c-text);
    font-weight: 800;
  }

  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--c-border);
    margin: 2.5rem 0;
  }

  /* ── Narrow ───────────────────────────────────────────────────────────── */
  @media (max-width: 719px) {
    /* The breadcrumb duplicates what the pill already offers on a phone, where
       there is no room for both on one line and stacking them costs a whole
       row of vertical space above the headline. The trail is still published
       as BreadcrumbList JSON-LD, and the pill still goes back to /blog. */
    .art__crumb {
      display: none;
    }
    .art__nav {
      grid-template-columns: 1fr;
    }
  }

  /*
   * Windows high-contrast. The pane's whole identity is a background colour,
   * which forced-colors replaces; without this the seam and the pane edge
   * disappear and the article runs into the rail below it.
   */
  @media (forced-colors: active) {
    .art__pane {
      border-block: 1px solid CanvasText;
    }
    .art__pane::before,
    .art__pane::after {
      display: none;
    }
  }
</style>
