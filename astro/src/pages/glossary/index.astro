---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import { breadcrumbs } from '../../lib/schema';
import Button from '../../components/ui/Button.astro';

const title = 'UK Procurement Glossary | CrowAgent';
const description =
  'Plain-English definitions of UK public procurement and bidding terms: PPN 002, Find a Tender, frameworks, MAT, standstill, TUPE and more.';
const path = '/glossary';

interface Term {
  cat: 'legislation' | 'procurement' | 'process';
  catLabel: string;
  name: string;
  /** The prose shown on the card. */
  card: string;
  /** The (sometimes differently worded, schema-safe) description in the DefinedTermSet JSON-LD. Defaults to `card` when the source carried the same text in both places. */
  ld?: string;
  href?: string;
  linkText?: string;
}

const terms: Term[] = [
  {
    cat: 'process',
    catLabel: 'Evaluation',
    name: 'Award criteria',
    card: 'The published, weighted factors, such as price, quality and social value, that a buyer scores each tender against to decide the winner. Weightings are set out in the tender documents before bids are submitted.',
  },
  {
    cat: 'process',
    catLabel: 'Qualification',
    name: 'Bid/no-bid',
    card: "The qualifying decision on whether to pursue a tender, weighing fit, likely competitiveness, resource cost and strategic value before committing to write a bid. A disciplined bid/no-bid gate protects a team's time and focus.",
    ld: 'The qualifying decision on whether to pursue a tender, weighing fit, likely competitiveness, resource cost and strategic value before committing to write a bid.',
  },
  {
    cat: 'process',
    catLabel: 'Process',
    name: 'Clarification questions',
    card: 'Questions bidders raise during the tender period to resolve ambiguities in the documents. Buyers normally publish the answers to every bidder, so all suppliers compete on the same information.',
    ld: 'Questions bidders raise during the tender period to resolve ambiguities in the documents. Buyers normally publish the answers to every bidder so all suppliers compete on the same information.',
  },
  {
    cat: 'procurement',
    catLabel: 'Procurement',
    name: 'Contract notice',
    card: 'A formal published notice that advertises a procurement opportunity and invites suppliers to express interest or bid. Higher-value notices appear on Find a Tender, lower-value ones on Contracts Finder.',
  },
  {
    cat: 'procurement',
    catLabel: 'Portal',
    name: 'Contracts Finder',
    card: 'The UK government service that publishes lower-value public sector contract opportunities and awarded contracts in England, generally from £12,000 for central government and £30,000 for the wider public sector. CrowMark tracks it daily.',
    ld: 'The UK government service that publishes lower-value public sector contract opportunities and awarded contracts in England, generally from 12,000 pounds for central government and 30,000 pounds for the wider public sector.',
  },
  {
    cat: 'procurement',
    catLabel: 'Classification',
    name: 'CPV code',
    card: 'Common Procurement Vocabulary code, a standard numeric classification that identifies the subject of a contract. Buyers tag notices with CPV codes, so suppliers can filter opportunities to their trade.',
    ld: 'Common Procurement Vocabulary code, a standard numeric classification that identifies the subject of a contract. Buyers tag notices with CPV codes so suppliers can filter opportunities to their trade.',
  },
  {
    cat: 'procurement',
    catLabel: 'Procurement',
    name: 'Dynamic Purchasing System (DPS)',
    card: 'An electronic list of qualified suppliers that stays open for new entrants to join at any time, unlike a closed framework. The Procurement Act 2023 replaces the DPS with dynamic markets for new procurements.',
  },
  {
    cat: 'procurement',
    catLabel: 'Process',
    name: 'E-sourcing',
    card: 'Running tenders through online portals such as In-tend, Jaggaer, Atamis or Proactis, where buyers issue documents and suppliers submit clarifications and bids. Most UK public tenders are now run this way.',
  },
  {
    cat: 'process',
    catLabel: 'Evaluation',
    name: 'Evaluation matrix',
    card: 'The scoring grid that maps each award criterion to its weighting and score. Buyers use it to assess tenders consistently, and bidders use it to focus effort on the highest-scoring sections.',
  },
  {
    cat: 'procurement',
    catLabel: 'Portal',
    name: 'Find a Tender Service (FTS)',
    card: "The UK e-notification service that publishes higher-value public contract notices above the legal thresholds. It replaced the EU's OJEU and TED for UK procurements from 1 January 2021.",
  },
  {
    cat: 'procurement',
    catLabel: 'Procurement',
    name: 'Framework agreement',
    card: 'An agreement with one or more suppliers that fixes the terms, such as price and quality, under which specific call-off contracts can be awarded over a set period, usually up to four years. Buyers award work without running a full tender each time.',
    ld: 'An agreement with one or more suppliers that fixes the terms under which specific call-off contracts can be awarded over a set period, usually up to four years. Buyers award work without running a full tender each time.',
  },
  {
    cat: 'process',
    catLabel: 'Process',
    name: 'ITT (invitation to tender)',
    card: 'The formal document that invites suppliers to submit a priced, detailed bid against the specification and award criteria. It follows the selection stage in a two-stage procurement.',
  },
  {
    cat: 'process',
    catLabel: 'Delivery',
    name: 'KPIs',
    card: 'Key Performance Indicators, the measurable targets written into a contract. Under the Procurement Act 2023, contracts above £5m must have at least three published KPIs, with performance assessed and published.',
    ld: 'Key Performance Indicators, the measurable targets written into a contract. Under the Procurement Act 2023, contracts above 5m pounds must have at least three published KPIs, with performance assessed and published.',
  },
  {
    cat: 'procurement',
    catLabel: 'Procurement',
    name: 'Lot',
    card: 'A division of a larger contract into smaller packages, by geography, discipline or value, that suppliers can bid for separately. Lotting widens access for smaller and specialist suppliers.',
  },
  {
    cat: 'legislation',
    catLabel: 'Legislation',
    name: 'Most Advantageous Tender (MAT)',
    card: 'The award standard under the Procurement Act 2023 that replaces the Most Economically Advantageous Tender (MEAT). It signals that buyers can weight wider value, not only lowest price, when scoring bids.',
  },
  {
    cat: 'legislation',
    catLabel: 'Policy note',
    name: 'PPN 002',
    card: 'Procurement Policy Note 002, published February 2025 and mandatory from 1 October 2025, sets a minimum 10% social value weighting on in-scope central government tenders.',
    href: '/glossary/ppn-002',
    linkText: 'Read full definition',
  },
  {
    cat: 'legislation',
    catLabel: 'Policy note',
    name: 'PPN 017',
    card: 'Procurement Policy Note 017, guidance on the transparent and responsible use of artificial intelligence in commercial activity and bidding, including disclosing AI use to the buyer. It underpins the AI-use disclosure CrowMark attaches to every AI-assisted draft.',
    ld: 'Procurement Policy Note 017, guidance on the transparent and responsible use of artificial intelligence in commercial activity and bidding, including disclosing AI use to the buyer.',
  },
  {
    cat: 'process',
    catLabel: 'Process',
    name: 'PQQ',
    card: 'Pre-Qualification Questionnaire, the earlier supplier-suitability stage that shortlists bidders on financial standing and experience before the invitation to tender. Under the Public Contracts Regulations 2015 it was largely renamed the Selection Questionnaire.',
    ld: 'Pre-Qualification Questionnaire, the earlier supplier-suitability stage that shortlists bidders on financial standing and experience before the invitation to tender. It was largely renamed the Selection Questionnaire under the Public Contracts Regulations 2015.',
  },
  {
    cat: 'legislation',
    catLabel: 'Legislation',
    name: 'Procurement Act 2023',
    card: 'The UK Act that reformed public procurement and went live on 24 February 2025, replacing the Public Contracts Regulations 2015. It introduced the Most Advantageous Tender, dynamic markets, a central digital platform and new transparency duties.',
  },
  {
    cat: 'process',
    catLabel: 'Process',
    name: 'Selection Questionnaire (SQ)',
    card: "The standard set of questions that assesses a supplier's suitability, covering financial standing, capability and grounds for exclusion, to shortlist bidders before the tender stage. It replaced the PQQ in most UK procurements.",
  },
  {
    cat: 'legislation',
    catLabel: 'Policy',
    name: 'Social value model',
    // `card` is unused for this one term: the grid renders a hand-written
    // fragment below so the in-line link to /glossary/toms-framework survives.
    // `ld` is what actually reaches the DefinedTermSet JSON-LD.
    card: '',
    ld: 'The UK government framework, introduced under PPN 06/20 and carried into PPN 002, that defines how social value is scored in central government procurement through themes, policy outcomes and model award criteria. It is commonly measured using the TOMs framework.',
  },
  {
    cat: 'process',
    catLabel: 'Process',
    name: 'Standstill period',
    card: 'A mandatory pause between telling bidders the award decision and signing the contract, giving unsuccessful bidders time to challenge. The Procurement Act 2023 sets a minimum standstill of 8 working days.',
  },
  {
    cat: 'process',
    catLabel: 'Process',
    name: 'Tender readiness',
    card: 'Having the documents, accreditations and evidence, such as accounts, insurances, policies, accreditations and case studies, prepared in advance so a bid can be produced quickly and in full. Ready suppliers respond to more opportunities and miss fewer deadlines.',
    ld: 'Having the documents, accreditations and evidence, such as accounts, insurances, policies, accreditations and case studies, prepared in advance so a bid can be produced quickly and in full.',
  },
  {
    cat: 'legislation',
    catLabel: 'Employment law',
    name: 'TUPE',
    card: "Transfer of Undertakings (Protection of Employment) Regulations 2006, which protect employees' terms when a business or service contract transfers to a new provider. It is central to facilities management and outsourced service re-tenders.",
  },
];

const schema = [
  // BreadcrumbList was published by the legacy page and lost in the port (OA-24).
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Glossary', path: '/glossary' },
  ]),
  {
    '@type': 'CollectionPage',
    name: 'UK Procurement Glossary',
    description:
      'Plain-English definitions of the UK public procurement and bidding terms that decide whether a supplier wins and delivers public contracts.',
    url: `${SITE.origin}/glossary`,
    publisher: { '@type': 'Organization', name: 'CrowAgent', url: `${SITE.origin}/` },
  },
  {
    '@type': 'DefinedTermSet',
    '@id': `${SITE.origin}/glossary#termset`,
    name: 'CrowAgent UK Public Procurement and Bid Glossary',
    description: 'Definitions of the UK public procurement and bidding terms that decide whether a supplier wins and delivers public contracts.',
    url: `${SITE.origin}/glossary`,
    hasDefinedTerm: terms.map((t) => ({
      '@type': 'DefinedTerm',
      name: t.name,
      description: t.ld ?? t.card,
      ...(t.href ? { url: `${SITE.origin}${t.href}` } : {}),
    })),
  },
];
---

<Base title={title} description={description} path={path} image="/Assets/og/glossary-index.png?v=20260730" schema={schema}>
  <main>
    <header class="gx-hero">
      <div class="gx-wrap">
        <span class="gx-eyebrow">Glossary</span>
        <h1>Procurement terms, defined.</h1>
        <p class="gx-hero-sub">Plain-English definitions of the regulations, frameworks and standards behind UK public sector bidding.</p>
      </div>
    </header>

    <section class="gx-index" aria-labelledby="index-heading">
      <div class="gx-wrap">
        <h2 class="sr-only" id="index-heading">Term index</h2>
        <div class="gx-toolbar">
          <div class="gx-search">
            <label for="gq" class="sr-only">Search glossary terms</label>
            <input id="gq" type="search" autocomplete="off" placeholder="Search terms, e.g. PPN 002, framework, standstill" aria-describedby="gcount" />
            <button class="gx-clear" id="gclear" type="button" aria-label="Clear search">&times;</button>
          </div>
          <div class="gx-filters" role="group" aria-label="Filter by category">
            <button class="gx-chip" type="button" data-cat="all" aria-pressed="true">All</button>
            <button class="gx-chip" type="button" data-cat="legislation" aria-pressed="false">Legislation</button>
            <button class="gx-chip" type="button" data-cat="procurement" aria-pressed="false">Procurement</button>
            <button class="gx-chip" type="button" data-cat="process" aria-pressed="false">Bidding process</button>
          </div>
          <p class="gx-count" id="gcount" aria-live="polite" role="status"></p>
        </div>

        <div class="gx-grid" id="ggrid">
          {
            terms.map((t) =>
              t.href ? (
                <a class="gx-term surface surface--read" href={t.href} data-cat={t.cat}>
                  <span class="gx-cat">{t.catLabel}</span>
                  <h3>{t.name}</h3>
                  <p>{t.card}</p>
                  <span class="gx-more">{t.linkText} &rarr;</span>
                </a>
              ) : (
                <div class="gx-term surface surface--read" data-cat={t.cat}>
                  <span class="gx-cat">{t.catLabel}</span>
                  <h3>{t.name}</h3>
                  <p>
                    {t.name === 'Social value model' ? (
                      <>
                        The UK government framework, introduced under PPN 06/20 and carried into PPN 002, that defines how
                        social value is scored in central government procurement through themes, policy outcomes and model
                        award criteria. It is commonly measured using the <a href="/glossary/toms-framework">TOMs framework</a>.
                      </>
                    ) : (
                      t.card
                    )}
                  </p>
                </div>
              ),
            )
          }
        </div>

        <p class="gx-empty" id="gempty">No terms match your search. Try a different word.</p>
      </div>
    </section>

    <section class="gx-cross">
      <div class="gx-wrap">
        <div class="gx-head">
          <span class="gx-eyebrow-inline">Keep reading</span>
          <h2>Go deeper on the rules.</h2>
        </div>
        <div class="gx-xlinks">
          <a class="gx-xcard surface" href="/resources">
            <span class="gx-xt">Resources</span>
            <p>In-depth guides, the free PPN 002 calculator and the method behind its scoring.</p>
            <span class="gx-more">Browse resources &rarr;</span>
          </a>
          <a class="gx-xcard surface" href="/blog">
            <span class="gx-xt">Regulatory blog</span>
            <p>Analysis of PPN changes and UK public procurement deadlines.</p>
            <span class="gx-more">Read the blog &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <section class="gx-cta">
      <div class="gx-wrap">
        <span class="gx-eyebrow">Next step</span>
        <h2>Know the term. <span class="accent">Now price the requirement.</span></h2>
        <p class="gx-cta-sub">Enter a contract value and the free PPN 002 calculator sizes the 10% minimum social-value weighting, cited to National TOMs. No account, no email.</p>
        <div class="gx-cta-actions">
          <Button href="/tools/ppn-002-calculator" size="md">Use the calculator</Button>
          <Button href="/contact?enquiry=limited-access#contact-form" variant="secondary" size="md">Request access</Button>
        </div>
        <div class="gx-cta-links">
          <a href="/resources">Browse resources</a>
          <a href="/crowmark">See CrowMark</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  (function () {
    const input = document.getElementById('gq') as HTMLInputElement | null;
    const clear = document.getElementById('gclear');
    const count = document.getElementById('gcount');
    const empty = document.getElementById('gempty');
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.gx-chip'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#ggrid .gx-term'));
    if (!input || !cards.length || !clear || !count || !empty) return;
    let activeCat = 'all';

    function apply() {
      const q = (input as HTMLInputElement).value.trim().toLowerCase();
      let shown = 0;
      cards.forEach((card) => {
        const matchCat = activeCat === 'all' || card.getAttribute('data-cat') === activeCat;
        const matchText = !q || (card.textContent || '').toLowerCase().indexOf(q) !== -1;
        const vis = matchCat && matchText;
        if (vis) {
          card.removeAttribute('hidden');
          shown++;
        } else {
          card.setAttribute('hidden', '');
        }
      });
      clear!.classList.toggle('on', q.length > 0);
      empty!.classList.toggle('on', shown === 0);
      count!.textContent = shown + (shown === 1 ? ' term' : ' terms');
    }

    input.addEventListener('input', apply);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        (input as HTMLInputElement).value = '';
        apply();
      }
    });
    clear.addEventListener('click', () => {
      (input as HTMLInputElement).value = '';
      input.focus();
      apply();
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeCat = chip.getAttribute('data-cat') || 'all';
        chips.forEach((c) => c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'));
        apply();
      });
    });

    apply();
  })();
</script>

<style>
  .gx-wrap {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .gx-hero {
    position: relative;
    padding: var(--sec-pad-y-hero) 0 var(--sec-pad-y-sm);
    text-align: center;
    overflow: hidden;
  }
  .gx-hero::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -6%;
    width: 70vw;
    height: 44vw;
    transform: translateX(-50%);
    z-index: -1;
    background: var(--grad-hero-glow);
    filter: blur(20px);
    opacity: 0.5;
  }
  /*
   * EVERY EYEBROW IS A GRADIENT CAPSULE — owner decision, 2026-08-02. Same
   * shape as components/layout/Section.astro, restated because this page
   * builds its own bands.
   *
   * The 6px teal dot goes with the inline-flex it needed. It was the
   * left-aligned way of giving a bare mono line something to start against;
   * the capsule outline does that now.
   *
   * Colour is a second signal, never the only one: mono, letter-spaced,
   * uppercase, inside a visible outline. WCAG 1.4.1.
   *
   * NOT applied to .gx-cat, the category tag inside each term card. That is
   * card content, not a section head, and 24 gradient capsules down a grid
   * would compete with the terms themselves.
   */
  .gx-eyebrow,
  .gx-eyebrow-inline {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  /*
   * background-clip: text needs a transparent fill, and an inherited
   * -webkit-text-fill-color is what caused this site's invisible-text P0. The
   * @supports gate leaves a solid readable colour where it is unsupported, and
   * the declaration reaches these two short labels and nothing else.
   */
  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .gx-eyebrow,
    .gx-eyebrow-inline {
      background: var(--grad-spectrum);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }
  .gx-hero h1 {
    font-family: var(--font-display);
    font-size: var(--t-h1);
    font-weight: var(--t-w-h1);
    letter-spacing: -0.032em;
    color: var(--c-text);
    margin: 18px 0 0;
  }
  .gx-hero-sub {
    /* 62ch, the same measure Section gives every standfirst. This page had
       one of five different widths (40, 42, 44, 48 and 52rem) used for the
       identical element across the compare, glossary and sector families. */
    max-width: 62ch;
    margin: 1rem auto 0;
    color: var(--c-text-muted);
    font-size: var(--t-lede);
    line-height: 1.6;
  }

  .gx-index {
    padding: var(--sec-pad-y-sm) 0;
    background: var(--c-panel);
  }
  .gx-toolbar {
    max-width: var(--measure-band);
    margin: 0 auto clamp(30px, 4vw, 46px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .gx-search {
    position: relative;
  }
  .gx-search input {
    width: 100%;
    min-height: 56px;
    padding: 0 52px;
    border-radius: var(--radius-panel);
    border: 1px solid var(--c-border);
    background: var(--c-card);
    color: var(--c-text);
    font-size: var(--t-body);
    letter-spacing: -0.01em;
  }
  .gx-search input::placeholder {
    color: var(--c-text-muted);
  }
  .gx-search input:focus-visible {
    outline: 2px solid var(--c-interactive);
    outline-offset: 2px;
  }
  .gx-clear {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: var(--radius-chip);
    background: transparent;
    color: var(--c-text-muted);
    font-size: var(--t-h4);
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
  }
  .gx-clear.on {
    display: inline-flex;
  }
  .gx-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .gx-chip {
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--c-border);
    background: var(--c-card);
    color: var(--c-text-sub);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .gx-chip:hover {
    border-color: var(--c-interactive);
    color: var(--c-text);
  }
  .gx-chip[aria-pressed='true'] {
    background: var(--c-teal);
    border-color: var(--c-teal);
    color: var(--c-bg);
  }
  .gx-count {
    text-align: center;
    color: var(--c-text-muted);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gx-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 18px;
  }
  /* Card treatment, hover and the -4px lift come from `surface`. This page had
     18px radius, 28px padding and a 5px lift, none of which is in any scale. */
  /* `surface--read`: these hold a four to six line definition, and a definition
     is read rather than scanned. It is the one case the structural exclusions in
     styles/surfaces.css cannot see, because the card is a single paragraph. */
  .gx-term {
    display: flex;
    flex-direction: column;
    padding: var(--blk-pad);
    text-decoration: none;
    color: inherit;
  }
  .gx-cat {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-teal);
    margin-bottom: 14px;
  }
  .gx-term h3 {
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin: 0 0 12px;
  }
  .gx-term p {
    color: var(--c-text-sub);
    font-size: var(--t-body);
    line-height: 1.55;
    margin: 0;
  }
  .gx-term p a {
    color: var(--c-interactive);
    text-decoration: underline;
  }
  .gx-more {
    margin-top: 22px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--c-teal);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.04em;
  }
  .gx-empty {
    display: none;
    text-align: center;
    color: var(--c-text-sub);
    font-size: var(--t-lede);
    padding: 40px 0;
  }
  .gx-empty.on {
    display: block;
  }

  .gx-cross {
    padding: var(--sec-pad-y-sm) 0;
  }
  .gx-head {
    text-align: center;
    margin-bottom: var(--sec-gap);
  }
  .gx-head h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    color: var(--c-text);
    margin: 0.75rem 0 0;
  }
  .gx-xlinks {
    display: grid;
