---
/**
 * The homepage.
 *
 * SEO IS CARRIED OVER VERBATIM from the live legacy homepage: title,
 * description, canonical and the Organization/WebSite JSON-LD graph. The design
 * changes; the metadata does not. Changing homepage metadata is a separate,
 * measured decision and must never ride along inside a redesign.
 */
import Base from '../layouts/Base.astro';
import HeroStack from '../components/sections/HeroStack.astro';
import { SITE } from '../data/site';

const title = 'CrowAgent | Bid and tender software for UK suppliers';
const description =
  'CrowAgent helps UK suppliers find the work, draft answers cited to the rules, the tender and their own bids, and evidence delivery after award.';

/** The WebSite node the legacy page emits alongside Organization. */
const webSite = {
  '@type': 'WebSite',
  '@id': `${SITE.origin}/#website`,
  url: `${SITE.origin}/`,
  name: SITE.name,
  publisher: { '@id': `${SITE.origin}/#organization` },
};
---

<Base title={title} description={description} path="/" schema={[webSite]}>
  <HeroStack />
</Base>
