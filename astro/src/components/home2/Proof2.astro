---
/**
 * HOME 2.0: THE PROOF, AND THE GATE.
 *
 * The live homepage's second section, ProofGate, word for word. Its two panels
 * carried the page's whole positioning: where the engine is proved (UK public
 * procurement, a market with a published rulebook) and what it refuses (a
 * figure with nothing behind it). Both are kept. What changes is that they are
 * no longer two equal cards.
 *
 * ── AN EDITORIAL SPLIT, NOT TWO BOXES ──────────────────────────────────────
 *
 * The statement is prose, so it reads left, at a measure, with no container
 * round it. The three commitments beneath it are a ledger: three hairline rows
 * with a mono index, staggered in by the shared cascade. The gate is the one
 * thing in the section that is an ARTEFACT rather than an argument, so it is
 * the one thing drawn as an object: a document line with a figure, and the
 * stamp that refuses it.
 *
 * ── THE STAMP SETTLES ONCE, ON data-lit, AND RESTS STAMPED ─────────────────
 *
 * The rest state is the refused line: struck figure, stamp in place. When the
 * gate reaches the viewport the stamp lands from a slight lift and scale and
 * settles, once. Scale and translate that return to identity are a pulse, not
 * an entrance, and nothing here moves opacity. A reader with no script or with
 * reduced motion gets the stamped line, immediately.
 */
import Section from '../layout/Section.astro';

const NEVER = [
  'A bid is not a forecast, so no win probability is invented.',
  'Every figure traces to a commitment you confirmed. Anything else is removed, not estimated.',
  'A named person signs off. The engine never clears its own gate.',
];
---

<Section id="proof" class="h2pf">
  <div class="h2pf__grid">
    <div class="h2pf__copy">
      <p class="eyebrow">UK public procurement</p>
      <h2 class="h2pf__h">The engine that refuses to make things up.</h2>
      <p class="h2pf__p">
        The hardest market to bluff in is the one with a published rulebook, so
        it is the one the engine is proved against. CrowAgent reads both UK
        registers, drafts answers cited to the published requirement, to your
        own past bids and to commitments you have confirmed, and evidences
        delivery after award.
      </p>
      <p class="h2pf__p">
        The same engine runs a private-sector bid. What changes is the rulebook
        it cites, not the standard of proof.
      </p>

      <ol class="h2pf__ledger" data-cascade>
        {
          NEVER.map((line, i) => (
            <li class="h2pf__row">
              <span class="meta h2pf__n" aria-hidden="true">0{i + 1}</span>
              <span class="h2pf__line">{line}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="h2pf__gate" data-lit data-lit-threshold="0.25">
      <div class="h2gate">
        <p class="eyebrow eyebrow--marker h2gate__brow">Refusal gate</p>
        <h3 class="h2gate__h">A figure with nothing behind it does not survive the draft.</h3>
        <p class="h2pf__p h2gate__p">
          Every pound and every percentage in a CrowAgent answer is computed
          from a commitment you have confirmed. If the commitment is not there,
          the claim is taken out before a named human reviews the answer.
        </p>

        <div class="surface surface--frame surface--row h2gate__doc" role="group" aria-label="A refused figure">
          <p class="meta h2gate__doc-label">Draft · Social value · 4.2</p>
          {/* The struck thing is the CLAIM, not a number. The live page's slab
              says "Local supply chain spend. No recorded commitment sits behind
              the figure", and a claim with no commitment behind it has no
              figure to strike. An earlier cut of this line struck £108,000
              here, which is the TRACED total in the worked example further
              down the page, so it was the wrong number in the wrong place. */}
          <p class="h2gate__doc-line">
            <span>The contract will also deliver</span>
            <s class="h2gate__fig">local supply chain spend</s>
            <span>across the term.</span>
          </p>
          <p class="h2gate__why">
            <span class="chip h2gate__stamp">Refused</span>
            No recorded commitment sits behind the figure.
          </p>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Closer to the hero than a full section pad. The live hero ends on its own
     closing line and its own bottom padding, and a full pad on top of that
     left the page's largest dead zone right under the fold. */
  .h2pf {
    padding-block-start: var(--sec-pad-y-sm);
  }

  .h2pf__grid {
    display: grid;
    gap: var(--space-12);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .h2pf__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-12) clamp(var(--space-12), 7vw, calc(var(--space-12) * 2));
    }
  }

  .h2pf__copy {
    min-width: 0;
    text-align: left;
  }

  .h2pf__h {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--c-text);
    max-width: 14em;
    text-wrap: balance;
  }

  .h2pf__p {
    margin: var(--stack-2) 0 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--c-text-sub);
    max-width: 58ch;
    text-wrap: pretty;
  }

  /* ── THE LEDGER ──────────────────────────────────────────────────────── */
  .h2pf__ledger {
    margin: var(--space-10) 0 0;
    padding: 0;
    list-style: none;
    max-width: 58ch;
    border-block-start: 1px solid var(--c-border);
  }

  .h2pf__row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--c-border);
  }

  /* The shared micro label carries the type; only the ink is local. A local
     weight or tracking here would be a fifth label recipe, which is what
     check-treatments counts. */
  .h2pf__n {
    color: var(--c-verified);
  }

  .h2pf__line {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--c-text);
  }

  /* ── THE GATE ────────────────────────────────────────────────────────── */
  .h2pf__gate {
    min-width: 0;
  }

  @media (min-width: 62rem) {
    .h2pf__gate {
      position: sticky;
      top: calc(var(--space-12) * 2);
      padding-block-start: var(--space-2);
    }
  }

  .h2gate {
    text-align: left;
  }

  .h2gate__brow {
    color: var(--c-refused);
  }

  .h2gate__h {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: var(--t-w-h3);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--c-text);
    text-wrap: balance;
  }

  .h2gate__p {
    max-width: 44ch;
  }

  /* The document. A device frame, not a card: it is a page with a line on it. */
  .h2gate__doc {
    margin-block-start: var(--space-8);
    padding: var(--space-5);
    /* A page, so the smaller frame radius; the glass is the recipe's. */
    border-radius: var(--radius-frame);
  }

  .h2gate__doc::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    block-size: 1px;
    background-image: var(--grad-rule);
    -webkit-mask-image: linear-gradient(90deg, transparent, rgb(0 0 0) 30%, rgb(0 0 0) 70%, transparent);
    mask-image: linear-gradient(90deg, transparent, rgb(0 0 0) 30%, rgb(0 0 0) 70%, transparent);
  }

  .h2gate__doc-label {
    margin: 0 0 var(--stack-1);
    letter-spacing: 0.1em;
    color: var(--c-text-muted);
  }

  .h2gate__doc-line {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text);
  }

  .h2gate__fig {
    display: inline-block;
    margin-inline: 0.25em;
    padding-inline: 0.3em;
    border-radius: var(--radius-chip);
    background-color: color-mix(in srgb, var(--c-refused) 16%, transparent);
    color: var(--c-refused);
    text-decoration-color: var(--c-refused);
    text-decoration-thickness: 2px;
  }

  .h2gate__why {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding-block-start: var(--space-4);
    border-block-start: 1px dashed var(--c-border);
    font-family: var(--font-body);
    font-size: var(--t-caption);
    line-height: 1.5;
    color: var(--c-text-sub);
  }

  .h2gate__stamp {
    background-color: var(--c-refused);
    color: var(--c-bg);
  }

  /* ── THE STAMP LANDS. Rest is stamped; this is a pulse back to rest ────── */
  @media (prefers-reduced-motion: no-preference) {
    .h2pf__gate[data-lit='on'] .h2gate__stamp {
      animation: h2gate-stamp calc(var(--m-beat) * 0.8) var(--m-ease-land) calc(var(--m-beat) / 2) 1;
    }

    .h2pf__gate[data-lit='on'] .h2gate__fig {
      animation: h2gate-strike calc(var(--m-beat) / 2) var(--m-ease-land) calc(var(--m-beat) * 0.9) 1;
    }
  }

  /* Starts and ends at identity. Lands from above with a slight overshoot. */
  @keyframes h2gate-stamp {
    0%   { transform: scale(1) translateY(0); }
    30%  { transform: scale(1.18) translateY(-3px); }
    100% { transform: scale(1) translateY(0); }
  }

  /* Light only: the highlight behind the figure flares and returns. */
  @keyframes h2gate-strike {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-refused) 0%, transparent); }
    50%  { box-shadow: 0 0 0 5px color-mix(in srgb, var(--c-refused) 22%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-refused) 0%, transparent); }
  }
</style>
