---
/**
 * /resources — the hub page.
 *
 * SEO carried over verbatim.
 *
 * TWO CONTENT REPAIRS ARE CARRIED FORWARD, not reintroduced. The live page (now
 * fixed) listed "National TOMs, National TOMs" and had a methodology description
 * beginning mid-clause in lower case. Both were collateral from the Oxford
 * Social Value Bank remediation, whose find/replace ran over text that already
 * said "National TOMs". The corrected strings are used here.
 *
 * The "Intel trackers" section exists on the legacy page only as an HTML comment
 * (removed 2026-07-28) and is deliberately NOT ported.
 *
 * NOTHING ON THIS PAGE IS GATED, and the page says so before the click — twice.
 * That is a promise to keep: if a resource ever moves behind an email capture,
 * the "No account, no email gate, no credit card" line has to change with it.
 */
import Base from '../layouts/Base.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';
import { breadcrumbs } from '../lib/schema';

const title = 'Resources | CrowAgent';
const description =
  'A statute-cited PPN 002 social value calculator, in-depth briefings on UK public-sector bidding, and a plain-English glossary.';

const schema = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources' },
  ]),
];
---

<Base title={title} description={description} path="/resources" schema={schema}>
  <Section
    as="h1"
    eyebrow="Hub"
    title="The rules, explained for UK teams."
    standfirst="A statute-cited PPN 002 social value calculator, in-depth briefings on UK public-sector bidding, and a plain-English glossary, built around CrowMark for Suppliers."
    id="resources-hero"
  >
    <div class="row">
      <Button href="/tools/ppn-002-calculator">Run the free calculator</Button>
      <Button href="/blog" variant="secondary">Read the latest briefing</Button>
    </div>
  </Section>

  <Section
    eyebrow="Free tool"
    title="Free PPN 002 calculator"
    standfirst="Runs the same regulatory engine CrowMark uses internally. No account, no email gate, no credit card. Use it, share the result, then request access if you want the full audit trail."
    id="tools"
  >
    <article class="card card--accent">
      <h3 class="card__h">
        <a href="/tools/ppn-002-calculator">PPN 002 Social Value Calculator</a>
      </h3>
      <p class="card__body">
        Deterministic mission mapping with National TOMs 2023-24 proxy values. Enter a
        contract value and see the 10% minimum social-value weighting.
      </p>
      <p class="card__cta"><a href="/tools/ppn-002-calculator">Open tool</a></p>
    </article>
    <div class="more"><Button href="/tools" variant="secondary">View all tools</Button></div>
  </Section>

  <Section
    eyebrow="Guides"
    title="In-depth guides"
    standfirst="Long-form analysis written in-house. Each article cites the policy note, Act or section it rests on, not somebody else's summary of it."
    id="guides"
  >
    {/*
      The legacy version wrapped the whole card in a single <a>, which makes the
      accessible name the entire card text — capsule, heading, standfirst and
      meta line read out as one string. Here the LINK is the heading and the
      card is a container, so the accessible name is the article title.
    */}
    <article class="card">
      <p class="capsule">PPN 002</p>
      <h3 class="card__h">
        <a href="/blog/ppn-002-social-value-guide">
          PPN 002 Social Value: How the 10% Weighting Works
        </a>
      </h3>
      <p class="card__body">
        A minimum 10% social value weighting now applies to in-scope central government
        contracts. How the National TOMs measures and National TOMs proxies turn into a
        defensible, bid-ready score.
      </p>
      <p class="card__meta">7 min read · March 2026</p>
    </article>
    <div class="more"><Button href="/blog" variant="secondary">View all articles</Button></div>
  </Section>

  <Section
    eyebrow="Methodology"
    title="How our calculator works"
    standfirst="Our free calculator ships with a public methodology page so the maths is verifiable. No black box."
    id="methodology"
  >
    <article class="card card--accent">
      <h3 class="card__h">
        <a href="/tools/ppn-002-calculator/methodology">PPN 002 Calculator</a>
      </h3>
      {/* Sentence case, not the mid-clause fragment the live page carried. */}
      <p class="card__body">
        Mission mapping logic, National TOMs 2023-24 proxy-value sourcing, and the 10%
        minimum weighting.
      </p>
      <p class="card__cta">
        <a href="/tools/ppn-002-calculator/methodology">Read methodology</a>
      </p>
    </article>
  </Section>

  <Section
    eyebrow="Glossary"
    title="Glossary of procurement terms"
    standfirst="Plain-English definitions of the regulations, frameworks and acronyms that come up in UK public-sector bidding."
    id="glossary"
  >
    {/*
      The legacy glossary block is a single bounded panel, wider than the
      resource cards and carrying a teal top accent, with the examples and the
      action inside it rather than loose on the page. Reproduced here as a
      panel around the BODY only: the eyebrow and heading stay in the Section
      head, where the owner's centred-head decision governs them.

      "National TOMs" listed ONCE. The live page listed it twice.
    */}
    <div class="card card--wide card--centred">
      <p class="examples">PPN 002, PPN 06/20, National TOMs, and more.</p>
      <div class="more"><Button href="/glossary">Browse the glossary</Button></div>
    </div>
  </Section>

  <Section
    title="Start with the workflow you need now."
    standfirst="CrowMark: find UK public-sector tenders, draft grounded social-value answers, and prove delivery, all in one workspace."
    id="resources-cta"
  >
    <div class="row">
      <Button href="/contact?enquiry=limited-access#contact-form">Request access</Button>
      <Button href="/pricing" variant="secondary">View all pricing</Button>
    </div>
    <p class="compare">
      Weighing up your options?{' '}
      <a href="/compare">
        See how CrowMark compares to AutogenAI, mytender.io, CleanTender and SwiftBid
      </a>.
    </p>
    <p class="legal">CrowAgent Ltd, Companies House No. 17076461</p>
  </Section>
</Base>

<style>
  /* Centred on the same axis as the head block above it (owner decision,
     2026-08-02), which is also what the legacy page does with every action row
     on this page. Alignment only. */
  .row { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }

  /*
   * THE CARD IS CENTRED AND NARROWER THAN THE MEASURE, which is the single
   * biggest thing this page had wrong. Every section head is centred and every
   * card sat flush against the left gutter of a 1160px measure, so the page
   * read as two layouts stacked on each other.
   *
   * The legacy page puts each of these cards in a `max-w-xl mx-auto` wrapper —
   * one narrow column, centred, for what is a single card rather than a grid
   * row. Width is expressed as a fraction of --measure rather than the 720px
   * that used to be hardcoded here, so there is still exactly one number on
   * this page that decides how wide anything is, and it lives in tokens.css.
   * Half the measure lands at 580px against the legacy 576px.
   */
  .card {
    max-width: min(100%, calc(var(--measure) / 2));
    margin-inline: auto;
    padding: var(--blk-pad);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-card);
    background: var(--c-card);
    /* The glass recipe the token file defines and this page was not using.
       It is what makes a card read as a lit surface rather than an outline. */
    box-shadow: var(--shadow-card);
  }

  /* The legacy tool and methodology cards carry a teal left accent that marks
     them as an action rather than an article. The colour is a token; only the
     rule weight is literal, as it is for every other border in this codebase. */
  .card--accent { border-left: 3px solid var(--c-teal); }

  /* The glossary panel is deliberately the wider of the two card widths on the
     legacy page (max-w-4xl against max-w-xl) and turns its accent to the top
     edge. Same fraction-of-measure treatment, at 893px against the legacy 896. */
  .card--wide {
    max-width: min(100%, calc(var(--measure) * 0.77));
    border-top: 3px solid var(--c-teal);
  }

  .card--centred { text-align: center; }

  .capsule {
    display: inline-block;
    margin: 0 0 var(--stack-1);
    padding: 3px 10px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  .card__h {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 700;
    line-height: 1.35;
  }

  .card__h a {
    color: var(--c-text);
    text-decoration: none;
  }

  .card__h a:hover { color: var(--c-teal); }

  .card__h a:focus-visible {
    outline: 3px solid var(--c-teal);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .card__body {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text-sub);
  }

  .card__cta { margin: 0; }

  /* The article card closes on a RULED FOOTER ROW on the legacy page, which is
     what separates the read-time from the body copy above it. It was rendering
     here as one more line of text in the stack. */
  .card__meta {
    margin: var(--stack-2) 0 0;
    padding-top: var(--stack-2);
    border-top: 1px solid var(--c-border);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  /* The in-card action is a small uppercase link on the legacy page, which is
     what keeps it distinct from the section-level button below the card. */
  .card__cta a {
    /* inline-flex + --btn-h-sm, not a bare inline link: at --t-micro the text
       box is 15px tall, and this is a standalone action in its own row rather
       than a link inside a sentence, so the WCAG 2.5.8 inline exception does
       not cover it. --btn-h-sm IS the 44px floor. */
    display: inline-flex;
    align-items: center;
    min-height: var(--btn-h-sm);
    color: var(--c-teal);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .card__cta a:hover { text-decoration: underline; text-underline-offset: 0.3em; }

  .compare a {
    color: var(--c-teal);
    font-family: var(--font-body);
    font-size: var(--t-body);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .card__cta a:focus-visible,
  .compare a:focus-visible {
    outline: 3px solid var(--c-teal);
    outline-offset: 3px;
  }

  /*
   * "View all tools" / "View all articles" are BUTTONS on the legacy page, sat
   * centred under the card, not inline text links flush against the left
   * gutter. They are the section's exit, so they carry a control's weight and
   * a control's 44px target, which an underlined run of text does not.
   */
  .more {
    display: flex;
    justify-content: center;
    margin: var(--sec-gap) 0 0;
  }

  /* Inside the glossary panel the action closes the panel rather than the
     section, so it sits on the tighter of the two stack gaps. */
  .card .more { margin-top: var(--stack-2); }

  .examples {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-lede);
    font-style: italic;
    color: var(--c-text-sub);
  }

  .compare {
    margin: var(--sec-gap) auto 0;
    max-width: 68ch;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    text-align: center;
    color: var(--c-text-sub);
  }

  .legal {
    margin: var(--stack-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-align: center;
    color: var(--c-text-muted);
  }
</style>
