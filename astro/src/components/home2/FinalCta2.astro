---
/**
 * HOME 2.0: THE CLOSING PANEL.
 *
 * One gradient panel, one heading, one lede and two pills.
 *
 * ── THE GRADIENT IS DARKENED, AND IT IS DARKENED FOR CONTRAST ──────────────
 *
 * The board draws violet-deep to panel to teal-dark. Computed against white
 * before it was typed: --c-violet-deep clears 5.70:1 and --c-teal-dark clears
 * only 2.09:1, so the right hand third of the board's panel puts every word on
 * it below the 4.5:1 this page has to hold. Both ends are therefore mixed down
 * into --c-floor, which keeps the hue and the direction of the board and lifts
 * the ratios to about 8.0:1 at the violet end and about 10.6:1 at the teal end.
 * The mid stop is --c-panel unchanged.
 *
 * This is a colour correction rather than a design change, and it is exactly
 * the kind tokens.css already records for --c-teal: that token is a dark-ground
 * colour, it clears 7.7:1 on --c-bg and it fails outright on anything light.
 *
 * ── THE TWO PILLS ARE THE PAGE'S ONLY TWO OFFERS ───────────────────────────
 *
 * Request access, or read a tender free. Both are stated once at the top of the
 * page and once here, which is the arrangement R262-WEB-03 settled for the live
 * homepage after it was found to be carrying four competing calls to action.
 * There is no third.
 */
import Button from '../ui/Button.astro';
---

<section class="h2cta" aria-labelledby="h2cta-title">
  <div class="h2cta__panel">
    <h2 class="h2cta__title" id="h2cta-title">See it on your own tender.</h2>

    <p class="h2cta__lede">
      Bring a live notice and we will show you what it refuses. Access is limited
      and by request.
    </p>

    <div class="h2cta__row">
      <Button href="/contact/?enquiry=limited-access#contact-form">Request access</Button>
      <Button href="/tools/tender-compliance-matrix/" variant="secondary">Read a tender, free</Button>
    </div>

    <p class="h2cta__note">
      There is no free plan and no self-serve signup. A 14-day evaluation trial
      is available on request.
    </p>
  </div>
</section>

<style>
  .h2cta {
    padding-block: var(--sec-pad-y);
  }

  .h2cta__panel {
    max-width: var(--measure);
    margin-inline: auto;
    padding: clamp(32px, 6vw, 72px) var(--gutter);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-panel);
    background-image: linear-gradient(
      110deg,
      color-mix(in srgb, var(--c-violet-deep) 78%, var(--c-floor)) 0%,
      var(--c-panel) 52%,
      color-mix(in srgb, var(--c-teal-dark) 34%, var(--c-floor)) 100%
    );
    box-shadow: var(--shadow-panel);
    text-align: center;
  }

  .h2cta__title {
    margin: 0;
    margin-inline: auto;
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--c-text);
    max-width: 15.5em;
  }

  .h2cta__lede {
    margin: var(--stack-2) auto 0;
    font-family: var(--font-body);
    font-size: var(--t-lede);
    line-height: 1.6;
    color: var(--c-text-sub);
    max-width: 40ch;
  }

  .h2cta__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
  }

  .h2cta__note {
    margin: var(--space-6) auto 0;
    font-family: var(--font-body);
    font-size: var(--t-caption);
    line-height: 1.55;
    color: var(--c-text-muted);
    max-width: 52ch;
  }
</style>
