---
/**
 * Carousel — the product showcase, restored.
 *
 * Owner instruction, 2026-08-03: the showcase carousel that shipped on the live
 * product pages before 26 July is absent from the rebuild, and it should come
 * back on the product pages showing what CrowMark does. The legacy source is
 * `js/modules/product-carousel-2026-05-26.js` and its stylesheet at commit
 * `46b6af55`, and everything it did for a reader is kept: a browser-chrome
 * device frame, a crossfade between captures, dot tabs that show how long is
 * left on the current slide, arrows, captions, swipe, arrow keys, pause on
 * hover and focus, and a live region so the change is announced.
 *
 * ── THE CLOCK IS THE RING, AND THAT IS THE WHOLE REDESIGN ───────────────────
 *
 * The legacy version ran a `requestAnimationFrame` loop for the entire life of
 * the page. Every frame it added a delta to a counter, compared it against a
 * 5200ms interval, wrote a `stroke-dashoffset` on each of the dot rings, and
 * advanced when the counter overflowed. Two clocks — the rAF counter and the
 * reader's sense of the animation — kept in step by arithmetic that had to be
 * right every frame.
 *
 * Here the ring is a CSS animation whose duration IS the interval, and the
 * slide advances on its `animationend`. There is one clock. The ring cannot
 * disagree with the timer about how much time is left, because it is the timer.
 * That removes the rAF loop, the delta arithmetic, the per-frame DOM writes and
 * the `injectRings()` innerHTML pass, and it buys three things for free:
 *
 *   PAUSE IS ONE CSS LINE. `:hover` and `:focus-within` set
 *   `animation-play-state: paused`, which stops the ring and the advance
 *   together because they are one object. The legacy version had four
 *   listeners and a `paused` flag to keep those two in sync.
 *
 *   A BACKGROUND TAB COSTS NOTHING. Browsers throttle CSS animations in hidden
 *   tabs, so the carousel stops on its own. The rAF loop had the same property
 *   and paid for it with a listener; this pays nothing.
 *
 *   REDUCED MOTION IS STRUCTURAL. The animation is declared inside
 *   `prefers-reduced-motion: no-preference`. A reader who asked for stillness
 *   gets no ring, and therefore no `animationend`, and therefore no autoplay —
 *   from the same declaration, rather than from a second code path that can
 *   drift from the first. The controls still work; nothing moves on its own.
 *
 * ── WHAT IT DELIBERATELY DOES NOT DO ────────────────────────────────────────
 *
 * NO IntersectionObserver. check-motion.js rule 3 fails the build on one
 * anywhere under src/, and its allow-list already carries four entries it is
 * trying to shrink rather than grow. The legacy carousel used one to stop
 * advancing off-screen, and that behaviour is kept ANOTHER way: the root
 * carries `data-lit`, so the autoplay rule only matches once the shared trigger
 * has marked the block as seen. Both product pages already run that trigger, so
 * this reuses the observer the site already has instead of adding a fifth.
 *
 * The honest limit: `data-lit` is set once and never unset, so scrolling PAST a
 * carousel does not re-pause it. What it does buy is the half that matters —
 * a reader arriving at the section sees slide 1, not slide 4.
 *
 * NO REVEAL. Slide 1 carries `is-active` in the markup and its caption is
 * server-rendered, so with no JavaScript the frame shows a complete captioned
 * screenshot. Only the CONTROLS are held back until the script marks the root
 * `data-pcar="on"`, because a dot that cannot be pressed is worse than no dot.
 * Nothing a reader needs is behind the script.
 *
 * ── THE SCREENS ─────────────────────────────────────────────────────────────
 *
 * These are PURPOSE-DRAWN screens, not captures of a running product and not a
 * customer's account. Sixteen were drawn in Figma on 2026-08-03 and approved by
 * the owner, eight supplier and eight buyer, and they are what the two CrowMark
 * product pages have shown since 2026-08-04. The full node table and the
 * research behind the artwork are in specs/PRODUCT-SCREENS-FIGMA.md.
 *
 * THIS IS NOT ALL OF OA-34. That defect is eleven product captures still
 * shipping across the site, and the two carousels are two of the places they
 * shipped. /compare, /sectors and the rest still reference Assets/shots/, and
 * closing the rest of it is a separate pass.
 *
 * TWO THINGS THE CAPTIONS AND ALT TEXT MAY NOT SAY, and they pull in opposite
 * directions, which is why both are written down here:
 *
 *   Nothing may claim these are the live product, a live account, a customer or
 *   a client. That is OA-16 and it is a truthfulness rule.
 *
 *   Nothing may label them "illustrative" or "sample data" INLINE either. The
 *   owner's decision of 2026-08-03 is that the site calls the data question out
 *   separately, and saying it twice weakens both. The chrome bar used to carry
 *   a "Sample data" chip for exactly that reason and it has been removed.
 *
 * What is left is the only thing that was ever needed: describe what the screen
 * SHOWS, factually.
 *
 * ── SLIDES OF DIFFERENT SHAPES, ON ONE STAGE ────────────────────────────────
 *
 * The sixteen screens are drawn at three device sizes — 1440x900 desktop,
 * 1024x768 tablet, 390x844 mobile — so a set now spans aspect ratios from 1.60
 * down to 0.46. A single fixed frame with `object-fit: cover` would crop a
 * different amount off every one of them, and what it crops off a picture of an
 * interface is the interface. See `.pcar__screen` below for how each slide is
 * given its own true proportions inside one stage that never changes height.
 */
export interface Slide {
  /**
   * The PNG path under /Assets, with its cache-busting query. AVIF and WebP
   * siblings are derived from it — see `sources()` below. copy-assets.js fails
   * the build if any of the three does not exist, which is what makes deriving
   * them safe rather than hopeful.
   */
  src: string;
  /** What the image SHOWS. Never a claim, never a customer, never live data. */
  alt: string;
  /** The line under the frame. One sentence, sentence case, no trailing stop. */
  caption: string;
  /** Intrinsic pixel size, so the frame reserves its box and nothing shifts. */
  width: number;
  height: number;
}

interface Props {
  slides: Slide[];
  /** The path shown in the chrome bar, after the host. */
  path?: string;
  /** Accessible name for the carousel region. */
  label?: string;
  /**
   * ABOVE THE FOLD, AND IT DEFAULTS TO FALSE ON PURPOSE (A-93).
   *
   * Slide 1 used to be `loading="eager"` unconditionally, on the reasoning that
   * "slide 1 is on screen as soon as the section is". That reasoning was never
   * checked against where the section actually sits. Measured on :8095,
   * 2026-08-04: the first slide's document offset is 5,905px at 1440 and 8,596px
   * at 390 on /crowmark, and 7,726px / 10,659px on /crowmark-buyers — six to ten
   * screens down — and it was the largest single asset on both routes. So it was
   * being fetched at the highest priority the loader has, in competition with
   * the LCP element of a page the reader had not begun to scroll.
   *
   * The name and the semantics are `PostImage.astro`'s `priority`, deliberately:
   * one word means one thing on this site.
   */
  priority?: boolean;
  /**
   * The widest this carousel's stage ever renders, in CSS pixels, at viewports
   * of 1063px and up. It feeds the first arm of `sizes`, so getting it wrong
   * makes the browser fetch the wrong candidate.
   *
   * OMIT IT unless the call site is NOT measure-capped. The default is the
   * measure-capped width, which is what /crowmark and /crowmark-buyers are. The
   * homepage product showcase is not: it renders this inside a 7fr grid column
   * and comes out at 653px, so it passes its own figure. See the long note
   * above STAGE_MAX_DEFAULT for the measurement.
   */
  stageMaxPx?: number;
  class?: string;
}

const {
  slides,
  path = 'mark',
  label = 'CrowMark product screens',
  priority = false,
  stageMaxPx,
  class: className = '',
} = Astro.props;

/* 2 * PI * 13, the radius the ring circle is drawn at. Written out rather than
   computed in CSS so the dash array in the markup and the keyframe in the
   stylesheet cannot drift apart. */
const CIRC = 81.681;

/*
 * One derivative path, from the PNG path. `variant(src, 'avif', 800)` turns
 * `/Assets/shots/figma-v2/sup-1-discover.png?v=x` into
 * `/Assets/shots/figma-v2/sup-1-discover-800w.avif?v=x`, and a null width gives
 * the master. The cache-busting query is carried through rather than dropped:
 * every rung of a screen has to move together when the screen is re-exported.
 *
 * WHY THIS IS NOT OPTIONAL HERE. Measured on the four screens this component
 * carries on /crowmark: 685 KB as PNG, 214 KB as AVIF. That is 471 KB on one
 * route, against a documented per-route image budget of 1,200 KB in
 * specs/architecture/PERFORMANCE-BUDGETS.md which also records that images are
 * 58% of the whole build and that the largest files on the site are these
 * product screenshots. A showcase is the one component that can put four of
 * them on a single page, so it is the one component that must not ship PNGs.
 *
 * DERIVED RATHER THAN DECLARED, so a call site cannot list a PNG and forget the
 * other two. The three-file set already exists for every capture in
 * Assets/shots/dark, and copy-assets.js fails the build on a missing reference,
 * so a derived path that does not exist stops the build rather than 404ing for
 * a reader. That is the same contract the sitemap generator uses.
 */
const variant = (src: string, ext: 'avif' | 'webp', width: number | null) =>
  src.replace(/\.png(\?|$)/, `${width === null ? '' : `-${width}w`}.${ext}$1`);

/*
 * ── RESOLUTION, NOT ONLY FORMAT (A-93) ──────────────────────────────────────
 *
 * Until 2026-08-04 the two `<source>` elements below carried a bare `srcset`
 * with one candidate each, so this component negotiated FORMAT and never
 * RESOLUTION. Measured on the build at :8095: /crowmark fetched 548,979 B of
 * images at a 390 viewport, byte-identical to 1440, and /crowmark-buyers
 * 509,624 B likewise. `sup-1-discover` is 2880x1800 on disk and paints into 348
 * CSS px on a phone — 8.3x linear, about 69x the pixels.
 *
 * The ladder and the `sizes` below are the same mechanism `PostImage.astro`
 * already runs for the blog heroes, which is why /blog falls from 107,444 B at
 * 1440 to 51,801 B at 390. Nothing new was invented for this; the files are
 * written by `scripts/build-product-screens.mjs`, which is
 * `scripts/build-blog-photos.mjs` pointed at the product screens.
 *
 * IT IS PostImage'S FOUR WIDTHS, DELIBERATELY, and it is declared in both places
 * and must change in both. Same contract and same reason: adding a rung means
 * adding the file first. `scripts/copy-assets.js` reads srcset and fails the
 * build on a reference that does not exist, so the mistake stops a build rather
 * than reaching a reader.
 *
 * 0.7 IS MEASURED, NOT CHOSEN. These are 2x renders of flat UI panels, so a
 * master is mostly large uniform regions that AVIF encodes almost for nothing,
 * and resampling to a NEARBY width replaces every crisp edge with interpolated
 * grey that the encoder then has to pay for. Measured: a 1600w rung of the
 * 2048w tablet masters lands at 61,041 B against a 59,790 B master, and a 600w
 * rung of the 780w phone masters at 30,491 B against 29,689 B. A srcset whose
 * candidates are not monotonic in bytes can only pessimise, because the browser
 * picks by width. `build-product-screens.mjs` FAILS if any rung it keeps is not
 * in fact smaller than its master. So the phone screens get one rung, the
 * tablet and desktop screens four, and above that the master IS the candidate.
 *
 * ── ONLY THE AVIF SOURCE HAS A LADDER, AND THE BUDGET FILE ASKED FOR THAT ───
 *
 * The WebP source below still carries the single master candidate it has always
 * carried, so a browser that reads WebP and not AVIF is served exactly what it
 * is served today: nothing is retired and nothing is deleted. What is declined
 * is EXTENDING that tier. `scripts/check-budgets.js` records, beside the
 * `wholeBuild` budget, that the WebP tier of these sixteen screens is larger
 * than the PNG tier on all 16 of 16 files and is "the first place to look when
 * this budget next binds" — and it bound: a WebP ladder took the build from
 * 12,541 KB to 17,831 KB against a 14,336 KB budget, 55% of the growth being
 * WebP nobody would fetch.
 */
const LADDER = [400, 600, 800, 1200] as const;
const MAX_OF_MASTER = 0.7;
const rungsFor = (masterWidth: number) => LADDER.filter((w) => w <= masterWidth * MAX_OF_MASTER);

const avifSrcset = (s: Slide) =>
  [
    ...rungsFor(s.width).map((w) => `${variant(s.src, 'avif', w)} ${w}w`),
    `${variant(s.src, 'avif', null)} ${s.width}w`,
  ].join(', ');

/*
 * THE STAGE RATIO, AND WHY A SLIDE IS EITHER FULL-BLEED OR INSET.
 *
 * 16/10 rather than the 2/1 this component shipped with. The drawn desktop
 * screens are 1440x900, which IS 16/10 exactly, so the four screens that carry
 * the argument fill the frame edge to edge with nothing cropped and nothing
 * letterboxed. The stage height is then fixed for the life of the carousel,
 * which is what stops the page reflowing under the reader every 5.2 seconds.
 *
 * A slide whose own ratio differs from the stage is INSET instead: it is given
 * its true proportions, full stage height, centred, with the stage colour
 * either side. Tablet screens (4/3) land at 83% of the stage width and phone
 * screens (390/844) at 29%, which reads as a device standing on a stage rather
 * than as a picture that failed to fill its box — so an inset slide gets a
 * hairline and a radius of its own, and a full-bleed one does not, because on a
 * full-bleed slide that ring would sit a pixel inside the frame's own border
 * and read as a double line.
 *
 * The tolerance is 0.02 because 1440/900 and 2360/1180 are 1.600 and 2.000: it
 * has to be tight enough to tell a desktop screen from a wide capture, and
 * loose enough that a screen drawn one pixel off is not treated as a phone.
 */
const STAGE_RATIO = 16 / 10;
const isFullBleed = (s: Slide) => Math.abs(s.width / s.height - STAGE_RATIO) < 0.02;

/*
 * ── `sizes`, DERIVED FROM THE STAGE RATHER THAN GUESSED ─────────────────────
 *
 * A `srcset` without a correct `sizes` is a slower way of downloading the wrong
 * file: the browser assumes 100vw and picks accordingly. So the width of the
 * stage is written down here, and it was MEASURED on :8095 across sixteen
 * viewport widths from 320 to 1920 rather than read off the stylesheet:
 *
 *   vw >= 1063        964.7px   capped by --measure-mid on `.pcar`
 *   400 <= vw < 1063  90vw - 2  the gutter is 5vw through that whole range
 *   vw < 400          100vw-42  the gutter has bottomed out at its 20px floor
 *
 * The three constants below are `--gutter`'s own `clamp(20px, 5vw, 48px)` read
 * back out: the 5vw arm gives 100vw - 10vw, the 20px floor gives 100vw - 40px,
 * and the 2px in both is the frame's two 1px borders. They are stated as
 * measurements because that is what makes them falsifiable — re-measure and
 * they either still hold or this comment is wrong.
 *
 * A SLIDE IS NOT THE STAGE. `.pcar__screen` is `height: 100%` with the slide's
 * own aspect-ratio, so its width is `stage * (ratio / STAGE_RATIO)`, capped at
 * the stage by `max-width: 100%`. Desktop screens come out at 1.0 of the stage,
 * tablet at 0.833 and phone at 0.289 — which is where the numbers in the
 * `.pcar__screen` note above come from. Deriving the fraction from each slide's
 * own ratio, rather than writing three classes, keeps this component ignorant of
 * the list of device sizes, which is the call site's business.
 */
/*
 * ── STAGE_MAX IS A DEFAULT NOW, NOT A CONSTANT, AND IT WAS WRONG TWICE ──────
 *
 * 964.7 was measured when this component had exactly one call site and the page
 * measure was 1160px, so `--measure-mid` (5/6 of it) came out at ~966. Two
 * things have happened since. The measure moved to the concept's 1280px, which
 * makes --measure-mid 1066.67. And the homepage product showcase now renders
 * this carousel inside a 7fr column of a 12-track stage grid, where it is not
 * governed by --measure-mid at all.
 *
 * MEASURED ON THE BUILT PAGE rather than argued: at a 1440 viewport the
 * homepage frame renders 653px wide while `sizes` was declaring 965px, so the
 * browser fetched the 1200w candidate and decoded 964px for a 653px slot, a
 * 1.48x oversample. At 834 and 390 the other two arms already land at 1.02x and
 * 1.14x, which is why this only bites at desktop.
 *
 * A SINGLE MODULE CONSTANT CANNOT BE RIGHT FOR BOTH CALL SITES, which is the
 * real defect: /crowmark's carousel genuinely is measure-capped and the
 * homepage's genuinely is a grid column. The width a component renders at is
 * the CALL SITE'S business, exactly as the note above says the list of device
 * sizes is, so it becomes a prop with the old value as the default. A call site
 * that passes nothing behaves exactly as it did.
 *
 * NOTE THIS DOES NOT FIX LEGIBILITY, and nobody should expect it to. Board item
 * A-115 reports the product screens as unreadable, and the cause is NOT
 * resolution: at 1.48x the asset is already over-supplied for its slot, and a
 * 2x asset would sharpen it on a HiDPI panel without making a single glyph
 * bigger. A full desktop application UI drawn at 2880px and shown at 653px puts
 * its type at roughly 22 per cent of design size. Only cropping each screen to
 * the one detail its caption names changes that. This change is about bytes.
 */
const STAGE_MAX_DEFAULT = 964.7;
const STAGE_MAX = stageMaxPx ?? STAGE_MAX_DEFAULT;
const sizesFor = (s: Slide) => {
  const f = Math.min(1, s.width / s.height / STAGE_RATIO);
  const n = (v: number) => Number(v.toFixed(2));
  return [
    `(min-width: 1063px) ${Math.round(STAGE_MAX * f)}px`,
    `(min-width: 400px) calc(${n(90 * f)}vw - ${n(2 * f)}px)`,
    `calc(${n(100 * f)}vw - ${n(42 * f)}px)`,
  ].join(', ');
};
---

<div
  class:list={['pcar', className]}
  data-pcar
  data-lit
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
>
  <div class="pcar__frame">
    {/* The browser chrome. Decoration apart from the address, which is the real
        address of the product these screens are drawn from, so the traffic
        lights are hidden from assistive tech and the address is not. It stays
        outside the slides because it is true of every one of them: a phone
        screen of a web application is that application at that address, viewed
        narrow. */}
    <div class="pcar__chrome">
      <span class="pcar__lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="pcar__url">app.crowagent.ai<span class="pcar__url-path">/{path}</span></span>
    </div>

    <div class="pcar__viewport">
      {
        slides.map((s, i) => (
          <figure class:list={['pcar__slide', i === 0 && 'is-active']} aria-hidden={i === 0 ? 'false' : 'true'}>
            {/* The screen's own proportions, carried as a custom property so
                one CSS rule serves every device size. See STAGE_RATIO above. */}
            <div
              class:list={['pcar__screen', !isFullBleed(s) && 'pcar__screen--inset']}
              style={`--screen-ratio: ${s.width} / ${s.height}`}
            >
              <picture>
                <source type="image/avif" srcset={avifSrcset(s)} sizes={sizesFor(s)} />
                {/* No `sizes` here, and its absence is the honest signal: this
                    source offers ONE candidate, so a sizes hint would have
                    nothing to choose between. See the ladder note above. */}
                <source type="image/webp" srcset={variant(s.src, 'webp', null)} />
                {/* The PNG is the fallback for a browser that reads neither
                    modern format, and it stays at the master resolution with no
                    srcset of its own — there are no PNG rungs on disk, and
                    PostImage.astro's JPEG fallback works the same way.

                    EAGER ONLY WHEN THE CALLER SAYS SO. See the `priority` prop:
                    both carousels on this site sit six to ten screens down, and
                    slide 1 was the largest asset on its route while being
                    fetched at the highest priority the loader has. The rest are
                    behind a control or a 5.2s wait and have never competed. */}
                <img
                  src={s.src}
                  alt={s.alt}
                  width={s.width}
                  height={s.height}
                  decoding="async"
                  loading={priority && i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={priority && i === 0 ? 'high' : undefined}
                />
              </picture>
            </div>
          </figure>
        ))
      }
      {/* The screen glare. Purely optical, so it is hidden and cannot be hit. */}
      <span class="pcar__glare" aria-hidden="true" />
    </div>
  </div>

  <div class="pcar__foot">
    <button class="control pcar__arrow" data-pcar-prev type="button" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    {/* Server-rendered for slide 1, so the frame is captioned without JS. */}
    <p class="pcar__caption" data-pcar-caption>{slides[0]?.caption}</p>

    <div class="pcar__tabs" role="tablist" aria-label="Choose a screen">
      {
        /*
         * `tabindex` below is the server-rendered half of the roving tabindex,
         * so the dot row is ONE tab stop from first paint rather than from
         * whenever the script upgrades it. show() maintains it after that.
         *
         * The comment sits here, in the map body, and not between the
         * attributes: a {/* *\/} block inside an attribute list does not parse
         * as a comment, it parses as an expression, and it silently swallowed
         * the following six attributes into it. Astro reported the symptom as
         * six "Cannot find name" errors on the NEXT button in the file.
         */
        slides.map((s, i) => (
          <button
            class="pcar__tab"
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            aria-label={`Screen ${i + 1} of ${slides.length}: ${s.caption}`}
          >
            {/* The ring is markup, not innerHTML written at runtime. It is
                therefore correct before any script has run, and correct if none
                ever does. */}
            <svg class="pcar__ring" viewBox="0 0 28 28" aria-hidden="true">
              <circle class="pcar__ring-bg" cx="14" cy="14" r="13" fill="none" stroke-width="1.5" />
              <circle
                class="pcar__ring-progress"
                cx="14"
                cy="14"
                r="13"
                fill="none"
                stroke-width="1.5"
                stroke-dasharray={CIRC}
                stroke-dashoffset={CIRC}
                transform="rotate(-90 14 14)"
              />
            </svg>
          </button>
        ))
      }
    </div>

    <button class="control pcar__arrow" data-pcar-next type="button" aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    {/*
      ── A REAL PAUSE CONTROL, AND WHY HOVER WAS NEVER ENOUGH ──────────────────

      WCAG 2.2.2 is Level A and asks for "a mechanism for the user to pause,
      stop, or hide" anything that moves automatically for more than five
      seconds. This carousel advances every 5.2 seconds.

      Hover and focus-within pause it, and until 2026-08-05 even that did not
      work (see the play-state note in the stylesheet). But neither is a
      MECHANISM in the sense the criterion means: a touch reader has no hover,
      and focus-within only pauses while a control inside happens to hold the
      caret, so it resumes the moment they tab away. The sibling TabSwitcher
      already renders exactly this button for exactly this reason.

      Rendered `hidden` and revealed by the script only once the carousel is
      genuinely autoplaying, so a reader with JavaScript off, or with reduced
      motion set, or looking at a single-slide frame, never receives a control
      for something that is not moving.
    */}
    <button class="control pcar__pause" data-pcar-pause type="button" hidden aria-pressed="false">
      <span class="pcar__pause-icon" aria-hidden="true"></span>
      <span class="visually-hidden" data-pcar-pause-label>Pause the slideshow</span>
    </button>
  </div>

  <p class="visually-hidden" data-pcar-live aria-live="polite"></p>
</div>

<style>
  .pcar {
    /* Live's 5200ms, kept. Long enough to read a caption and look at the
       screen behind it; the ring makes the wait legible rather than a
       surprise. */
    --pcar-interval: 5200ms;
    --pcar-circ: 81.681;
    max-width: var(--measure-mid);
    margin-inline: auto;
    /* A-81. At a 320px viewport the caption inside this carousel measured
       338.3px wide, left -9.2, right 329.2 — 18px wider than the viewport,
       centred, so the document scrolled sideways by 9px on /crowmark and
       /crowmark-buyers. That is WCAG 1.4.10 (Reflow), which states 320px.
       CLIP, NOT HIDDEN, and the distinction is the whole reason this is safe:
       `overflow-x: clip` does not create a scroll container, so it cannot trap
       the page's scroll, cannot break `position: sticky` on an ancestor, and
       leaves the carousel's own slide mechanism alone. `hidden` would do all
       three.
       Measured: 9px -> 0 at 320 on both routes, and 0 -> 0 at 390, 834 and
       1440 — so nothing changes at any width a reader was already served.
       max-width: 100% was tried first and did NOT fix it; the caption is not
       overflowing this box's WIDTH, it is painting outside it. */
    overflow-x: clip;
  }

  /* ── The device ──────────────────────────────────────────────────────────
   *
   * NOT A CARD, and the gate agrees for the right reason rather than by
   * exemption. check-design-system rule 3 fires on radius AND padding AND
   * paint together; this frame has no padding, because a device frame holds a
   * screen edge to edge. It is a window, not a container. */
  .pcar__frame {
    /* --radius-frame, not --radius-card, since 2026-08-05. The block directly
       above already argued this box is a window rather than a container, and
       tokens.css defines --radius-frame as exactly that ("a device frame: a
       window, not a container") at the 12px the concept measures. It was
       reaching for the 16px card radius while calling itself a device, and the
       fidelity harness read 12 vs 16 at all three viewports. */
    border-radius: var(--radius-frame);
    overflow: hidden;
    /* --c-floor, not --c-panel. The concept's .frame sits on the page's DEEPEST
       step (homepage-v2.html:238), so the device reads as a screen cut into the
       page rather than a panel laid on it, and the screenshot inside it gains
       the contrast that makes it look like a screen. Measured rgb(12,16,32)
       against the concept's rgb(3,4,10) at all three viewports. */
    background-color: var(--c-floor);
    /* ── THE EDGE CATCHES THE LIGHT, 2026-08-05 ────────────────────────────
     *
     * Owner: "also all the carousels boundary as well". Every carousel on this
     * site is one of these frames, so this rule is the whole of that request.
     *
     * IT IS THE SAME RECIPE AS `surface--edge` IN styles/surfaces.css, AND THAT
     * FILE HOLDS THE ARGUMENT. In one line: a real object catches a light from
     * above, so --grad-hairline runs white 30% at the top down to 5% at the
     * foot, painted to the BORDER box under a transparent border, and the flat
     * rgba(255, 255, 255, 0.12) line this frame carried the whole way round is
     * the strongest PowerPoint tell in the craft table. A device sitting in a
     * dark page now reads as a thing with a top edge rather than as a rectangle
     * somebody outlined.
     *
     * WHY IT IS WRITTEN HERE RATHER THAN BY TAKING THE CLASS. This frame is
     * deliberately NOT a `.surface` — see the block directly above, "a device
     * frame holds a screen edge to edge. It is a window, not a container" — and
     * `surface--edge` arrives with a card's radius, fill, hover and sheen
     * attached to its siblings. The EDGE itself is still central: the gradient
     * is --grad-hairline, the one token, so the two cannot drift.
     *
     * THE FACE MUST BE OPAQUE AND IT IS: `linear-gradient(var(--c-floor) 0 0)`
     * is the --grad-solid idiom, a flat colour written as an image because a
     * background-color cannot sit between two image layers. A TRANSLUCENT face
     * here would let the hairline read across the whole frame, which is exactly
     * the defect measured on `.in__chip` in Integrations.astro, where a 10%
     * face let a border ramp through and put text at 4.03:1. Nothing here is
     * over text in any case — the screenshot is painted inside the padding box
     * and the ring is outside it — but the construction is the one that failed
     * and it is worth saying which half makes it safe.
     *
     * `overflow: hidden` clips children at the PADDING box, so the 1px ring
     * cannot be covered by the chrome bar or by a slide. */
    border: 1px solid transparent;
    background-image:
      linear-gradient(var(--c-floor) 0 0),
      var(--grad-hairline);
    background-origin: padding-box, border-box;
    background-clip: padding-box, border-box;
  }

  /* A transparent border is invisible in Windows high-contrast, and the frame
     is the only thing separating a screenshot from the page. Restated as a
     system colour, which is what the `.surface` recipe does for the same
     reason. */
  @media (forced-colors: active) {
    .pcar__frame {
      border-color: CanvasText;
    }
  }

  .pcar__chrome {
    display: flex;
    align-items: center;
    gap: var(--stack-1);
    padding: var(--stack-1) var(--stack-2);
    background: var(--c-raised);
    border-bottom: 1px solid var(--c-border);
  }

  .pcar__lights {
    display: inline-flex;
    gap: 0.4rem;
    flex: 0 0 auto;
  }
  /* ── THE THREE LIGHTS ──────────────────────────────────────────────────────
   *
   * Owner, 2026-08-05: "noticed carasouls has 3 dots but hardly visible hence
   * improve with colors dots". They were `background: var(--c-border)` — the
   * BORDER colour, white at 12% alpha, used as a FILL, on a --c-raised bar.
   * Measured, that is 1.37:1 against the bar behind them, which is why three
   * dots read as three smudges. They are now about 5:1.
   *
   * THE WHOLE ARGUMENT IS IN styles/tokens.css beside the tokens: why colour
   * rather than a brighter grey, why the traffic-light idiom is the right
   * picture for a device frame, why it does not break one semantic per hue, and
   * why the middle light is NOT --c-amber (amber means AT RISK on this site, and
   * a window control wearing a mark is how a mark stops meaning anything).
   *
   * NAMED FOR THE CONTROL, NOT THE COLOUR. `--c-chrome-close` says what the dot
   * depicts; a component may not name the pigment behind it, and
   * check-palette-roles.js rule 1 enforces that.
   *
   * `:nth-child` RATHER THAN THREE CLASSES, because the three <i> elements carry
   * no meaning to write a class about: they are `aria-hidden` and they are a
   * picture of a window, in the order every window draws them. */
  .pcar__lights i {
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: var(--radius-pill);
    /* The same one-token specular every card, button and chip on this site
       takes. On an 11px circle it is a thin bright chord at the top, which is
       the same light the frame's own edge is now catching. */
    box-shadow: var(--gloss-inset);
  }
  .pcar__lights i:nth-child(1) { background: var(--c-chrome-close); }
  .pcar__lights i:nth-child(2) { background: var(--c-chrome-minimise); }
  .pcar__lights i:nth-child(3) { background: var(--c-chrome-maximise); }

  .pcar__url {
    flex: 1 1 auto;
    text-align: center;
    font-family: var(--font-mono);
    line-height: var(--lh-tight);
    font-size: var(--t-micro);
    color: var(--c-text-sub);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pcar__url-path {
    color: var(--c-text);
  }

  /* ── The stage ───────────────────────────────────────────────────────────
   *
   * A FIXED ASPECT RATIO, so the frame reserves its height before the image
   * arrives and the page cannot shift under the reader — and, just as
   * importantly, so it cannot shift when the carousel advances itself every
   * 5.2 seconds. 16/10 because the drawn desktop screens are 1440x900, which is
   * 16/10 exactly. See STAGE_RATIO in the frontmatter.
   *
   * `contain` AND NOT `cover`, WHICH IS THE OPPOSITE OF THE LEGACY SHEET, and
   * the reason is what these images are. `cover` on a mixed set crops a
   * different amount off every slide, and what it crops off a picture of an
   * interface is the interface — on the opportunities feed at 2.00 in a 16:10
   * frame it takes 10% off each side, which is exactly where the relevance
   * score sits. A marketing image can lose its edges; a picture of a product
   * loses the thing it was drawn to show.
   *
   * This used to hold the whole answer, because the set was chosen to one ratio
   * and the note here said so: "a slide at 0.95 would show real bars, and the
   * answer then is a better capture rather than a crop". The set is no longer
   * one ratio — it runs 1.60, 1.33 and 0.46 — so the answer moved down one
   * level, to `.pcar__screen`. */
  .pcar__viewport {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--c-bg);
  }

  .pcar__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    /* The screen is centred rather than stretched: an inset slide is a device
       standing on the stage, and a device does not sit in a corner. */
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-slow) var(--ease);
  }
  /* Slide 1 carries this in the markup, so the frame is never empty. */
  .pcar__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── One screen, at its own proportions ──────────────────────────────────
   *
   * `height: 100%` plus the slide's own `aspect-ratio` is what gives every
   * device size its true shape from a single rule: the stage sets the height,
   * the ratio sets the width, and nothing is cropped or stretched at any size.
   * The ratio arrives as an inline custom property because it is data about
   * that one picture — writing a class per device size would mean this
   * component knowing the list of device sizes, which is the call site's
   * business and not its own. */
  .pcar__screen {
    position: relative;
    height: 100%;
    aspect-ratio: var(--screen-ratio);
    max-width: 100%;
    overflow: hidden;
  }

  /* Only where the screen does not fill the stage. On a full-bleed slide this
     ring would sit one pixel inside the frame's own border and read as a
     double line. */
  .pcar__screen--inset {
    border-radius: var(--radius-card);
    border: 1px solid var(--c-border);
    box-shadow: var(--shadow-panel);
  }

  .pcar__screen picture {
    display: contents;
  }
  .pcar__screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  /* ── Light falling across the glass ──────────────────────────────────────
   *
   * WRITTEN HERE RATHER THAN TAKEN FROM A TOKEN, and check-design-system rule 7
   * permits exactly this: a gradient at the point of use passes if every colour
   * in it resolves from a var(). The rule was amended on 2026-08-03 for the
   * reason this glare runs into — a knob token bakes its fallbacks in where it
   * is DECLARED, so a shared gradient cannot take a per-element angle.
   *
   * The two existing tokens are both the wrong shape rather than the wrong
   * value. --grad-vignette DARKENS towards the edges, which would dim the parts
   * of a screenshot furthest from the middle; --grad-wash runs top to bottom.
   * Live's is diagonal, brightest at the top right, which is where a screen
   * catches a room light. Direction is the whole effect, so the direction is
   * what had to be kept. */
  .pcar__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(
      to top right,
      transparent 45%,
      color-mix(in srgb, var(--c-text) 8%, transparent) 100%
    );
  }

  /* ── The controls ────────────────────────────────────────────────────────
   *
   * Hidden until the script says it is driving. A dot that cannot be pressed
   * is worse than no dot, and the caption below is server-rendered so nothing
   * a reader needs is behind this. */
  .pcar__foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--stack-2);
    margin-top: var(--stack-2);
  }
  .pcar__arrow,
  .pcar__tabs {
    display: none;
  }
  .pcar[data-pcar='on'] .pcar__arrow {
    display: inline-flex;
  }

  /* ── THE PAUSE CONTROL ────────────────────────────────────────────────────
   *
   * It takes `.control`, the shared small-control recipe in styles/controls.css,
   * so its target size, border, hover and focus ring are the arrows' and there
   * is no second control treatment here to drift. What this block adds is only
   * the glyph, which is drawn from borders rather than shipped as an icon: two
   * bars for pause, one triangle for play, mirroring the trust band's control.
   *
   * NEITHER BRAND HUE APPEARS ON IT. Teal means verified and violet means
   * refused, and a transport control asserts neither, so it inherits
   * `currentColor` like the arrows beside it. */
  .pcar__pause[hidden] {
    display: none;
  }

  /* ── IT IS SIZED LIKE THE ARROWS, AND IT HAS TO BE ───────────────────────
   *
   * The first version of this control set no box of its own and measured
   * 339 x 19: 19px tall because its only visible child is a 12px glyph and its
   * LABEL is `visually-hidden`, so nothing held the height open, and 339px wide
   * because it stretched along the flex foot. check-render caught it as a WCAG
   * 2.5.8 failure - the standalone minimum is 24px and it was five short.
   *
   * A visually-hidden label is the right call here (the arrows beside it are
   * icon-only too, and a visible "Pause" would be the only worded control in
   * the row), but it means the button cannot inherit a size from its text the
   * way a normal button does. So it takes the arrows' box explicitly, which
   * also makes the three controls one row of equal circles rather than two
   * circles and a bar. */
  .pcar__pause {
    flex: 0 0 auto;
    width: var(--btn-h-sm);
    height: var(--btn-h-sm);
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: var(--radius-pill);
    /* Same reason as `.pcar__arrow`: the glyph IS the control, so it carries
       SC 1.4.11 on its own and takes full ink rather than the muted default. */
    --ctl-ink: var(--c-text);
  }

  .pcar__pause-icon {
    width: 10px;
    height: 12px;
    border-inline: 3px solid currentColor;
    box-sizing: border-box;
  }

  .pcar__pause.is-paused .pcar__pause-icon {
    width: 0;
    height: 0;
    border: 6px solid transparent;
    border-inline-start: 10px solid currentColor;
    border-inline-end: 0;
  }

  /* ── A-12: THE CAPTION CENTRES ON THE FRAME ──────────────────────────────
   *
   * Measured at 1440 on /crowmark and /crowmark-buyers: the frame's centre sits
   * at 720px and the caption's at 548px — 172px out. It was not a margin to
   * nudge, it was the row's construction. Four flex items in the order prev,
   * caption, tabs, next put THREE control clusters on one side of the caption
   * and one on the other, so the only width left for it was the 490px the
   * controls did not want, and its centre landed wherever that gap happened to
   * be. Anything that added a slide would have moved it again.
   *
   * So the driven foot is a grid with two symmetric side tracks. The caption
   * spans all three, which centres it on the foot and therefore on the frame,
   * by construction rather than by measurement; the dots sit in the middle
   * track with an arrow inside each 1fr beside them, so the control cluster is
   * centred too and stays centred whatever the caption says.
   *
   * IT IS THE COMPOSITION THE NARROW BREAKPOINT ALREADY USED. Below 40rem the
   * arrows are hidden and the caption has taken its own line since this file was
   * written — see that block at the foot. Desktop was the odd one out, drawing
   * the same three objects in a shape that only worked while the caption was
   * short.
   *
   * Only the DRIVEN state is a grid. With one slide there are no arrows and no
   * dots, the caption is alone, and a centred flex row already puts it in the
   * middle; a grid there would reserve a second row and a row gap for nothing. */
  .pcar[data-pcar='on'] .pcar__foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-areas:
      'caption caption caption'
      'prev    tabs    next';
    align-items: center;
    row-gap: var(--stack-1);
    column-gap: var(--stack-2);
  }
  .pcar[data-pcar='on'] .pcar__caption {
    grid-area: caption;
  }
  .pcar[data-pcar='on'] [data-pcar-prev] {
    grid-area: prev;
    justify-self: end;
  }
  /* `justify-self: center`, and it is not belt and braces. The caption spans all
     three tracks, and a spanning item contributes to the size of every track it
     spans — so at 390, where the caption wraps to three lines, the middle track
     came out wider than the dots and the row sat 23px left of centre while the
     two 1fr tracks were still perfectly equal. Measured on /crowmark at 390
     before this line. The dots centre in their own track now, whatever the
     caption does to it. */
  .pcar[data-pcar='on'] .pcar__tabs {
    display: inline-flex;
    grid-area: tabs;
    justify-self: center;
  }
  .pcar[data-pcar='on'] [data-pcar-next] {
    grid-area: next;
    justify-self: start;
  }

  .pcar__caption {
    flex: 1 1 auto;
    /* A flex item's default `min-width: auto` is its longest unbreakable word,
       which is why this had to be said out loud: without it the caption refuses
       to shrink below its widest word and pushes the dot row off the end of the
       page. Measured at 390px on /crowmark-buyers before this line existed —
       the document scrolled 402px wide inside a 390px viewport. */
    min-width: 0;
    margin: 0;
    text-align: center;
    /* --t-caption, not --t-body. A caption set at the size of the prose it
       supports does not read as subordinate to it, and the concept agrees: its
       equivalent is `.muted` at 0.875rem against a `.body` of 0.95rem. Measured
       at 1440 this ran to TWO lines at body size where the concept takes one,
       which was 36.79px of the product section's remaining height delta and all
       of it below the frame rather than inside it. See the token's own note:
       this is a hierarchy tier, and it does not reopen the owner's ruling that
       --t-body stays at 17px. */
    font-size: var(--t-caption);
    color: var(--c-text-sub);
    /* Two lines at the narrowest width, reserved, so advancing a slide does not
       move the controls under the reader's finger. `em` here is now the caption
       size rather than the body size, so the reservation shrinks with the text
       it reserves for and stays exactly two lines. */
    min-height: 2.8em;
  }

  /* 44px. WCAG 2.2 target size, the same floor Button.astro states, and the
     reason it is set with width and height rather than padding is that the
     circle must not grow with its icon.
     The wash, the hairline and the hover are `.control` in styles/controls.css
     (A-52). TWO THINGS WENT WITH THEM. The 1.5px lift, because an arrow is
     pressed repeatedly and a control that rises slides the target out from
     under the finger aiming at it — and because that transform still applied
     under prefers-reduced-motion, where collapsing --dur removes the animation
     and leaves the displacement. And the focus ring, which was the only one on
     the site drawn at 2px/2px rather than the sitewide 3px/3px in
     styles/motion.css; same colour, so nobody could see it had forked. */
  .pcar__arrow {
    width: var(--btn-h-sm);
    height: var(--btn-h-sm);
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: var(--radius-pill);
    /* Full ink rather than `.control`'s sub default. The glyph IS the control
       here — there is no label beside it — so it carries the whole of SC 1.4.11
       on its own. */
    --ctl-ink: var(--c-text);
  }
  .pcar__arrow svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  /* The `flex: 0 0 auto` that sat on this and on `.pcar__arrow` is gone with
     A-12: both are only ever visible inside the driven foot, and that is a grid
     now, where a flex declaration does nothing. */
  .pcar__tabs {
    gap: var(--stack-1);
    align-items: center;
  }

  /* The painted dot is 6px and the TARGET is 28px, which is how a 6px indicator
     satisfies the 24px minimum without a 44px blob sitting in the layout. Same
     separation the legacy sheet used, and the reason it is 28 and not 24 is
     that the ring is drawn at r=13 and needs the room. */
  .pcar__tab {
    position: relative;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    -webkit-appearance: none;
    appearance: none;
  }
  .pcar__tab::before {
    content: '';
    display: block;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: var(--radius-pill);
    background: var(--c-text-muted);
    transition:
      background var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .pcar__tab[aria-selected='true']::before {
    background: var(--c-interactive);
    transform: scale(1.2);
  }
  .pcar__tab:focus-visible {
    outline: 2px solid var(--c-border-glow);
    outline-offset: 2px;
    border-radius: var(--radius-pill);
  }

  .pcar__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .pcar__tab[aria-selected='true'] .pcar__ring {
    opacity: 1;
  }
  .pcar__ring-bg {
    stroke: var(--c-border);
  }
  .pcar__ring-progress {
    stroke: var(--c-interactive);
    stroke-linecap: round;
  }

  /* ── THE CLOCK ───────────────────────────────────────────────────────────
   *
   * This rule is the autoplay. There is no timer in the script: it listens for
   * this animation ending and advances. See the component header for why one
   * clock instead of two.
   *
   * `data-lit` gates it, so a carousel that has not been scrolled to yet is
   * still on slide 1 when the reader arrives. That attribute is set by the
   * shared view trigger the product pages already run — no new observer.
   *
   * INSIDE no-preference ON PURPOSE. No animation means no `animationend`,
   * which means no autoplay, from this one declaration rather than from a
   * second branch in the script that could disagree with it. */
  @media (prefers-reduced-motion: no-preference) {
    .pcar[data-pcar='on'][data-lit='on'] .pcar__tab[aria-selected='true'] .pcar__ring-progress {
      animation: pcar-ring var(--pcar-interval) linear forwards;
      /* ── THE LONGHAND, IN THIS RULE, AFTER THE SHORTHAND ──────────────────
       *
       * PAUSE DID NOT WORK AT ALL UNTIL 2026-08-05, and the comment below
       * asserted that it did. Measured by an independent verifier: hovering for
       * 11 seconds advanced the carousel 4 to 6, and holding keyboard focus for
       * 11 seconds advanced it 0 to 2.
       *
       * The cause is pure cascade. `animation` is a SHORTHAND, so it resets
       * every longhand it covers, including `animation-play-state`, to its
       * initial value of `running`. This rule is six classes and attributes
       * deep; the pause rule below was three. Higher specificity won, reset
       * play-state to running on every recalculation, and because the advance
       * is driven by `animationend`, nothing ever paused. WCAG 2.2.2 is Level A,
       * so this was a conformance failure and not a polish item.
       *
       * Setting the longhand HERE, immediately after the shorthand that resets
       * it, and driving it from an inherited custom property takes specificity
       * out of the question entirely: an ancestor sets the variable, this
       * declaration reads it, and no future selector can out-rank it by being
       * written more deeply. Raising the pause rule's specificity would have
       * fixed today's symptom and left the trap armed. */
      animation-play-state: var(--pcar-play, running);
    }

    /* The variable, set on the ROOT rather than on the ring, so it inherits to
       whatever reads it and the hover target and the animated element do not
       have to be the same node. */
    .pcar:hover,
    .pcar:focus-within {
      --pcar-play: paused;
    }

    /* Latched by the pause button. It has to beat the two above, because a
       reader who has explicitly paused must stay paused when the pointer
       leaves. */
    .pcar[data-pcar-paused='true'],
    .pcar[data-pcar-paused='true']:hover,
    .pcar[data-pcar-paused='true']:focus-within {
      --pcar-play: paused;
    }
  }

  /* Not an entrance: it starts at the ring's own resting dash offset and draws
     it in. check-motion rule 2 reads `opacity` and `transform`, and this is
     neither, which is correct rather than lucky — nothing here appears, a
     measure fills. */
  @keyframes pcar-ring {
    from {
      stroke-dashoffset: var(--pcar-circ);
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 40rem) {
    /* The arrows go on a phone: swipe is the gesture there, the dots still
       give a position and a target, and three control clusters in a 390px row
       squeezes the caption to nothing. */
    .pcar[data-pcar='on'] .pcar__arrow {
      display: none;
    }

    /* AND THE CAPTION TAKES ITS OWN LINE, because eight dots is not four.
       Eight 28px targets plus their gaps is roughly 290px of the 350px a 390px
       phone leaves after the gutter, so a caption beside them has nothing left
       to be read in. Wrapping is the answer rather than shrinking the dots:
       the 28px target is what carries the 24px WCAG 2.2 minimum, and it is not
       the thing that gives way when the row runs out of room.

       THE TWO DECLARATIONS THAT USED TO DO THIS ARE GONE, NOT MOVED. They were
       `flex-wrap: wrap` and `flex: 1 0 100%`, and A-12 made the driven foot a
       grid at every width — which puts the caption on its own row here as a
       property of the layout rather than as a narrow-viewport special case. A
       flex declaration on a grid container is inert, so leaving them would have
       left two lines that read as the thing keeping this working while doing
       nothing at all. The dots keep the middle track and both empty 1fr tracks
       collapse to zero with the arrows hidden, so the row still centres.

       ── AND THE SENTENCE THAT USED TO END HERE WAS FALSE ────────────────────
       It read "and there is nothing left for this breakpoint to say about it".
       There was, and it cost 35.9px of caption off EACH SIDE at 320.

       The 1fr tracks do collapse. The middle one is `auto`, and an auto track
       cannot shrink below its content's min-content width: eight 28px targets
       and seven 12.6px gaps is 312.156px, and the two column gaps add 39.6px
       more. So the foot resolves to 351.8px inside the 280px a 320px viewport
       leaves after the gutter. The caption spans `caption caption caption`, so
       it takes that same 351.8px, centres, and hangs 35.9px off both ends -
       where `overflow-x: clip` on `.pcar` silently cuts it. Measured on the
       built page: 35.9px each side at 320, 15.9px at 360, 0.9px at 390, clean
       at 834. The tab strip is cut too, taking the first and last slide tabs
       with it, and those are interactive controls rather than decoration.

       THE PREMISE WAS ALSO WRONG, not just the conclusion. The paragraph above
       estimates "roughly 290px of the 350px a 390px phone leaves". It measures
       312.156px, and 320 - the width WCAG 1.4.10 Reflow actually contemplates -
       was never considered at all.

       IT HID FROM THE OVERFLOW CHECKS FOR A REASON WORTH RECORDING: `overflow-x:
       clip` produces no scrollbar and no scrollWidth growth, so every gate and
       audit that asks `scrollWidth === clientWidth` reports this page clean.
       Clipped overflow is invisible to the test everyone reaches for first. It
       has to be found by comparing a child's rect against its clipping
       ancestor's, which is what caught it.

       BOTH DECLARATIONS ARE LOAD-BEARING AND NEITHER IS SUFFICIENT. Removing
       the column gap takes 351.8px to 312.2px, still wider than 280. Letting
       the strip wrap is what lets 312.156px of min-content become two rows. But
       wrapping ALONE forces a two-row dot strip at 390, where one row fits
       today and looks better; keeping the gap at zero is what preserves the
       single row there. Measured with both applied: 320 caption 0..280 with the
       dots on two rows, 360 and 390 unclipped with the dots still on ONE row at
       h 28 exactly as now, and 834/1440 unchanged. */
    .pcar[data-pcar='on'] .pcar__foot {
      column-gap: 0;
    }

    .pcar__tabs {
      flex-wrap: wrap;
    }
  }
</style>

<script>
  /*
   * The driver. Everything about WHEN is in the stylesheet; this is only WHAT.
   *
   * It never sets a timer, never writes a transform, and never measures
   * anything. It flips `is-active`, `aria-hidden` and `aria-selected`, writes
   * the caption, and announces. Flipping `aria-selected` is also what restarts
   * the ring, because the animation rule only matches the selected tab — so
   * the progress indicator resets itself and cannot drift from the slide.
   */
  interface Car {
    root: HTMLElement;
    slides: HTMLElement[];
    tabs: HTMLElement[];
    caption: HTMLElement | null;
    live: HTMLElement | null;
    index: number;
  }

  function show(c: Car, n: number, announce: boolean): void {
    c.index = (n + c.slides.length) % c.slides.length;

    c.slides.forEach((s, i) => {
      s.classList.toggle('is-active', i === c.index);
      s.setAttribute('aria-hidden', i === c.index ? 'false' : 'true');
    });
    /* ── ROVING TABINDEX, WHICH THIS TABLIST WAS MISSING ────────────────────
     *
     * Measured 2026-08-05: eight tabs meant EIGHT tab stops, so a keyboard
     * reader tabbing through /crowmark crossed the whole dot row one press at a
     * time before reaching anything after it. The ARIA tabs pattern asks for
     * ONE stop for the group, with the arrow keys moving within it, and the
     * arrow keys were already implemented here - only the tabindex half was
     * absent, so the pattern was half-built and the half that was missing is
     * the one a reader feels.
     *
     * Written in the same loop as `aria-selected`, deliberately: the selected
     * tab and the focusable tab are the same tab by definition, and keeping
     * them in two places is how they come to disagree. The shared TabSwitcher
     * already does exactly this. */
    c.tabs.forEach((t, i) => {
      const on = i === c.index;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
    });

    const text = c.tabs[c.index]?.getAttribute('aria-label') ?? '';
    /* The caption is the tab label minus its "Screen 1 of 4: " prefix, so the
       two can never disagree about what the slide is. One source, two readers:
       one visual, one assistive. */
    const caption = text.replace(/^Screen \d+ of \d+:\s*/, '');
    if (c.caption) c.caption.textContent = caption;
    /* Only on a deliberate move. Announcing an autoplay step would interrupt a
       screen-reader user reading something else on the page, every 5.2 seconds. */
    if (announce && c.live) c.live.textContent = text;
  }

  function init(root: HTMLElement): void {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.pcar__slide'));
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('.pcar__tab'));
    /* One slide is a framed screenshot, not a carousel. Leave it exactly as
       rendered: the controls stay hidden because data-pcar is never set. */
    if (slides.length < 2) return;

    const c: Car = {
      root,
      slides,
      tabs,
      caption: root.querySelector<HTMLElement>('[data-pcar-caption]'),
      live: root.querySelector<HTMLElement>('[data-pcar-live]'),
      index: 0,
    };

    tabs.forEach((t, i) => t.addEventListener('click', () => show(c, i, true)));
    root.querySelector('[data-pcar-prev]')?.addEventListener('click', () => show(c, c.index - 1, true));
    root.querySelector('[data-pcar-next]')?.addEventListener('click', () => show(c, c.index + 1, true));

    /*
     * ── THE PAUSE CONTROL, WCAG 2.2.2 ─────────────────────────────────────
     *
     * Revealed only when the carousel can genuinely autoplay, which is the same
     * condition the ring animation is declared under: more than one slide, and
     * the reader has not asked for reduced motion. A control for something that
     * is not moving is worse than no control, and a reader under `reduce` never
     * receives one because there is nothing to pause.
     *
     * It latches `data-pcar-paused` on the root, which the stylesheet reads to
     * hold `--pcar-play: paused` even when the pointer leaves. Hover and focus
     * SUSPEND; this STAYS. That distinction is the whole reason a real control
     * is required: hover is not available to a touch reader at all, and
     * focus-within stops the moment they tab onwards.
     */
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pcar-pause]');
    const pauseLabel = pauseBtn?.querySelector<HTMLElement>('[data-pcar-pause-label]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (pauseBtn && tabs.length > 1 && !reduced.matches) {
      pauseBtn.hidden = false;
      pauseBtn.addEventListener('click', () => {
        const paused = root.dataset.pcarPaused !== 'true';
        root.dataset.pcarPaused = String(paused);
        pauseBtn.setAttribute('aria-pressed', String(paused));
        pauseBtn.classList.toggle('is-paused', paused);
        if (pauseLabel) {
          pauseLabel.textContent = paused ? 'Play the slideshow' : 'Pause the slideshow';
        }
      });

      /* Turning the preference ON mid-read withdraws the control with the
         motion it governs. Turning it off does not start animating a page
         somebody is already reading. */
      if (typeof reduced.addEventListener === 'function') {
        reduced.addEventListener('change', () => {
          if (reduced.matches) pauseBtn.hidden = true;
        });
      }
    }

    /* THE AUTOPLAY. The ring finishing IS the interval elapsing. Matched on the
       target rather than on `animationName`, because Astro rewrites keyframe
       names when it scopes a component stylesheet and a string comparison here
       would break silently the first time that changed. */
    root.addEventListener('animationend', (e) => {
      if ((e.target as HTMLElement).classList?.contains('pcar__ring-progress')) show(c, c.index + 1, false);
    });

    /* Left and right move between slides whenever focus is inside the
       carousel, and focus follows to the now-current tab so a screen-reader
       user does not lose their place. */
    root.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      show(c, c.index + (e.key === 'ArrowRight' ? 1 : -1), true);
      c.tabs[c.index]?.focus();
    });

    /* Swipe. 40px so a tap or a vertical scroll is never taken as a swipe, and
       passive so the gesture cannot delay the page scrolling. */
    const view = root.querySelector<HTMLElement>('.pcar__viewport') ?? root;
    let startX: number | null = null;
    view.addEventListener('touchstart', (e: TouchEvent) => { startX = e.touches[0]?.clientX ?? null; }, { passive: true });
    view.addEventListener('touchend', (e: TouchEvent) => {
      if (startX === null) return;
      const dx = (e.changedTouches[0]?.clientX ?? startX) - startX;
      if (Math.abs(dx) > 40) show(c, c.index + (dx < 0 ? 1 : -1), true);
      startX = null;
    }, { passive: true });

    /* LAST, and that ordering is the contract. The controls only become visible
       once every listener above is attached, so there is no window in which a
       dot is on screen and does nothing. */
    root.setAttribute('data-pcar', 'on');
  }

  for (const el of Array.from(document.querySelectorAll<HTMLElement>('[data-pcar]'))) init(el);
</script>
