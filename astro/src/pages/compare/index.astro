---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import Button from '../../components/ui/Button.astro';
import FinalCta from '../../components/sections/FinalCta.astro';

const title = 'Compare CrowMark with UK bid software';
const description =
  'Side-by-side comparisons of CrowMark against AutogenAI, mytender.io, CleanTender and SwiftBid. A dated source for every competitor figure.';
const path = '/compare';

const comparisons = [
  {
    href: '/compare/crowmark-vs-autogenai',
    tag: 'Enterprise engine',
    name: 'CrowMark vs AutogenAI',
    blurb:
      'Published SME pricing against a venture-backed enterprise engine that quotes on request. Where scale wins and where it does not.',
  },
  {
    href: '/compare/crowmark-vs-mytender-io',
    tag: 'UK drafting platform',
    name: 'CrowMark vs mytender.io',
    blurb:
      'Two UK-built tools. Figure-grounding and published pricing against a private-cloud drafting platform with content-tool integrations.',
  },
  {
    href: '/compare/crowmark-vs-cleantender',
    tag: 'Soft-FM specialist',
    name: 'CrowMark vs CleanTender',
    blurb: 'A sector-agnostic suite against a soft-FM specialist. Both publish pricing, so the question is scope and depth.',
  },
  {
    href: '/compare/crowmark-vs-swiftbid',
    tag: 'Per-bid service',
    name: 'CrowMark vs SwiftBid',
    blurb: 'Subscribe, or pay per bid. Which model fits depends on how often you bid. The break-even, worked through.',
  },
];

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Compare', item: `${SITE.origin}/compare` },
    ],
  },
  {
    '@type': 'CollectionPage',
    name: title,
    url: `${SITE.origin}/compare`,
    description: 'Honest, sourced comparisons of CrowMark against AutogenAI, mytender.io, CleanTender and SwiftBid.',
    publisher: { '@id': `${SITE.origin}/#organization` },
    hasPart: comparisons.map((c) => ({
      '@type': 'WebPage',
      name: c.name,
      url: `${SITE.origin}${c.href}`,
    })),
  },
];
---

<Base title={`${title} | CrowAgent`} description={description} path={path} image="/Assets/og/crowmark.png?v=20260730" schema={schema}>
  <main>
    <header class="cmp-hero">
      <div class="cmp-hero-inner">
        <nav aria-label="Breadcrumb" class="cmp-breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span> <span aria-current="page">Compare</span>
        </nav>
        <span class="cmp-eyebrow">Honest comparisons</span>
        <h1 class="cmp-h1"><span>Compare CrowMark</span> <span class="accent">with UK bid software</span></h1>
        <p class="cmp-hero-desc">
          Side-by-side, sourced comparisons of CrowMark against the tools UK suppliers shortlist. Real feature tables, our
          published pricing, and a dated source for every competitor figure.
        </p>
      </div>
    </header>

    <section class="cmp-hub">
      <div class="cmp-hub-inner">
        <p class="cmp-intro">
          CrowMark is a UK bid and tender management suite from &pound;49 per month. Where a rival does not publish a
          figure, we mark it Not published rather than guess, and we concede the points where CrowMark is not the
          strongest option. Pick a comparison below.
        </p>
        <p class="cmp-intro">
          CrowMark serves both sides of a procurement: CrowMark for Suppliers answers tenders, RFPs and questionnaires,
          and CrowMark for Buyers locates the evidence for each published requirement across the responses received.
          Both work in the public sector and the private sector. Supplier plans are published; buyer engagements are
          scoped to the organisation, so they are quoted rather than listed. The comparisons below are supplier-side,
          because that is where the competing tools sit.
        </p>

        <figure class="cmp-shot">
          <picture>
            <source type="image/avif" srcset="/Assets/shots/dark/mark-opportunities-feed.avif?v=20260730j" />
            <source type="image/webp" srcset="/Assets/shots/dark/mark-opportunities-feed.webp?v=20260730j" />
            <img
              src="/Assets/shots/dark/mark-opportunities-feed.png?v=20260730j"
              width="2360"
              height="1180"
              loading="lazy"
              decoding="async"
              alt="The CrowMark opportunities feed listing published UK tender notices. Each row shows the notice title, the buying authority, the contract value, a sector tag, how long ago it was published and whether it came from Find a Tender or Contracts Finder, with buttons to open it in CrowMark, view it on the original portal or save it. The three notices shown are a National Supervised Toothbrushing Programme for Suffolk County Council, a healthcare offensive waste collection for Leeds Teaching Hospitals NHS Trust, and M6 Lune Gorge bored piling works."
            />
          </picture>
          <figcaption>The daily UK tender feed in CrowMark, shown with a sample account. The notices themselves are genuine published Find a Tender and Contracts Finder records.</figcaption>
        </figure>

        <div class="cmp-hub-grid">
          {
            comparisons.map((c) => (
              <a class="cmp-hub-card surface" href={c.href}>
                <span class="cmp-hub-tag">{c.tag}</span>
                <h2>{c.name}</h2>
                <p>{c.blurb}</p>
                <span class="cmp-hub-more">Read comparison &rarr;</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <FinalCta
      id="compare-cta"
      title="DECIDE FASTER."
      standfirst="Published pricing from £49/month. Live, paid, and in daily use on real bids."
    >
      <Button href="/pricing?product=mark" size="md">See pricing</Button>
      <Button href="/crowmark" variant="secondary" size="md">Explore CrowMark</Button>
    </FinalCta>
  </main>
</Base>

<style>
  /*
   * CENTRED HEAD BLOCK, GRADIENT EYEBROW — owner decision, 2026-08-02.
   * components/layout/Section.astro is the canonical implementation; this page
   * builds its own hero, so the rules are restated here and match the
   * per-comparison pages in layouts/Compare.astro.
   *
   * The centring is on .cmp-hero and stops there. .cmp-hub holds two intro
   * paragraphs, a captioned screenshot and the four comparison cards, all of
   * which stay left-aligned.
   */
  .cmp-hero {
    position: relative;
    padding: var(--sec-pad-y-hero) var(--gutter) var(--sec-pad-y-sm);
    text-align: center;
    overflow: hidden;
  }
  .cmp-hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 60%;
    z-index: -1;
    background: var(--grad-hero-glow);
    filter: blur(30px);
    opacity: 0.5;
  }
  .cmp-hero-inner {
    max-width: var(--measure);
    margin-inline: auto;
  }
  .cmp-breadcrumb {
    font-size: var(--t-body);
    color: var(--c-text-muted);
    margin: 0 0 var(--stack-2);
  }
  .cmp-breadcrumb a {
    color: var(--c-text-muted);
    text-decoration: none;
  }
  .cmp-breadcrumb a:hover {
    color: var(--c-text);
  }
  .cmp-breadcrumb [aria-current='page'] {
    color: var(--c-text);
  }
  .cmp-eyebrow {
    display: inline-block;
    margin: 0 0 var(--stack-2);
    padding: 0.5rem 0.85rem;
    /* --c-border, not the two hardcoded teal rgba() values this rule carried.
       The outline is the one every eyebrow on the site now wears, and the
       colour comes from the gradient below rather than a tinted fill. */
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  /*
   * background-clip: text needs a transparent fill, and an inherited
   * -webkit-text-fill-color is what caused this site's invisible-text P0. The
   * @supports gate leaves a solid readable colour where it is unsupported, and
   * the declaration reaches one short label and nothing else.
   */
  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .cmp-eyebrow {
      background: var(--grad-spectrum);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }
  .cmp-h1 {
    font-family: var(--font-display);
    font-size: var(--t-h1);
    font-weight: var(--t-w-h1);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin: 0 0 var(--stack-2);
  }
  .cmp-h1 .accent {
    color: var(--c-teal);
  }
  .cmp-hero-desc {
    /* 62ch, the same measure Section gives every standfirst. This page had
       one of five different widths (40, 42, 44, 48 and 52rem) used for the
       identical element across the compare, glossary and sector families. */
    max-width: 62ch;
    font-size: var(--t-lede);
    line-height: 1.6;
    color: var(--c-text-sub);
    /* The measure has to be centred too, or a centred standfirst sits left
       inside a centred head block. */
    margin: 0 auto;
  }

  .cmp-hub {
    padding: 0 var(--gutter) var(--sec-pad-y);
  }
  .cmp-hub-inner {
    max-width: var(--measure);
    margin-inline: auto;
  }
  .cmp-intro {
    max-width: 62ch;
    font-size: var(--t-lede);
    line-height: 1.7;
    color: var(--c-text-sub);
    margin: 0 0 1.5rem;
  }
  .cmp-shot {
    margin: var(--sec-gap) 0 3rem;
  }
  .cmp-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--c-border);
  }
  .cmp-shot figcaption {
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--c-text-muted);
    margin-top: 1rem;
  }

  .cmp-hub-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .cmp-hub-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* Card treatment, hover and lift come from `surface`. This page's own hover
     moved the card 3px while glossary moved 4px and contact moved none, which
     is the inconsistency the owner reported. */
  .cmp-hub-card {
    display: block;
    padding: var(--blk-pad);
    text-decoration: none;
  }
  .cmp-hub-tag {
    font-family: var(--font-display);
    font-size: var(--t-micro);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-teal);
  }
  .cmp-hub-card h2 {
    margin: 0.6rem 0;
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
    color: var(--c-text);
  }
  .cmp-hub-card p {
    margin: 0 0 1rem;
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--c-text-sub);
  }
  .cmp-hub-more {
    font-family: var(--font-display);
    font-size: var(--t-micro);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  /* --t-h1 is reserved for the hero (tokens.css); the homepage's own closing
     CTA renders through Section at --t-h2 / --t-w-h2. Matched to it. */
</style>
