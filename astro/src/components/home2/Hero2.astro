---
/**
 * HOME 2.0: THE HERO.
 *
 * Two columns at desktop, stacked on a phone. Copy on the left, a glass
 * workstation window on the right showing one tender clause, the grounded draft
 * answer beneath it, and the figure the engine refused.
 *
 * ── THE ARRIVAL IS INHERITED AND NOT ONE LINE OF IT IS WRITTEN HERE ─────────
 *
 * styles/motion.css owns the hero landing for the whole site and keys it on
 * `#hero-title`. Getting it is a matter of SHAPE rather than of opt-in, so the
 * shape is stated once here and must not be rearranged casually:
 *
 *   main > section.h2hero            the first block, so it takes `sv-land`
 *     div.h2hero__inner              `:has(> * > #hero-title)`, so its LAST
 *                                    child is the follow row at index 6
 *       div.h2hero__copy             `:has(> #hero-title)`, animation-name none
 *         p.eyebrow                  first child, `sv-land-hero` at delay 0
 *         h1#hero-title              its three spans land 120ms apart
 *         p.h2hero__lede             nth-child(3), `sv-land-row`
 *         div.h2hero__ctas           nth-child(4)
 *         ul.h2hero__trust           nth-child(5)
 *       div.h2hero__win              last child, arrives after the copy
 *
 * Move the window out of `.h2hero__inner` and it stops arriving. Add a sixth
 * copy row and it lands with the fourth, because motion.css enumerates
 * `--hero-follow-i` up to 5. Both are stated so the next edit can see them.
 *
 * ── THE TRACE IS CLIP-PATH, WHICH IS WHY IT CANNOT HIDE ANYTHING ────────────
 *
 * The clause types, the draft fills, the citations pop and the refusal settles.
 * Every one of those is an animation on `clip-path` or on a scale that returns
 * to 1, and not one of them touches `opacity`. The window is fully painted and
 * fully legible before the trace runs, while it runs, and after it. If the
 * `data-lit` observer in scripts/motion.ts never fires, if the module is
 * blocked, or if the reader has asked for reduced motion, the result is the
 * finished window, immediately. That inversion is the repository's rule and the
 * reason there is no reveal here to get stuck in.
 */
import Button from '../ui/Button.astro';
import AuroraField from './AuroraField.astro';

const CITATIONS = ['Appendix B, p.4', 'Case study 07'];

const TRUST = [
  'Refuses unproven figures',
  'UK data residency',
  'Supplier and buyer sides',
];
---

<section class="h2hero">
  <AuroraField par="40px" />

  <div class="h2hero__inner">
    <div class="h2hero__copy">
      <p class="eyebrow eyebrow--marker h2hero__brow">
        <span class="h2hero__dot" aria-hidden="true"></span>
        Bid and tender software, supplier and buyer
      </p>

      <h1 class="h2hero__title" id="hero-title">
        <span>Qualify.</span>
        <span>Draft.</span>
        <span class="h2hero__prove">Prove it.</span>
      </h1>

      <p class="h2hero__lede">
        Every figure in your bid traced to evidence you already hold. The engine
        drafts the answer, checks every number against the tender, and refuses
        the ones it cannot prove.
      </p>

      <div class="h2hero__ctas">
        <Button href="/contact/?enquiry=limited-access#contact-form">Request access</Button>
        <Button href="/tools/tender-compliance-matrix/" variant="secondary">Read a tender, free</Button>
      </div>

      <ul class="h2hero__trust">
        {
          TRUST.map((t) => (
            <li class="h2hero__trust-item">
              <svg class="h2hero__tick" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M3 8.5l3.2 3.2L13 5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="h2hero__win" data-lit data-lit-threshold="0.25">
      <div class="h2win">
        <div class="h2win__chrome">
          <span class="h2win__lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="h2win__file">Highways maintenance framework · Answer 3.2 of 14</span>
        </div>

        <div class="h2win__body">
          <div class="h2win__pane h2win__pane--clause">
            <p class="h2win__label">Tender clause 3.2</p>
            <p class="h2win__clause">
              <span class="h2win__type h2win__type--clause">
                Tenderers shall submit a method statement of no more than 500
                words, naming an account manager for the duration of the
                contract.
              </span>
            </p>
          </div>

          <div class="h2win__pane h2win__pane--draft">
            <p class="h2win__label h2win__label--ok">Draft · Grounded</p>
            <p class="h2win__draft">
              <span class="h2win__type h2win__type--draft">
                Our account manager, named in Appendix B, has held the same role
                on two frameworks of comparable value since 2022. Method
                statement runs to 412 words against the 500 permitted.
              </span>
            </p>
            <p class="h2win__cites">
              {
                CITATIONS.map((c, i) => (
                  <span class="h2cite" style={`--cite-i: ${i}`}>{c}</span>
                ))
              }
            </p>
          </div>
        </div>

        <p class="h2win__refused">
          <span class="h2win__badge">Refused</span>
          <span class="h2win__refused-text">
            "£27,450 per year" has no source in your evidence. Not drafted until
            you attach one.
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .h2hero {
    position: relative;
    isolation: isolate;
    padding-block: var(--sec-pad-y-hero) var(--sec-pad-y);
    overflow-x: clip;
  }

  .h2hero__inner {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .h2hero__inner {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
      gap: var(--space-10);
    }
  }

  /* ── THE SHORT LAPTOP FOLD, MEASURED RATHER THAN GUESSED ────────────────
   *
   * At 1280x585, which is a 1280 laptop once the browser chrome is taken off,
   * the window's bottom edge measured 634px against a 585px viewport. The hero
   * fitted the H1 and lost the thing the H1 is arguing about, which is the
   * worse half to lose.
   *
   * The cause is vertical padding sized for a tall desktop: --sec-pad-y-hero is
   * about 110px at this width, and it is spent twice over before the window
   * starts. This block spends less of it when there is less height to spend,
   * and it is keyed on HEIGHT because that is the constraint. Nothing changes
   * at 1440x900 or on a phone. */
  @media (min-width: 62rem) and (max-height: 800px) {
    .h2hero {
      padding-block: var(--space-12) var(--space-12);
    }

    .h2hero__ctas,
    .h2hero__trust {
      margin-block-start: var(--space-6);
    }

    .h2win__body {
      padding: var(--space-4);
      gap: var(--space-4);
    }

    .h2win__refused {
      padding: var(--space-3) var(--space-4);
    }
  }

  .h2hero__copy {
    text-align: left;
    min-width: 0;
  }

  /* The eyebrow keeps the site's pill, and adds the teal dot the board draws.
     `eyebrow--marker` turns off the spectrum text clip so the label reads as
     one colour beside the dot rather than as a second gradient. */
  .h2hero__brow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--c-text-sub);
  }

  .h2hero__dot {
    inline-size: 7px;
    block-size: 7px;
    flex: 0 0 auto;
    border-radius: var(--radius-pill);
    background: var(--c-teal);
    box-shadow: 0 0 10px var(--c-teal-glow);
  }

  /* A flex column, so each line is its own row. motion.css sets
     `display: inline-block` on `#hero-title > span` for the landing, and a flex
     parent blockifies its children, so the two agree without a fight. */
  .h2hero__title {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-h1);
    font-weight: var(--t-w-h1);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--c-text);
    text-wrap: balance;
  }

  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .h2hero__prove {
      background-image: var(--grad-hero-text);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      /* The descender of a clipped line is cut by its own box, so the box is
         grown and the growth is taken back out of the flow. */
      padding-block-end: 0.08em;
      margin-block-end: -0.08em;
    }
  }

  @media (forced-colors: active) {
    .h2hero__prove {
      background-image: none;
      color: CanvasText;
      -webkit-text-fill-color: CanvasText;
    }
  }

  .h2hero__lede {
    margin: var(--stack-2) 0 0;
    font-family: var(--font-body);
    font-size: var(--t-lede);
    line-height: 1.6;
    color: var(--c-text-sub);
    max-width: 46ch;
  }

  .h2hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
  }

  .h2hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .h2hero__trust-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--t-caption);
    color: var(--c-text-sub);
  }

  .h2hero__tick {
    inline-size: 15px;
    block-size: 15px;
    flex: 0 0 auto;
    color: var(--c-teal);
  }

  .h2hero__win {
    min-width: 0;
  }

  /* ── THE GLASS ─────────────────────────────────────────────────────────
   *
   * `--blur-glass` is the site's one backdrop filter and is used rather than
   * the board's blur(24px) saturate(140%). The board's pair is close to it and
   * is not in tokens.css, and RULE 0-C says a value that is not in the token
   * file is a defect rather than a decision. The delta is handed back in the
   * report instead of being written here as a literal.
   *
   * The @supports fallback is a SOLID panel, because a 6 percent white fill
   * with no blur behind it reads as a smear on the aurora rather than as a
   * window. */
  .h2win {
    position: relative;
    border-radius: var(--radius-panel);
    border: 1px solid color-mix(in srgb, var(--c-text) 18%, transparent);
    background-color: var(--c-panel);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
  }

  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .h2win {
      background-color: color-mix(in srgb, var(--c-text) 6%, transparent);
      -webkit-backdrop-filter: var(--blur-glass);
      backdrop-filter: var(--blur-glass);
    }
  }

  @media (hover: hover) {
    .h2win {
      transition: border-color var(--dur) var(--ease);
    }

    .h2hero__win:hover .h2win {
      border-color: color-mix(in srgb, var(--c-text) 30%, transparent);
    }
  }

  .h2win__chrome {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-block-end: 1px solid var(--c-border);
    background-color: color-mix(in srgb, var(--c-text) 4%, transparent);
  }

  .h2win__lights {
    display: inline-flex;
    gap: 0.4rem;
    flex: 0 0 auto;
  }

  .h2win__lights i {
    inline-size: 0.625rem;
    block-size: 0.625rem;
    border-radius: var(--radius-pill);
    box-shadow: var(--gloss-inset);
  }

  .h2win__lights i:nth-child(1) { background: var(--c-chrome-close); }
  .h2win__lights i:nth-child(2) { background: var(--c-chrome-minimise); }
  .h2win__lights i:nth-child(3) { background: var(--c-chrome-maximise); }

  .h2win__file {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-tight);
    color: var(--c-text-sub);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .h2win__body {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    text-align: left;
  }

  @media (min-width: 48rem) {
    .h2win__body {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
      padding: var(--space-5);
      gap: var(--space-5);
    }
  }

  .h2win__pane {
    min-width: 0;
    border-radius: var(--radius-chip);
    padding: var(--space-4);
  }

  .h2win__pane--clause {
    background-color: color-mix(in srgb, var(--c-floor) 62%, transparent);
    border: 1px solid var(--c-border);
  }

  .h2win__pane--draft {
    background-color: color-mix(in srgb, var(--c-text) 4%, transparent);
    border: 1px solid var(--c-border);
  }

  .h2win__label {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 700;
    line-height: var(--lh-tight);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .h2win__label--ok {
    color: var(--c-verified);
  }

  .h2win__clause {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.7;
    color: var(--c-text-sub);
  }

  .h2win__draft {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-caption);
    line-height: 1.62;
    color: var(--c-text);
  }

  /* A block, so the clip-path in the trace below applies to one rectangle
     rather than to the union of an inline element's line boxes. */
  .h2win__type {
    display: block;
  }

  .h2win__cites {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
  }

  .h2cite {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--c-teal) 34%, transparent);
    background-color: color-mix(in srgb, var(--c-teal) 12%, transparent);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-tight);
    color: var(--c-teal);
  }

  .h2win__refused {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-4);
    border-block-start: 1px solid color-mix(in srgb, var(--c-amber) 26%, transparent);
    background-color: color-mix(in srgb, var(--c-amber) 10%, transparent);
    text-align: left;
  }

  .h2win__badge {
    flex: 0 0 auto;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background-color: var(--c-amber);
    color: var(--c-bg);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 700;
    line-height: var(--lh-tight);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .h2win__refused-text {
    font-family: var(--font-body);
    font-size: var(--t-caption);
    line-height: 1.55;
    color: var(--c-text-sub);
  }

  /* ── THE TRACE. Only clip-path and scale, and only under data-lit ───────
   *
   * Every rest state above is the FINISHED state. Nothing below sets a
   * property on an element directly, so removing this whole block leaves the
   * window exactly as it reads now. */
  @media (prefers-reduced-motion: no-preference) {
    .h2hero__win[data-lit='on'] .h2win__type--clause {
      animation: h2-type calc(var(--m-beat) * 3) steps(48, end) both;
    }

    .h2hero__win[data-lit='on'] .h2win__type--draft {
      animation: h2-type calc(var(--m-beat) * 2) steps(36, end) calc(var(--m-beat) * 3) both;
    }

    .h2hero__win[data-lit='on'] .h2cite {
      animation: h2-pop 180ms var(--m-ease-land)
        calc(var(--m-beat) * 5 + var(--cite-i, 0) * 180ms) 1;
    }

    .h2hero__win[data-lit='on'] .h2win__badge {
      animation: h2-settle calc(var(--m-beat) / 2) var(--m-ease-land)
        calc(var(--m-beat) * 5 + 400ms) 1;
    }

    .h2hero__win[data-lit='on'] .h2win {
      animation: h2-drift var(--m-drift) var(--m-ease-breath)
        calc(var(--m-beat) * 6) infinite alternate;
    }
  }

  /* Types left to right. The element is inline, so the clip follows the text
     rather than a box, and the finished state is `inset(0)`, which clips
     nothing at all. */
  @keyframes h2-type {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0 0 0); }
  }

  /* Both endpoints are scale 1, so this is a pop and not an entrance. */
  @keyframes h2-pop {
    0%   { transform: scale(1); }
    45%  { transform: scale(1.14); }
    100% { transform: scale(1); }
  }

  /* Lands, overshoots 4px, settles. Starts and ends at zero displacement. */
  @keyframes h2-settle {
    0%   { transform: translateY(0); }
    40%  { transform: translateY(-4px); }
    100% { transform: translateY(0); }
  }

  /* The window's own six pixels of life, on the site's ambient period. */
  @keyframes h2-drift {
    from { transform: translateY(3px); }
    to   { transform: translateY(-3px); }
  }
</style>
