---
/**
 * Footer.astro — the sitewide footer.
 *
 * Renders from `src/data/footer.ts`, itself extracted verbatim from the
 * legacy injector `js/nav-inject.js` (FOOTER_HTML, ~line 444-639).
 *
 * Not reproduced from the legacy markup: the mobile tap-to-expand accordion
 * on each column heading (nav-inject.js ~line 1109-1163). That behaviour is
 * a progressive-enhancement convenience (collapsed-by-default columns below
 * 768px), not content that would be lost without it — every link is still
 * present and reachable, just always-expanded. Reproducing it would mean
 * duplicating a second stateful disclosure-widget implementation right next
 * to the one already in Nav.astro's Products dropdown, for a footer that
 * only ever holds four short columns of links. Left out deliberately rather
 * than silently dropped.
 */
import { FOOTER } from '../../data/footer';

const year = new Date().getFullYear();
---

<div class="ca-footer-hairline" aria-hidden="true"></div>
<footer class="ca-footer" role="contentinfo">
  <div class="ca-footer-wrap">
    <div class="ca-footer-credibility" role="group" aria-label="Security and compliance">
      <ul class="ca-footer-trust-row" role="list">
        {
          FOOTER.trustBadges.map((badge) => (
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--c-verified)" stroke-width="2" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <polyline points="22 4 12 14.01 9 11.01" />
              </svg>
              {badge}
            </li>
          ))
        }
      </ul>
      <p class="ca-footer-trust-note">{FOOTER.trustNote}</p>
    </div>

    <div class="ca-footer-grid">
      <div class="ca-footer-col ca-footer-col-brand">
        <a href="/" class="ca-logo" aria-label="CrowAgent, home">
          <span class="ca-logo-mark" aria-hidden="true">
            <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <defs>
                <linearGradient id="caMarkBlue-footer" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#60a5fa"></stop>
                  <stop offset="1" stop-color="#2563eb"></stop>
                </linearGradient>
                <linearGradient id="caMarkTeal-footer" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#22c55e"></stop>
                  <stop offset="1" stop-color="#3b82f6"></stop>
                </linearGradient>
              </defs>
              <rect x="4" y="4" width="56" height="56" rx="14" fill="#FCFDFF" stroke="rgba(15,23,42,.20)" stroke-width="1.5"></rect>
              <rect x="15" y="48.4" width="34" height="1.2" rx="0.6" fill="#94a3b8" opacity="0.35"></rect>
              <rect x="15" y="34.72" width="6" height="14.28" rx="2" fill="url(#caMarkBlue-footer)"></rect>
              <rect x="24.33" y="28.6" width="6" height="20.4" rx="2" fill="url(#caMarkBlue-footer)"></rect>
              <rect x="33.67" y="22.48" width="6" height="26.52" rx="2" fill="url(#caMarkTeal-footer)"></rect>
              <rect x="43" y="15" width="6" height="34" rx="2" fill="url(#caMarkTeal-footer)"></rect>
            </svg>
          </span>
          <span class="ca-logo-word">CrowAgent</span>
        </a>
        <p class="ca-footer-tagline">{FOOTER.brand.tagline}</p>
        <div class="ca-footer-status">
          {/* The live mark breathes. `fx-status-pulse` is the shared recipe in
              styles/effects.css, the same one the current milestone on /about
              wears — the label says "All systems operational", which is a
              statement about right now, and a still dot says it in the past
              tense. Decorative and aria-hidden: the sentence beside it carries
              the meaning, so a reader who never sees the motion loses nothing. */}
          <span class="ca-footer-status-dot fx-status-pulse" aria-hidden="true"></span>
          <span class="ca-footer-status-label">{FOOTER.brand.statusLabel}</span>
        </div>
        <div class="ca-foot-social">
          {
            FOOTER.social.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`CrowAgent on ${s.label} (opens in a new tab)`}
                class="ca-social-link"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--c-text-muted)" aria-hidden="true">
                  <path d={s.d} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      {/* ── A COLUMN IS A NAMED NAVIGATION REGION, NOT AN <h3>. O-45 ────────
          ── (2026-08-04) ───────────────────────────────────────────────────

          WHAT WAS WRONG. "Product / Resources / Company / Legal" were <h3>
          elements rendering at --t-micro, 13px at 1440, on pages whose real h3s
          are 32.8px. So the document outline of all 43 routes carried four
          headings that are, to a reader, tiny uppercase labels — level 3 in the
          structure and the smallest type on the page. A screen reader announces
          them as "heading level 3", search engines read them as section
          headings, and neither claim is true of a 13px column label.

          THE STYLING WAS NEVER THE DEFECT and is untouched. `.grouplabel` is
          the one shared definition of this recipe (styles/labels.css, A-61) and
          it stays exactly as it was, on the same element, with the same class
          list — check-treatments.js rule 10 fails the build on a second
          declaration of it and nothing here declares one. The DEFECT WAS THE
          ELEMENT, so the element is what changes.

          WHY NOT SIMPLY A <p>, WHICH IS THE OBVIOUS FIX. Because it would cost
          a reader something real. Heading navigation is how a screen-reader
          user jumps around a page, and four footer headings are four stops —
          take them away and the footer becomes 25 links with nothing to step
          between. "The outline is wrong" and "the reader can still navigate"
          both have to hold.

          SO THE GROUP IS PROMOTED RATHER THAN THE LABEL DEMOTED. Each column is
          what it has always been — a set of links on one topic — and that is a
          navigation region. Marked as <nav> and named by its own visible label
          through aria-labelledby, it appears in the landmark rotor as "Product,
          navigation", which is the mechanism designed for this job rather than
          the one borrowed for it. The reader gains a labelled landmark and the
          outline loses four false headings; nobody loses a way to move.

          aria-labelledby AND NOT aria-label, so the accessible name IS the
          visible text. One source of truth, and WCAG 2.5.3 Label in Name is
          satisfied by construction rather than by two strings being kept in
          step by hand.

          FOUR LANDMARKS RATHER THAN ONE, AND THAT IS THE POINT. A single
          <nav aria-label="Footer"> around the grid would be one stop for 25
          links, which is the same "nothing to step between" problem in a
          different place. ARIA's own guidance is that multiple navigation
          regions are fine PROVIDED each is labelled; all four are, from data.

          THE `.ca-footer-col` CLASS IS UNCHANGED, so the grid, the widths and
          every rule in this file's <style> block still select it. Only the tag
          differs, which is exactly the size the fix should be. */}
      {
        FOOTER.columns.map((col) => {
          const titleId = `footer-nav-${col.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
          return (
            <nav class="ca-footer-col" aria-labelledby={titleId}>
              <p class="grouplabel ca-footer-col-title" id={titleId}>{col.title}</p>
              <div class="ca-footer-links">
                {col.links.map((link) => (
                  <a href={link.href}>
                    {link.label}
                    {link.chip && <span class="ca-footer-free-chip">{link.chip}</span>}
                  </a>
                ))}
              </div>
            </nav>
          );
        })
      }
    </div>

    <div class="ca-footer-bottom">
      {/*
        ONE STATUTORY DISCLOSURE, NOT TWO. Owner report, 2026-08-04: the company
        number appears "multiple times" on every page. It did, and the footer was
        the reason. Two adjacent paragraphs both stated it, three lines apart, on
        all 43 routes: a copyright line reading "CrowAgent Ltd (Company No.
        17076461)" and a legal-entity line reading "Company No. 17076461 ·
        Registered in England & Wales".

        THE PARTICULARS ARE ALL STILL HERE, which is the part that is not
        negotiable. The Company, Limited Liability Partnership and Business
        (Names and Trading Disclosures) Regulations 2015 reg. 25 requires a
        company to disclose on its websites its registered name, the part of the
        UK it is registered in, its registered number and the address of its
        registered office. This line carries the first three; the registered
        office is disclosed on /contact and /privacy, which is what reg. 25 asks
        for, since the duty is on the website rather than on each page.

        So the merge removes a repetition, not a disclosure. It is deliberately
        the one line that is kept rather than the shorter one: the Companies
        House link is the part a reader can actually verify.
      */}
      <p class="ca-footer-copyright">
        &copy; <span>{year}</span> CrowAgent Ltd. Registered in England &amp; Wales, company no.{' '}
        <a href={FOOTER.legalEntity.companiesHouseUrl} target="_blank" rel="noopener noreferrer" class="ca-footer-companies-house-link">
          {FOOTER.legalEntity.companyNumber}</a>. All rights reserved.
      </p>
      <a href={FOOTER.bottomLinks.status.href} target="_blank" rel="noopener noreferrer" class="ca-footer-bottom-link">
        {FOOTER.bottomLinks.status.label}
      </a>
      <a href={FOOTER.bottomLinks.cookiePreferences.href} class="ca-footer-bottom-link">
        {FOOTER.bottomLinks.cookiePreferences.label}
      </a>
    </div>
  </div>
</footer>

<style>
  .ca-footer-hairline {
    height: 6px;
    /* O-40. This hand-rolled a THIRD gradient opinion: 90deg across three ambient
       stops, where brand pack v5 defines two — --grad-rule at two stops and
       --grad-spectrum at four. A third, undocumented, on every page, is exactly
       the drift the pack exists to prevent, and it is worse for being invisible:
       nothing referenced it, so no inventory counted it.
       Collapsed to the token. THE VIOLET END STOP IS GONE AND THAT IS THE
       DECISION, not an oversight — --grad-rule runs ambient-start to ambient-mid
       and is the divider recipe this site already uses seven times over. A
       6px bar under the footer is a rule, so it takes the rule gradient. */
    background: var(--grad-rule);
  }

  .ca-footer {
    background: var(--c-panel);
    border-top: 1px solid var(--c-border);
  }

  .ca-footer-wrap {
    max-width: 1440px;
    margin-inline: auto;
    padding: var(--sec-pad-y) clamp(1rem, 3vw, 2.5rem) var(--stack-2);
  }

  /* THE TRUST ROW IS CENTRED. Owner report, 2026-08-02: the badges were "not
     centrally aligned". They sat flush left in a footer whose columns below run
     the full width, so the row read as an orphaned line rather than a banner
     across the top of the footer. The asterisk note under it centres with it,
     because a note that does not sit under the thing it annotates is worse than
     no note. */
  .ca-footer-credibility {
    margin-bottom: var(--sec-gap);
    text-align: center;
  }
  .ca-footer-trust-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--stack-1) clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
  }
  /* ICON TO TEXT. This row has a recorded defect where the tick sat off the
     text's optical centre. `align-items: center` on the row item does the
     alignment; the two additions are `flex: none` so a wrapping label cannot
     squash the 14px tick into an ellipse, and a line-height that matches the
     icon box so the flex centring has a stable box to centre against. */
  .ca-footer-trust-row li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-micro);
    line-height: 1.2;
    color: var(--c-text-sub);
  }
  .ca-footer-trust-row li svg {
    flex: none;
    display: block;
  }
  .ca-footer-trust-note {
    font-size: var(--t-micro);
    line-height: 1.5;
    color: var(--c-text-muted);
    margin: var(--stack-1) auto 0;
    max-width: 62ch;
  }

  .ca-footer-grid {
    display: grid;
    grid-template-columns: minmax(240px, 1.6fr) repeat(4, minmax(150px, 1fr));
    gap: var(--sec-gap) var(--stack-2);
  }

  .ca-footer-col-brand .ca-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-bottom: var(--stack-2);
  }
  .ca-logo-mark svg {
    display: block;
    width: 30px;
    height: 30px;
  }
  .ca-logo-word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-body);
    color: var(--c-text);
  }
  .ca-footer-tagline {
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--c-text-muted);
    max-width: 34ch;
    margin: 0 0 var(--stack-2);
  }
  .ca-footer-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: var(--stack-2);
  }
  .ca-footer-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-verified);
  }
  /* THE LEADING IS STATED BECAUSE THE DOCUMENT NOW HAS ONE. O-50, 2026-08-04.
     styles/tokens.css sets --lh-body on <body>, and this label had no leading of
     its own, so it would have taken the reading leading: measured, a 20.15px
     line box against 16px, which pushes the dot-and-sentence row 4.14px taller
     on all 43 routes. A one-line status label is scanned rather than read, which
     is the same argument styles/labels.css makes for the mono tier, so it takes
     the same tier's value from the same token. */
  .ca-footer-status-label {
    font-size: var(--t-micro);
    line-height: var(--lh-tight);
    color: var(--c-text-muted);
  }
  .ca-foot-social {
    display: flex;
    gap: 0.5rem;
  }
  /* ── 36px -> 44px, AND ONLY WHERE A FINGER IS THE POINTER ────────────────
   *
   * 2026-08-03. Measured at a 320px viewport across six routes: these were the
   * only standalone controls on the site between the WCAG 2.2 AA floor and a
   * comfortable touch target. Everything else was either already 44px, or over
   * 24px and deliberately so, or a visually hidden input whose LABEL is the
   * target.
   *
   * 36px clears SC 2.5.8, which asks for 24. It does not clear SC 2.5.5, which
   * asks for 44 and is AAA, and an icon-only circle is the exact case that
   * guidance is about: there is no text to widen the hit area and no label
   * beside it to catch a near miss.
   *
   * `(pointer: coarse)` SO THE DESKTOP FOOTER IS UNCHANGED. A mouse is precise
   * and 36px is right for it; growing these on desktop would put four 44px
   * circles in a footer row designed around 36. This is the one place on the
   * site where the correct size genuinely depends on the input device, so it is
   * the one place that asks. */
  .ca-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--c-border);
  }

  @media (pointer: coarse) {
    .ca-social-link {
      width: 44px;
      height: 44px;
    }
  }
  /* ── THE TRANSITION GOES ON THE THING THAT CHANGES. O-52, 2026-08-04 ─────
   *
   * The hover below repaints the ICON, not the anchor: `fill` is declared on the
   * <svg> child. styles/motion.css lists `fill` and `stroke` in its pointer
   * floor and applies that floor to the CONTROL — a, button, summary and the
   * rest — so widening the floor past <main> gives this anchor a transition for
   * a property that never changes on it, and the icon still snaps. Measured on
   * the built site: 215 of these across 43 routes, every one an instant jump
   * from --c-text-muted to --c-interactive.
   *
   * It is stated here rather than added to the floor's selector list because the
   * floor's contract is "every CONTROL answers a cursor", and an <svg> is not a
   * control. Reaching inside one from a sitewide rule would put a transition on
   * every drawn figure on the site — the strata, the lifecycle ring, the
   * reasoning trace — whose hovers light parts of an SVG with `filter` and
   * `stroke` and were deliberately left alone twice before. The general rule
   * covers the general case; this one icon states its own.
   *
   * NO MEDIA QUERY. --dur-fast collapses to 0.01ms under prefers-reduced-motion
   * in tokens.css, and nothing here moves — a colour arriving instantly is what
   * that setting asks for. */
  .ca-social-link svg {
    transition-property: fill;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }
  .ca-social-link:hover svg {
    fill: var(--c-interactive);
  }

  /* ── THE RECIPE IS GONE FROM HERE. A-61, 2026-08-04 ──────────────────────
   *
   * This block declared the display face, --t-micro, weight 800, 0.08em and
   * uppercase, and NavDropdown.astro declared the same five properties byte for
   * byte for its mega-menu column labels. Both now carry `grouplabel` from
   * styles/labels.css, which is the one place that recipe is written;
   * check-treatments.js rule 10 fails the build if any file under src/ but that
   * one declares it again.
   *
   * WHAT IS LEFT IS WHAT IS NOT THE RECIPE. Full-strength ink, because unlike
   * the mega-menu label this one titles a region of the page rather than
   * dividing a floating panel, and --stack-2 down to the links it names.
   *
   * THAT SENTENCE SAID "this one is a heading in the page" UNTIL O-45, and the
   * word was load-bearing: it was the justification for the ink AND it was a
   * description of the tag, which is now a <p> naming a <nav>. The argument for
   * full-strength ink survives the change unaltered — this label is the title of
   * a region a reader is looking at, and the mega-menu label is a divider inside
   * a panel they have opened — so only the word that described the markup moved.
   *
   * `margin: 0` MATTERS MORE THAN IT DID. On an <h3> it was overriding a user
   * agent margin measured in em of a 13px font; on a <p> it overrides
   * 1em/1em, which at 13px is 13px above and below. The declaration was already
   * here and already correct, and it is now doing real work rather than tidying. */
  .ca-footer-col-title {
    color: var(--c-text);
    margin: 0 0 var(--stack-2);
  }
  .ca-footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    /* ── THE `align-items: center` THAT USED TO BE HERE IS GONE ───────────
     *
     * It was added on 2026-08-03 as a consequence of styles/alignment.css
     * centring every word on the site from <body>. That reached the four column
     * titles above these links, left the links themselves hard against the
     * column's left edge, and the fix recorded here was to centre the links to
     * match — noted at the time as being worse than either answer on its own.
     *
     * IT WAS EVIDENCE, AND IT WAS READ AS A ONE-OFF. A sitewide rule needing a
     * hand-written correction in the footer meant the rule was reaching into
     * chrome, which is exactly what the owner reported the following day. The
     * authority has moved from <body> to <main>, so the footer is no longer
     * centred at all and there is nothing here to correct; see the scope note
     * at the top of styles/alignment.css for the argument.
     *
     * WITHOUT IT the column falls back to `align-items: stretch`, and because
     * each anchor below sets `width: fit-content` it shrink-wraps and sits at
     * the start of the cross axis — links on the column's left edge, under a
     * left-aligned title, which is what the reference build at :8092 renders.
     * Nothing replaces the declaration; the correct behaviour is the default
     * once the rule that broke it is out of the way. */
  }
  .ca-footer-links a {
    font-size: var(--t-body);
    color: var(--c-text-sub);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    /* ── WCAG 2.2 SC 2.5.8, TARGET SIZE (MINIMUM) ────────────────────────
     *
     * Measured at 390px: every one of these rendered 20px tall. 25 links on
     * every route, which is the same 25 on all 43 because they are one
     * component — the single largest accessibility defect on the site by count.
     *
     * THE INLINE EXEMPTION DOES NOT APPLY. 2.5.8 excuses a link inside a
     * sentence, because enlarging it would break the line. Classified in the
     * browser, 24 of the 25 are standalone links in a column with no sentence
     * around them, so they are targets and have to meet 24 by 24.
     *
     * min-height rather than padding, because these are already inline-flex, so
     * the box grows without moving the text or changing where a line wraps. The
     * 0.65rem column gap is unchanged, so the layout is identical and only the
     * hit area differs. */
    min-height: 24px;
  }
  .ca-footer-links a:hover {
    color: var(--c-interactive);
  }
  .ca-footer-free-chip {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
    /* STATED FOR THE SAME REASON AS THE STATUS LABEL ABOVE, O-50, and here it is
       geometry rather than rhythm: this is a pill with 1px of vertical padding,
       so its height IS its line box. Under the document leading it measures
       15.5px against the 12px the font's own `normal` was giving it — a 3.5px
       taller capsule inside a 24px link, for a two-word chip that can never wrap.
       A chip's shape is a decision; --lh-tight is the tier that keeps it.

       IT IS NOT QUITE A NO-OP AND SAYING SO IS THE POINT. 1.25 of 10px is
       12.5px, so the capsule is 0.5px taller than the font metric it replaces.
       That half-pixel is the difference between a value somebody chose and a
       value that came from whichever face the label happens to be set in, which
       is the whole argument for the base rule this line answers. */
    line-height: var(--lh-tight);
    text-transform: uppercase;
    /* --c-interactive, NOT --c-verified. The chip says a product is free; it
       says nothing about whether anything was traced to a source, and it sits
       INSIDE the anchor it labels, so it is part of a control. Painting it with
       the verified mark was the exact confusion the role layer exists to end.
       White fill, page-colour label: 20.13:1. */
    color: var(--c-interactive-fill-text);
    background: var(--c-interactive-fill);
    border-radius: var(--radius-chip);
    padding: 1px 6px;
  }

  .ca-footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: var(--sec-gap);
    padding-top: var(--stack-2);
    border-top: 1px solid var(--c-border);
    font-size: var(--t-micro);
    color: var(--c-text-muted);
  }
  .ca-footer-copyright {
    margin: 0;
  }
  .ca-footer-companies-house-link,
  .ca-footer-bottom-link {
    color: var(--c-text-muted);
    /* WCAG 2.2 SC 2.5.8 again, and these were the worst on the site: measured
       15px tall at 390px, eight of them, in a horizontal nav row with no
       sentence around them. The inline exemption covers a link constrained by
       the line-height of surrounding text; a row of standalone links is not
       that. inline-flex so the box can grow without disturbing the row. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .ca-footer-companies-house-link:hover,
  .ca-footer-bottom-link:hover {
    color: var(--c-interactive);
  }
  .ca-footer-bottom-link {
    margin-left: auto;
  }
  .ca-footer-bottom-link + .ca-footer-bottom-link {
    margin-left: 0;
  }

  @media (max-width: 900px) {
    .ca-footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .ca-footer-grid {
      grid-template-columns: 1fr;
    }
    .ca-footer-bottom-link {
      margin-left: 0;
    }
  }
</style>
