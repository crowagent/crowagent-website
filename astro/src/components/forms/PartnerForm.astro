---
/**
 * PartnerForm: the partner enquiry form.
 *
 * POSTS TO THE PLATFORM API, NOT A THIRD PARTY. Until 2026-09-03 this posted to
 * https://formspree.io/f/xbdpkaol, an undisclosed third party recipient per the
 * privacy policy (UK GDPR Art. 13(1)(e)) and an undocumented US transfer
 * (Ch. V), logged as website item OA-08. Owner decision 2026-09-03
 * (R281-PARTNERS-ENQUIRY-DECISION-01): point the form at the platform's own
 * `POST /api/v1/partners/enquiry` instead (`api/app/routers/partners.py:111`
 * in the platform repo). That closes the disclosure gap and the US transfer
 * at once: the enquiry now lands first party in the `partner_enquiries`
 * Supabase table, and CrowAgent ops is alerted by email from the same request.
 *
 * ENDPOINT is `https://crowagent-platform-production.up.railway.app`, the same
 * Railway host the platform's own production frontend calls
 * (`NEXT_PUBLIC_API_URL` in `web/.env.example`), so this form reaches the
 * identical backend the app does rather than a second copy of it. The route is
 * PUBLIC (`/api/v1/partners/enquiry` is in `EXEMPT_PATHS`,
 * `api/app/middleware/auth.py`, no JWT required), rate limited to 5 requests
 * per hour per caller, and `https://crowagent.ai` / `https://www.crowagent.ai`
 * were already in the API's CORS allowlist (`_always_allowed` in
 * `api/app/main.py`) and already in this site's own `connect-src` in
 * `_headers`, so reaching it needed no CORS or CSP change.
 *
 * PAYLOAD IS THE API'S OWN TEN FIELDS, NOTHING MORE: `name`, `company`,
 * `role`, `email`, `phone`, `partner_type`, `description`, `consent_text`,
 * `consented_at`, `turnstile_token`, matching `PartnerEnquiryRequest`
 * exactly. Same reasoning as OA-04 on the contact form and OA-32 on the
 * newsletter form: a field the schema does not declare is not invented on
 * the wire.
 *
 * [R281-PARTNERS-ENQUIRY-CONSENT-01, 2026-09-03] CLOSED the consent gap this
 * comment used to describe. `PartnerEnquiryRequest` now carries
 * `consent_text` (required, the visible consent sentence verbatim) and
 * `consented_at` (required, ISO timestamp at submit), lawful basis evidence
 * under UK GDPR Art. 7(1), and stores both in `partner_enquiries`
 * (`supabase/migrations/20269000000004_r281_partner_enquiries_consent_evidence.sql`,
 * platform repo). `turnstile_token` is sent too: the API best-effort
 * verifies it against Cloudflare's `/siteverify` when
 * `CLOUDFLARE_TURNSTILE_SECRET` is configured and records the outcome in
 * `turnstile_verified`, but a rejected, timed-out or unconfigured check
 * never refuses the enquiry, consent evidence stands on its own regardless.
 * The consent checkbox stays REQUIRED client-side.
 *
 * WHAT IS STILL BETTER HERE THAN ON THE LEGACY FORM:
 *   - errors are wired with aria-describedby and aria-invalid, and every error
 *     has text; the legacy blur handler revealed empty spans
 *   - the submit button is never left disabled by a rejection
 *   - success is read from the response, never assumed: a non-2xx answer shows
 *     a plain error rather than a false "sent" message
 *
 * FIELD NAMES ARE A WIRE CONTRACT with `PartnerEnquiryRequest`. Rename a label
 * freely. Never rename a `name` attribute without checking the Pydantic model.
 */
import Turnstile from './Turnstile.astro';
import '../../styles/forms.css';
import Button from '../ui/Button.astro';

/**
 * The Railway host the platform's own frontend calls (`NEXT_PUBLIC_API_URL`
 * in `web/.env.example`). See the file header for why this is the target
 * rather than `app.crowagent.ai`: the platform's Next.js app has no BFF route
 * for this form to go through, so this posts straight to the FastAPI route.
 */
const API_ENDPOINT = 'https://crowagent-platform-production.up.railway.app/api/v1/partners/enquiry';

interface Field {
  name: string;
  id: string;
  label: string;
  type: 'text' | 'email' | 'tel';
  required?: boolean;
  autocomplete?: string;
  placeholder?: string;
  error?: string;
}

const FIELDS: Field[] = [
  {
    name: 'name',
    id: 'pt-name',
    label: 'Full name',
    type: 'text',
    required: true,
    autocomplete: 'name',
    placeholder: 'Your name',
    error: 'Please enter your name.',
  },
  {
    name: 'company',
    id: 'pt-company',
    label: 'Company',
    type: 'text',
    required: true,
    autocomplete: 'organization',
    placeholder: 'Company name',
    error: 'Please enter your company name.',
  },
  {
    name: 'role',
    id: 'pt-role',
    label: 'Your role',
    type: 'text',
    required: true,
    autocomplete: 'organization-title',
    placeholder: 'Managing Director',
    error: 'Please enter your role.',
  },
  {
    name: 'email',
    id: 'pt-email',
    label: 'Work email',
    type: 'email',
    required: true,
    autocomplete: 'email',
    placeholder: 'you@company.com',
    error: 'Please enter a valid email address.',
  },
  {
    name: 'phone',
    id: 'pt-phone',
    label: 'Phone',
    type: 'tel',
    autocomplete: 'tel',
    placeholder: '+44 20 ...',
  },
];

const PARTNER_TYPES = [
  { value: '', label: 'Select...' },
  { value: 'Bid Agency', label: 'Bid Agency' },
  { value: 'Law Firm', label: 'Law Firm' },
  { value: 'NHS/Public Sector Advisor', label: 'NHS / Public Sector Advisor' },
  { value: 'Other', label: 'Other' },
];
---

<form
  id="partnerForm"
  class="form"
  method="POST"
  action={API_ENDPOINT}
  novalidate
>
  <div class="form__pot" aria-hidden="true">
    <label for="pt-website">Website</label>
    <input type="text" name="website" id="pt-website" tabindex="-1" autocomplete="off" />
  </div>

  {
    FIELDS.map((f) => (
      <div class="field">
        <label class="field__label" for={f.id}>
          {f.label}
          {f.required && <span class="field__req" aria-hidden="true">*</span>}
          {f.required && <span class="visually-hidden">(required)</span>}
        </label>
        <input
          class="field__input"
          type={f.type}
          id={f.id}
          name={f.name}
          required={f.required}
          autocomplete={f.autocomplete}
          placeholder={f.placeholder}
          aria-describedby={f.error ? `${f.id}-err` : undefined}
        />
        {f.error && (
          <p class="field__err" id={`${f.id}-err`} hidden>
            {f.error}
          </p>
        )}
      </div>
    ))
  }

  <div class="field">
    <label class="field__label" for="pt-type">
      Partner type
      <span class="field__req" aria-hidden="true">*</span>
      <span class="visually-hidden">(required)</span>
    </label>
    <select
      class="field__input"
      id="pt-type"
      name="partner_type"
      required
      aria-describedby="pt-type-err"
    >
      {PARTNER_TYPES.map((t) => <option value={t.value}>{t.label}</option>)}
    </select>
    <p class="field__err" id="pt-type-err" hidden>Please choose a partner type.</p>
  </div>

  <div class="field">
    <label class="field__label" for="pt-description">About your client base</label>
    <textarea
      class="field__input field__input--area"
      id="pt-description"
      name="description"
      rows="4"
      maxlength="200"
      placeholder="Briefly describe your client base..."
      aria-describedby="pt-description-help"></textarea>
    <p class="field__help" id="pt-description-help">Optional. Up to 200 characters.</p>
  </div>

  {/* [R281-PARTNERS-ENQUIRY-CONSENT-01, 2026-09-03] The token IS sent now and
      the API best-effort verifies it against Cloudflare's /siteverify
      (`app.services.turnstile.verify_turnstile_with_status`,
      `api/app/routers/partners.py`, platform repo) when
      `CLOUDFLARE_TURNSTILE_SECRET` is configured, recording the outcome in
      `turnstile_verified`. It never gates the enquiry either way: consent
      evidence (consent_text/consented_at) is the lawful basis record, this
      is a bot-abuse signal. `Turnstile.astro`'s own header comment carries
      the authoritative per-endpoint verified/unverified table, update that
      alongside this one rather than trusting this note in isolation. */}
  <Turnstile id="pt" />

  <div class="field field--consent">
    <label class="consent">
      <input
        type="checkbox"
        name="gdpr_consent"
        id="pt-consent"
        required
        aria-describedby="pt-consent-err"
      />
      <span>
        I agree that CrowAgent Ltd may process my data to evaluate this partner enquiry,
        in line with the <a href="/privacy/">Privacy Policy</a>.
      </span>
    </label>
    <p class="field__err" id="pt-consent-err" hidden>
      Please confirm you agree to the Privacy Policy before sending.
    </p>
  </div>

  <Button type="submit" id="ptSubmitBtn">Submit enquiry</Button>

  {/* [A-269 2026-09-08] The spinner and the tick are both in the markup and the
      state class shows one of them, so a transition changes a text node and a
      class rather than rebuilding the children of a live region. Only
      `.form__status-text` is ever written to. Same shape as the contact form,
      which is the point: three forms, one submit vocabulary. */}
  <p class="form__status" id="ptFormStatus" role="status" aria-live="polite" hidden>
    <span class="form__spinner" aria-hidden="true"></span>
    <svg class="form__tick" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
      <polyline points="20 6 9 17 4 12" />
    </svg>
    <span class="form__status-text"></span>
  </p>

  <noscript>
    <p class="form__noscript">
      This form needs JavaScript to send. Please email us directly at
      <a href="mailto:hello@crowagent.ai">hello@crowagent.ai</a>.
    </p>
  </noscript>
</form>

<script>
  /** Same definition as the contact form. One rule, so blur and submit agree. */
  const EMAIL_RE = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;

  function initPartnerForm() {
    const form = document.getElementById('partnerForm') as HTMLFormElement | null;
    if (!form) return;
    const btn = document.getElementById('ptSubmitBtn') as HTMLButtonElement | null;
    const status = document.getElementById('ptFormStatus');
    const consent = document.getElementById('pt-consent') as HTMLInputElement | null;
    const statusText = status?.querySelector<HTMLElement>('.form__status-text') ?? null;
    if (!btn || !status || !consent || !statusText) return;

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

    /* [A-269 2026-09-08] One place that changes the outcome region, so a stale
       state class cannot survive behind a fresh sentence. See ContactForm. */
    const setStatus = (state: 'busy' | 'ok' | 'bad', message: string) => {
      status.className = `form__status form__status--${state}`;
      statusText.textContent = message;
      status.hidden = false;
    };

    /* aria-busy is what distinguishes a control that is working from one that
       is broken. A disabled button on its own does not say which. */
    const setBusy = (busy: boolean) => {
      btn.disabled = busy;
      if (busy) btn.setAttribute('aria-busy', 'true');
      else btn.removeAttribute('aria-busy');
    };
    const val = (id: string) => ($<HTMLInputElement>(id)?.value ?? '').trim();

    const REQUIRED = ['pt-name', 'pt-company', 'pt-role', 'pt-email', 'pt-type'];

    function setError(id: string, show: boolean) {
      const err = $(`${id}-err`);
      const field = $(id);
      if (err) err.hidden = !show;
      if (field) field.setAttribute('aria-invalid', show ? 'true' : 'false');
    }

    function check(id: string): boolean {
      if (id === 'pt-email') return EMAIL_RE.test(val(id));
      return val(id).length > 0;
    }

    for (const id of REQUIRED) {
      const el = $(id);
      el?.addEventListener('blur', () => setError(id, !check(id)));
      const clear = () => {
        if (check(id)) setError(id, false);
      };
      el?.addEventListener('input', clear);
      el?.addEventListener('change', clear);
    }
    consent.addEventListener('change', () => {
      if (consent.checked) setError('pt-consent', false);
    });

    /* Turnstile loading, wording and the submit gate are owned by
       Turnstile.astro. Its capture-phase gate runs before this handler, so a
       token is guaranteed present below. */

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const pot = form.querySelector<HTMLInputElement>('[name="website"]');
      if (pot && pot.value) return; // bot; fail silently

      let ok = true;
      for (const id of REQUIRED) {
        const good = check(id);
        setError(id, !good);
        if (!good) ok = false;
      }
      if (!consent.checked) {
        setError('pt-consent', true);
        ok = false;
      }

      if (!ok) {
        const firstBad = [...REQUIRED, 'pt-consent'].find(
          (id) => $(`${id}-err`)?.hidden === false
        );
        if (firstBad) $<HTMLInputElement>(firstBad)?.focus();
        // Never strand the user on a dead button after a rejection.
        btn.disabled = false;
        return;
      }

      /* [A-269 2026-09-08] The wait is stated rather than left to a dead
         button. This form posts to the Railway API, which runs its own
         Turnstile check and its own persistence before it answers, so the
         reader can be waiting several seconds with nothing to read. */
      setBusy(true);
      btn.textContent = 'Sending...';
      setStatus('busy', 'Sending your enquiry...');

      /* Exactly the ten fields `PartnerEnquiryRequest` declares
         (`api/app/routers/partners.py`), nothing more. Optional fields go
         through as `null` rather than an empty string when blank, matching
         the model's `str | None`. */
      const orNull = (s: string) => (s.length ? s : null);

      /* [R281-PARTNERS-ENQUIRY-CONSENT-01] The visible consent sentence,
         verbatim, is the lawful basis record (UK GDPR Art. 7(1)), read from
         the DOM rather than retyped so it can never drift from what the
         reader actually saw. Whitespace is collapsed: the source markup
         wraps the sentence across lines for readability, textContent keeps
         the raw indentation and newlines. */
      const consentSpan = consent.closest('.consent')?.querySelector('span');
      const consentText = (consentSpan?.textContent ?? '').replace(/\s+/g, ' ').trim();

      fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          name: val('pt-name'),
          company: val('pt-company'),
          role: val('pt-role'),
          email: val('pt-email'),
          phone: orNull(val('pt-phone')),
          partner_type: orNull(val('pt-type')),
          description: orNull(val('pt-description')),
          consent_text: consentText,
          consented_at: new Date().toISOString(),
          turnstile_token:
            form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value ||
            null,
        }),
        /* [A-264 2026-09-08] 30s, for the reason measured on the contact form:
           a real submission there returned 200 on the server while the reader
           was shown a failure, because the client aborted at 10s. This form
           posts to the Railway API, which does its own Turnstile check and its
           own persistence, so it carries the same tail risk. The three forms
           keep one number so the next person changes one thing. */
        signal: AbortSignal.timeout(30000),
      })
        .then((r) => {
          // Success ONLY on a 2xx. A non-2xx (422 validation, 429 rate limit,
          // 500 DB error) falls through to the plain error below.
          if (!r.ok) throw new Error(String(r.status));
          form.reset();
          setError('pt-consent', false);
          setStatus('ok', "Enquiry received. We'll be in touch within 2 business days.");
          /* aria-busy off, disabled on. The work has finished, and the form has
             been reset, so a second press would post an empty enquiry. */
          setBusy(false);
          btn.disabled = true;
          btn.textContent = 'Enquiry sent';
        })
        .catch((err) => {
          /* [A-263 2026-09-07] Logged rather than discarded. See the same note
             in NewsletterForm.astro. This form is the one where it would have
             mattered most: on production it still posts to the Formspree
             endpoint this component was moved OFF, and the shipped CSP no
             longer permits that origin, so every submission is refused by the
             browser before it leaves the page. A discarded reason is exactly
             the evidence that would have named it. */
          console.error(
            JSON.stringify({
              level: 'error',
              service: 'partner-form',
              operation: 'submit',
              endpoint: form.action,
              error: err instanceof Error ? `${err.name}: ${err.message}` : String(err),
              timestamp: new Date().toISOString(),
            }),
          );
          setStatus('bad', 'Something went wrong. Please email hello@crowagent.ai directly.');
          setBusy(false);
          btn.textContent = 'Submit enquiry';
        });
    });
  }

  initPartnerForm();
</script>
