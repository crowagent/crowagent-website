---
/**
 * /partners
 *
 * ⚠️ CUTOVER BLOCKER ON THIS PAGE. The enquiry form POSTs to Formspree, a US
 * processor that privacy.html does not name, while the form's own consent line
 * promises processing "in line with the Privacy Policy". See OA-08. This page
 * must not go live on the new site until that is resolved. Porting it does not
 * make it worse; shipping it knowingly would.
 *
 * SEO carried over verbatim. Note that `description` and `og:description` are
 * DIFFERENT strings on the live page — two separately written sentences, both
 * already indexed — so they are kept distinct rather than unified.
 *
 * The H1 is the CORRECTED wording. As shipped, the two hero spans concatenated
 * to "Put CrowMark in front of to your clients.", which is not grammatical under
 * any reading and was the page's accessible name. Repaired in the legacy page
 * too, and logged as OA-11 in case a different headline was intended.
 */
import Base from '../layouts/Base.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';
import PartnerForm from '../components/forms/PartnerForm.astro';
import { breadcrumbs } from '../lib/schema';

const title = 'Partners | CrowAgent';
const description =
  'Partner with CrowAgent. Bid agencies, law firms and public sector advisors get revenue share, branded exports and a named contact.';
/** Deliberately a different sentence from `description`. Both are published. */
const ogDescription =
  'Deliver PPN 002 social value tools to your public-sector bidding clients, under your own brand.';

const schema = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Partners', path: '/partners' },
  ]),
];

const BENEFITS = [
  {
    kicker: 'Capability',
    heading: 'Branded reports',
    body: 'Branded PDF and DOCX exports carrying your own name, and one pool of AI credits allocated across every client you act for.',
  },
  {
    kicker: 'Support',
    heading: 'A named contact',
    body: 'Dedicated account contact and a priority support channel for rapid technical and regulatory guidance.',
  },
  {
    kicker: 'Growth',
    heading: 'Joint marketing',
    body: 'Co-branded regulatory updates you can send to your own client list, and joint write-ups of the work once there is work to write up.',
  },
];

/*
 * AUDIENCE CATEGORIES, NOT NAMED PARTNERS. Nothing here asserts an existing
 * commercial relationship with any organisation, and it must stay that way
 * unless there is a signed one to name.
 *
 * The live page shows only two cards while the hero, the meta description and
 * the form dropdown all name law firms as a third audience. That inconsistency
 * is carried over rather than invented away: adding a "Law firms" card would
 * mean writing a proposition nobody has approved.
 */
const AUDIENCES = [
  {
    heading: 'Bid agencies',
    body: 'Automate PPN 002 social value for all your client bids. Bulk credits and evidence tracker for all clients.',
  },
  {
    heading: 'Public sector advisors',
    body: 'PPN 002 social value scoring (CrowMark) for your public sector bidding clients.',
  },
];

const WHY = [
  'Revenue share on all client credits',
  'White-label PDF report generation',
  'Bulk credit allocation across your client portfolio',
];

/*
 * THE BOOKING LINK IS BACK (OA-28, 2026-08-02). partners.html:320-327 closes on
 * a "Ready to start?" band whose two actions are this Calendly link and
 * mailto:hello@crowagent.ai. The port folded that band's heading into "Express
 * your interest." and kept the mailto in the hero, but the booking link went
 * with the band, leaving the form as the only way a partner could start a
 * conversation. It returns inside the enquiry section, which is where the folded
 * band now lives, rather than as a new closing band — restoring the affordance,
 * not re-adding a section the port deliberately merged.
 */
const CALENDLY = 'https://calendly.com/crowagent-platform/30min';
---

<Base
  title={title}
  description={description}
  ogDescription={ogDescription}
  path="/partners"
  schema={schema}
>
  <Section
    title="Put CrowMark in front of your clients."
    standfirst="CrowAgent partners with bid agencies, law firms and public sector advisors who want to run PPN 002 social value and delivery evidence for their clients under their own brand. Revenue share, co-marketing and a priority support channel."
    id="partners-hero"
  
    as="h1">
    <div class="btn-row">
      <Button href="#partner-enquiry">Become a partner</Button>
      <Button href="mailto:hello@crowagent.ai" variant="secondary">Talk to us</Button>
    </div>
  </Section>

  {/*
    NO EYEBROW HERE. It read "What partners get" directly above an h2 reading
    "What partners get" — the same six words twice, one capsule apart, which is
    the only place on either page where the eyebrow said nothing the heading did
    not. The legacy section carries no visible head at all (its h2 is sr-only),
    so dropping the duplicate moves toward the legacy treatment rather than away
    from it. The heading itself stays, visible and centred: it is what the
    content-parity gate matches on, and a section of three cards with no heading
    is worse for a screen-reader user than a slightly redundant one.
  */}
  <Section title="What partners get" id="partner-benefits">
    <ul class="cards">
      {
        BENEFITS.map((b) => (
          <li class="cards__item surface surface--pad">
            <p class="kicker">{b.kicker}</p>
            <h3 class="cards__h">{b.heading}</h3>
            <p class="cards__body">{b.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    eyebrow="Ecosystem"
    title="Who we partner with."
    standfirst="Whether you write bids, advise on procurement or guide public sector clients, CrowMark does the PPN 002 arithmetic and the evidence tracking underneath your service."
    id="partner-audiences"
  >
    <ul class="cards cards--two">
      {
        AUDIENCES.map((a) => (
          <li class="cards__item surface surface--pad">
            <h3 class="cards__h">{a.heading}</h3>
            <p class="cards__body">{a.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    eyebrow="Enquiry"
    title="Express your interest."
    standfirst="Tell us who your clients are and how you work with them. We reply within two business days."
    id="partner-enquiry"
  >
    {/*
      COLUMN ORDER FOLLOWS THE LEGACY PAGE: the "Why partner?" panel on the
      left, the form on the right. The port had them the other way round and at
      1.4fr / 1fr, which put an unbounded list of ticks in a narrow right-hand
      gutter next to a form that was not bounded either, so neither column read
      as a thing. Two equal columns, each in its own container, is the legacy
      arrangement and it is also what makes the form look like somewhere you
      type rather than fields floating on the page.

      DOM order is the mobile order, and it matches the legacy stack: reasons to
      partner, then the form to do it with.
    */}
    <div class="enquiry">
      {/* `surface surface--pad` rather than a local copy of the card recipe.
          The two columns restated border, radius, background and shadow
          themselves and landed on --radius-panel, so they were the only 16px
          blocks on the page while every card beside them was 20px. */}
      <aside class="enquiry__aside surface surface--pad" aria-labelledby="why-partner-title">
        {/* A HEADING, NOT A KICKER. `.kicker` is the mono 13px label used on
            <p> above each card heading on this page; putting it on the <h3>
            that names this whole panel made the heading smaller than the list
            underneath it. It takes .enquiry__h, the card-tier heading. */}
        <h3 class="enquiry__h" id="why-partner-title">Why partner?</h3>
        <ul class="why">
          {WHY.map((w) => <li>{w}</li>)}
        </ul>

        <p class="enquiry__alt">
          Prefer to talk it through first? Book a 30-minute call to go through your client base
          before you sign anything.
        </p>
        <Button href={CALENDLY} variant="secondary" target="_blank">Book a 30-minute call</Button>
      </aside>

      <div class="enquiry__form surface surface--pad">
        <PartnerForm />
      </div>
    </div>
  </Section>
</Base>

<style>
  .kicker {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-mono);
    line-height: var(--lh-tight);
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  /* Centred to match the head block above it (owner decision, 2026-08-02).
     Alignment only: the row centres on the same axis as its heading. */

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 36px);
  }

  /*
   * TWO CARDS DO NOT FILL A THREE-CARD MEASURE. The legacy page wraps this pair
   * in `max-w-3xl mx-auto`, a narrower centred track, because two cards stretched
   * across the full 1160px measure read as a three-column grid with one card
   * missing. The port had them at full measure and it was the most visible
   * spacing difference on the page.
   *
   * Expressed as a fraction of --measure rather than the legacy's own 768px, so
   * the width still follows the one shared measure. Lands at 766px.
   */
  .cards--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: calc(var(--measure) * 0.66);
    margin-inline: auto;
  }

  /* The card treatment, the padding, the gloss, the hover and the centring of
     card content are all `surface surface--pad` in the markup. This block used
     to restate border, radius, background and shadow, which is the duplication
     styles/surfaces.css exists to end and the reason these cards did not centre
     when every other card did. */

  .cards__h {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 700;
    color: var(--c-text);
  }

  .cards__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text-sub);
  }

  /* Two equal columns, and a gap wide enough that the two bounded containers
     read as separate panels rather than one split box. The legacy page uses
     gap-32, i.e. 128px, at this breakpoint. */
  .enquiry {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 7vw, 112px);
    align-items: start;
  }

  /*
   * BOTH COLUMNS ARE BOUNDED, which is the legacy treatment and was the other
   * half of what made this section look unfinished. The reasons panel takes the
   * teal left accent the legacy page gives it; the form takes the card
   * treatment, so the fields sit on a surface instead of on the page.
   *
   * --radius-panel and --shadow-panel rather than the card pair: these are the
   * two largest blocks on the page and the panel tier is what that scale is for.
   */
  /* Everything the two columns share is `surface surface--pad` in the markup.
     What stays here is the one thing that is genuinely local: the teal edge
     that marks the aside as the supporting column. */
  .enquiry__aside { border-left: 3px solid var(--c-teal); }

  .enquiry__h {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
    letter-spacing: -0.01em;
    color: var(--c-text);
  }

  .why {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .why li {
    padding: 0.7rem 0 0.7rem 1.6rem;
    border-bottom: 1px solid var(--c-border);
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--c-text-sub);
    position: relative;
  }

  /* A typographic tick rather than an inline SVG per row: it is decorative,
     it is one character, and aria-hidden keeps it out of the accessible name. */
  .why li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--c-teal);
    font-weight: 700;
  }

  .why li:last-child { border-bottom: 0; }

  /* --blk-pad, not --sec-gap: this sits INSIDE a panel now, and a section-level
     gap between two blocks of a single panel is how a panel comes apart. */
  .enquiry__alt {
    margin: var(--blk-pad) 0 var(--stack-2);
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text-sub);
  }

  @media (max-width: 899px) {
    .cards, .cards--two { grid-template-columns: minmax(0, 1fr); }
    .enquiry { grid-template-columns: minmax(0, 1fr); }
  }
</style>
