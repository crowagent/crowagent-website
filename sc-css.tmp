
  /* Auto-advancing product showcase. Tabs drive panels; panels stack in one grid
     cell so the container height is the tallest panel: no layout shift on change. */
  .nb-show{display:grid;grid-template-columns:minmax(268px,336px) 1fr;gap:clamp(20px,3vw,38px);align-items:start}
  .nb-tabs{display:flex;flex-direction:column;gap:10px;margin:0;padding:0}
  /* Chromium centres a <button>'s content box regardless of text-align (it cannot be
     overridden from the children either), so lay the tab out as a grid and align the
     items to the start. That gives real left alignment without fighting the UA. */
  .page-home .nb-tab{position:relative;display:grid;justify-items:start;gap:0;width:100%;text-align:left;padding:15px 17px 17px;border:1px solid var(--nb-line);border-radius:16px;
    background:linear-gradient(180deg,color-mix(in srgb,var(--nb-panel) 82%,transparent),color-mix(in srgb,var(--nb-bg2) 60%,transparent));
    color:var(--nb-steel);cursor:pointer;overflow:hidden;min-height:44px;font-family:var(--nb-body);
    /* box-shadow is deliberately not transitioned: the site-wide focus ring is a
       box-shadow, and a focus indicator must appear instantly, not fade in. */
    transition:border-color .45s var(--nb-ease),background .45s var(--nb-ease),transform .45s var(--nb-ease)}
  .page-home .nb-tab:hover{border-color:var(--nb-line-str);color:var(--nb-ink)}
  /* Focus ring comes from the site-wide rule in nav-global-fix (transparent outline +
     teal box-shadow ring, set !important). Do not restate it here: it would be dead code. */
  .page-home .nb-tab.on{border-color:color-mix(in srgb,var(--acc) 52%,transparent);color:var(--nb-ink);
    background:linear-gradient(180deg,color-mix(in srgb,var(--acc) 12%,var(--nb-panel)),color-mix(in srgb,var(--nb-panel) 70%,transparent));
    box-shadow:0 22px 50px -30px color-mix(in srgb,var(--acc) 70%,transparent)}
  .nb-tab .tj{display:block;font:600 10.5px/1 var(--nb-mono);letter-spacing:.2em;text-transform:uppercase;color:var(--acc);opacity:.85}
  .nb-tab .tk{display:flex;align-items:center;gap:9px;margin-top:9px;font:800 1.12rem/1.15 var(--nb-display);letter-spacing:-.02em;color:inherit}
  .nb-tab .tk i{width:7px;height:7px;border-radius:50%;background:var(--acc);flex:none;box-shadow:0 0 9px color-mix(in srgb,var(--acc) 75%,transparent)}
  .nb-tab .td{display:block;margin-top:7px;font:400 13px/1.5 var(--nb-body);color:var(--nb-mist)}
  .nb-tab .tp{position:absolute;left:0;right:0;bottom:0;height:2px;background:color-mix(in srgb,var(--nb-line-str) 60%,transparent);opacity:0;transition:opacity .35s var(--nb-ease)}
  .nb-tab.on .tp{opacity:1}
  .nb-tab .tp i{display:block;height:100%;width:100%;transform-origin:left center;transform:scaleX(var(--p,0));transition:none;
    background:linear-gradient(90deg,var(--acc),color-mix(in srgb,var(--acc) 40%,var(--nb-cyan)))}
  .nb-showfoot{display:flex;align-items:center;gap:11px;margin-top:14px;padding-left:2px}
  .page-home .nb-play{display:inline-grid;place-items:center;width:44px;height:44px;flex:none;border-radius:12px;border:1px solid var(--nb-line-str);
    background:color-mix(in srgb,var(--nb-panel) 70%,transparent);color:var(--nb-steel);cursor:pointer;transition:border-color .3s,color .3s}
  .page-home .nb-play:hover{border-color:var(--nb-teal);color:var(--nb-ink)}
  .nb-play svg{width:15px;height:15px}
  .nb-play .ic-pause{display:block}.nb-play .ic-play{display:none}
  .nb-play[aria-pressed="true"] .ic-pause{display:none}.nb-play[aria-pressed="true"] .ic-play{display:block}
  .nb-showfoot .lbl{font:500 12px/1.5 var(--nb-mono);letter-spacing:.05em;color:var(--nb-faint)}

  .nb-panels{position:relative;display:grid}
  .nb-panel{grid-area:1/1;opacity:0;visibility:hidden;transform:translate3d(0,14px,0) scale(.985);
    transition:opacity .7s var(--nb-ease),transform 1s var(--nb-ease),visibility 0s linear .7s}
  .nb-panel.on{opacity:1;visibility:visible;transform:none;transition-delay:0s,0s,0s}
  .nb-panel .nb-frame{box-shadow:0 40px 92px -36px color-mix(in srgb,var(--acc) 62%,transparent),0 20px 60px -32px color-mix(in srgb,var(--nb-violet-d) 55%,transparent)}
  .nb-panel .nb-frame{background:linear-gradient(135deg,color-mix(in srgb,var(--acc) 68%,transparent),color-mix(in srgb,var(--nb-violet) 40%,transparent) 60%,color-mix(in srgb,var(--nb-sky) 34%,transparent))}
  .nb-panel .nb-shot{aspect-ratio:3/2}
  /* Worked-example marker. Two of the four screens carry an overlay that fills a
     live-but-empty account with example figures, so those two say so on the frame
     itself. Understated on purpose: it sits in the browser chrome beside the URL,
     at the same weight as the Live pip, not as a banner over the screen. */
  .nb-chrome .samp{margin-left:auto;display:inline-flex;align-items:center;gap:6px;
    padding:3px 9px;border:1px solid var(--nb-line-str);border-radius:999px;
    font:600 9.5px/1 var(--nb-mono);letter-spacing:.13em;text-transform:uppercase;color:var(--nb-mist)}
  .nb-chrome .samp i{width:5px;height:5px;border-radius:50%;background:var(--nb-mist);flex:none}
  .nb-chrome .samp + .live{margin-left:10px}
  /* On narrow frames the URL is the least load-bearing thing in the bar, so it
     yields first. The worked-example marker is never the thing that gets dropped. */
  @media(max-width:520px){.nb-frame .nb-chrome > span:not(.samp):not(.live){display:none}}
  /* Captions stay centred: nav-global-fix force-centres every section descendant
     (!important), which is the page-wide convention the section header follows too. */
  .nb-pcap{margin-top:20px}
  .page-home .nb-pcap h3{font:800 clamp(1.18rem,2.2vw,1.55rem)/1.2 var(--nb-display);letter-spacing:-.02em;color:var(--nb-ink);margin:0;text-wrap:balance}
  /* margin-inline must be auto: the 60ch measure otherwise pins the block left while its
     text is centred, leaving the caption visibly off-centre under the frame. */
  .page-home .nb-pcap p{color:var(--nb-steel);font-size:14.5px;line-height:1.62;margin:11px auto 0;max-width:60ch}
  .nb-pcap .nb-chips{margin-top:16px}
  .nb-pcap .nb-chips span{border-color:color-mix(in srgb,var(--acc) 26%,var(--nb-line))}
  .nb-pcap .go{display:inline-flex;align-items:center;gap:7px;margin-top:16px;min-height:44px;color:var(--acc);font:600 14px/1 var(--nb-body)}
  .nb-pcap .go svg{width:15px;height:15px;transition:transform .3s var(--nb-ease)}
  .nb-pcap .go:hover svg{transform:translateX(4px)}

  @media(max-width:960px){
    .nb-show{grid-template-columns:1fr}
    .nb-tabs{flex-direction:row;flex-wrap:wrap}
    .page-home .nb-tab{flex:1 1 calc(50% - 5px);padding:13px 15px 15px}
    .nb-tab .td{display:none}
    .nb-tab .tk{font-size:1rem;margin-top:7px}
  }
  /* Keep two across on phones so the product screenshot stays near the top of the
     section; drop to one column only when two would get cramped. */
  @media(max-width:359px){
    .page-home .nb-tab{flex:1 1 100%}
  }
  @media (prefers-reduced-motion:reduce){
    .nb-panel{transition:none!important}
    .nb-tab,.nb-play{transition:none!important}
    .nb-tab .tp{display:none}
  }
