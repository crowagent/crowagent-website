    color: var(--app-refused);
  }

  /* The verdict, the one dark-on-light refusal band. */
  /* ── THE VERDICT SETTLES, ONCE, AT THE MOMENT THE CLAIM IS STRUCK ──────
   *
   * This is the one moment of emphasis left on the page, and it is here
   * because this sentence is the page's argument: the engine found a figure it
   * could not trace and took it out. Everything else on this section resolves
   * quietly in reading order; this arrives.
   *
   * `--land` is the same reel threshold the strike-through uses, offset a
   * fraction later so the verdict follows the strike rather than racing it.
   * clamp() holds it at 0 before and 1 after, so the resting state IS the
   * finished state: a browser with no script, a print, or a reader who has
   * scrolled past all see the verdict fully landed, and nothing here is ever
   * missing.
   *
   * TRANSFORM ONLY, AND UNDER ONE MOVE. It rises 6px and settles. It does not
   * fade, because a verdict that fades in can be caught half-said; it does not
   * bounce, because a bounce on a refusal is a cartoon; and it does not scale,
   * because scaling type at this size softens it for the frames that matter.
   * A single 6px rise over roughly a fifth of a second of scroll is what the
   * research on this calls a settle, and one settle on one element is the
   * whole budget this page has for emphasis. */
  .h2rt__verdict {
    --land: clamp(0, calc((var(--reel, 1) - 0.58) * 12), 1);
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
    padding: var(--space-3);
    border-radius: var(--radius-chip);
    border: 1px solid
      color-mix(
        in srgb,
        var(--app-refused) calc(var(--land) * 35%),
        var(--app-card)
      );
    background-color: color-mix(
      in srgb,
      var(--app-refused-tint) calc(var(--land) * 100%),
      transparent
    );
    transform: translateY(calc((1 - var(--land)) * 6px));
  }

  .h2rt__badge {
    flex: 0 0 auto;
    /* The badge takes its ground from the same number, so the label reads as
       ink on the card until the verdict has actually been reached. */
    background-color: color-mix(
      in srgb,
      var(--app-refused) calc(var(--land) * 100%),
      transparent
    );
    color: color-mix(in srgb, var(--app-card) calc(var(--land) * 100%), var(--app-refused));
  }

  .h2rt__verdict-text {
    font-size: var(--t-micro);
    line-height: 1.5;
    color: var(--app-ink-sub);
  }

