---
/**
 * Article.astro — the blog post layout.
 *
 * One h1 (the article headline), a 720px reading measure for the prose
 * column, and a heading hierarchy of h1 (this layout) -> h2/h3 (inside the
 * rendered Markdown body) so no post ever emits two h1s or skips a level.
 */
import Base from './Base.astro';
import ShareRow from '../components/blog/ShareRow.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import { blogPosting, breadcrumbs, faqPage } from '../lib/schema';
import type { FaqEntry } from '../lib/schema';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: string;
  readingTime?: number;
  /*
   * Question/answer pairs from the post's frontmatter. Optional because only
   * 5 of the 8 posts carry them; faqPage() returns an empty array for the
   * rest rather than an FAQPage with zero questions, which is a structured
   * data error rather than a neutral omission.
   */
  faq?: FaqEntry[];
}

const {
  title,
  description,
  path,
  image,
  publishedAt,
  updatedAt,
  category,
  readingTime,
  faq,
} = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

/*
 * Structured data is DERIVED here, not passed in by each route.
 *
 * This layout is the thing that knows a page is an article, so it is the thing
 * that should say so in JSON-LD. Every /blog entry gets BlogPosting and a
 * breadcrumb trail with no per-post work and nothing for an author to remember.
 *
 * A parity run against the legacy site caught all 8 ported posts emitting only
 * an Organization node where legacy emitted BlogPosting. That is live SEO
 * surface which would have been destroyed silently at cutover. Fixing it in the
 * layout rather than in 8 files is the difference between closing the gap and
 * closing it in a way that cannot reopen.
 */
const schema = [
  blogPosting({ title, description, path, publishDate: publishedAt, updatedDate: updatedAt, image }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: title, path },
  ]),
  /*
   * FAQPage. Five legacy posts published one and the port dropped all five,
   * which a structured-data parity run caught (OA-24). The helper and the
   * frontmatter field both already existed; nothing ever connected them, so
   * the site kept passing every check while losing five rich results.
   */
  ...faqPage(faq),
];

/*
 * The share row and the related-articles rail are OWNED BY THIS LAYOUT, not by
 * the eight markdown files. Both existed on every legacy post and both were
 * lost by the port (OA-28); putting them here is what stops the next post from
 * shipping without them, and it is the same reasoning as the JSON-LD above.
 *
 * `path` is the route ("/blog/some-post"), so the slug is its last segment and
 * the canonical URL is the origin plus the path. Neither is passed in
 * separately: two sources for one identity is how a share link ends up
 * pointing at the wrong post.
 */
const slug = path.replace(/^\/blog\//, '').replace(/\/$/, '');
const canonicalUrl = `${SITE.origin}${path}`;
---

<Base
  title={`${title} | CrowAgent`}
  description={description}
  path={path}
  image={image}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  schema={schema}
>
  <article class="article">
    <p class="article-eyebrow">{category}</p>
    <h1>{title}</h1>
    <p class="article-meta">
      <span>CrowAgent Editorial</span>
      <span aria-hidden="true">&middot;</span>
      <time datetime={publishedAt.toISOString()}>{dateFormatter.format(publishedAt)}</time>
      {readingTime && (
        <>
          <span aria-hidden="true">&middot;</span>
          <span>{readingTime} min read</span>
        </>
      )}
    </p>
    {/* Under the byline and again at the foot, which is where both rows sit on
        the live post. */}
    <ShareRow title={title} url={canonicalUrl} position="top" />
    <div class="article-body">
      <slot />
    </div>
    <ShareRow title={title} url={canonicalUrl} position="end" />
  </article>
  <RelatedPosts slug={slug} />
</Base>

<style>
  .article {
    max-width: 720px;
    margin-inline: auto;
    padding: var(--sec-pad-y) 1.5rem;
  }

  /*
   * CENTRED HEAD BLOCK, GRADIENT EYEBROW — owner decision, 2026-08-02. The
   * canonical implementation is components/layout/Section.astro; this layout
   * builds its own head, so the same two rules are restated here rather than
   * inherited.
   *
   * SCOPED ELEMENT BY ELEMENT, NOT ON .article. There is no head wrapper in
   * this template: the eyebrow, h1, meta line and .article-body are siblings.
   * A text-align on the parent would therefore centre the 720px prose column
   * as well, which is the exact mistake the legacy stylesheet made (sixteen
   * element types centred inside every section, then 138 per-element opt-outs
   * across 24 pages to escape it). Long-form reading stays left-aligned.
   */
  .article-eyebrow,
  h1 {
    text-align: center;
  }

  .article-eyebrow {
    /* A block with width: fit-content rather than the inline-block Section.astro
       uses. Section can rely on the head wrapper's text-align to centre an
       inline-block; there is no wrapper here, so the capsule has to centre
       itself with auto margins. */
    display: block;
    width: fit-content;
    margin: 0 auto var(--stack-1);
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  /*
   * background-clip: text needs a transparent fill, and an inherited
   * -webkit-text-fill-color is what caused this site's invisible-text P0. The
   * @supports gate leaves a solid readable colour in any engine without
   * support, and the declaration reaches one short category label and nothing
   * else — never the article body.
   */
  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .article-eyebrow {
      background: var(--grad-spectrum);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--t-h1);
    font-weight: var(--t-w-h1);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--stack-2);
    color: var(--c-text);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    /* The byline sits in the head block, where a standfirst would, so it
       centres with it. text-align cannot do this on a flex container. */
    justify-content: center;
    align-items: center;
    color: var(--c-text-muted);
    font-size: var(--t-body);
    margin: 0 0 var(--sec-gap);
  }

  .article-body :global(h2) {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: var(--t-w-h3);
    line-height: 1.2;
    margin: 2.5rem 0 1rem;
    color: var(--c-text);
    scroll-margin-top: 6rem;
  }

  .article-body :global(h3) {
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 700;
    line-height: 1.25;
    margin: 2rem 0 0.85rem;
    color: var(--c-text);
    scroll-margin-top: 6rem;
  }

  .article-body :global(p) {
    font-family: var(--font-body);
    font-size: var(--t-lede);
    line-height: 1.75;
    color: var(--c-text-sub);
    margin: 0 0 1.5rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    font-family: var(--font-body);
    font-size: var(--t-lede);
    line-height: 1.75;
    color: var(--c-text-sub);
    margin: 0 0 1.5rem;
    padding-inline-start: 1.5rem;
  }

  .article-body :global(li) {
    margin: 0 0 0.65rem;
  }

  .article-body :global(a) {
    color: var(--c-teal);
    font-weight: 600;
    /*
     * A URL used as its own link text has no spaces, so it cannot wrap and it
     * pushes the whole page sideways. Measured on /blog/ppn-002-social-value-guide
     * at 390px: a gov.uk collections URL ran to 396.8px against a 390px viewport,
     * taking document scrollWidth to 397 and giving mobile Safari a horizontal
     * scrollbar. WebKit only — Chromium's font metrics happened to fit, which is
     * exactly why one engine is not a test.
     *
     * `anywhere` rather than `break-word`: it also reduces the element's
     * min-content contribution, so the link cannot force its container wider in
     * the first place.
     */
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--c-border-glow);
    background: var(--c-card);
    border-radius: var(--radius-panel);
    color: var(--c-text-sub);
  }

  .article-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .article-body :global(pre) {
    margin: 1.5rem 0;
    padding: 1.25rem 1.5rem;
    background: var(--c-panel);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-panel);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--t-body);
    color: var(--c-text-sub);
  }

  .article-body :global(strong) {
    color: var(--c-text);
    font-weight: 800;
  }

  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--c-border);
    margin: 2.5rem 0;
  }
</style>
