---
import { getCollection, render } from 'astro:content';
import Sector from '../../layouts/Sector.astro';

export async function getStaticPaths() {
  const pages = await getCollection('sectors');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const d = page.data;
---

<Sector
  title={d.title}
  description={d.description}
  ogDescription={d.ogDescription}
  ogImageAlt={d.ogImageAlt}
  path={`/sectors/${page.id}`}
  sectorLabel={d.sectorLabel}
  heroTitleAccent={d.heroTitleAccent}
  heroDescription={d.heroDescription}
  contextEyebrow={d.contextEyebrow}
  contextHeading={d.contextHeading}
  helpsHeading={d.helpsHeading}
  steps={d.steps}
  helpsIntro={d.helpsIntro}
  figure={d.figure}
  faqHeading={d.faqHeading}
  finalCtaSub={d.finalCtaSub}
  faq={d.faq}
>
  <Content />
</Sector>
