---
/**
 * HOME 2.0: ONE CAROUSEL, TWO USES.
 *
 * The product tour (five slides, one visible at a time) and the proof carousel
 * (three cards plus a peek of the next). The difference between them is the
 * slide width and nothing else, so it is a prop rather than a second component.
 *
 * ── THE TRACK IS A NATIVE SCROLL-SNAP TRACK ────────────────────────────────
 *
 * The browser owns the momentum, the rubber banding and the touch swipe, and
 * every one of those is better than a reimplementation. Reading the current
 * slide is then a matter of asking where the track actually IS, which is the
 * same argument styles/motion.css makes for a view timeline over an observer: a
 * position cannot be wrong, and an event can fail to fire.
 *
 * WITH NO JAVASCRIPT AT ALL the track is still a usable, scrollable, keyboard
 * reachable list of cards. The script adds the arrows, the dots and the
 * autoplay. It cannot take anything away, because nothing here is hidden.
 *
 * ── THE FIRST CARD NEVER CLIPS ─────────────────────────────────────────────
 *
 * The track is full bleed so a card can peek past the right edge, and its
 * inline padding is computed back up to the page gutter, so the first card's
 * left edge lands exactly on the measure that every other section starts at.
 * `scroll-padding-inline-start` matches it, so a snap never parks a card under
 * that padding. The Figma board draws the first card clipped and that is the
 * one thing on it that is not copied.
 *
 * ── AUTOPLAY ───────────────────────────────────────────────────────────────
 *
 * The 6s dwell is a CSS animation on the active dot's progress line, and the
 * script advances on its `animationend`. That puts the pause conditions in CSS
 * where they belong: `:hover` and `:focus-within` pause the line, and the
 * script adds `document.hidden` by writing one attribute. Under
 * `prefers-reduced-motion: reduce` the animation does not exist, so the line
 * never ends, so nothing ever advances. There is no second code path to keep in
 * step with the first.
 */
interface Props {
  /** Names the carousel for a screen reader. */
  label: string;
  /** How many slides the caller has put in the slot. */
  count: number;
  /** `single` shows one slide, `peek` shows a row with the next card peeking. */
  fit?: 'single' | 'peek';
  /** Milliseconds each slide holds before the next. */
  interval?: number;
  class?: string;
}

const { label, count, fit = 'single', interval = 6000, class: className = '' } = Astro.props;
const dots = Array.from({ length: count }, (_, i) => i);
---

<div
  class:list={['h2car', `h2car--${fit}`, className]}
  data-h2car
  data-h2car-count={count}
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  style={`--h2car-interval: ${interval}ms`}
>
  {/*
    A DIV AND NOT A UL, AND THE REASON IS MEASURED. The slides have to carry
    `role="group"` with an "n of N" name, and `group` is not an allowed role on
    an <li>. With the list markup, axe reported `list` as SERIOUS on both
    carousels (a <ul> whose children are no longer listitems) and
    `aria-allowed-role` on all nine slides. Dropping the list semantics fixes
    both, and loses nothing: the slides are a carousel, which is what the region
    already announces, not a list.

    `tabindex="0"` because this element scrolls. axe's
    `scrollable-region-focusable` is right that a region a mouse can scroll and
    a keyboard cannot is unreachable, and the arrows and dots do not answer it,
    because they move a slide at a time rather than scrolling the region.
  */}
  <div class="h2car__rail">
    <div class="h2car__track" data-h2car-track tabindex="0">
      <slot />
    </div>
  </div>

  <div class="h2car__foot">
    <button class="control h2car__arrow" type="button" data-h2car-prev aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <div class="h2car__dots" data-h2car-dots>
      {
        dots.map((i) => (
          <button
            class="h2car__dot"
            type="button"
            data-h2car-dot
            aria-label={`Go to slide ${i + 1} of ${count}`}
            aria-current={i === 0 ? 'true' : 'false'}
          >
            <span class="h2car__dot-pip" aria-hidden="true">
              <span class="h2car__dot-fill"></span>
            </span>
          </button>
        ))
      }
    </div>

    <button class="control h2car__arrow" type="button" data-h2car-next aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <p class="visually-hidden" aria-live="polite" data-h2car-live></p>
</div>

<style>
  /* ── THE GUTTER IS A RAIL, NOT AN ARITHMETIC ────────────────────────────
   *
   * THIS WAS A PERCENTAGE AND THE PERCENTAGE WAS THE DEFECT. The track used to
   * be full bleed with
   * `padding-inline: max(--gutter, (100% - --measure) / 2 + --gutter)` and the
   * same expression in `scroll-padding-inline-start`. Those two look identical
   * and are not: a percentage in `padding` resolves against the CONTAINING
   * BLOCK's inline size, and a percentage in `scroll-padding` resolves against
   * the SCROLLPORT. While the page sits still the two boxes are the same width
   * and the pair agrees. Change the width and they disagree, the inline snap
   * re-resolves against the mismatched pair, and the scroll offset it lands on
   * is wrong.
   *
   * MEASURED ON 2026-09-03 AT 1440, and the numbers are the argument. At load,
   * `scrollLeft` 0 with the first card's left edge at 104px, which is exactly
   * the page gutter. After a full page screenshot, `scrollLeft` 94 with the
   * card at 10px: 94px of the first card cut off. Isolated by experiment:
   * `scroll-snap-type: none` survives the capture unchanged, and both
   * `proximity` and `mandatory` shift by the same 94px, so it is the snap
   * re-resolving and not the capture moving the page. That is what the Figma
   * board's clipped first card was a picture of.
   *
   * THE FIX REMOVES THE PERCENTAGE RATHER THAN COMPENSATING FOR IT. A rail at
   * the site's own measure gives the track a left edge that is already on the
   * gutter, so both the padding and the scroll padding become the plain length
   * `var(--gutter)` and cannot disagree with each other under any width. The
   * bleed is applied to the RIGHT edge only, where the peek is and where
   * nothing aligns to anything, so the one viewport unit left in the file
   * cannot misalign a card. */
  .h2car {
    position: relative;
    --h2car-gap: var(--space-5);
    --h2car-bleed: max(0px, calc((100vw - var(--measure)) / 2));
    /* Contains the right hand bleed so a negative margin can never widen the
       document. The track's own scrolling is internal and is unaffected. */
    overflow-x: clip;
  }

  .h2car__rail {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .h2car__track {
    display: flex;
    gap: var(--h2car-gap);
    margin: 0 calc(-1 * var(--h2car-bleed)) 0 0;
    padding: 0 var(--gutter) var(--space-2);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scroll-padding-inline-start: var(--gutter);
    scrollbar-width: none;
  }

  .h2car__track::-webkit-scrollbar {
    display: none;
  }

  .h2car__track:focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: -3px;
  }

  /* The card is the caller's element. The track only decides how wide it is and
     where it snaps, so a slide can be a schematic or a case study card without
     this file knowing which. */
  .h2car__track > :global(*) {
    flex: 0 0 var(--h2car-slide);
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* ── THE PEEK FIT SNAPS BY PROXIMITY, AND THE ROW IS WHY ────────────────
   *
   * In the peek fit at 1440 three and a half cards are already on screen, so
   * the track has 186px of scroll range while the start-aligned snap positions
   * are 0, 379, 758 and 1137. Only the first is reachable. `mandatory` means
   * the container must always REST on a snap point, so it pulled every attempt
   * to reach the tail straight back to zero and the fourth card could not be
   * brought fully into view by the arrows, the dots, a swipe or a drag.
   *
   * ALIGNING THE LAST SLIDE BY ITS END WAS TRIED FIRST AND WAS WORSE, which is
   * recorded because the idea is the obvious one and somebody will have it
   * again. It does create a reachable snap point at the end, and it also makes
   * that end the target the snap resolves to on any programmatic scroll:
   * measured, `scrollTo({ left: 0 })` on a track sitting at 0 came back
   * reporting 186. A carousel that jumps to its last card when asked for its
   * first is worse than one whose tail is hard to reach.
   *
   * `proximity` snaps when the reader stops near a card boundary and otherwise
   * leaves the track where they put it, which is exactly right for a row that
   * is nearly all on screen. The single fit keeps `mandatory`, because there
   * every snap position is reachable and a slide at a time is the whole point. */
  .h2car--peek .h2car__track {
    scroll-snap-type: inline proximity;
  }

  /* One slide fills the track's content box, which the rail has already capped
     at the measure less its two gutters. */
  .h2car--single {
    --h2car-slide: 100%;
    --h2car-bleed: 0px;
  }

  .h2car--peek {
    --h2car-slide: min(84vw, 21rem);
  }

  /* 3.55 slides across the content column, so the fourth shows the 55 percent
     peek the board draws. Below this width the phone shows one card and a hint
     of the next, which is the same idea at a size where three would be
     unreadable. */
  @media (min-width: 62rem) {
    .h2car--peek {
      /* THE BLEED IS PART OF THE VISIBLE WIDTH AND WAS MISSING FROM THIS SUM.
         The row runs from the page gutter to the RIGHT EDGE OF THE VIEWPORT,
         not to the right edge of the measure, so the width to divide is the
         measure less its leading gutter PLUS the bleed. Measured at 1440 with
         the old sum: cards came out at 330px, four of them very nearly filled
         the track, and the whole carousel had 69px of scroll range, so the
         fourth card was not a 55 percent peek and the arrows moved almost
         nothing. With the bleed counted the card is 359px, three sit inside the
         measure, and the fourth shows 198px, which is 0.55 of a card. */
      --h2car-slide: calc(
        (var(--measure) - var(--gutter) + var(--h2car-bleed) - 3 * var(--h2car-gap)) / 3.55
      );
    }
  }

  /* The peek fades at the inline END only. Masking the start would clip the
     first card, which is the defect this component is written not to have. */
  .h2car--peek .h2car__track:not(:focus-within) {
    -webkit-mask-image: linear-gradient(
      to right,
      rgb(0 0 0) calc(100% - 80px),
      transparent 100%
    );
    mask-image: linear-gradient(to right, rgb(0 0 0) calc(100% - 80px), transparent 100%);
  }

  .h2car__foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
    padding-inline: var(--gutter);
  }

  .h2car__arrow {
    inline-size: var(--btn-h-sm);
    block-size: var(--btn-h-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: var(--radius-pill);
    --ctl-ink: var(--c-text);
  }

  .h2car__arrow svg {
    inline-size: 1rem;
    block-size: 1rem;
    flex: 0 0 auto;
  }

  .h2car__arrow:focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: 3px;
  }

  .h2car__dots {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* 44px tall so the target clears the WCAG 2.2 floor with room, while the
     visible mark stays small. */
  .h2car__dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 28px;
    block-size: var(--btn-h-sm);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .h2car__dot:focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: 2px;
    border-radius: var(--radius-pill);
  }

  .h2car__dot-pip {
    display: block;
    inline-size: 7px;
    block-size: 7px;
    border-radius: var(--radius-pill);
    background-color: var(--c-text-muted);
    overflow: hidden;
    transition:
      inline-size var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .h2car__dot[aria-current='true'] .h2car__dot-pip {
    inline-size: 34px;
    background-color: color-mix(in srgb, var(--c-text) 22%, transparent);
  }

  .h2car__dot-fill {
    display: block;
    block-size: 100%;
    inline-size: 100%;
    background-color: var(--c-teal);
    transform-origin: 0 50%;
    /* Rest is the finished bar, so a dot with no animation reads as a solid
       active dot rather than as an empty one. */
  }

  .h2car__dot:not([aria-current='true']) .h2car__dot-fill {
    background-color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .h2car[data-h2car-play='on'] .h2car__dot[aria-current='true'] .h2car__dot-fill {
      animation: h2car-progress var(--h2car-interval) var(--m-ease-travel) 1;
      animation-play-state: var(--h2car-state, running);
    }

    .h2car:hover,
    .h2car:focus-within {
      --h2car-state: paused;
    }

    .h2car[data-h2car-paused='true'] {
      --h2car-state: paused;
    }
  }

  /* Scale only, and it ends where the dot rests. */
  @keyframes h2car-progress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  @media (forced-colors: active) {
    .h2car__dot-pip {
      border: 1px solid CanvasText;
    }
  }
</style>

<script>
  interface Car {
    root: HTMLElement;
    track: HTMLElement;
    slides: HTMLElement[];
    dots: HTMLElement[];
    live: HTMLElement | null;
    index: number;
  }

  function markActive(c: Car, index: number, announce: boolean): void {
    c.index = Math.max(0, Math.min(index, c.slides.length - 1));
    c.dots.forEach((d, i) => d.setAttribute('aria-current', i === c.index ? 'true' : 'false'));
    if (announce && c.live) {
      c.live.textContent = `Slide ${c.index + 1} of ${c.slides.length}`;
    }
    /* The one thing another component may know about this one. The product tour
       listens for it to keep its stage pills in step, and sends `h2car:goto`
       back the other way. Nothing reaches inside either component. */
    c.root.dispatchEvent(new CustomEvent('h2car:change', { detail: { index: c.index } }));
  }

  /*
   * ── THE ORIGIN IS SLIDE ZERO, NOT THE TRACK ───────────────────────────────
   *
   * This read `target.offsetLeft - track.offsetLeft`, and that number is the
   * track's own inline PADDING, which is the gutter the first card is supposed
   * to sit on. So going to slide 0 set `scrollLeft` to the gutter and pulled
   * the first card that far off the left edge. Measured on the built preview:
   * the first case study card lost about 104px of its left side at 1440, which
   * read as the title "Highways maintenance, £4.2m" starting at "hways". The
   * carousel autoplays, so it wrapped back to slide 0 on its own and clipped
   * itself without anybody touching it.
   *
   * Measuring every slide against SLIDE ZERO makes the arithmetic exact by
   * construction: slide 0 resolves to 0, which is the scroll position where the
   * padding is showing and the card is on the gutter. It also needs no
   * knowledge of padding, of the offset parent, or of which of the two fits is
   * in use.
   */
  /*
   * CLAMPED TO WHAT THE TRACK CAN ACTUALLY REACH, and that is not a defensive
   * `Math.min`. In the peek fit at 1440 three and a half cards are already on
   * screen, so the whole track has 186px of scroll range while the raw slide
   * offsets run 0, 379, 758 and 1137. Three of those four are unreachable. Left
   * unclamped, `goTo` asks for a position the browser refuses, the scroll
   * listener then reads the position it actually landed on, and the index and
   * the track disagree from that moment on. Measured consequence: the track
   * ended up parked at its far end with the first card 186px off the gutter,
   * after nothing but a keyboard tab pass.
   */
  function offsetOf(c: Car, index: number): number {
    const first = c.slides[0];
    const target = c.slides[index];
    if (!first || !target) return 0;
    const raw = target.offsetLeft - first.offsetLeft;
    const max = Math.max(0, c.track.scrollWidth - c.track.clientWidth);
    return Math.max(0, Math.min(raw, max));
  }

  function goTo(c: Car, index: number, smooth: boolean): void {
    const i = Math.max(0, Math.min(index, c.slides.length - 1));
    if (!c.slides[i]) return;
    c.track.scrollTo({ left: offsetOf(c, i), behavior: smooth ? 'smooth' : 'auto' });
  }

  /** The slide whose start edge is nearest the track's current scroll offset. */
  function nearest(c: Car): number {
    const origin = c.track.scrollLeft;
    let best = 0;
    let bestGap = Number.POSITIVE_INFINITY;
    c.slides.forEach((_, i) => {
      const gap = Math.abs(offsetOf(c, i) - origin);
      if (gap < bestGap) {
        bestGap = gap;
        best = i;
      }
    });
    return best;
  }

  function init(root: HTMLElement): void {
    const track = root.querySelector<HTMLElement>('[data-h2car-track]');
    if (!track) return;
    const slides = Array.from(track.children) as HTMLElement[];
    if (slides.length < 2) return;

    const c: Car = {
      root,
      track,
      slides,
      dots: Array.from(root.querySelectorAll<HTMLElement>('[data-h2car-dot]')),
      live: root.querySelector<HTMLElement>('[data-h2car-live]'),
      index: 0,
    };

    c.dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        markActive(c, i, true);
        goTo(c, i, true);
      }),
    );

    root.querySelector('[data-h2car-prev]')?.addEventListener('click', () => {
      const next = c.index - 1 < 0 ? c.slides.length - 1 : c.index - 1;
      markActive(c, next, true);
      goTo(c, next, true);
    });

    root.querySelector('[data-h2car-next]')?.addEventListener('click', () => {
      const next = (c.index + 1) % c.slides.length;
      markActive(c, next, true);
      goTo(c, next, true);
    });

    root.addEventListener('h2car:goto', (event: Event) => {
      const index = (event as CustomEvent<{ index: number }>).detail?.index;
      if (typeof index !== 'number') return;
      markActive(c, index, true);
      goTo(c, index, true);
    });

    root.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      const step = event.key === 'ArrowRight' ? 1 : -1;
      const next = (c.index + step + c.slides.length) % c.slides.length;
      event.preventDefault();
      markActive(c, next, true);
      goTo(c, next, true);
    });

    /* The track owns the scroll, so the dots follow it rather than the other
       way round. This is also what makes a touch swipe update them for free. */
    let settle = 0;
    track.addEventListener(
      'scroll',
      () => {
        window.clearTimeout(settle);
        settle = window.setTimeout(() => markActive(c, nearest(c), false), 90);
      },
      { passive: true },
    );

    /* Mouse drag. Touch already scrolls the track natively and must not be
       intercepted, so this is bound to mouse pointers only. */
    let dragFrom: number | null = null;
    let dragLeft = 0;
    track.addEventListener('pointerdown', (event: PointerEvent) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      dragFrom = event.clientX;
      dragLeft = track.scrollLeft;
    });
    track.addEventListener('pointermove', (event: PointerEvent) => {
      if (dragFrom === null) return;
      const dx = event.clientX - dragFrom;
      if (Math.abs(dx) > 3) track.scrollLeft = dragLeft - dx;
    });
    const endDrag = () => {
      dragFrom = null;
    };
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);
    track.addEventListener('pointerleave', endDrag);

    /* ── RE-ALIGN ON RESIZE, AND THIS IS A MEASURED DEFECT NOT A PRECAUTION ──
     *
     * The gutter is `padding-inline` plus a matching `scroll-padding-inline-start`,
     * both computed from the viewport width. Change the width and both change,
     * the mandatory inline snap re-resolves against the new numbers, and the
     * scroll offset that was correct a moment ago is left stale. Measured at
     * 1440 on 2026-09-03: `scrollLeft` sat at 0 with the first card exactly on
     * the 104px gutter, a full page screenshot was taken, and it came back at
     * 94 with the first card at 10px, which is the card clipped by 94px. The
     * board's own note about the first card clipping was read off exactly such
     * a capture.
     *
     * It is not only a capture artefact. Any width change does it: a window
     * drag, a tablet rotation, a devtools panel opening. Re-aligning to the
     * slide that is already current puts the card back on the gutter and moves
     * nothing else, and `auto` rather than `smooth` because a resize is not a
     * navigation and should not animate. */
    let realign = 0;
    const scheduleRealign = (delay: number) => {
      window.clearTimeout(realign);
      realign = window.setTimeout(() => goTo(c, c.index, false), delay);
    };

    window.addEventListener('resize', () => scheduleRealign(60), { passive: true });

    /* ── FOCUS MUST NOT SCROLL THE TRACK OFF ITS SLIDE ──────────────────────
     *
     * The track is a scroll container AND is focusable, and a browser scrolls a
     * focused element into view. The track's own box runs past the right edge
     * of the viewport by the bleed, so Chrome answers "bring it into view" by
     * scrolling the track to its own end. Measured at 1440: tabbing to it took
     * `scrollLeft` from 0 to 69, its maximum, and pulled the first card 69px
     * off the gutter. Nobody clicked anything.
     *
     * Realigning to the slide that is already current is the correction, and it
     * is not fighting the reader: they focused the track in order to scroll it
     * with the arrow keys, and the keyboard handler moves a slide at a time
     * from wherever it is. */
    c.track.addEventListener('focusin', () => scheduleRealign(0));

    const reduced =
      typeof window.matchMedia === 'function' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      root.dataset.h2carPlay = 'on';

      /* The dwell is the progress line. When it ends, the next slide is due.
         Hover, focus-within and the hidden-tab attribute all pause the line, so
         they all pause the carousel with no extra branch here. */
      root.addEventListener('animationend', (event: AnimationEvent) => {
        const target = event.target as HTMLElement;
        if (!target.classList?.contains('h2car__dot-fill')) return;
        const next = (c.index + 1) % c.slides.length;
        markActive(c, next, false);
        goTo(c, next, true);
      });

      const syncVisibility = () => {
        root.dataset.h2carPaused = document.hidden ? 'true' : 'false';
      };
      document.addEventListener('visibilitychange', syncVisibility);
      syncVisibility();
    }

    markActive(c, 0, false);
  }

  for (const el of Array.from(document.querySelectorAll<HTMLElement>('[data-h2car]'))) init(el);
</script>
