---
import { getCollection, render } from 'astro:content';
import Compare from '../../layouts/Compare.astro';

export async function getStaticPaths() {
  const pages = await getCollection('compare');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const d = page.data;
---

<Compare
  title={d.title}
  description={d.description}
  ogDescription={d.ogDescription}
  articleDescription={d.articleDescription}
  path={`/compare/${page.id}`}
  publishedAt={d.publishDate}
  updatedAt={d.updatedDate}
  competitor={d.competitor}
  eyebrow={d.eyebrow}
  heroDescription={d.heroDescription}
  ogImage={d.ogImage}
  ogImageAlt={d.ogImageAlt}
  ctaHeadline={d.ctaHeadline}
  ctaSubLine1={d.ctaSubLine1}
  ctaSubLine2={d.ctaSubLine2}
  faq={d.faq}
>
  <Content />
</Compare>
