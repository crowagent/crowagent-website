---
/**
 * HOME 2.0: WATCH IT REFUSE A FIGURE.
 *
 * The live homepage's ReasoningTrace, with its worked example verbatim: the
 * question, its provenance, the five steps and their detail, the claim dropped
 * at Ground, the tally and the illustrative sum. What changes is that the
 * engine is now SHOWN doing it, on a screen that looks like the product.
 *
 * ── THE DRAFT SCREEN IS DRAWN IN THE PRODUCT'S OWN LANGUAGE ────────────────
 *
 * Owner, 2026-09-06: the pane should be a realistic, light product screen like
 * the captures in the section above. No drawn capture of the draft editor
 * exists (the sixteen in Assets/shots stop at the questions list), so the
 * screen is built here in HTML on the same grammar those captures use: the
 * sidebar, the breadcrumb, the title with its pills, the purple grounding
 * banner, white cards on a pale ground, Inter throughout. Drawing it rather
 * than forging a PNG is what lets the engine be seen WORKING on it.
 *
 * Every colour on the light screen is derived from a token with color-mix()
 * against --c-text (the page ink, white on this theme) or --c-floor, never a literal, so the screen follows the
 * palette the way everything else does. The deep teal and deep violet are the
 * site's verified and refused roles mixed down to hold 4.5:1 on white.
 *
 * ── THE RUN ────────────────────────────────────────────────────────────────
 *
 * When the section reaches the viewport a scan runs down the draft, the three
 * claims that trace to a confirmed commitment are underlined one after
 * another, the one that does not is struck and refused, and the grounding list
 * beneath pops each row's mark as the scan reaches it. Above the frame the
 * five steps light in the engine's order; to its right the tally counts what
 * happened. One choreography on the site's one beat, and it runs once.
 *
 * ── THE FIGURES ARE ILLUSTRATIVE AND THE PAGE SAYS SO ──────────────────────
 *
 * £27,000 and £108,000 are recorded as illustrative placeholders in
 * pages/sources.astro, and the sum line carries the word in print. The draft
 * says "from a commitment you confirmed" and never "proxy". The word count on
 * the editor is computed from the draft string, not typed.
 *
 * ── EVERY REST STATE IS THE FINISHED TRACE ─────────────────────────────────
 *
 * Underlines drawn, strike struck, stamp stamped, marks in place, scan parked
 * off the page, before any script runs. Every animation below is scale from
 * the start edge, translate returning to zero, or ink and light. Nothing moves
 * opacity, so nothing can be left unread.
 */
import Section from '../layout/Section.astro';
import DeviceChrome from './DeviceChrome.astro';

interface Step {
  n: string;
  name: string;
  detail: string;
}

const QUESTION = 'Quantify the community and environmental benefit this contract will create.';
const PROVENANCE = 'A private-sector RFP. The same run answers a public notice.';

const STEPS: Step[] = [
  { n: '01', name: 'Retrieve', detail: 'The published question is read with its wording intact.' },
  {
    n: '02',
    name: 'Ground',
    detail: 'Every figure is matched to a confirmed commitment. One is not, and is dropped here.',
  },
  { n: '03', name: 'Compute', detail: 'What survives is computed from those commitments, never generated.' },
  { n: '04', name: 'Check', detail: 'The draft is counted against what it claimed: four asked for, three traced.' },
  { n: '05', name: 'Cite', detail: 'Each surviving figure carries its source, and a named person approves it.' },
];

const DROP_AT = '02';

const TALLY = [
  { k: 'Claimed', v: '4' },
  { k: 'Traced', v: '3' },
  { k: 'Refused', v: '1', refused: true },
];

const SUM_JOBS = 4;
const SUM_PER_JOB = 27000;
const SUM_TOTAL = SUM_JOBS * SUM_PER_JOB;
const GBP = new Intl.NumberFormat('en-GB', {
  style: 'currency',
  currency: 'GBP',
  maximumFractionDigits: 0,
});

/* The draft, as one string, so the word count on the editor is measured. */
const DRAFT_PARTS = [
  'This contract will create ',
  'four new roles',
  ' for local residents, each carried at ',
  '£27,000 per year',
  ' from a commitment you confirmed, ',
  '£108,000',
  ' across the term, alongside ',
  'local supply chain spend',
  ' in the borough.',
];
const WORDS = DRAFT_PARTS.join('').trim().split(/\s+/).length;

/* The grounding list under the draft: one row per claim, in the order the scan
   reaches them. The first three restate the sum; the fourth is the refusal. */
const GROUNDING = [
  { claim: 'four new roles', source: 'Commitment · local employment · 4 roles', state: 'traced' },
  { claim: '£27,000 per year', source: 'Commitment · per role, per year', state: 'traced' },
  { claim: '£108,000', source: `Computed · ${SUM_JOBS} × ${GBP.format(SUM_PER_JOB)}`, state: 'traced' },
  { claim: 'local supply chain spend', source: 'No recorded commitment', state: 'refused' },
] as const;

const BANNER =
  'Answers are AI-assisted and grounded only in your own answer library, the published requirement and your confirmed commitments. Every £ and % comes from your engine-computed commitments and is never invented. A named human reviews, edits and approves every answer before you submit it.';

const SIDEBAR = [
  { group: 'Workspace', items: ['Home', 'Action centre', 'Settings'] },
  { group: 'CrowMark', items: ['Contracts', 'Discover', 'New contract', 'Answer library', 'Insights', 'Reports'] },
];
---

<Section
  eyebrow="Run the real engine"
  title="Watch it refuse a figure."
  standfirst="If a figure cannot be traced, the engine refuses it. A generative tool asked for a number it does not have will produce a plausible one. CrowAgent does the opposite, and it does it visibly."
  id="reasoning"
  class="h2rt"
  cascade
>
  <div class="h2rt__rig">
    <div class="h2rt__trace" data-reel>
      <div class="h2rt__rail" aria-hidden="true">
        <i class="h2rt__rail-lit"></i>
      </div>

      <ol class="h2rt__steps" data-cascade>
        {
          STEPS.map((s, i) => (
            <li class="h2rt__step" style={`--step-i: ${i}`} data-drop={s.n === DROP_AT ? 'on' : undefined}>
              <span class="h2rt__dot" aria-hidden="true"></span>
              <p class="meta h2rt__n">
                <span class="visually-hidden">Step </span>{s.n}
              </p>
              <h3 class="h2rt__name">{s.name}</h3>
              <p class="h2rt__detail">{s.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="h2rt__desk">
      <div class="surface surface--frame surface--row h2rt__pane" role="group" aria-label="The draft, as the engine reads it" data-reel>
        <DeviceChrome host="app.crowagent.ai/" path="mark/draft" />

        <div class="h2rt__app">
          <nav class="h2rt__side" aria-label="Product navigation, illustrative">
            <p class="h2rt__brand">CrowAgent</p>
            <p class="h2rt__plan"><span>CrowMark</span><span class="chip h2rt__plan-tag">Pro</span></p>
            {
              SIDEBAR.map((g) => (
                <div class="h2rt__group">
                  <p class="meta h2rt__group-name">{g.group}</p>
                  <ul class="h2rt__navlist">
                    {g.items.map((item) => (
                      <li class="h2rt__navitem" data-on={item === 'Contracts' ? 'yes' : undefined}>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </nav>

          <div class="h2rt__main">
            <p class="h2rt__crumb">
              Crow <i>›</i> CrowMark <i>›</i> Contracts <i>›</i> Reablement &amp; Home Support Services <i>›</i>
              <b>Q7</b>
            </p>

            <div class="h2rt__head">
              <p class="h2rt__title">Q7 · Social value</p>
              <span class="h2rt__pill">500-word limit · weight 10</span>
              <span class="meta h2rt__live" aria-hidden="true"><i></i>Grounding</span>
            </div>

            <p class="surface--row h2rt__banner">
              <span class="h2rt__banner-i" aria-hidden="true">i</span>
              {BANNER}
            </p>

            <div class="surface--row h2rt__card h2rt__editor">
              <p class="meta h2rt__ask-label">Question, as published</p>
              <p class="h2rt__ask">{QUESTION}</p>
              <p class="meta h2rt__ask-src">{PROVENANCE}</p>

              <p class="meta h2rt__draft-label">
                <span>Draft answer</span>
                <span class="h2rt__count">{WORDS} of 500 words</span>
              </p>
              <p class="h2rt__draft">
                {DRAFT_PARTS[0]}
                <mark class="h2rt__claim" data-claim="traced" style="--claim-i: 0">{DRAFT_PARTS[1]}</mark>
                {DRAFT_PARTS[2]}
                <mark class="h2rt__claim" data-claim="traced" style="--claim-i: 1">{DRAFT_PARTS[3]}</mark>
                {DRAFT_PARTS[4]}
                <mark class="h2rt__claim" data-claim="traced" style="--claim-i: 2">{DRAFT_PARTS[5]}</mark>
                {DRAFT_PARTS[6]}
                <mark class="h2rt__claim" data-claim="refused">{DRAFT_PARTS[7]}</mark>
                {DRAFT_PARTS[8]}
                <i class="h2rt__scan" aria-hidden="true"></i>
              </p>
            </div>

            <div class="surface--row h2rt__card h2rt__ground">
              <p class="meta h2rt__ground-label">Where each figure came from</p>
              <ul class="h2rt__rows">
                {
                  GROUNDING.map((g, i) => (
                    <li class="h2rt__row" data-state={g.state} style={`--row-i: ${i}`}>
                      <span class="h2rt__mark" aria-hidden="true"></span>
                      <span class="h2rt__row-claim">{g.claim}</span>
                      <span class="h2rt__row-src">{g.source}</span>
                      <span class="chip h2rt__row-state">{g.state === 'traced' ? 'Traced' : 'Refused'}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <p class="surface--row h2rt__verdict">
              <span class="chip h2rt__badge">Refused</span>
              <span class="h2rt__verdict-text">
                "local supply chain spend" has no recorded commitment, so it carries no figure. The
                draft keeps the clause and an empty, highlighted field for a person to fill or
                remove.
              </span>
            </p>
          </div>
        </div>
      </div>

      <div class="h2rt__ledger">
        <dl class="h2rt__tally">
          {
            TALLY.map((t) => (
              <div class:list={['h2rt__cell', { 'h2rt__cell--refused': t.refused }]}>
                <dt>{t.k}</dt>
                <dd class="sv-numeral">{t.v}</dd>
              </div>
            ))
          }
        </dl>

        <p class="h2rt__sum">
          <span>{SUM_JOBS} jobs × {GBP.format(SUM_PER_JOB)} per year =</span>
          <b>{GBP.format(SUM_TOTAL)}</b>
          <span class="chip h2rt__eg">illustrative</span>
        </p>
        <p class="h2rt__refused">
          <s class="h2rt__refused-claim">local supply chain spend</s>
          <span class="h2rt__refused-why">
            No recorded commitment, so it carries no figure. The total above is the same with it as
            without it.
          </span>
        </p>
        <p class="h2rt__signoff">
          The untraced claim is removed before a named approver reads the draft. A person signs off,
          not the software.
        </p>
        <p class="h2rt__cta">
          <a href="/crowmark/">How the drafter works</a>
          <a href="/sources/#homepage">Sources</a>
        </p>
      </div>
    </div>
  </div>
</Section>

<style>
  .h2rt__rig {
    position: relative;
  }

  /* ── THE STEPS ─────────────────────────────────────────────────────────── */
  .h2rt__trace {
    position: relative;
    /* Rest is the finished drawing. See THE RUN at the foot of this file. */
    --reel: 1;
  }

  .h2rt__steps {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    --arrive-item-step: 64px;
  }

  .h2rt__step {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'dot n'
      'dot name'
      'dot detail';
    column-gap: var(--space-4);
    align-items: start;
    /* Third and last instance of the same defect on this page, found by
       sweeping every grid inside a stretched row rather than by looking. The
       five steps share one grid row, so they are all as tall as the tallest,
       and `align-content` defaults to spreading the leftover space equally
       across the rows of the shorter ones: measured at 1440, the short steps
       ran 17.3 / 41.5 / 35.3 / 51.3 against 12 / 36.3 / 30.1 / 67 on the tall
       ones, which puts their names on five different lines. `start` sends the
       slack to the foot of the column. Same fix as .h2run__stage and
       .h2bs__station. */
    align-content: start;
    text-align: left;
  }

  .h2rt__dot {
    grid-area: dot;
    display: block;
    inline-size: 12px;
    block-size: 12px;
    margin-block-start: 3px;
    border-radius: var(--radius-pill);
    --dot-ink: var(--c-verified);
  }

  [data-drop='on'] .h2rt__dot {
    --dot-ink: var(--c-refused);
  }

  .h2rt__n {
    grid-area: n;
    margin: 0;
    letter-spacing: 0.1em;
    color: var(--c-text-muted);
  }

  .h2rt__name {
    grid-area: name;
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
    line-height: var(--lh-tight);
    color: var(--c-text);
  }

  [data-drop='on'] .h2rt__name {
    color: var(--c-refused);
  }

  .h2rt__detail {
    grid-area: detail;
    margin: var(--space-1) 0 0;
    font-family: var(--font-body);
    font-size: var(--t-caption);
    line-height: 1.5;
    color: var(--c-text-sub);
    text-wrap: pretty;
  }

  .h2rt__rail {
    display: none;
  }

  /* ── STACKED: THE RAIL RUNS DOWN THROUGH THE DOTS ────────────────────
   *
   * Below 62rem the five steps stack and the horizontal rail has nowhere to
   * go, so until 2026-09-06 a phone and a tablet had five dots and no line at
   * all between them: the owner reported the step lighting as not working, and
   * a dot changing colour with nothing joining it is not a sequence. The same
   * drawing turned on its side, drawn by the same reel. */
  @media (max-width: 61.999rem) {
    .h2rt__dot {
      position: relative;
      z-index: 1;
    }

    .h2rt__rail {
      display: block;
      position: absolute;
      inset-block: 6px;
      inset-inline-start: 5px;
      inline-size: 2px;
      border-radius: var(--radius-pill);
      background-color: var(--c-border);
    }

    .h2rt__rail-lit {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      border-radius: var(--radius-pill);
      background-image: var(--grad-draw-y);
      transform-origin: 50% 0;
      transform: scaleY(var(--reel));
    }
  }

  @media (min-width: 62rem) {
    .h2rt__steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .h2rt__step {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'dot'
        'n'
        'name'
        'detail';
      padding-inline-end: var(--space-6);
    }

    .h2rt__dot {
      margin-block-start: 0;
    }

    .h2rt__n {
      margin-block-start: var(--space-5);
    }

    .h2rt__detail {
      max-width: 24ch;
    }

    .h2rt__rail {
      display: block;
      position: absolute;
      inset-block-start: 6px;
      inset-inline: 6px;
      block-size: 1px;
      background-color: var(--c-border);
      overflow: hidden;
    }

    .h2rt__rail-lit {
      display: block;
      block-size: 100%;
      background-image: var(--grad-draw);
    }
  }

  /* ── THE DESK: THE SCREEN AND THE LEDGER ───────────────────────────────── */
  .h2rt__desk {
    display: grid;
    gap: var(--space-8);
    align-items: start;
    margin-block-start: calc(var(--space-12) * 1.25);
  }

  @media (min-width: 62rem) {
    .h2rt__desk {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(var(--space-10), 5vw, calc(var(--space-12) * 1.5));
    }
  }

  .h2rt__pane {
    position: relative;
    /* Rest is the finished screen. See THE RUN at the foot of this file. */
    --reel: 1;
    --surface-shadow:
      var(--shadow-panel),
      0 40px 120px -40px color-mix(in srgb, var(--c-ambient-deep) 55%, transparent);
  }

  /* The browser chrome, dark, the same bar the product frame above wears. */





  /* ── THE LIGHT SCREEN ──────────────────────────────────────────────────
   *
   * Every colour below is a token mixed against --c-text (the page ink, white on this theme) or --c-floor. The
   * app's grammar, taken from the captures: pale sidebar, white cards, hairline
   * borders, deep teal for the verified role and deep violet for the refused
   * one, and the CrowMark purple on the banner. */
  .h2rt__app {
    --app-bg: color-mix(in srgb, var(--c-text) 97%, var(--c-floor));
    --app-card: var(--c-text);
    --app-line: color-mix(in srgb, var(--c-text) 89%, var(--c-floor));
    --app-ink: color-mix(in srgb, var(--c-floor) 90%, var(--c-text));
    --app-ink-sub: color-mix(in srgb, var(--c-floor) 62%, var(--c-text));
    --app-ink-muted: color-mix(in srgb, var(--c-floor) 46%, var(--c-text));
    --app-verified: color-mix(in srgb, var(--c-verified) 62%, var(--c-floor));
    --app-verified-tint: color-mix(in srgb, var(--c-verified) 12%, var(--c-text));
    --app-refused: color-mix(in srgb, var(--c-refused) 58%, var(--c-floor));
    --app-refused-tint: color-mix(in srgb, var(--c-refused) 14%, var(--c-text));
    --app-brand: color-mix(in srgb, var(--c-ambient-deep) 88%, var(--c-floor));
    --app-brand-tint: color-mix(in srgb, var(--c-ambient-deep) 8%, var(--c-text));
    --app-brand-line: color-mix(in srgb, var(--c-ambient-deep) 34%, var(--c-text));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background-color: var(--app-bg);
    color: var(--app-ink);
    font-family: var(--font-body);
  }

  @media (min-width: 48rem) {
    .h2rt__app {
      grid-template-columns: 9.5rem minmax(0, 1fr);
    }
  }

  /* The sidebar: pale, hairline on its end edge, hidden on a phone. */
  .h2rt__side {
    display: none;
    padding: var(--space-4) var(--space-3);
    border-inline-end: 1px solid var(--app-line);
    background-color: var(--app-bg);
  }

  @media (min-width: 48rem) {
    .h2rt__side {
      display: block;
    }
  }

  .h2rt__brand {
    margin: 0 0 var(--space-3);
    padding-inline: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--t-caption);
    font-weight: var(--t-w-h3);
    line-height: var(--lh-tight);
    color: var(--app-ink);
  }

  .h2rt__plan {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 var(--space-4);
    padding: 6px var(--space-2);
    border-radius: var(--radius-chip);
    background-color: var(--app-brand-tint);
    font-size: var(--t-micro);
    font-weight: 700;
    line-height: var(--lh-tight);
    color: var(--app-brand);
  }

  .h2rt__plan-tag {
    background-color: var(--app-brand);
    color: var(--app-card);
  }

  .h2rt__group {
    margin-block-end: var(--space-3);
  }

  .h2rt__group-name {
    margin: 0 0 var(--space-1);
    padding-inline: var(--space-2);
    letter-spacing: 0.1em;
    color: var(--app-ink-muted);
  }

  .h2rt__navlist {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .h2rt__navitem {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px var(--space-2);
    border-radius: var(--radius-chip);
    font-size: var(--t-micro);
    line-height: var(--lh-tight);
    color: var(--app-ink-sub);
  }

  .h2rt__navitem::before {
    content: '';
    inline-size: 4px;
    block-size: 4px;
    border-radius: var(--radius-pill);
    background-color: var(--app-ink-muted);
  }

  .h2rt__navitem[data-on='yes'] {
    background-color: var(--app-verified-tint);
    color: var(--app-ink);
    font-weight: 600;
  }

  .h2rt__navitem[data-on='yes']::before {
    background-color: var(--app-verified);
  }

  /* The main pane. */
  .h2rt__main {
    min-width: 0;
    padding: var(--space-4);
    background-color: var(--app-bg);
  }

  @media (min-width: 48rem) {
    .h2rt__main {
      padding: var(--space-5);
    }
  }

  .h2rt__crumb {
    margin: 0 0 var(--space-3);
    font-size: var(--t-micro);
    line-height: var(--lh-tight);
    color: var(--app-ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .h2rt__crumb i {
    font-style: normal;
    padding-inline: 4px;
  }

  .h2rt__crumb b {
    color: var(--app-ink);
    font-weight: 600;
  }

  .h2rt__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-block-end: var(--space-3);
  }

  .h2rt__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
    line-height: var(--lh-tight);
    letter-spacing: -0.01em;
    color: var(--app-ink);
  }

  .h2rt__pill {
    padding: 3px 9px;
    border: 1px solid var(--app-line);
    border-radius: var(--radius-pill);
    background-color: var(--app-card);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-tight);
    color: var(--app-ink-sub);
  }

  .h2rt__live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-inline-start: auto;
    letter-spacing: 0.1em;
    color: var(--app-verified);
  }

  .h2rt__live i {
    inline-size: 6px;
    block-size: 6px;
    border-radius: var(--radius-pill);
    background-color: var(--app-verified);
    box-shadow: 0 0 8px var(--c-verified-glow);
  }

  /* The grounding banner, verbatim from the product, in its purple. */
  .h2rt__banner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--app-brand-line);
