---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { SITE } from '../../data/site';
import Button from '../../components/ui/Button.astro';

const title = 'By Sector | CrowAgent';
const description =
  'See the statute behind your sector. CrowAgent helps UK teams find, win and evidence public sector tenders, cited to the regulation that applies to you.';
const path = '/sectors';

const sectorCards = [
  {
    accent: 'violet',
    name: 'Public-Sector Suppliers',
    say: 'PPN 002, dated February 2025 and mandatory from 1 October 2025, makes social value a scored 10% minimum weighting on in-scope central-government tenders.',
    href: '/crowmark',
  },
  {
    accent: 'teal',
    name: 'IT Managed Service Providers',
    say: 'Public-sector IT and managed-service tenders are scored on PPN 002 social value alongside technical fit and price.',
    href: '/crowmark',
  },
  {
    accent: 'teal',
    name: 'Professional Services',
    say: 'Framework and consultancy tenders reward a consistent, evidenced bid response.',
    href: '/crowmark',
  },
  {
    accent: 'violet',
    name: 'Construction',
    say: 'Public works bids score PPN 002 social value against a 10% minimum weighting.',
    href: '/sectors/construction',
  },
  {
    accent: 'violet',
    name: 'Facilities Management',
    say: 'FM tenders turn on TUPE, mobilisation and evidenced delivery against the published KPIs.',
    href: '/sectors/facilities',
  },
  {
    accent: 'violet',
    name: 'Highways',
    say: 'Term-maintenance and NEC4 contracts are scored on social value alongside price and capability.',
    href: '/sectors/highways',
  },
  {
    accent: 'violet',
    name: 'NHS Suppliers',
    say: 'Framework bids weigh PPN 002 social value alongside a track record of on-time, evidenced delivery.',
    href: '/crowmark',
  },
  {
    accent: 'teal',
    name: 'Education',
    say: 'Public-sector contracts expect a consistent, well-evidenced bid and a track record of on-time delivery.',
    href: '/sectors/education',
  },
  {
    accent: 'violet',
    name: 'Charities',
    say: 'Grant and tender bids are judged on PPN 002 social value, with reporting that has to stay lean.',
    href: '/crowmark',
  },
];

const schema = [
  {
    '@type': 'CollectionPage',
    name: 'Sectors',
    description: 'How CrowAgent serves UK teams by sector, cited to the statute that applies to each.',
    url: `${SITE.origin}/sectors`,
    publisher: { '@type': 'Organization', name: 'CrowAgent', url: `${SITE.origin}/` },
  },
];
---

<Base title={title} description={description} path={path} image="/Assets/og-image.png?v=20260730" schema={schema}>
  {/* A DIV, NOT A SECOND <main> — A-66, same as layouts/Sector.astro. Kept as an
      element rather than deleted because styles/motion.css unwraps one wrapper via
      `main > *:only-child > *`. */}
  <div>
    <header class="sec-hero">
      <div class="sec-wrap">
        {/*
          THE SHARED HEAD BLOCK. Was a `.sec-eyebrow` capsule, a bare <h1> and a
          `.sec-sub` lede — one of the fifteen routes rendering a flat white
          title, because the treatment lived in Section's SCOPED styles.

          The words are unchanged: "The statute behind your sector." What has
          gone is the `<span class="accent">` around "your sector.", which
          painted it with --grad-hero-text. That is a SECOND heading treatment,
          and the owner asked for one.

          `.sec-eyebrow` KEEPS ITS RULE BELOW: the closing band still uses it.
        */}
        <PageHeader
          eyebrow="By sector"
          title="The statute behind your sector."
          standfirst="Different rules, one product. See what decides whether you win the tender in your sector, and how CrowMark for Suppliers helps you answer it."
        />
      </div>
    </header>

    <section class="sec-band">
      <div class="sec-wrap">
        <div class="sec-head">
          <span class="eyebrow sec-eyebrow-inline">Who we build for</span>
          <h2>Every sector is under its own clock.</h2>
          <p class="sec-head-lede">Nine UK sectors, each with its own bidding pressure. One line on the pressure, and how CrowMark answers it.</p>
        </div>
        <div class="sec-grid">
          {
            sectorCards.map((c) => (
              <div class="sec-card surface" data-accent={c.accent}>
                <div class="sec-verb">{c.name}</div>
                <p class="sec-say">{c.say}</p>
                <div class="sec-serves">
                  <a class="meta" href={c.href}>CrowMark</a>
                </div>
              </div>
            ))
          }
        </div>

        <figure class="sec-shot">
          <picture>
            <source type="image/avif" srcset="/Assets/shots/figma/mark-analytics-hero.avif?v=20260731e" />
            <source type="image/webp" srcset="/Assets/shots/figma/mark-analytics-hero.webp?v=20260731e" />
            <img
              src="/Assets/shots/figma/mark-analytics-hero.png?v=20260731e"
              width="1024"
              height="768"
              loading="lazy"
              decoding="async"
              alt="The CrowMark Insights screen: headline figures for total contracts, social value delivered, evidence completion and s.71 assessments due, a contracts-by-status bar chart beside a pipeline summary, and quick stats beside sector benchmarks including the PPN 002 minimum weighting."
            />
          </picture>
          <figcaption>Bids and contracts grouped by sector in CrowMark Analytics, shown as a drawn representation. Every number on screen is that sample account&rsquo;s own data. It is not a customer result and not an outcome to expect.</figcaption>
        </figure>
      </div>
    </section>

    <section class="sec-band sec-light">
      <div class="sec-wrap">
        <div class="sec-head">
          <span class="eyebrow sec-eyebrow-inline">How CrowMark works</span>
          <h2>Whatever your sector, the answer is cited.</h2>
          <p class="sec-head-lede">CrowMark reads the rules behind the tender, so every score, weighting and figure traces back to its source.</p>
        </div>
        <div class="sec-ledger">
          {/* `surface--row`: reference, description and source are three
              columns whose alignment is their meaning, which the stylesheet
              below already said in a comment and could not say in a class.
              Defined once in styles/surfaces.css. */}
          <div class="sec-lrow surface surface--row">
            <div class="sec-ref">CrowMark</div>
            <div class="sec-desc"><strong>Social value computed in code on the PPN 002 model</strong> at the 10% minimum weighting, over a curated catalogue of TOMs-aligned measures, with answers drafted from your own submitted bids.</div>
            <div class="sec-meta">Cabinet Office<br />February 2025 &middot; mandatory from 1 Oct 2025</div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec-final">
      <div class="sec-wrap">
        {/* `sec-eyebrow` dropped 2026-08-04 with the capsule it named: nothing
            declares it any more, and a class that styles nothing is a hook
            somebody will hang a seventh capsule on. */}
        <span class="eyebrow">Ready when you are</span>
        <h2>Find the work. Win it. <span class="accent">Prove you delivered.</span></h2>
        <p class="sec-final-sub">See how CrowMark fits your sector's bidding calendar.</p>
        <div class="btn-row sec-hero-cta">
          <Button href="/contact?enquiry=limited-access#contact-form" size="md">Request access</Button>
          <Button href="https://calendly.com/crowagent-platform/30min" variant="secondary" size="md">Book a demo</Button>
        </div>
        <div class="sec-final-links">
          <a href="/pricing">See pricing</a>
          <a href="mailto:hello@crowagent.ai">Ask a question</a>
          <span>Built by UK procurement and ML engineers</span>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .sec-wrap {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .sec-hero {
    position: relative;
    padding: var(--sec-pad-y-hero) 0 var(--sec-pad-y-sm);
    text-align: center;
    overflow: hidden;
  }
  .sec-hero::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -6%;
    width: 70vw;
    height: 44vw;
    transform: translateX(-50%);
    z-index: -1;
    background: var(--grad-hero-glow);
    filter: blur(20px);
    opacity: 0.5;
  }
  /*
   * EVERY EYEBROW IS A GRADIENT CAPSULE — owner decision, 2026-08-02 — AND THE
   * CAPSULE IS NO LONGER RESTATED HERE. Converted 2026-08-04, A-56/A-48.
   *
   * The old comment said the shape was "restated because this page builds its
   * own bands", which is the exact sentence that produced all six declarations
   * of one capsule: a page cannot reach a treatment locked inside a component,
   * so it writes the treatment again. The answer is not to stop building bands,
   * it is for the treatment to be a CLASS anything can carry. `.eyebrow` in
   * styles/labels.css is that class, the markup above already carries it, and
   * scripts/check-treatments.js rule 8 now fails the build if the capsule is
   * declared anywhere else.
   *
   * THE HERO EYEBROW IS NOT ONE OF THESE: it is PageHeader's `eyebrow` prop.
   * What was left here is section-level, never page-level.
   *
   * The 6px teal dot goes with the inline-flex it needed. It was the
   * left-aligned way of giving a bare mono line something to start against;
   * the capsule outline does that now.
   *
   * `.sec-eyebrow-inline` keeps its 0.75rem bottom margin below. That is where
   * the label sits rather than what it is.
   */

  /*
   * `.sec-hero h1`, ITS `.accent` RULES AND `.sec-sub` MOVED TO
   * styles/headings.css.
   *
   * FIVE RULES WENT: the h1 itself, the accent's flat-teal fallback, the
   * @supports block that clipped --grad-hero-text to it, the forced-colours
   * reset for that clip, and the lede. The h1 rule is why this route rendered a
   * flat white title — the shiny treatment was in Section's SCOPED styles, and
   * a page that draws its own head cannot reach another component's scope.
   *
   * THE ACCENT WORK IS NOT LOST, IT IS SUPERSEDED. Those three rules existed to
   * give an accented hero phrase ONE recipe across the site; the answer now is
   * that a page heading has one recipe with no accented phrase in it at all,
   * which is what the owner asked for. `h1.section__title` in headings.css
   * carries both the ramp and its own forced-colours reset, and keeps a
   * defensive `.accent` rule so a span added back reads teal, never invisible.
   *
   * `.sec-sub` was the standfirst at 56ch against the shared 62ch.
   */

  .sec-band {
    padding: var(--sec-pad-y-sm) 0;
  }
  .sec-band.sec-light {
    background: var(--c-panel);
  }
  /*
   * CENTRED HEAD BLOCK — owner decision, 2026-08-02. Scoped to .sec-head,
   * which holds only the eyebrow, the h2 and the lede. It must NOT reach
   * .sec-grid, .sec-shot or .sec-ledger: nine sector cards, a captioned
   * screenshot and a three-column ledger row all read left to right.
   */
  .sec-head {
    margin-bottom: var(--sec-gap);
    text-align: center;
  }
  .sec-eyebrow-inline {
    margin-bottom: 0.75rem;
  }
  .sec-head h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    letter-spacing: -0.02em;
    color: var(--c-text);
    /* The measures are centred too, or heading and lede sit left inside a
       centred head block. */
    margin: 0 auto 0.75rem;
    max-width: 32ch;
  }
  .sec-head-lede {
    color: var(--c-text-muted);
    font-size: var(--t-lede);
    max-width: 48ch;
    margin: 0 auto;
  }

  .sec-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  /* Card treatment from `surface`; only the accent edge and padding are local. */
  .sec-card {
    display: flex;
    flex-direction: column;
    padding: var(--blk-pad);
    border-left: 3px solid var(--step-accent, var(--c-ambient-start));
  }
  .sec-card[data-accent='violet'] {
    --step-accent: var(--c-ambient-end);
  }
  .sec-card[data-accent='teal'] {
    --step-accent: var(--c-ambient-start);
  }
  .sec-verb {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-h4);
    color: var(--c-text);
    margin-bottom: 0.6rem;
  }
  .sec-say {
    color: var(--c-text-sub);
    font-size: var(--t-body);
    line-height: 1.6;
    margin: 0;
  }
  .sec-serves {
    margin-top: auto;
    padding-top: 1.25rem;
  }
  .sec-serves a {
    /* WCAG 2.2 SC 2.5.8. Standalone navigation, not a link inside a sentence,
       so the inline exemption does not reach it. inline-flex so the box grows
       without moving the text or changing where the row wraps. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    /* The label recipe is `.meta` in styles/labels.css. The display face at 800
       was one of the labels set in Plus Jakarta Sans where every other mono label
       on the site is JetBrains Mono. */
    text-transform: uppercase;
    color: var(--c-interactive);
    text-decoration: none;
  }
  .sec-serves a:hover {
  }

  .sec-shot {
    max-width: var(--measure-mid);
    margin: 38px auto 0;
  }
  .sec-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--c-border);
  }
  .sec-shot figcaption {
    margin-top: 14px;
    color: var(--c-text-muted);
    font-size: var(--t-body);
    line-height: 1.6;
    text-align: left;
  }

  .sec-ledger {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sec-lrow {
    display: grid;
    gap: 1rem;
    padding: var(--blk-pad);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .sec-lrow {
      grid-template-columns: 10rem 1fr 12rem;
      align-items: start;
    }
  }
  .sec-ref {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--c-ambient-start);
  }
  .sec-desc {
    color: var(--c-text-sub);
    font-size: var(--t-body);
    line-height: 1.6;
  }
  .sec-desc strong {
    color: var(--c-text);
  }
  .sec-meta {
    color: var(--c-text-muted);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.5;
  }

  .sec-final {
    padding: var(--sec-pad-y) 0;
    text-align: center;
    background: var(--c-panel);
    border-top: 1px solid var(--c-border);
  }
  /* Layout comes from .btn-row. These two are genuinely this section s own:
     a wider gap than the default, and the space above it. */
  .sec-hero-cta {
    gap: 1rem;
    margin-top: 30px;
  }
  /* --t-h1 is reserved for the hero (tokens.css); the homepage's own closing
     CTA renders through Section at --t-h2 / --t-w-h2. Matched to it. */
  .sec-final h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin: 26px 0 0;
  }
  .sec-final h2 .accent {
    /* The same accented-phrase recipe as the hero, not a flat teal. Four
       elements across three pages lifted a phrase out of a heading and three of
       them painted it --c-teal while the homepage used --grad-hero-text. This is
       the fourth; it was hidden while the CTA card-ification covered it and
       reappeared when that was reverted, which is a good argument for fixing a
       pattern everywhere rather than where it happens to be visible. */
    color: var(--c-ambient-start);
  }

  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .sec-final h2 .accent {
      background-image: var(--grad-hero-text);
      background-size: 100% 1.06em;
      background-repeat: repeat;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }

  @media (forced-colors: active) {
    .sec-final h2 .accent {
      background-image: none;
      color: CanvasText;
      -webkit-text-fill-color: CanvasText;
    }
  }
  .sec-final-sub {
    /* 62ch, the same measure Section gives every standfirst. This page had
       one of five different widths (40, 42, 44, 48 and 52rem) used for the
       identical element across the compare, glossary and sector families. */
    max-width: 62ch;
    margin: 1.25rem auto var(--sec-gap);
    color: var(--c-text-muted);
    font-size: var(--t-lede);
    line-height: 1.6;
  }
  .sec-final-links {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    font-size: var(--t-body);
    color: var(--c-text-muted);
  }
  .sec-final-links a {
    /* WCAG 2.2 SC 2.5.8: standalone links in a row, not inside a sentence, so
       the inline exemption does not reach them. Measured at 20px tall before
       this. inline-flex so the box grows without moving the text.
       Re-applied after the CTA card-ification was reverted: the cards had fixed
       these incidentally, and reverting them brought the defect back. A fix that
       only exists as a side effect of another change is not a fix. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--c-text-muted);
  }
  .sec-final-links a:hover {
    color: var(--c-text);
  }
</style>
