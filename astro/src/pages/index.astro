---
/**
 * The homepage.
 *
 * SEO IS CARRIED OVER VERBATIM from the live legacy homepage: title,
 * description, canonical and the Organization/WebSite JSON-LD graph. The design
 * changes; the metadata does not. Changing homepage metadata is a separate,
 * measured decision and must never ride along inside a redesign.
 */
import Base from '../layouts/Base.astro';
import HeroStack from '../components/sections/HeroStack.astro';
import MarketShape from '../components/sections/MarketShape.astro';
import Lifecycle from '../components/sections/Lifecycle.astro';
import BothSides from '../components/sections/BothSides.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { SITE } from '../data/site';

const title = 'CrowAgent | Bid and tender software for UK suppliers';
const description =
  'CrowAgent helps UK suppliers find the work, draft answers cited to the rules, the tender and their own bids, and evidence delivery after award.';

/** The WebSite node the legacy page emits alongside Organization. */
const webSite = {
  '@type': 'WebSite',
  '@id': `${SITE.origin}/#website`,
  url: `${SITE.origin}/`,
  name: SITE.name,
  publisher: { '@id': `${SITE.origin}/#organization` },
};
---

<Base title={title} description={description} path="/" schema={[webSite]}>
  <HeroStack />
  <MarketShape />
  <Lifecycle />
  <BothSides />
  {/* Section 5 is still absent on purpose. Section 3 was gated on the same
      OA-01 entry and is now here: its uniqueness claim ("the only engine that
      sits on both sides", "almost nothing else in this market does both") was
      softened at source, so the port no longer carries it. Section 5's own
      blocker — 40/30/20% weightings presented as a published breakdown with no
      authority named — is resolved on the legacy page by labelling them
      illustrative, and that section is the next one to port. */}
  <FinalCta />
</Base>
