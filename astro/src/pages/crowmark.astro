  .award {
    position: relative;
    padding: var(--blk-pad);
  }

  /* The gate. One absolutely positioned rule down the middle of the panel, so
     both lanes and every stop below measure against the same vertical. */
  .award::before {
    content: '';
    position: absolute;
    top: calc(var(--blk-pad) * 1.6);
    bottom: calc(var(--blk-pad) * 0.6);
    left: 50%;
    width: 1px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-text) 34%, transparent),
      color-mix(in srgb, var(--c-text) 6%, transparent)
    );
  }

  .award__gate {
    margin: 0 0 var(--stack-2);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-text);
  }

  .award__lane {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 6px;
    margin-top: var(--stack-2);
  }

  .award__name {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-micro);
    font-weight: 700;
    color: var(--c-text-sub);
  }

  .award__lane--us .award__name { color: var(--c-teal); }

  /* THE TRACK EXISTS TO CLIP, and that is not belt and braces. The bar scales
     from zero on its left edge; without a clipping parent a mid-animation frame
     can paint outside the panel and grow the document's scrollWidth, which is a
     horizontal-overflow failure that exists ONLY while the animation runs and
     is invisible to a settled-page check. */
  .award__track {
    display: block;
    position: relative;
    height: 8px;
    overflow: hidden;
  }

  .award__bar {
    position: absolute;
    inset-block: 0;
    left: 0;
    border-radius: var(--radius-pill);
    transform-origin: left center;
  }

  /* Ends at the gate. Neutral, because "the bid" is not a marker of anything:
     it is the half of the timeline that finishes. */
  .award__bar--a {
    width: 50%;
    background: color-mix(in srgb, var(--c-text) 26%, transparent);
  }

  /* Crosses it and runs to month 12. Teal at the source through cyan at the
     far end: one light, not two categories. */
  .award__bar--b {
    width: 100%;
    background: linear-gradient(90deg, var(--c-teal), var(--c-cyan));
    box-shadow: 0 0 12px var(--c-teal-glow);
  }

  /* Centred, because the centre of the lane IS the gate: the panel is one
     measure wide and the rule sits at 50%. So "ends here" lands on the line the
     bar stops at without a single magic offset. */
  .award__note {
    margin: 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--t-micro);
    color: var(--c-text-muted);
  }

  /*
   * THE KNOCKOUT, AND IT NEEDS ITS OWN CLASS RATHER THAN `.award__note span`.
   * The first version selected the span inside the note, which also matched
   * `.award__tick` — the s.71 marker is a span inside the SAME class of
   * paragraph — and painted the marker --c-raised at 16px wide instead of cyan
   * at 2px. A descendant selector on a shared block class is exactly how that
   * happens, so the escape is a name, not a more specific descendant.
   *
   * --c-raised is what `.sv-raised` paints under this element: its 5% white wash
   * has fallen to zero well above here, so the knockout reads only as a break in
   * the rule. `position: relative` is load-bearing — the gate rule is an
   * absolutely positioned pseudo-element, which paints above ordinary inline
   * content whatever its colour is, so the span has to be positioned to sit in
   * the same layer and win on tree order.
   */
  .award__knock {
    position: relative;
    padding: 0 8px;
    background: var(--c-raised);
  }

  .award__note--lit {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: flex-end;
    color: var(--c-teal);
  }

  .award__tick {
    width: 2px;
    height: 14px;
    border-radius: var(--radius-pill);
    background: var(--c-cyan);
    box-shadow: 0 0 8px var(--c-teal-glow);
    transform-origin: center;
  }

  /* THREE STOPS IN THE LEFT HALF AND ONE IN THE RIGHT, WHICH IS THE WHOLE
     POINT OF THE DIAGRAM. Four equal columns put "Submit" at 62.5% — to the
     RIGHT of the award line at 50% — which says you submit after award. 1fr
     1fr 1fr 3fr puts the first three at 8%, 25% and 42% and Month 12 at 75%,
     so the timeline agrees with the gate it is drawn under. */
  .award__stops {
    list-style: none;
    margin: var(--stack-2) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 3fr);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-text-muted);
  }

  .award__stops li { text-align: center; }

  /*
   * ── M-P2 · THE AWARD LINE, TWO BARS, ONE STOPS ───────────────────────────
   *
   * TRIGGER   data-lit, IntersectionObserver at 25% of the section in view,
   *           once. src/scripts/motion.ts, shared with the homepage.
   * DURATION  bar 1, one beat. Bar 2 starts 1.33 beats in and runs 1.5 beats,
   *           finishing at 2.83 beats. The board writes 600ms then 900ms, 200ms
   *           apart, with the second bar complete at 1700ms; at --m-beat 600ms
   *           those are the same four numbers to within 2ms, expressed in the
   *           grammar rather than as literals.
   * EASING    --m-ease-land. DIVERGENCE, RECORDED: the board names
   *           cubic-bezier(.22, 1, .36, 1). The grammar in tokens.css allows
   *           three curves and says a fourth needs a reason recorded beside it.
   *           .22/1/.36/1 and .16/1/.3/1 are the same expo-out to within a
   *           frame at this duration, and "each section invents its own curve"
   *           is the exact defect the grammar was written to end. The token
   *           wins; the difference is not visible.
   * REDUCED   both bars at full length on first paint. That is the base rule
   *           above; nothing below exists outside no-preference.
   *
   * THE S.71 MARKER NEVER FADES ITS OWN TEXT IN. The board draws the label
   * appearing at 1700ms. This codebase has already shipped a staged reveal that
   * failed the axe gate with colour-contrast on 7 nodes because the checker
   * sampled semi-transparent text mid-transition, and the contrast failure was
   * only the symptom: the fault was making correct content depend on an
   * observer. So the label is at full contrast from first paint and only the
   * 2px TICK beside it grows, plus a glow behind the words. If the observer
   * never fires, the worst outcome is a tick at full height, which is where it
   * ends anyway.
   */
  @media (prefers-reduced-motion: no-preference) {
    [data-lit='on'] .award__bar--a {
      animation: cw-grow var(--m-beat) var(--m-ease-land) 1 both;
    }

    [data-lit='on'] .award__bar--b {
      animation: cw-grow calc(var(--m-beat) * 1.5) var(--m-ease-land) calc(var(--m-beat) * 1.33) 1 both;
    }

    [data-lit='on'] .award__tick {
      animation: cw-tick calc(var(--m-beat) * 0.5) var(--m-ease-land) calc(var(--m-beat) * 2.83) 1 both;
    }
  }

  @keyframes cw-grow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  @keyframes cw-tick {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }

  /* ══ THE MECHANISM, `229:2` ══════════════════════════════════════════════ */

  .mech {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 2.2vw, 30px);
  }

  /*
   * ── M-P4 · THE CARD ANSWERS THE CURSOR ───────────────────────────────────
   *
   * TRIGGER   @media (hover: hover), pointer enter and leave.
   * WHAT MOVES border white 30 to 5 brightens to the glow colour, the fill
   *           steps to the lit surface, the shadow ladder steps up, and the
   *           card lifts --lift-card.
   * REDUCED   border and background change only, transform: none.
   *
   * NOT ONE LINE OF THAT IS WRITTEN HERE. All of it is `.surface` in
   * styles/surfaces.css, which is the one card recipe, and its reduced-motion
   * override already zeroes the lift. This rule sets padding and nothing else.
   *
   * DIVERGENCE, RECORDED: the board asks for 180ms in and 240ms out. The shared
   * recipe transitions at --dur, 300ms, symmetrically. Two per-page timing
   * values on the one central card treatment is precisely what the motion
   * grammar exists to prevent, and 240ms is not a token. If the asymmetry is
   * wanted it belongs in surfaces.css for every card on the site, in one edit,
   * not here for three.
   */
  .mech__card { padding: var(--blk-pad); }

  .mech__n {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--c-teal);
  }

  /* The per-card artefact. A stack of source chips (01), a redacted draft with
     its two citations under it (02), and a promise joined to its evidence (03).
     Sits on the floor step so the card reads as a surface with something ON it
     rather than as a rectangle with a paragraph in it. */
  /*
   * THE CHIPS HUG AND CENTRE RATHER THAN STRETCHING AND LEFT-ALIGNING, and that
   * is the design system deciding, not a workaround. `.surface` centres card
   * content because a card is scanned, and the first build of this artefact
   * wrote `text-align: left` on the chip, which check-design-system.js reported
   * correctly: an opt-out with no argument behind it. Three short mono labels
   * are exactly what the centring rule is for. So the chip became an inline-flex
   * pill that hugs its own text, the dot became a flex item instead of an
   * absolutely positioned one, and there is nothing left to align.
   */
  .mech__art {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 0 0 var(--stack-2);
    padding: var(--stack-2);
    border-radius: var(--radius-chip);
    background: color-mix(in srgb, var(--c-floor) 72%, transparent);
    min-height: 108px;
  }

  .mech__chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    padding: 6px 11px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-chip);
    background: color-mix(in srgb, var(--c-raised) 80%, transparent);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.4;
    color: var(--c-text-sub);
  }

  /* Teal = a source that was retrieved and kept with its citation. A flex item,
     so it sits before the label without taking the label off centre. */
  .mech__chip::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-teal);
    box-shadow: 0 0 6px var(--c-teal-glow);
  }

  /* 02 draws the drafted sentence as three redacted rules, because the point of
     the card is that the CITATION travels with the sentence, not what the
     sentence says. Two chips sit under it, side by side. */
  .mech__rule {
    display: block;
    height: 26px;
    border-left: 2px solid var(--c-teal);
    padding-left: 10px;
    background:
      linear-gradient(color-mix(in srgb, var(--c-text) 22%, transparent) 0 0) no-repeat 10px 3px / 100% 4px,
      linear-gradient(color-mix(in srgb, var(--c-text) 14%, transparent) 0 0) no-repeat 10px 13px / 82% 4px,
      linear-gradient(color-mix(in srgb, var(--c-text) 10%, transparent) 0 0) no-repeat 10px 23px / 58% 4px;
    margin-bottom: 8px;
  }

  /* 02 puts its two citations side by side under the drafted sentence, because
     the point of the card is that they travel WITH it. */
  .mech__art--draft { flex-direction: row; flex-wrap: wrap; }
  .mech__art--draft .mech__rule { flex: 1 0 100%; }

  /* 03 hangs the evidence off the promise. The connector is the argument of the
     card: a commitment and the artefact that proves it are one object. */
  .mech__art--link { gap: 22px; }

  .mech__art--link .mech__chip:last-child {
    border-color: color-mix(in srgb, var(--c-teal) 45%, transparent);
  }

  .mech__art--link .mech__chip:last-child::after {
    content: '';
    position: absolute;
    left: 50%;
    top: -22px;
    width: 1px;
    height: 22px;
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in srgb, var(--c-teal) 60%, transparent)
    );
  }

  /* ══ THE ALTERNATING CAPABILITY PAIRS ════════════════════════════════════
     P1's rhythm, and the reason P1 was chosen: the argument alternates side to
     side down the page while the surface alternates floor and base underneath
     it, so a reader always knows which step they are on.

     THE HEADING SITS IN THE SLOTTED BODY, NOT IN Section's HEAD BLOCK, and that
     is deliberate rather than a workaround. The head block is centred by owner
     decision; a capability pair has no head block at all, it has a left column
     and an artefact. Section.astro's own comment draws exactly this line:
     "Structured content keeps its own internal alignment." */
  .cap {
    display: grid;
    grid-template-columns: minmax(0, 440fr) minmax(0, 60fr) minmax(0, 520fr);
    align-items: center;
  }

  .cap--art-right .cap__text { grid-column: 1; }
  .cap--art-right .cap__art  { grid-column: 3; }
  /* Reading order in the DOM is always text then artefact; only the painted
     position swaps, so a screen reader meets the argument before the drawing
     on every one of the four. */
  .cap--art-left .cap__text { grid-column: 3; grid-row: 1; }
  .cap--art-left .cap__art  { grid-column: 1; grid-row: 1; }

  .cap__n {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--c-teal);
  }

  .cap__h {
    margin: 0 0 var(--stack-2);
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    line-height: 1.14;
    letter-spacing: -0.015em;
    max-width: 18ch;
    color: var(--c-text);
  }

  .cap__body {
    margin: 0;
    max-width: 48ch;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text-sub);
  }

  .cap__more { margin: var(--stack-2) 0 0; }

  .cap__more a {
    display: inline-flex;
    align-items: center;
    /* WCAG 2.2 target size. */
    min-height: 44px;
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--c-teal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cap__more a:hover { color: var(--c-teal-dark); }

  .cap__more a:focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* ── 01 · Fit ───────────────────────────────────────────────────────────── */

  .fit,
  .cite,
  .gate,
  .strip { padding: var(--blk-pad); }

  .cite { margin: 0; }

  .fit__rows { list-style: none; margin: 0; padding: 0; }

  .fit__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: 0 var(--stack-2);
    padding: var(--stack-1) 0 calc(var(--stack-1) + 6px);
    border-top: 1px solid var(--c-border);
  }

  .fit__row:first-child { border-top: 0; }

  .fit__name {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--c-text);
  }

  /* THE WORD, NOT ONLY THE COLOUR. WCAG 1.4.1: remove every pixel of hue and
     the verdict still reads. */
  .fit__verdict {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tone, var(--c-text-muted));
  }

  .fit__score {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-h4);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--tone, var(--c-text));
  }

  /* The bar length is the score. Drawn under the row rather than beside it, so
     four rows read as one chart. */
  .fit__bar {
    position: absolute;
    left: 0;
    bottom: var(--stack-1);
    width: var(--w);
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--tone, var(--c-text-muted));
    box-shadow: 0 0 8px color-mix(in srgb, var(--tone, var(--c-text)) 45%, transparent);
  }

  /* teal = pursue, amber = review, orchid = pass. See the note in the
     frontmatter: a low fit score is a fact about the reader's situation, not a
     figure the engine refused, and blurring those two weakens the one signal on
     this site a competitor cannot copy. */
  .fit__row--go   { --tone: var(--c-teal); }
  .fit__row--risk { --tone: var(--c-amber); }
  .fit__row--stop { --tone: var(--c-orchid); }

  /* ── 02 · Citation ──────────────────────────────────────────────────────── */

  .cite__q {
    margin: 0;
    padding-left: var(--stack-2);
    border-left: 2px solid var(--c-teal);
    font-family: var(--font-body);
    font-size: var(--t-lede);
    line-height: 1.6;
    color: var(--c-text);
  }

  .cite__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: var(--stack-2) 0 0;
  }

  /* A chip, not a card: --radius-chip is below the card threshold by
     construction, which is how the design-system gate tells the two apart. */
  .cite__chips span {
    padding: 4px 10px;
    border: 1px solid color-mix(in srgb, var(--c-teal) 45%, transparent);
    border-radius: var(--radius-chip);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-teal);
  }

  .cite__foot {
    margin: var(--stack-2) 0 0;
    font-family: var(--font-body);
    font-size: var(--t-micro);
    color: var(--c-text-muted);
  }

  /* ── 03 · The gate ──────────────────────────────────────────────────────── */

  /* THE GATE ITSELF. Without a drawn line, "track 4 stops at the gate" is a
     shorter bar and nothing else; with it, three tracks visibly cross and one
     visibly does not. Positioned off the verdict column's own width so the rule
     lands exactly where every track ends, at any type size. */
  .gate__rows {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gate__rows::after {
    content: '';
    position: absolute;
    top: 4px;
    bottom: 4px;
    right: calc(10ch + var(--stack-2));
    width: 1px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-text) 30%, transparent),
      color-mix(in srgb, var(--c-text) 8%, transparent)
    );
  }

  .gate__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 84px) minmax(0, 10ch);
    align-items: center;
    gap: 4px var(--stack-2);
    padding: var(--stack-1) 0;
    border-top: 1px solid var(--c-border);
  }

  .gate__row:first-child { border-top: 0; }

  .gate__name {
    grid-column: 1;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--c-text);
  }

  .gate__src {
    grid-column: 1;
    grid-row: 2;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-micro);
    color: var(--c-text-muted);
  }

  .gate__track {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    height: 2px;
    overflow: hidden;
  }

  .gate__bar {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, transparent, var(--c-teal));
    transform-origin: left center;
  }

  .gate__row--stop .gate__bar {
    /* Stops at the gate: two thirds of the track, and the last third stays
       empty. The refusal is drawn as an absence, which is what a refusal is. */
    right: 34%;
    background: linear-gradient(90deg, transparent, var(--c-orchid));
  }

  .gate__end {
    grid-column: 3;
    grid-row: 1 / span 2;
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  .gate__end--stop { color: var(--c-orchid); }

  .gate__pip {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-teal);
    box-shadow: 0 0 6px var(--c-teal-glow);
  }

  .gate__x { flex: none; width: 12px; height: 12px; }

  /* Dashed entirely out of view at rest, so the visible cross is the path
     beneath it and this one only ever adds light. */
  .gate__x-draw { stroke-dasharray: 0 20; }

  /*
   * ── M-P3 · THE GATE, THREE PASS AND ONE IS REFUSED ───────────────────────
   *
   * TRIGGER   data-lit, IntersectionObserver at 25%, once. NEVER LOOPS.
   * DURATION  0.7 of a beat per track, 0.25 of a beat apart. The board writes
   *           420ms and 140ms; 0.7 x 600 is exactly 420, and 150ms is the
   *           nearest clean fraction of a beat to 140ms, a difference of one
   *           frame at 60Hz.
   * EASING    --m-ease-land, which IS cubic-bezier(.16, 1, .3, 1), the value
   *           the board names.
   * REDUCED   final state: three tracks lit, the fourth stopped with its cross
   *           visible. That is the base rule above.
   *
   * AND IT NEVER REPEATS, WHICH IS THE EDITORIAL DECISION IN THIS BLOCK. Light
   * on this site may loop because it carries nothing. A refusal is the
   * section's argument, and an argument re-staged every twelve seconds becomes
   * a performance. It fires once and the page holds the finished state, which
   * is the state it shipped in before any of this existed.
   *
   * NOTHING THAT AFFECTS THE CONTRAST OF A WORD IS ANIMATED. No opacity on
   * text, no colour on text, no background under text. The tracks scale and the
   * cross draws itself over a cross that is already there.
   */
  @media (prefers-reduced-motion: no-preference) {
    [data-lit='on'] .gate__bar {
      animation: cw-grow calc(var(--m-beat) * 0.7) var(--m-ease-land) 1 both;
    }

    [data-lit='on'] .gate__row:nth-child(2) .gate__bar { animation-delay: calc(var(--m-beat) * 0.25); }
    [data-lit='on'] .gate__row:nth-child(3) .gate__bar { animation-delay: calc(var(--m-beat) * 0.5); }
    [data-lit='on'] .gate__row:nth-child(4) .gate__bar { animation-delay: calc(var(--m-beat) * 0.75); }

    /* The cross draws 220ms after track 4 has stopped: 0.75 + 0.7 beats of
       track, then the board's 220ms hold, expressed as 0.37 of a beat. Two
       strokes, forwards, once. */
    [data-lit='on'] .gate__x-draw {
      animation: cw-cross calc(var(--m-beat) * 0.55) var(--m-ease-travel) calc(var(--m-beat) * 1.82) forwards;
    }
  }

  @keyframes cw-cross {
    from { stroke-dasharray: 0 20; }
    to   { stroke-dasharray: 20 20; }
  }

  /* ── 04 · Twelve months ─────────────────────────────────────────────────── */

  .strip__chart {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    gap: 6px;
    /* A ratio rather than a height, so the chart keeps its proportions as the
       artefact column narrows instead of needing a second number per
       breakpoint. */
    aspect-ratio: 16 / 7;
    padding-right: 18px;
  }

  .strip__bar {
    height: var(--h);
    border-radius: var(--radius-chip) var(--radius-chip) 0 0;
    background: linear-gradient(
      180deg,
      var(--c-teal),
      color-mix(in srgb, var(--c-teal) 35%, transparent)
    );
    transform-origin: bottom center;
  }

  /* The assessment. A single lit rule at the right edge: the moment the twelve
     months become one published document. */
  .strip__line {
    position: absolute;
    right: 4px;
    top: 6%;
    bottom: 0;
    width: 2px;
    border-radius: var(--radius-pill);
    background: var(--c-cyan);
    box-shadow: 0 0 10px var(--c-teal-glow), 0 0 26px var(--c-teal-glow);
  }

  .strip__foot {
    display: flex;
    justify-content: space-between;
    gap: var(--stack-2);
    margin: var(--stack-1) 0 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-text-muted);
  }

  .strip__out { color: var(--c-cyan); }

  /* The strip rises as the section is lit. TWELVE BARS, ONE BEAT APART OVER ONE
     BEAT is a full cycle of noise; the board gives this section no sequence of
     its own, so it takes the shared entrance shape instead: one beat total,
     each bar a twelfth of a beat behind the last, scale only, once. Bars are
     aria-hidden decoration and carry no figure, so nothing here can hide
     content. */
  @media (prefers-reduced-motion: no-preference) {
    [data-lit='on'] .strip__bar {
      animation: cw-rise calc(var(--m-beat) * 0.8) var(--m-ease-land) 1 both;
    }

    .strip__bar:nth-child(2)  { animation-delay: calc(var(--m-beat) / 12); }
    .strip__bar:nth-child(3)  { animation-delay: calc(var(--m-beat) * 2 / 12); }
    .strip__bar:nth-child(4)  { animation-delay: calc(var(--m-beat) * 3 / 12); }
    .strip__bar:nth-child(5)  { animation-delay: calc(var(--m-beat) * 4 / 12); }
    .strip__bar:nth-child(6)  { animation-delay: calc(var(--m-beat) * 5 / 12); }
    .strip__bar:nth-child(7)  { animation-delay: calc(var(--m-beat) * 6 / 12); }
    .strip__bar:nth-child(8)  { animation-delay: calc(var(--m-beat) * 7 / 12); }
    .strip__bar:nth-child(9)  { animation-delay: calc(var(--m-beat) * 8 / 12); }
    .strip__bar:nth-child(10) { animation-delay: calc(var(--m-beat) * 9 / 12); }
    .strip__bar:nth-child(11) { animation-delay: calc(var(--m-beat) * 10 / 12); }
    .strip__bar:nth-child(12) { animation-delay: calc(var(--m-beat) * 11 / 12); }
  }

  @keyframes cw-rise {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }

