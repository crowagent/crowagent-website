---
/**
 * ContactForm: the site's primary conversion path.
 *
 * Every sitewide "Request access" CTA points at
 * /contact?enquiry=limited-access#contact-form, so this form is where the
 * marketing site actually converts. It is ported with more care than anything
 * else on the site, and with four defects from the legacy version fixed at the
 * source rather than carried across.
 *
 * 1. CONSENT IS ENFORCED. On the legacy page #cp-consent carried `required`,
 *    but the form sets novalidate and the handler never checked the box, so an
 *    enquiry could be sent with consent unticked. UK GDPR Art. 6(1)(a).
 *
 * 2. ONE VALIDATION RULE, NOT TWO. Blur used `includes('@') && includes('.')`
 *    while submit used an RFC-5322-lite regex, so "a@b." cleared the error on
 *    blur and was rejected on submit, the form appearing to change its mind.
 *    EMAIL_RE below is the only definition.
 *
 * 3. ERRORS ARE PROGRAMMATICALLY ASSOCIATED. The legacy spans sat next to their
 *    fields with no aria-describedby and no aria-invalid, and the blur handler
 *    revealed an EMPTY span (measured: display block, height 0, textContent "").
 *    Here the message text is the single source and the wiring is declarative.
 *
 * 4. ONE `?enquiry=` READER. The legacy page had two, an inline script and one
 *    in scripts.js, which happened to agree. This keeps the UNION of what they
 *    did: set the select, dispatch `change` so assistive tech is told the field
 *    changed without user action, and seed the message body.
 *
 * WHY novalidate SURVIVES THE PORT. It is load-bearing, not an oversight.
 * Without it the browser's native constraint validation blocks submission, the
 * `submit` event never fires, and these inline errors never appear. The fields
 * keep `required` so assistive tech still announces them.
 *
 * WIRE VALUES. The `enquiry_type` option values and every field `name` are
 * consumed by app.crowagent.ai/api/contact/submit. They are an API contract.
 * Rename a label freely; never rename a value.
 */

interface Field {
  name: string;
  id: string;
  label: string;
  /*
   * `text | email`, and NOT `| textarea | select`, which it claimed until
   * 2026-08-04. Every entry in FIELDS is rendered by one `<input type={f.type}>`
   * in the map below, so a 'textarea' or 'select' here would have produced
   * `<input type="textarea">`, invalid, and silently rendered as a text box.
   * The real select and textarea are written out by hand further down, because
   * each needs its own markup. The union was describing a component that does
   * not exist; `astro check` was the first thing to say so.
   */
  type: 'text' | 'email';
  required?: boolean;
  autocomplete?: string;
  placeholder?: string;
  help?: string;
  /** Message shown when this field fails. One string, used by blur AND submit. */
  error?: string;
  minlength?: number;
}

const FIELDS: Field[] = [
  {
    name: 'name',
    id: 'cp-name',
    label: 'Full name',
    type: 'text',
    required: true,
    autocomplete: 'name',
    placeholder: 'Your name',
    error: 'Please enter your name.',
  },
  {
    name: 'email',
    id: 'cp-email',
    label: 'Work email',
    type: 'email',
    required: true,
    autocomplete: 'email',
    placeholder: 'you@company.com',
    error: 'Please enter a valid email address.',
  },
  {
    name: 'organisation',
    id: 'cp-org',
    label: 'Organisation',
    type: 'text',
    autocomplete: 'organization',
    placeholder: 'Company name',
  },
];

/** Values are WIRE VALUES. Never rename. */
const ENQUIRY_OPTIONS = [
  { value: '', label: 'Select an option' },
  { value: 'limited-access', label: 'Request access' },
  { value: 'ppn002-bid', label: 'CrowMark for Suppliers' },
  { value: 'buyer-side', label: 'CrowMark for Buyers' },
  { value: 'enterprise', label: 'Portfolio / volume pricing' },
  { value: 'general', label: 'General question' },
];

import Turnstile from './Turnstile.astro';
import '../../styles/forms.css';
import Button from '../ui/Button.astro';
import { FOOTER } from '../../data/footer';

/**
 * [A-269 2026-09-08] TRUST ROW AT THE CONVERSION POINT.
 *
 * NOTHING HERE IS WRITTEN FRESH. Two of the three lines are read out of
 * FOOTER.trustBadges, the array that already carries this site's verified
 * security claims and, more to the point, the decision history behind each of
 * them. Copying the strings would create a second place a claim can be edited,
 * and the footer's own note records that the last time a claim on this site
 * was reasoned about in isolation it was removed for a bad reason and had to
 * be restored.
 *
 * WHY THESE TWO OF THE SIX. A procurement buyer reading this form is deciding
 * where their organisation's data will sit and under whose law. "GDPR
 * compliant" and "EU data residency" answer exactly that. AES-256, TLS 1.3 and
 * ICO registration are true and they stay in the footer, but a row of six
 * beside a submit button is a wall rather than an assurance.
 *
 * THE HEDGING IS THE FOOTER'S DECISION AND IS NOT REOPENED HERE. "GDPR
 * compliant" is unhedged because compliance is self assessed by design and
 * Article 42 certification is voluntary. "Built to ISO 27001 controls" is
 * hedged because an accredited body confers that one. Read the note above
 * `trustBadges` in data/footer.ts before changing either.
 */
function fromFooter(claim: string): string {
  /* A build-time assertion rather than a comment asking the next person to be
     careful. If the footer ever drops or rewords one of these, this page fails
     to build instead of quietly shipping a claim the site no longer makes. */
  if (!FOOTER.trustBadges.includes(claim)) {
    throw new Error(
      `ContactForm: "${claim}" is no longer in FOOTER.trustBadges. ` +
        'The conversion-point trust row must not outlive the footer claim it quotes.',
    );
  }
  return claim;
}

/**
 * THE THIRD LINE IS THE ONE THE FOOTER DOES NOT CARRY, and it is sourced
 * rather than asserted. content/legal/privacy.md: "We use Google Gemini and
 * Anthropic Claude as AI sub-processors. No personal data is used to train
 * their foundation models." content/legal/security.md says the same thing from
 * the other side: "No personal data is sent to AI providers for training."
 * privacy.md adds, for CrowMark specifically, that prompts and completions
 * submitted via the API are not used to train Google's foundation models and
 * that PII is stripped at the prompt boundary.
 *
 * The badge stays inside all three. It claims personal data and AI training,
 * which is what those pages state, and it does not claim zero retention or a
 * contractual guarantee, which they do not state in those words.
 *
 * WHAT WAS NOT SHIPPED. The external review proposed "Average Specialist
 * Response Time: < 4 Business Hours". The standfirst and the success message
 * on this same screen both say three to five business days, so that badge
 * would have put a broken promise beside a true one. Dropped on the owner's
 * decision, not softened.
 */
const AI_TRAINING_CLAIM = 'No personal data used for AI training';

const TRUST_BADGES: string[] = [
  fromFooter('GDPR compliant'),
  fromFooter('EU data residency'),
  AI_TRAINING_CLAIM,
];
---

<form
  id="contactPageForm"
  class="form"
  method="POST"
  action="https://app.crowagent.ai/api/contact/submit"
  novalidate
>
  {/* Honeypot. aria-hidden and tabindex=-1 so it is unreachable by keyboard or
      assistive tech, and invisible to a human, but attractive to a bot that
      fills every input it finds. */}
  <div class="form__pot" aria-hidden="true">
    <label for="cp-website">Website</label>
    <input type="text" name="website" id="cp-website" tabindex="-1" autocomplete="off" />
  </div>

  {
    FIELDS.map((f) => (
      <div class="field">
        <label class="field__label" for={f.id}>
          {f.label}
          {f.required && <span class="field__req" aria-hidden="true">*</span>}
          {f.required && <span class="visually-hidden">(required)</span>}
        </label>
        <input
          class="field__input"
          type={f.type}
          id={f.id}
          name={f.name}
          required={f.required}
          autocomplete={f.autocomplete}
          placeholder={f.placeholder}
          aria-describedby={f.error ? `${f.id}-err` : undefined}
        />
        {f.error && (
          <p class="field__err" id={`${f.id}-err`} data-msg={f.error} hidden>
            {f.error}
          </p>
        )}
      </div>
    ))
  }

  <div class="field">
    <label class="field__label" for="cp-type">What are you working on?</label>
    <select class="field__input" id="cp-type" name="enquiry_type">
      {ENQUIRY_OPTIONS.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
  </div>

  <div class="field">
    <label class="field__label" for="cp-msg">
      Message
      <span class="field__req" aria-hidden="true">*</span>
      <span class="visually-hidden">(required)</span>
    </label>
    <textarea
      class="field__input field__input--area"
      id="cp-msg"
      name="message"
      rows="5"
      required
      minlength="20"
      placeholder="Tell us more about your requirements..."
      aria-describedby="cp-msg-help cp-msg-err"></textarea>
    <p class="field__help" id="cp-msg-help">Minimum 20 characters.</p>
    <p class="field__err" id="cp-msg-err" data-msg="Please tell us a little about your enquiry, in at least 20 characters." hidden>
      Please tell us a little about your enquiry, in at least 20 characters.
    </p>
  </div>

  {/* The Cloudflare check. Sitekeys, lazy loading, wording and the submit gate
      all live in Turnstile.astro, so this form cannot hold a variant of them.
      This endpoint VERIFIES the token server-side against Cloudflare
      /siteverify and fails closed in production. See the note in that file. */}
  <Turnstile id="cp" />

  <div class="field field--consent">
    <label class="consent">
      <input type="checkbox" name="gdpr_consent" id="cp-consent" required aria-describedby="cp-consent-err" />
      <span>
        I agree that CrowAgent Ltd may process my data to respond to this enquiry, in
        line with the <a href="/privacy/">Privacy Policy</a>.
      </span>
    </label>
    <p class="field__err" id="cp-consent-err" data-msg="Please confirm you agree to the Privacy Policy before sending." hidden>
      Please confirm you agree to the Privacy Policy before sending.
    </p>
  </div>

  {/* [A-269 2026-09-08] Directly above the button, so the assurances are read
      on the way to the press rather than after it, and so the button keeps its
      adjacency to the live region below it. The tick is the same shape and the
      same muted ink as the footer credibility row: a bullet, not a
      certification. See the frontmatter for where each line comes from. */}
  <ul class="form__trust" role="list" aria-label="How CrowAgent handles the information you send">
    {
      TRUST_BADGES.map((badge) => (
        <li>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
          </svg>
          {badge}
        </li>
      ))
    }
  </ul>

  <Button type="submit" id="cpSubmitBtn">Send message</Button>

  {/* One live region for the outcome. role="status" is polite: a success is
      announced without interrupting, and the failure text is swapped in here
      too rather than into a second region that competes with it.

      [A-269 2026-09-08] IT NOW CARRIES THE SENDING STATE AS WELL. The spinner
      and the tick are both in the markup and the state class shows one of
      them, so a transition changes a text node and a class rather than
      rebuilding the children of a live region. Only `.form__status-text` is
      ever written to, which keeps what a screen reader announces to one
      sentence. */}
  <p class="form__status" id="cpFormStatus" role="status" aria-live="polite" hidden>
    <span class="form__spinner" aria-hidden="true"></span>
    <svg class="form__tick" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
      <polyline points="20 6 9 17 4 12" />
    </svg>
    <span class="form__status-text"></span>
  </p>

  <noscript>
    <p class="form__noscript">
      This form needs JavaScript to send. Please email us directly at
      <a href="mailto:hello@crowagent.ai">hello@crowagent.ai</a>.
    </p>
  </noscript>
</form>

<script>
  /** The ONLY definition of a valid address on this page. */
  const EMAIL_RE = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;

  const ACCESS_SEED =
    'I would like to request access to CrowAgent.\n\nOrganisation:\nWhat we need CrowAgent for:\n';

  /** ?product= / ?tier= mapping, carried over verbatim from scripts.js. The
      legacy slugs cyber / cash / esg / csrd are deliberately UNMAPPED: those
      products no longer exist and must not resolve to an enquiry type. */
  const PRODUCT_TO_ENQUIRY: Record<string, string> = {
    mark: 'ppn002-bid',
    crowmark: 'ppn002-bid',
    public: 'ppn002-bid',
    'public-sector': 'ppn002-bid',
    buyer: 'buyer-side',
    buyers: 'buyer-side',
    enterprise: 'enterprise',
  };
  const PRODUCT_LABELS: Record<string, string> = {
    'ppn002-bid': 'CrowMark for Suppliers',
    'buyer-side': 'CrowMark for Buyers',
    enterprise: 'the Portfolio plan',
  };

  function initContactForm() {
    const form = document.getElementById('contactPageForm') as HTMLFormElement | null;
    if (!form) return;

    const btn = document.getElementById('cpSubmitBtn') as HTMLButtonElement | null;
    const status = document.getElementById('cpFormStatus');
    const consent = document.getElementById('cp-consent') as HTMLInputElement | null;
    const statusText = status?.querySelector<HTMLElement>('.form__status-text') ?? null;
    if (!btn || !status || !consent || !statusText) return;

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

    /* [A-269 2026-09-08] ONE PLACE THAT CHANGES THE OUTCOME REGION.
       Three call sites used to set `hidden`, `className` and `textContent`
       separately, which is three chances to leave a stale state class behind a
       fresh sentence. The class is rebuilt from scratch every time, so `busy`
       cannot survive into `ok`. */
    const setStatus = (state: 'busy' | 'ok' | 'bad', message: string) => {
      status.className = `form__status form__status--${state}`;
      statusText.textContent = message;
      status.hidden = false;
    };

    /* The button's own state. `aria-busy` is what tells assistive tech the
       control is working rather than broken, which a disabled button on its
       own does not distinguish. */
    const setBusy = (busy: boolean) => {
      btn.disabled = busy;
      if (busy) btn.setAttribute('aria-busy', 'true');
      else btn.removeAttribute('aria-busy');
    };

    /** Show or hide a field's error, and keep aria-invalid honest with it. */
    function setError(fieldId: string, show: boolean) {
      const err = $(`${fieldId}-err`);
      const field = $<HTMLInputElement>(fieldId);
      if (err) err.hidden = !show;
      // aria-invalid is what a screen reader uses to announce the field as
      // erroneous. Without it the visible red text is decoration.
      if (field) field.setAttribute('aria-invalid', show ? 'true' : 'false');
    }

    function valueOf(id: string) {
      return ($<HTMLInputElement>(id)?.value ?? '').trim();
    }

    /** One rule set, shared by blur and submit so they can never disagree. */
    function checkField(id: string): boolean {
      if (id === 'cp-name') return valueOf(id).length > 0;
      if (id === 'cp-email') return EMAIL_RE.test(valueOf(id));
      if (id === 'cp-msg') return valueOf(id).length >= 20;
      return true;
    }

    // Blur validation. Only ever flags a field the user has actually left, so
    // an untouched form is never covered in red.
    ['cp-name', 'cp-email', 'cp-msg'].forEach((id) => {
      const el = $<HTMLInputElement>(id);
      el?.addEventListener('blur', () => setError(id, !checkField(id)));
      // Clear as soon as it becomes valid; making someone re-blur to clear an
      // error they have already fixed is needless friction.
      el?.addEventListener('input', () => {
        if (checkField(id)) setError(id, false);
      });
    });
    consent.addEventListener('change', () => {
      if (consent.checked) setError('cp-consent', false);
    });

    /* NOTE ON TURNSTILE. Loading, wording and the submit gate are owned by
       Turnstile.astro. Its gate is a CAPTURE-phase submit listener, so it runs
       before this handler and blocks the submission outright when there is no
       token. By the time the code below runs, a token is guaranteed. */

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Honeypot: a bot filled a field no human can see. Fail silently. An
      // error message would tell it what to avoid next time.
      const pot = form.querySelector<HTMLInputElement>('[name="website"]');
      if (pot && pot.value) return;

      let ok = true;
      for (const id of ['cp-name', 'cp-email', 'cp-msg']) {
        const good = checkField(id);
        setError(id, !good);
        if (!good) ok = false;
      }
      if (!consent.checked) {
        setError('cp-consent', true);
        ok = false;
      }

      /* `cf-turnstile-response` is Cloudflare's own input name, written by
         their widget. Read, not re-derived: the gate in Turnstile.astro has
         already refused this submit if it were empty. */
      const tsToken =
        form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value ?? null;

      if (!ok) {
        /* Focus the FIRST thing that failed. Without this a keyboard or screen
           reader user gets a form that silently refuses to submit, with the
           reason somewhere above them on the page. */
        const firstBad = ['cp-name', 'cp-email', 'cp-msg', 'cp-consent'].find(
          (id) => $(`${id}-err`)?.hidden === false
        );
        if (firstBad) $<HTMLInputElement>(firstBad)?.focus();
        // The submit button must NOT be left disabled by a rejection. On the
        // legacy page a capture-phase guard disabled it on every submit event
        // and released only after 15 seconds, so a corrected retry did nothing.
        btn.disabled = false;
        return;
      }

      /* [A-269 2026-09-08] THE WAIT IS NOW STATED, NOT LEFT TO A DEAD BUTTON.
         This route does Cloudflare /siteverify, a Supabase insert and a Brevo
         send in series (see the timeout note below), so the reader can be
         waiting several seconds. A disabled button and a hidden status region
         is also exactly what a broken button looks like, and the reader's
         options at that point are to leave or to send again. */
      setBusy(true);
      btn.textContent = 'Sending...';
      setStatus('busy', 'Sending your message...');

      fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          name: valueOf('cp-name'),
          // Strip CR/LF: a newline in an address is the classic header
          // injection vector if the value is ever used to build an email.
          email: valueOf('cp-email').replace(/[\r\n]+/g, ''),
          organisation: valueOf('cp-org'),
          enquiry_type: ($<HTMLSelectElement>('cp-type')?.value ?? ''),
          message: valueOf('cp-msg'),
          turnstile_token: tsToken,
        }),
        /*
         * [A-264 2026-09-08] 10s WAS SHORTER THAN A SUCCESSFUL SUBMISSION.
         *
         * MEASURED ON PRODUCTION, not reasoned about. After the Turnstile
         * secret was corrected, a real submission from a real browser showed
         * "Something went wrong" while the server logged
         * `POST /api/contact/submit 200`. The enquiry WAS accepted. The client
         * had already aborted at 10s and shown a failure for work that
         * succeeded, which is the worst shape a form can fail in: the reader
         * gives up or sends again, and a duplicate is the best case.
         *
         * WHY THIS ROUTE IS SLOW, and why 10s was never enough headroom. It
         * does three things in series after the token arrives: Cloudflare
         * /siteverify, a Supabase insert, and a Brevo send. Warm, siteverify
         * alone measured 0.3-1.0s across three probes, so the tail is the
         * other two plus any cold start.
         *
         * 30s is chosen against the SERVER's own ceiling rather than picked as
         * a round number: the function may run to the platform limit, and a
         * client that gives up first converts a slow success into a reported
         * failure. Erring long costs a reader a few more seconds of a spinner
         * they can see. Erring short costs the enquiry.
         */
        signal: AbortSignal.timeout(30000),
      })
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          form.reset();
          setError('cp-consent', false);
          setStatus(
            'ok',
            "Message received. We'll be in touch within three to five business days.",
          );
          /* aria-busy comes OFF while disabled stays ON. The work has finished,
             so announcing it as still working would be false, but the form has
             been reset and a second press would post an empty enquiry. A
             duplicate is the thing the 10s abort was already causing. */
          setBusy(false);
          btn.disabled = true;
          btn.textContent = 'Message sent';
        })
        .catch((err) => {
          /* [A-263 2026-09-07] Logged rather than discarded. See the same note
             in NewsletterForm.astro: a swallowed reason made a production
             outage undiagnosable from the browser, and the reader-facing
             sentence is identical for a 502, a 429 and a CORS refusal. The
             message shown is deliberately unchanged. */
          console.error(
            JSON.stringify({
              level: 'error',
              service: 'contact-form',
              operation: 'submit',
              endpoint: form.action,
              error: err instanceof Error ? `${err.name}: ${err.message}` : String(err),
              timestamp: new Date().toISOString(),
            }),
          );
          setStatus('bad', 'Something went wrong. Please email hello@crowagent.ai directly.');
          setBusy(false);
          btn.textContent = 'Send message';
        });
    });

    /* ── ?enquiry= / ?product= / ?tier= ────────────────────────────────────
       ONE reader. The legacy page had two that happened to agree; this keeps
       the union of what they did. */
    const params = new URLSearchParams(location.search);
    const type = $<HTMLSelectElement>('cp-type');
    const msg = $<HTMLTextAreaElement>('cp-msg');
    if (!type) return;

    const setType = (value: string) => {
      if (![...type.options].some((o) => o.value === value)) return false;
      type.value = value;
      // Dispatched because the field changed WITHOUT the user doing it, and
      // assistive tech is otherwise never told.
      type.dispatchEvent(new Event('change', { bubbles: true }));
      return true;
    };

    const enquiry = (params.get('enquiry') ?? '').toLowerCase();
    if (enquiry && setType(enquiry)) {
      if (enquiry === 'limited-access' && msg && !msg.value) msg.value = ACCESS_SEED;
      return;
    }

    const product = (params.get('product') ?? '').toLowerCase();
    const tier = (params.get('tier') ?? '').toLowerCase();
    let resolved = PRODUCT_TO_ENQUIRY[product];
    if (!resolved && (tier === 'portfolio' || tier === 'enterprise')) resolved = 'enterprise';
    if (resolved && setType(resolved) && msg && !msg.value) {
      const label = PRODUCT_LABELS[resolved] ?? 'CrowMark';
      msg.value = `I would like to talk to sales about ${label}${tier ? ` (${tier} tier)` : ''}.\n\n`;
    }
  }

  initContactForm();
</script>
