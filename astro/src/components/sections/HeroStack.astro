---
/**
 * HeroStack — the homepage hero. Direction B, "the receding tender stack".
 *
 * THE IDEA. The hero is the product, not a claim about it. Four commitments
 * recede into depth like pages in a bid; three carry a citation, and the fourth
 * has nothing behind it and is struck out. That is the gate, shown rather than
 * described, and it is the one thing a competitor cannot paste onto their own
 * site because they cannot do it.
 *
 * WHY DEPTH, AND WHY THIS DEPTH. The depth is made of the subject's own
 * material rather than generic 3D: tender pages, receding. It is faked with
 * scale, offset, opacity and a progressive blur, so it costs no 3D engine, no
 * canvas and no library. On a page whose measured problem is payload, that
 * matters more than fidelity.
 *
 * WHAT IT DELIBERATELY IS NOT. A near-black canvas with one bright accent and a
 * big number is the default look AI reaches for on any brief. The palette here
 * is frozen and correct, so the distinctiveness has to come from structure: a
 * citation gutter that aligns on one axis, mono used as the auditor's voice
 * rather than as a label font, and exactly one animated moment.
 *
 * MOTION. One orchestrated sequence, not scattered effects. Every element is
 * VISIBLE BY DEFAULT and motion only refines it, so if the script never runs
 * the hero still reads correctly. See src/scripts/motion.ts.
 */
import Button from '../ui/Button.astro';

interface Claim {
  cite: string;
  text: string;
  traced: boolean;
}

/**
 * Real values from the product's own worked example: the Oxford proxy constants
 * the methodology screen prints, and one commitment that was never recorded.
 * Nothing here is invented for the sake of the design.
 */
const CLAIMS: Claim[] = [
  { cite: 'T1M1 · recorded 12 Mar', text: '4 new jobs for local residents', traced: true },
  { cite: 'T1M2 · 4 × £27,000', text: '£108,000 of measurable social value', traced: true },
  { cite: 'T1M3 · s.52 KPI', text: 'Quarterly reporting to the authority', traced: true },
  { cite: 'no recorded commitment', text: 'Local supply chain spend', traced: false },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__wash" aria-hidden="true"></div>

  <div class="hero__inner">
    <p class="hero__eyebrow">ITT CF-2026-0417 · award question 4.2 · social value 10%</p>

    {/* Two spans rather than a bare <br />. A <br /> gives the visual line break
        but leaves the accessible name as "Four claims.Three survive." with no
        separator, so a screen reader runs the two sentences together. Block
        spans break the line visually AND leave a word boundary in the text. */}
    <h1 class="hero__title" id="hero-title"><span>Four claims.</span> <span>Three survive.</span></h1>

    <p class="hero__lede">
      Every figure is checked against a commitment you recorded. The one that is not
      does not ship. That is the whole product.
    </p>

    <div class="hero__actions">
      <Button href="/contact?enquiry=limited-access#contact-form">Request access</Button>
      <Button href="/crowmark" variant="secondary">How the drafter works</Button>
    </div>
  </div>

  {/*
    The stack. `--i` drives depth so the recession is arithmetic rather than
    four hand-tuned rules: one formula, four cards, and adding a fifth needs no
    new CSS. Marked aria-hidden because the same claims are read out in the
    visually-hidden list below, where a screen reader gets them as text rather
    than as a depth illusion.
  */}
  <ol class="stack" aria-hidden="true">
    {CLAIMS.map((c, i) => (
      <li
        class:list={['stack__card', { 'stack__card--dropped': !c.traced }]}
        style={`--i:${i}; --n:${CLAIMS.length}`}
        data-motion="reveal"
      >
        <span class="stack__cite">{c.cite}</span>
        <span class="stack__text">{c.text}</span>
      </li>
    ))}
  </ol>

  <p class="visually-hidden">
    Four commitments are assessed. Three are traced to a recorded commitment:
    {CLAIMS.filter((c) => c.traced).map((c) => `${c.text}, cited ${c.cite}`).join('; ')}.
    One is not: {CLAIMS.find((c) => !c.traced)?.text}, which has no recorded
    commitment and is removed from the draft.
  </p>

  <p class="hero__foot">The engine cannot clear its own gate. A named person approves.</p>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--sec-pad-y) 0;
  }

  /* One soft field, not four. The legacy homepage carried multiple blurred
     orbs; at this size a single wash does the same work for a quarter of the
     paint cost. */
  .hero__wash {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 70%;
    background:
      radial-gradient(60% 60% at 30% 30%, color-mix(in srgb, var(--c-violet) 34%, transparent), transparent 70%),
      radial-gradient(50% 50% at 78% 20%, color-mix(in srgb, var(--c-cyan) 26%, transparent), transparent 72%);
    filter: blur(90px);
    pointer-events: none;
  }

  .hero__inner,
  .stack,
  .hero__foot {
    position: relative;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 48px);
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    margin: 0 0 var(--stack-2);
  }

  .hero__title span { display: block; }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--t-h1);
    font-weight: var(--t-w-h1);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin: 0 0 var(--stack-2);
  }

  .hero__lede {
    font-family: var(--font-body);
    font-size: var(--t-lede);
    line-height: 1.65;
    color: var(--c-text-sub);
    max-width: 54ch;
    margin: 0 0 var(--sec-gap);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: var(--sec-gap);
  }

  /* ── The stack ────────────────────────────────────────────────────────── */
  .stack {
    list-style: none;
    margin: 0 auto;
    display: grid;
    /* Cards overlap in one grid cell; depth comes from the transform. */
    grid-template-columns: 1fr;
  }

  .stack__card {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    padding: clamp(18px, 2.4vw, 26px) clamp(20px, 3vw, 34px);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-card);
    background: linear-gradient(180deg, var(--c-panel), var(--c-bg));
    box-shadow: var(--shadow-card);

    /* Depth as arithmetic. `--d` is 1 for the furthest card and 0 for the
       front one, and every visual property is a function of it. */
    --d: calc((var(--n) - 1 - var(--i)) / (var(--n) - 1));
    transform:
      translateY(calc(var(--d) * -46px))
      scale(calc(1 - var(--d) * 0.13));
    opacity: calc(1 - var(--d) * 0.62);
    filter: blur(calc(var(--d) * 2.4px));
    z-index: calc(10 - var(--d) * 10);
  }

  .stack__cite {
    flex: 0 0 auto;
    width: clamp(140px, 18vw, 230px);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  .stack__text {
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 700;
    color: var(--c-text);
  }

  .stack__card--dropped .stack__cite { color: var(--c-orchid); }
  .stack__card--dropped .stack__text {
    color: var(--c-text-muted);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }

  .hero__foot {
    margin: var(--sec-gap) auto 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  /* Below the fold of a phone the depth illusion costs more than it earns:
     a blurred, shrunken card is just an unreadable card. Flatten it. */
  @media (max-width: 719px) {
    .stack__card {
      transform: none;
      opacity: 1;
      filter: none;
      position: relative;
      grid-area: auto;
      margin-bottom: 10px;
    }
    .stack { display: block; }
    .stack__card { flex-direction: column; align-items: flex-start; gap: 6px; }
  }

  /* Motion refines an already-correct hero. It never creates one. */
  @media (prefers-reduced-motion: no-preference) {
    .stack__card {
      transition:
        transform var(--dur-slow) var(--ease),
        opacity var(--dur-slow) var(--ease),
        filter var(--dur-slow) var(--ease);
      transition-delay: calc((var(--n) - 1 - var(--i)) * 90ms);
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
