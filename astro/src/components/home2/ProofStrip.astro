---
/**
 * HOME 2.0: THREE NUMBERS YOU ARE ALREADY HELD TO.
 *
 * The live homepage's statutory figures, unchanged in value, label and source.
 * Every one is taken verbatim from MarketShape.astro's STOPS, and each has a
 * row in HOMEPAGE_MAP in pages/sources.astro, which is where the link at the
 * foot of this strip goes.
 *
 * ── A LEDGER, NOT THREE CARDS ──────────────────────────────────────────────
 *
 * The live page draws these as three equal panels with a numeral floating in a
 * lot of padding. Three figures are a table row, so this draws them as one: a
 * hairline above, a hairline below, and vertical rules between the columns. The
 * numerals take the whole width they are given and nothing is boxed.
 *
 * ── ONE FIGURE COUNTS, AND THE OTHER TWO MUST NOT ──────────────────────────
 *
 * MarketShape.astro settled this test and it is followed rather than re-argued:
 * a figure may count only if no intermediate value it prints is a real and
 * different figure in the same regulatory domain. 12 passes, because no rival
 * interval sits under it. £5m prints £1m, £2m and £3m, which are real contract
 * values from the OTHER PPN 026 band. 10% prints 5%, which this site has a
 * standing rule never to print, and check-facts.js enforces that rule. So one
 * of three ticks. The value is authored text painted at first render, the count
 * only ever writes OVER a figure that is already correct, and the authored
 * string is restored when it ends, when it is interrupted and when it never
 * starts at all.
 */
interface Figure {
  tag: string;
  /** The source card on /sources this figure is drawn from. */
  href: string;
  value: string;
  label: string;
}

const FIGURES: Figure[] = [
  {
    tag: 'Procurement Act s.52',
    href: '/sources/#s52',
    value: '£5m',
    label: 'contract value threshold',
  },
  {
    tag: 'Procurement Act s.71',
    href: '/sources/#s71',
    value: '12',
    label: 'months between published assessments',
  },
  {
    tag: 'PPN 026',
    href: '/sources/#ppn-026',
    value: '10%',
    label: 'minimum social value weighting',
  },
];
---

{/* NO `data-reel` ANY MORE. Nothing here is scrubbed by the scroll, so
    asking scripts/reel.ts to measure this block on every frame would be work
    done for an attribute nothing reads. */}
<section class="h2ps" data-lit data-lit-threshold="0.3" aria-labelledby="h2ps-title">
  <div class="h2ps__inner">
    {/* The visible label is a mono kicker rather than a display heading, and
        scripts/check-design-system.js rule `type` is right to insist that an
        <h2> take one of the four heading tiers. So the outline gets a real
        heading at its real size and the reader gets the kicker. */}
    <h2 class="visually-hidden" id="h2ps-title">Three numbers you are already held to</h2>
    <p class="meta h2ps__kicker" aria-hidden="true">Three numbers you are already held to</p>

    <div class="h2ps__frame">
      {/* A STILL HAIRLINE, AND THAT IS THE DECISION. It carried a beam that
          drew across as the reader scrolled, behind a glowing head, and so did
          its twin below. Owner, 2026-09-06, on that device across four
          sections: "dont you think this looks so cheap". Nothing in this block
          is progressing, so nothing in it should appear to. The four-colour
          ramp stays, still. */}
      <i class="h2ps__rule h2ps__rule--top" aria-hidden="true"></i>

    <ul class="h2ps__ledger" data-cascade>
      {
        FIGURES.map((f) => (
          <li class="h2fig">
            {/* The tag IS the citation, so it is the link: straight to the
                source card that carries this figure's primary reference. */}
            <p class="meta h2fig__tag"><a class="h2fig__cite" href={f.href}>{f.tag}</a></p>
            {/* NO COUNT. A figure that counts up to £5,000,000 says it is
                accumulating, and a statutory threshold is the one kind of
                number that never does. It was also the third moving thing in a
                section that needs none. */}
            <p class="h2fig__value sv-numeral">{f.value}</p>
            <p class="h2fig__label">{f.label}</p>
          </li>
        ))
      }
    </ul>

      <i class="h2ps__rule h2ps__rule--bot" aria-hidden="true"></i>
    </div>

    <p class="h2ps__note">
      <a href="/sources/">Every figure on this page is listed with its source.</a>
    </p>
  </div>
</section>

<style>
  .h2ps {
    position: relative;
    padding-block: var(--sec-pad-y-sm);
  }

  .h2ps__inner {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .h2ps__kicker {
    margin: 0 0 var(--space-8);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--c-text-muted);
    text-align: center;
  }

  /* ── THE LEDGER ──────────────────────────────────────────────────────────
   *
   * The two horizontal rules are gradient hairlines faded at both ends, the
   * same rule the site's sections already draw. The vertical rules between
   * columns are the ordinary border colour. */
  /* ── THE TWO RULES, DRAWN BY THE SCROLL ────────────────────────────────
   *
   * They were two static gradient hairlines. Owner, 2026-09-06: give both the
   * beam motion the rest of the page now carries. The top rule draws from the
   * start edge and the bottom from the end edge, so the pair closes around the
   * figures as the reader arrives at them, which is what the section is: two
   * published limits and the numbers held between them.
   *
   * Same recipe as the spine in BothSides2: a hairline at rest colour, a beam
   * on the ambient ramp scaled by --reel, and a bright head at its leading
   * edge. `--reel` rests at 1, so with no script both rules are fully drawn.
   */
  /* NO `--reel` DECLARED HERE. The host is the <section>, which carries
     `data-reel`, and a rest value declared on this descendant would shadow the
     value scripts/reel.ts writes on the host: measured 2026-09-06, the beams
     stayed at full width at every scroll position. The rest value lives in the
     `var(--reel, 1)` fallback on each beam instead. */
  .h2ps__frame {
    position: relative;
  }

  .h2ps__rule {
    position: absolute;
    inset-inline: 0;
    block-size: 2px;
    border-radius: var(--radius-pill);
    background-color: var(--c-border);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, rgb(0 0 0) 12%, rgb(0 0 0) 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, rgb(0 0 0) 12%, rgb(0 0 0) 88%, transparent);
  }

  /* The ramp sits on the rule itself now rather than on a beam inside it, so
     each line is drawn in full from the first frame and never moves. The mask
     on .h2ps__rule already fades both ends, which is what stops a
     full-strength gradient reading as a bar. The two run in opposite
     directions so the pair frames the figures rather than pointing the same
     way twice. */
  .h2ps__rule--top {
    inset-block-start: 0;
    background-image: var(--grad-draw);
  }

  .h2ps__rule--bot {
    inset-block-end: 0;
    background-image: linear-gradient(270deg, var(--c-ambient-far), var(--c-ambient-end));
  }

  .h2ps__ledger {
    position: relative;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .h2fig {
    display: flex;
    flex-direction: column;
    gap: var(--stack-1);
    padding: var(--space-8) var(--space-6);
    text-align: center;
    border-block-end: 1px solid var(--c-border);
  }

  .h2fig:last-child {
    border-block-end: 0;
  }

  @media (min-width: 48rem) {
    .h2ps__ledger {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .h2fig {
      padding: var(--space-10) var(--space-8);
      border-block-end: 0;
      border-inline-end: 1px solid var(--c-border);
    }

    .h2fig:last-child {
      border-inline-end: 0;
    }
  }

  .h2fig__tag {
    margin: 0;
    letter-spacing: 0.1em;
    color: var(--c-text-muted);
  }

  .h2fig__value {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--t-numeral);
    font-weight: var(--t-w-h1);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  /* The citation link rests without an underline, in the tag's own muted ink,
     and the shared hover rule in motion.css turns the underline up. */
  .h2fig__cite {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
  }

  .h2fig__cite:focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: 4px;
    border-radius: var(--radius-chip);
  }

  .h2fig__label {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-caption);
    line-height: 1.5;
    color: var(--c-text-sub);
    max-width: 26ch;
    margin-inline: auto;
    text-wrap: balance;
  }

  .h2ps__note {
    margin: var(--space-6) 0 0;
    font-family: var(--font-body);
    font-size: var(--t-caption);
    color: var(--c-text-muted);
    text-align: center;
  }

</style>
