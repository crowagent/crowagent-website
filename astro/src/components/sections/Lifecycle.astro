---
/**
 * Lifecycle — homepage section, "Delivery is the first stage of the next bid."
 *
 * Implements the owner-approved Figma frame M7 "Closed loop"
 * (wJ9DK6ByFUN6rWe0CpCVPU, node 79:53, page 72:2 "Section — Lifecycle v2
 * (market-neutral)"), owner decision 2026-08-02.
 *
 * ── WHAT THE SECTION ARGUES, AND WHY IT IS A RING ────────────────────────────
 *
 * The previous version of this file was a four-tab interface. Tabs present a
 * sequence you step through and then leave. That is the wrong shape for the
 * claim: Deliver is not the end of the process, it is the input to the next
 * bid, because the evidence a contract produces while you deliver it is what
 * makes the next answer credible. A ring closes; a rail stops. The geometry is
 * the argument, which is also why this section makes no competitor claim.
 *
 * ── THE COMPETITOR CLAIMS THAT ARE NOT HERE ──────────────────────────────────
 *
 * Earlier lifecycle drafts (M1, M4) each carried a line asserting that rival
 * tools stop before the post-award half and that hardly anyone competes there.
 * Both are unsourced, sweeping statements about every rival in the market,
 * which is the same class of claim already stripped as OA-18 and OA-01. They
 * are not softened here, they are absent: the drawing makes the point without
 * asserting anything about anyone else.
 *
 * ── NO FIGURES ───────────────────────────────────────────────────────────────
 *
 * The three unsourced statistics banned under OA-27 (an annual notice count
 * and two percentages) do not appear, in any form. Deliver's arc is drawn long
 * because delivery outlasts the tender, and the caption says in as many words
 * that the arc lengths carry emphasis and are not measured durations. A
 * drawing must never be dressed as data.
 *
 * ── WHY THE STAGE IS CALLED "COMMIT" ─────────────────────────────────────────
 *
 * Recorded rather than hidden: Commit is the blandest word on the page and it
 * is the stage that sells the product. It is deliberately not "Prove" or
 * "Evidence". Both of those mean substantiate something already true, and
 * stage three holds forward priced promises: PPN 002 commitments, EU Art. 67
 * and 70 conditions, s.52 KPIs, SLAs. You cannot prove what you have not done
 * yet, and "Evidence" would collide with the post-award artefact name. The
 * specificity therefore rides in the heading and in the stage's own line
 * ("priced before you sign") rather than in the label.
 *
 * ── THE EU POST-AWARD DUTY IS ART. 70 MONITORING ─────────────────────────────
 *
 * Earlier drafts of this file put the US federal contractor-performance
 * reporting system in the EU column, in several places. It is a US system and
 * belongs in neither the EU nor the UK vocabulary; the EU post-award duty is
 * Art. 70 monitoring, and that is what is written. Separately, s.52 (minimum
 * KPIs) and s.71 (assessment against them) are kept as two distinct duties.
 * Merging them was a live defect, OA-26.
 *
 * ── NO JAVASCRIPT ────────────────────────────────────────────────────────────
 *
 * This component ships zero script. Every word is in the document at first
 * paint. That is deliberate: a staged reveal elsewhere on this site failed the
 * axe gate on seven nodes because correct content depended on an observer
 * firing. The only motion is an ambient pulse on the core glow, gated behind
 * prefers-reduced-motion: no-preference, and nothing reads it for meaning.
 *
 * ── THE DIAGRAM IS SVG, NOT CSS ──────────────────────────────────────────────
 *
 * conic-gradient can sweep, but it cannot give each arc its own radius and
 * band width, cannot draw the leader stubs or the closing arrowhead, and
 * cannot carry <title>/<desc>. Every path below is computed in this
 * frontmatter from one polar helper, so the geometry is stated once as angles
 * rather than as hand-typed path strings nobody can check.
 */
import Section from '../layout/Section.astro';

/* ── Geometry ──────────────────────────────────────────────────────────────
   All angles are degrees CLOCKWISE FROM 12 O'CLOCK, matching how the frame
   reads. The spans below are measured off the Figma spoke positions, which is
   why they are not round numbers: the spokes sit at 0, 60, 130 and 192.

   Deliver spans 192 to 354, which is 162 degrees, close to half the ring. The
   remaining 6 degrees at the top are the gap the closing arrowhead sits in. */
const CX = 200;
const CY = 200;

/** A point on a circle of radius r at `deg` clockwise from 12 o'clock. */
function polar(r: number, deg: number): [number, number] {
  const a = ((deg - 90) * Math.PI) / 180;
  return [CX + r * Math.cos(a), CY + r * Math.sin(a)];
}
const f = (n: number) => Number(n.toFixed(2));

/** A circular arc, swept clockwise. */
function arcPath(r: number, from: number, to: number): string {
  const [x1, y1] = polar(r, from);
  const [x2, y2] = polar(r, to);
  return `M${f(x1)} ${f(y1)}A${r} ${r} 0 ${to - from > 180 ? 1 : 0} 1 ${f(x2)} ${f(y2)}`;
}

/** A radial line: a spoke, a leader stub or a bracket cap. */
function spokePath(deg: number, r1: number, r2: number): string {
  const [x1, y1] = polar(r1, deg);
  const [x2, y2] = polar(r2, deg);
  return `M${f(x1)} ${f(y1)}L${f(x2)} ${f(y2)}`;
}

/** A triangle sitting on the ring at `deg`, pointing clockwise along it. */
function arrowPoints(deg: number, r: number, len = 10, half = 5.5): string {
  const a = ((deg - 90) * Math.PI) / 180;
  const [px, py] = polar(r, deg);
  const tx = -Math.sin(a);
  const ty = Math.cos(a);
  const nx = Math.cos(a);
  const ny = Math.sin(a);
  const bx = px - len * 0.4 * tx;
  const by = py - len * 0.4 * ty;
  return [
    [px + len * tx, py + len * ty],
    [bx + half * nx, by + half * ny],
    [bx - half * nx, by - half * ny],
  ]
    .map(([x, y]) => `${f(x)},${f(y)}`)
    .join(' ');
}

interface Stage {
  /** Grid area name, and the class suffix. */
  key: 'find' | 'answer' | 'commit' | 'deliver';
  name: string;
  /** One line. Short enough to sit beside the ring at 280px. */
  line: string;
  /** The at-a-glance vocabulary, one example per market. */
  eg: string[];
  start: number;
  end: number;
}

const STAGES: Stage[] = [
  {
    key: 'find',
    name: 'Find',
    line: 'Notices read at source and scored against your own record.',
    eg: ['Find a Tender', 'TED', 'Ariba'],
    start: 0,
    end: 60,
  },
  {
    key: 'answer',
    name: 'Answer',
    line: 'Questions answered from your approved library, cited line by line.',
    eg: ['SQ', 'ESPD', 'SIG', 'SOC 2'],
    start: 60,
    end: 130,
  },
  {
    key: 'commit',
    name: 'Commit',
    line: 'Promises priced before you sign, with the numbers behind each one.',
    eg: ['PPN 002', 'Art. 67', 'SLAs'],
    start: 130,
    end: 192,
  },
  {
    key: 'deliver',
    name: 'Deliver',
    line: 'Commitments tracked, evidence filed, and the reports an authority expects years later.',
    eg: ['s.52 KPIs', 'Art. 70 monitoring', 'scorecards'],
    start: 192,
    end: 354,
  },
];

/* Band radii and widths. Deliver is drawn wider and reaching further in and
   out than the other three, so it holds the eye without needing a caption to
   say which arc matters. */
const R_STAGE = 132;
const W_STAGE = 30;
const R_DELIVER = 129;
const W_DELIVER = 48;
const R_BRACKET = 163;
const R_CORE = 52;
/** Clear space at each end of an arc, so the joins read as cuts not seams. */
const GAP = 3;

const arcs = STAGES.map((s) => ({
  key: s.key,
  d: arcPath(
    s.key === 'deliver' ? R_DELIVER : R_STAGE,
    s.start + GAP,
    s.end - GAP
  ),
}));

/** Boundary spokes, core out to the inner edge of the ring. */
const spokes = STAGES.map((s) => spokePath(s.start, 58, 98));

/** Leader stubs at each arc's midpoint, pointing outward at its label. */
const leaders = STAGES.map((s) => {
  const mid = (s.start + s.end) / 2;
  return s.key === 'deliver'
    ? spokePath(mid, R_BRACKET + 6, R_BRACKET + 28)
    : spokePath(mid, R_STAGE + W_STAGE / 2 + 3, R_STAGE + W_STAGE / 2 + 20);
});

/** The outer duration bracket over Deliver, with a cap at each end. */
const bracket = arcPath(R_BRACKET, 194, 351);
const bracketCaps = [spokePath(194, 157, 169), spokePath(351, 157, 169)];
/** The arrowhead in the top gap: Deliver arriving back at Find. */
const arrow = arrowPoints(356, R_BRACKET);

/* ── Market vocabulary ─────────────────────────────────────────────────────
   The narrative is market-neutral and UK public is the proof point, so the
   same four stages are shown three times rather than the UK vocabulary being
   presented as the vocabulary. This block is also the diagram's text
   equivalent: everything the ring encodes except its geometry is here as
   ordinary prose, visible to everyone rather than hidden for screen readers. */
const MARKETS: { name: string; rows: [string, string][] }[] = [
  {
    name: 'UK public sector',
    rows: [
      ['Find', 'Find a Tender, Contracts Finder'],
      ['Answer', 'Selection questionnaires, method statements'],
      ['Commit', 'PPN 002 commitments, National TOMs measures'],
      ['Deliver', 's.52 KPIs, then s.71 assessment against them'],
    ],
  },
  {
    name: 'EU and international',
    rows: [
      ['Find', 'TED, SAM.gov, AusTender'],
      ['Answer', 'ESPD, RFP responses'],
      ['Commit', 'Directive 2014/24/EU Art. 67 criteria, Art. 70 conditions'],
      ['Deliver', 'Art. 70 monitoring'],
    ],
  },
  {
    name: 'Private sector',
    rows: [
      ['Find', 'Portal invites, Ariba, Coupa'],
      ['Answer', 'SIG, CAIQ, ISO 27001, SOC 2'],
      ['Commit', 'SLAs, sustainability targets'],
      ['Deliver', 'Scorecards, quarterly business reviews'],
    ],
  },
];
---

<Section
  eyebrow="One engine, end to end"
  title="Delivery is the first stage of the next bid."
  standfirst="Find, Answer, Commit, Deliver. What you price as a promise at Commit becomes a duty you report at Deliver, and the record that produces is what makes your next answer credible."
  id="lifecycle"
>
  <div class="lc">
    <div class="lc__amb" aria-hidden="true"></div>

    <div class="lc__diagram">
      <div class="lc__ring">
        <div class="lc__glow" aria-hidden="true"></div>

        <svg
          class="lc__svg"
          viewBox="0 0 400 400"
          role="img"
          aria-labelledby="lc-svg-title lc-svg-desc"
          style={`--w-stage:${W_STAGE};--w-deliver:${W_DELIVER};--w-halo:${W_DELIVER + 14}`}
        >
          <title id="lc-svg-title">The four stages drawn as a closed ring.</title>
          <desc id="lc-svg-desc">
            Find, Answer, Commit and Deliver run clockwise around a single central
            record. Deliver is drawn as much the longest arc, and an arrow at the top
            carries it back into Find, so the ring closes rather than stopping. Each
            stage is written out in full beside and below the diagram.
          </desc>

          {spokes.map((d) => <path class="lc__spoke" d={d} />)}

          {
            arcs
              .filter((a) => a.key !== 'deliver')
              .map((a) => (
                <>
                  <path class="lc__band" d={a.d} />
                  <path
                    class="lc__hair"
                    d={arcPath(
                      R_STAGE - W_STAGE / 2,
                      STAGES.find((s) => s.key === a.key)!.start + GAP,
                      STAGES.find((s) => s.key === a.key)!.end - GAP
                    )}
                  />
                  <path
                    class="lc__hair"
                    d={arcPath(
                      R_STAGE + W_STAGE / 2,
                      STAGES.find((s) => s.key === a.key)!.start + GAP,
                      STAGES.find((s) => s.key === a.key)!.end - GAP
                    )}
                  />
                </>
              ))
          }

          <path class="lc__halo" d={arcs.find((a) => a.key === 'deliver')!.d} />
          <path class="lc__deliver" d={arcs.find((a) => a.key === 'deliver')!.d} />

          <path class="lc__bracket" d={bracket} />
          {bracketCaps.map((d) => <path class="lc__bracket" d={d} />)}
          <polygon class="lc__arrow" points={arrow} />

          {leaders.map((d, i) => (
            <path
              class:list={['lc__leader', { 'lc__leader--on': STAGES[i].key === 'deliver' }]}
              d={d}
            />
          ))}

          <circle class="lc__core" cx={CX} cy={CY} r={R_CORE} />
        </svg>

        <p class="lc__core-label" aria-hidden="true">One record</p>
      </div>

      {
        STAGES.map((s) => (
          <div class:list={['lc__stage', `lc__stage--${s.key}`]}>
            <h3 class="lc__stage-name">{s.name}</h3>
            <p class="lc__stage-line">{s.line}</p>
            <p class="lc__eg">
              {s.eg.map((e, i) => (
                <>
                  {i > 0 && (
                    <span class="lc__sep" aria-hidden="true">
                      ·
                    </span>
                  )}
                  {e}
                </>
              ))}
            </p>
          </div>
        ))
      }
    </div>

    <p class="lc__caption">
      Deliver is drawn as the longest arc because it outlasts every stage before it,
      and the evidence it files is what qualifies you at the next Find. The arc
      lengths carry emphasis, not measured durations.
    </p>

    <div class="lc__markets">
      {
        MARKETS.map((m) => (
          <div class="lc__market">
            <h4 class="lc__market-name">{m.name}</h4>
            <dl class="lc__vocab">
              {m.rows.map(([stage, vocab]) => (
                <>
                  <dt>{stage}</dt>
                  <dd>{vocab}</dd>
                </>
              ))}
            </dl>
          </div>
        ))
      }
    </div>

    <p class="lc__more">
      <a href="/crowmark">How one record carries from notice to s.52 report</a>
    </p>

    <p class="lc__note">
      The Procurement Act 2023 sets minimum KPIs under s.52 for contracts above the
      £5m threshold, and a separate duty to assess performance against them under
      s.71. CrowMark prices PPN 002 social value against published National TOMs
      proxy values, aligned to National TOMs conventions rather than a full National
      TOMs implementation. Advisory, not legal advice.
    </p>
  </div>
</Section>

<style>
  .lc {
    position: relative;
    isolation: isolate;
  }

  /* Ambient wash, contained inside the wrapper so it can never widen the page.
     The token layer exists for exactly this and the rebuild kept dropping it. */
  .lc__amb {
    position: absolute;
    z-index: -1;
    inset-inline: 0;
    top: -12%;
    height: 70%;
    background: var(--orb-teal);
    opacity: 0.18;
    pointer-events: none;
  }

  /* ── The radial layout ───────────────────────────────────────────────────
     Named areas, so the DOM can read Find, Answer, Commit, Deliver in order
     while Deliver is placed opposite the other three. That matters: Deliver
     holds the whole left half of the ring, so its label belongs on the left,
     and no amount of source-order shuffling should be needed to get it there. */
  .lc__diagram {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 430px) minmax(0, 1fr);
    grid-template-areas:
      'deliver ring find'
      'deliver ring answer'
      'deliver ring commit';
    gap: clamp(14px, 2.2vw, 34px);
    align-items: center;
  }

  .lc__ring {
    grid-area: ring;
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    align-self: center;
  }

  .lc__glow {
    position: absolute;
    inset: 27%;
    background: var(--orb-teal);
    opacity: 0.55;
    border-radius: 50%;
    pointer-events: none;
  }

  /* Ambient only. Nothing is revealed by it and nothing is read from it, so
     it is safe to run always and correct to stop under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .lc__glow {
      animation: lc-breathe 6s var(--ease) infinite;
    }
  }

  @keyframes lc-breathe {
    0%, 100% { opacity: 0.42; }
    50%      { opacity: 0.68; }
  }

  .lc__svg {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Every stroke width comes from the frontmatter constants via custom
     properties on the <svg>, so band width and arc radius can never drift
     apart in two files. */
  .lc__band {
    fill: none;
    stroke: var(--c-card-hover);
    stroke-width: var(--w-stage);
  }

  .lc__hair {
    fill: none;
    stroke: var(--c-border);
    stroke-width: 1;
  }

  .lc__halo {
    fill: none;
    stroke: var(--c-border-glow);
    stroke-width: var(--w-halo);
    opacity: 0.28;
  }

  /* Teal, because teal is the verified colour on this site and Deliver is
     where a commitment stops being a promise. Violet and orchid are reserved
     for refused or flagged, so neither appears in this section. */
  .lc__deliver {
    fill: none;
    stroke: var(--c-teal);
    stroke-width: var(--w-deliver);
  }

  .lc__bracket,
  .lc__leader,
  .lc__spoke {
    fill: none;
    stroke: var(--c-border);
    stroke-width: 1.25;
  }

  .lc__bracket {
    stroke: var(--c-teal);
    opacity: 0.5;
  }

  .lc__leader--on {
    stroke: var(--c-teal);
    opacity: 0.7;
  }

  .lc__arrow {
    fill: var(--c-teal);
  }

  .lc__core {
    fill: var(--c-card);
    stroke: var(--c-border);
    stroke-width: 1;
  }

  .lc__core-label {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    margin: 0;
    max-width: 9ch;
    margin-inline: auto;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-align: center;
    text-transform: uppercase;
    color: var(--c-teal);
    pointer-events: none;
  }

  /* ── Stage labels ────────────────────────────────────────────────────────*/
  .lc__stage--find { grid-area: find; }
  .lc__stage--answer { grid-area: answer; }
  .lc__stage--commit { grid-area: commit; }
  .lc__stage--deliver {
    grid-area: deliver;
    text-align: right;
  }

  .lc__stage-name {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
    line-height: 1.2;
    color: var(--c-text);
  }

  .lc__stage--deliver .lc__stage-name { color: var(--c-teal); }

  .lc__stage-line {
    margin: 0 0 8px;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.55;
    color: var(--c-text-sub);
  }

  .lc__eg {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.6;
    color: var(--c-text-muted);
  }

  .lc__sep {
    padding-inline: 0.45em;
    color: var(--c-border-glow);
  }

  /* ── Caption, markets, notes ─────────────────────────────────────────────*/
  .lc__caption {
    margin: var(--sec-gap) auto 0;
    max-width: 74ch;
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text-sub);
  }

  .lc__markets {
    margin-top: var(--sec-gap);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 28px);
  }

  .lc__market {
    padding: var(--blk-pad);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-panel);
    background: var(--c-card);
    box-shadow: var(--shadow-card);
  }

  .lc__market-name {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  .lc__vocab {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.9rem;
    row-gap: 0.55rem;
    align-items: baseline;
  }

  .lc__vocab dt {
    font-family: var(--font-body);
    font-size: var(--t-micro);
    font-weight: 600;
    color: var(--c-text);
  }

  .lc__vocab dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-micro);
    line-height: 1.55;
    color: var(--c-text-sub);
  }

  .lc__more {
    margin: var(--stack-2) 0 0;
    text-align: center;
  }

  /* Cyan is the interactive colour on this site and this is the only
     interactive element in the section, so it is the only cyan here. */
  .lc__more a {
    color: var(--c-cyan);
    font-family: var(--font-body);
    font-size: var(--t-body);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .lc__more a:focus-visible {
    outline: 3px solid var(--c-teal);
    outline-offset: 3px;
  }

  .lc__note {
    margin: var(--stack-2) auto 0;
    max-width: 82ch;
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--t-micro);
    line-height: 1.7;
    color: var(--c-text-muted);
  }

  /* ── The linear fallback ─────────────────────────────────────────────────
     A radial layout needs room on both sides of the ring for labels, and
     below roughly 900px there is none. Rather than shrink four label blocks
     into unreadable columns, the SAME markup relayouts: the ring becomes a
     capped graphic at the top and the four stages stack beneath it in reading
     order. Nothing is hidden and nothing is duplicated, because the labels
     were never inside the SVG. */
  @media (max-width: 899px) {
    .lc__diagram {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'ring ring'
        'find answer'
        'commit deliver';
      gap: clamp(20px, 4vw, 32px);
    }

    .lc__ring {
      justify-self: center;
      width: min(100%, 340px);
      margin-bottom: clamp(8px, 2vw, 20px);
    }

    .lc__stage--deliver { text-align: left; }

    .lc__markets { grid-template-columns: minmax(0, 1fr); }
  }

  /* 390px: two label columns stop working before the ring does, so the ring
     stays and the stages go to one column. At this width the ring renders at
     about 300px, which still reads as a ring; the caption and the market
     blocks carry every word regardless. */
  @media (max-width: 599px) {
    .lc__diagram {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'ring'
        'find'
        'answer'
        'commit'
        'deliver';
    }
  }
</style>
