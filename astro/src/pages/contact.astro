---
/**
 * /contact — the page every "Request access" CTA on the site points at.
 *
 * SEO IS CARRIED OVER VERBATIM from the live page: title, description,
 * canonical and the BreadcrumbList JSON-LD. The design changes; the metadata
 * does not.
 *
 * THE SCREENSHOT SECTION IS BACK (2026-08-02). An earlier note here said the
 * legacy "What you will see on the call" block was deliberately not ported,
 * because product captures on the public site are a known credibility defect
 * (empty test tenant, literal "Test Contract 1" strings). That reasoning did
 * not survive checking: the capture the legacy contact page actually uses is
 * /Assets/shots/dark/mark-analytics, the SAME file crowmark.astro:115 already
 * ships in its hero, and the same capture library is shipped by all four
 * /compare pages and every /sectors page in this rebuild. Holding one page to a
 * rule the other twelve do not follow is not a standard, it is an omission with
 * a justification attached. It returns here, captioned exactly as crowmark.astro
 * captions it, and the sample-account wording is kept so nobody reads it as a
 * customer's data. The wider "seed the captures properly" item stays open.
 */
import Base from '../layouts/Base.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import NewsletterForm from '../components/forms/NewsletterForm.astro';
import { SITE } from '../data/site';

const title = 'Contact | CrowAgent';
const description =
  'Book a 30-minute call, send an enquiry, or email us. UK team, replying within three to five business days.';

const CALENDLY = 'https://calendly.com/crowagent-platform/30min';

/** Verbatim from the live page. */
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.origin}/` },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${SITE.origin}/contact` },
  ],
};

/** Who to email, and for what. Kept as data so the list cannot drift from the
    directory rendered below it. */
const DIRECTORY = [
  { purpose: 'General and partnerships', address: 'hello@crowagent.ai' },
  { purpose: 'Support and data requests (GDPR)', address: 'support@crowagent.ai' },
  { purpose: 'Enterprise sales', address: 'sales@crowagent.ai' },
  { purpose: 'Security disclosures', address: 'security@crowagent.ai' },
];

/**
 * REACH PANELS — restored from contact.html:177-205.
 *
 * The port kept only the hero and the form, so the "Send us an email" panel
 * went with the section it lives in. It is restored as the PAIR the live page
 * has: the two panels are one two-up grid, and shipping a lone card in a
 * two-column layout would be a design decision rather than a restoration. The
 * booking panel duplicating the hero button is how the live page reads today.
 *
 * Copy is verbatim, including "3 to 5 business days" in digits, which is how
 * these two panels are written on the live page.
 *
 * THE ENTERPRISE PANEL IS BACK (OA-28, 2026-08-02). It was the only route to a
 * portfolio conversation on the page and the port dropped it; the content-parity
 * allow-list carried it as "NOT a recorded decision, needs an owner call". It
 * comes back here rather than as a fourth section because contact.html:233 puts
 * it in a three-up card grid with the booking card and the email card, which are
 * the two panels this grid already renders. Copy is verbatim from
 * contact.html:245-247, and the action is the same mailto the live card carries;
 * sales@crowagent.ai is already published in the directory below.
 */
const REACH = [
  {
    heading: 'Book a 30-minute call',
    body: 'Speak directly with the founders. Walk through your procurement challenge live.',
    href: 'https://calendly.com/crowagent-platform/30min',
    action: 'Choose a time',
    external: true,
  },
  {
    heading: 'Portfolio plan and volume licensing',
    body: 'Microsoft Entra ID single sign-on, branded exports, invoice or purchase order billing, and pricing scoped to a high-volume bidding team.',
    href: 'mailto:sales@crowagent.ai?subject=Enterprise%20enquiry',
    action: 'Email sales',
    external: false,
  },
  {
    heading: 'Send us an email',
    body: 'hello@crowagent.ai · We respond within 3 to 5 business days.',
    href: 'mailto:hello@crowagent.ai',
    action: 'hello@crowagent.ai',
    external: false,
  },
];

const COMPANY = [
  { term: 'Registration', detail: 'Registered in England and Wales' },
  { term: 'Companies House number', detail: '17076461', mono: true },
  { term: 'Data protection', detail: 'ICO registered data controller' },
  { term: 'Data residency', detail: 'UK and EU' },
  { term: 'UK business hours', detail: 'Mon-Fri, 09:00-17:30 BST' },
  { term: 'Response time', detail: 'Typically three to five business days' },
];
---

<Base title={title} description={description} path="/contact" schema={[breadcrumb]}>
  <Section
    {/* "Contact · London based · UK team" until 2026-08-03. An eyebrow is
        positioning copy, and OA-25 settled that the narrative covers UK public,
        UK private, EU and global private tenders, with UK public as the PROOF
        POINT rather than the identity. Telling a global reader "UK team" in the
        first line of the contact page narrows exactly what that decision opened.

        NOTHING FACTUAL IS LOST, which is why this is safe to do without asking:
        the CrowAgent Ltd card on this same page already prints "Registered in
        England and Wales", the Companies House number, UK and EU data residency
        and UK business hours. The eyebrow was the only place the jurisdiction
        led rather than informed. */}
    eyebrow="Contact"
    title="Talk to CrowAgent."
    standfirst="Book a slot, send an enquiry, or email us directly. We reply within three to five business days, and the person who replies is on the team that built it."
    id="contact-hero"
  
    as="h1">
    <div class="btn-row">
      <Button href={CALENDLY} target="_blank">Book a 30-minute call</Button>
      <Button href="mailto:hello@crowagent.ai" variant="secondary">Email us</Button>
    </div>
  </Section>

  {/*
    REACH PANELS — restored from contact.html:177-205. No head block, because
    the legacy section has none: the two panel headings ARE the h2s, and adding
    a section heading over them would be new copy nobody wrote.
  */}
  <Section id="reach">
    <div class="reach">
      {
        REACH.map((r) => (
          <a
            class="reach__card surface"
            href={r.href}
            target={r.external ? '_blank' : undefined}
            rel={r.external ? 'noopener noreferrer' : undefined}
          >
            <h2 class="reach__h">{r.heading}</h2>
            <p class="reach__body">{r.body}</p>
            {/* The arrow is decoration on a link whose text already says where
                it goes, so it is hidden from assistive tech. */}
            <span class="reach__action">
              {r.action}
              <span aria-hidden="true"> &rarr;</span>
            </span>
          </a>
        ))
      }
    </div>

    <p class="reach__trust">
      Response within 3 to 5 business days · Founded in the UK · No outsourced support
    </p>
  </Section>

  {/*
    PRODUCT CAPTURE — restored from contact.html:214-228. See the note at the
    top of this file for why the earlier decision not to port it was reversed.
  */}
  <Section
    eyebrow="The product"
    title="What you will see on the call"
    standfirst="Screens from the live product, shown with a sample account rather than a customer's data."
    id="contact-shots"
  >
    <figure class="shot">
      <picture>
        <source type="image/avif" srcset="/Assets/shots/dark/mark-analytics.avif?v=20260731e" />
        <source type="image/webp" srcset="/Assets/shots/dark/mark-analytics.webp?v=20260731e" />
        <img
          src="/Assets/shots/dark/mark-analytics.png?v=20260731e"
          width="3200"
          height="2000"
          loading="lazy"
          decoding="async"
          alt="The CrowMark analytics screen, shown with a sample account: headline tiles for total contracts, social value delivered across won bids, and evidence completion against committed measures; bar charts of contracts by status and bids by sector; and an average social value score trend. Each chart has a CSV export button."
        />
      </picture>
      <figcaption>
        CrowMark Analytics, social value bid performance, shown with a sample account.
      </figcaption>
    </figure>
  </Section>

  {/*
    The form gets its own section and its own heading, and it is `#contact-form`
    because every sitewide CTA links to that fragment. Changing this id breaks
    the anchor on every page at once.
  */}
  <Section
    eyebrow="Send a message"
    title="Tell us what you're working on."
    standfirst="Bidding for public sector contracts, or working out whether CrowAgent fits your organisation: tell us the situation and we will answer properly."
    id="contact-form"
  >
    <div class="contact-grid">
      <div class="contact-grid__form">
        <ContactForm />
      </div>

      <aside class="contact-grid__aside" aria-labelledby="directory-title">
        <h3 class="aside__title" id="directory-title">How to reach us by email</h3>
        <dl class="directory">
          {
            DIRECTORY.map((d) => (
              <div class="directory__row">
                <dt>{d.purpose}</dt>
                <dd>
                  <a href={`mailto:${d.address}`}>{d.address}</a>
                </dd>
              </div>
            ))
          }
        </dl>

        <h3 class="aside__title" id="company-title">CrowAgent Ltd</h3>
        <dl class="directory" aria-labelledby="company-title">
          {
            COMPANY.map((c) => (
              <div class="directory__row">
                <dt>{c.term}</dt>
                <dd class={c.mono ? 'is-mono' : undefined}>{c.detail}</dd>
              </div>
            ))
          }
          <div class="directory__row">
            <dt>Registered office</dt>
            <dd>Details available in our <a href="/privacy">Privacy Policy</a></dd>
          </div>
        </dl>
      </aside>
    </div>
  </Section>

  {/*
    NEWSLETTER — restored from contact.html:485-498, which the first port
    dropped. Same block as /about, different framing copy, both verbatim. The
    eyebrow is the one addition, for the reason recorded on /about.
  */}
  <Section
    eyebrow="Monthly digest"
    title="Prefer regulatory updates?"
    standfirst="Get our monthly procurement digest covering PPN 002 social value and CrowMark product news."
    id="newsletter"
  >
    <NewsletterForm id="contact-nl" source="contact-newsletter" />
  </Section>
</Base>

<style>
  /* Centred to match the head block above it (owner decision, 2026-08-02).
     Alignment only: the row centres on the same axis as its heading. */

  /* ── Reach panels ─────────────────────────────────────────────────────── */
  /* Three-up, matching contact.html:233 (`grid-cols-1 md:grid-cols-3`): booking,
     enterprise, email. It was two-up only while the enterprise panel was
     missing. */
  .reach {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 36px);
  }

  /* The whole card is the link, so the target is the panel rather than a short
     line of text at the bottom of it. */
  /* Border, background, gloss, hover and the focus ring all come from
     `surface`. This page previously carried its own hover (border-color only,
     no lift, no change of light) which is why the card felt dead next to the
     compare hub cards, which had a different hover again. */
  .reach__card {
    display: block;
    padding: var(--blk-pad);
    text-decoration: none;
  }

  .reach__h {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 700;
    color: var(--c-text);
  }

  .reach__body {
    margin: 0 0 var(--stack-2);
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text-sub);
    overflow-wrap: anywhere;
  }

  .reach__action {
    display: inline-block;
    font-family: var(--font-mono);
    line-height: var(--lh-tight);
    font-size: var(--t-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-teal);
    overflow-wrap: anywhere;
  }

  .reach__trust {
    margin: var(--sec-gap) 0 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.8;
    color: var(--c-text-muted);
  }

  /* ── Product capture ──────────────────────────────────────────────────── */
  /* Matches crowmark.astro, which ships the same file. */
  .shot { margin: 0; }

  .shot img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-card);
  }

  .shot figcaption {
    margin-top: var(--stack-1);
    font-family: var(--font-body);
    font-size: var(--t-micro);
    line-height: 1.6;
    color: var(--c-text-muted);
    max-width: 78ch;
  }

  .contact-grid {
    display: grid;
    /* minmax(0, …) on both tracks: a bare 1fr keeps the min-content floor and a
       long email address would then push the page sideways. */
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  /* THESE ARE HEADINGS, SO THEY TAKE A HEADING SIZE. "How to reach us by
     email" and "CrowAgent Ltd" each head a definition list and each is the
     accessible name of the block below it, and they were set at --t-micro:
     13px, mono, uppercase, muted. That is the label treatment, and at 13px a
     heading is smaller than the text it introduces.
     --t-h4 is the tier for a heading inside a card or panel, which is what the
     aside column is. The eyebrow treatment stays where it belongs, on <p>. */
  .aside__title {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
    letter-spacing: -0.01em;
    color: var(--c-text);
  }

  .aside__title + .directory { margin-bottom: var(--sec-gap); }

  .directory {
    margin: 0;
    display: grid;
    gap: 0;
  }

  .directory__row {
    display: grid;
    /* The label column is fixed so every value starts on one vertical, which is
       the only reason a definition list beats two stacked paragraphs. */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 0 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--c-border);
  }

  .directory__row:last-child { border-bottom: 0; }

  .directory dt {
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--c-text-muted);
  }

  .directory dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--c-text-sub);
    /* A long address wraps rather than widening the column. */
    overflow-wrap: anywhere;
  }

  .directory dd.is-mono { font-family: var(--font-mono); }

  .directory a {
    color: var(--c-interactive);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .directory a:focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: 3px;
  }

  @media (max-width: 899px) {
    .contact-grid { grid-template-columns: minmax(0, 1fr); }
    .reach { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 519px) {
    .directory__row { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
</style>
