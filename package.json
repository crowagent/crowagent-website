{
  "name": "crowagent-website",
  "version": "1.0.0",
  "description": "",
  "main": "scripts.js",
  "scripts": {
    "prepare": "git config core.hooksPath .husky || true",
    "dev": "serve . -l 8092",
    "build:css": "node -e \"console.error('REFUSED. This used to run tailwind with -o pointed straight at Assets/css/sovereign-core-v2.compiled.css, the sheet 43 marketing pages load. A fresh build is NOT equivalent: it drops 472 utility rules, loses the srgb color-mix() fallbacks on every ca-* colour with an opacity modifier (they degrade to full opacity), and reintroduces the hardcoded hex/z-index/px values the token pass removed. Run `npm run check:css:sovereign` to see the measured delta and the fix order.'); process.exit(1)\"",
    "check:css:sovereign": "node scripts/check-sovereign-core-reproducibility.js",
    "build:css:legacy": "node .dev-tools/build-css-postcss.mjs styles.css styles.inlined.css && csso styles.inlined.css --output styles.min.css && node .dev-tools/purge-run.mjs && cp styles.purged.css styles.min.css && rm -f styles.inlined.css",
    "build:css:purge": "node scripts/build-css.js",
    "build:js": "terser scripts.js --compress --mangle --output scripts.min.js",
    "build:og": "node scripts/generate-og-images.js",
    "build:og:force": "node scripts/generate-og-images.js --force",
    "build:og:check": "node scripts/generate-og-images.js --check",
    "build:webp": "node scripts/build-webp.js --rewrite-html",
    "build:webp:check": "node scripts/build-webp.js --check",
    "build:avif": "node scripts/build-avif.js",
    "build:avif:check": "node scripts/build-avif.js --check",
    "build:avif:force": "node scripts/build-avif.js --force",
    "build": "node scripts/build-dist.js",
    "build:full": "npm run build:webp && npm run build:css && npm run build:js && npm run build:og",
    "test": "jest",
    "test:responsive": "playwright test tests/responsive.spec.js",
    "test:visual": "playwright test --project=visual-regression",
    "test:visual:update": "playwright test --project=visual-regression --update-snapshots",
    "test:cross-browser": "playwright test --project=cross-browser-chromium --project=cross-browser-firefox --project=cross-browser-webkit",
    "test:cross-browser:chromium": "playwright test --project=cross-browser-chromium",
    "sync-pricing": "tsx scripts/sync-pricing-from-stripe.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crowagent/crowagent-website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/crowagent/crowagent-website/issues"
  },
  "homepage": "https://github.com/crowagent/crowagent-website#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "csso": "^5.0.5",
    "csso-cli": "^4.0.2",
    "esbuild": "^0.27.7",
    "gsap": "^3.15.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lighthouse": "^13.3.0",
    "postcss": "^8.5.15",
    "postcss-import": "^16.1.1",
    "purgecss": "^8.0.0",
    "satori": "^0.12.2",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "stripe": "^17.5.0",
    "tailwindcss": "^4.3.0",
    "terser": "^5.46.1",
    "tsx": "^4.19.2",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}
