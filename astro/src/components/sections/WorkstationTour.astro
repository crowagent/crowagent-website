---
/**
 * WorkstationTour — the five product screens as one cinematic carousel.
 *
 * ── WHERE IT COMES FROM ─────────────────────────────────────────────────────
 *
 * Owner instruction, 2026-08-07, pointing at the Ultra-Premium Mode of
 * homepage-concept.html: build the Workstation tour as its own section. Three
 * earlier passes gave the existing tab switcher a pair of arrows instead and
 * called it done; that was a substitution, not the thing asked for.
 *
 * WHAT IS PORTED, RULE BY RULE, from `.apple-carousel-wrapper` in that file:
 *
 *     wrapper   radius 24, padding 2.5rem, teal-tinted 35% border,
 *               0 24px 60px rgba(0,0,0,.7), overflow hidden
 *     stage     aspect-ratio 16/10, radius 16, 18% white border, deep fill
 *     slide     absolute inset 0, opacity 0 -> 1 with scale(.98) -> scale(1)
 *     caption   bottom overlay, transparent -> near-solid, tag + title + desc
 *     controls  46px round buttons, dots that elongate to 36px when active
 *
 * WHAT IS DELIBERATELY NOT PORTED, AND WHY EACH ONE:
 *
 *   · EVERY HEX. The concept writes #2DD4BF, #22D3EE, #B39DFB, #FFFFFF and
 *     #03050C inline. check-palette-roles.js allows a colour to be named only
 *     in styles/tokens.css, so none of them are written as hex here.
 *
 *     THIS SAID "every one of them arrives here as the token it already
 *     equals: --c-teal, --c-cyan, --c-orchid, --c-interactive, --c-floor"
 *     UNTIL 2026-08-08, and it was wrong about the first one: the bezel edge,
 *     the tag badge and the nav/dot response wrote `var(--c-teal)` directly,
 *     which is the SAME mistake rule 1 exists to catch, one remove from the
 *     hex it claims to have avoided — a hue named through a variable rather
 *     than hardcoded. check-design-system.js never reached this file to say
 *     so, because a card-recipe fault in the same component failed the build
 *     first and the chain is `&&`-joined. Fixed by routing all seven
 *     occurrences through `--c-tour-accent` in tokens.css, a role bound to
 *     `--c-teal` and documented beside `--c-ambient-*` for the same reason:
 *     decoration, not a mark, kept teal because V6 never drained the
 *     decorative ramp. The rendered colour is unchanged; the authority for it
 *     now genuinely lives in tokens.css rather than only claiming to.
 *
 *   · `transition: all`. Named properties only, so a future declaration cannot
 *     silently acquire an animation.
 *
 *   · THE UNGUARDED AUTOPLAY. The concept advances on a timer with no
 *     prefers-reduced-motion branch and no pause control. check-autoplay.mjs
 *     requires both, and it is right to: WCAG 2.2.2 is Level A for anything
 *     moving longer than five seconds. This carousel therefore never starts
 *     under `reduce`, and ships a real pause button that genuinely pauses.
 *
 * ── IT DOES NOT DUPLICATE ProductScreens, AND THAT IS ENFORCED BY POSITION ──
 *
 * Both draw the same five screens. That would be a repetition defect if they
 * made the same argument, so they do not: this section is the SWEEP — five
 * frames, one after another, read in ten seconds — and ProductScreens below it
 * is the READ, where each screen sits still beside the wording it carries and
 * the verbatim in-product quotes that keep the claims honest. Tour first, then
 * the detail. The five slides here carry no quote for exactly that reason.
 */
import Section from '../layout/Section.astro';
import { TOUR } from '../../data/tour';

/* AVIF and WebP siblings are derived from the PNG the same way Carousel.astro
   derives them, so copy-assets.js fails the build if any of the three is
   missing rather than shipping a silent 404. */
const alt = (src: string, ext: string) => src.replace(/\.png(\?|$)/, `.${ext}$1`);
---

<Section
  eyebrow="Workstation tour"
  title="The rest of the workstation."
  standfirst="Six screens that appear nowhere else on this page: what a buyer publishes, what a supplier answers from, how a commitment is evidenced, how a response is banded, what the audit trail records, and the duties that get carried on a phone."
  id="workstation-tour"
>
  <div class="wt" data-wt>
    <div class="wt__stage">
      {
        TOUR.map((s, i) => (
          <figure class:list={['wt__slide', i === 0 && 'is-active']} aria-hidden={i === 0 ? 'false' : 'true'}>
            <picture>
              <source type="image/avif" srcset={alt(s.src, 'avif')} />
              <source type="image/webp" srcset={alt(s.src, 'webp')} />
              <img
                src={s.src}
                alt={s.alt}
                width={s.width}
                height={s.height}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </picture>

            {/* The caption is the REGISTRY's, not this component's. See the
                note in data/tour.ts: a sentence describing a drawing belongs
                beside the drawing's own record, or the two drift. */}
            <figcaption class="wt__cap">
              <p class="chip wt__tag">{s.tag}</p>
              <p class="wt__desc">{s.caption}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="wt__controls">
      <button class="wt__nav" type="button" data-wt-prev aria-label="Previous screen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <div class="wt__dots" role="tablist" aria-label="Choose a screen">
        {
          TOUR.map((s, i) => (
            <button
              class:list={['wt__dot', i === 0 && 'is-active']}
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              aria-label={`Screen ${i + 1} of ${TOUR.length}: ${s.tag}`}
            >
              <span class="wt__dot-mark" aria-hidden="true"></span>
            </button>
          ))
        }
      </div>

      <div class="wt__right">
        {/* `hidden` until the module confirms a timer is genuinely running, so a
            reader with JavaScript off or reduced motion set never receives a
            pause control for something that is not moving. */}
        <button class="wt__pause" type="button" data-wt-pause hidden aria-pressed="false">
          <span class="wt__pause-icon" aria-hidden="true"></span>
          <span data-wt-pause-label>Pause</span>
        </button>

        <button class="wt__nav" type="button" data-wt-next aria-label="Next screen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <p class="visually-hidden" data-wt-live aria-live="polite"></p>
  </div>
</Section>

<style>
  /* THE WRAPPER IS THE CONCEPT'S, VALUE FOR VALUE, with every colour named as a
     role. 24px radius, 2.5rem pad, a teal-tinted edge at 35% and the deep drop
     shadow are what make it read as a device rather than as a section. */
  .wt {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--c-tour-accent) 35%, transparent);
    /* --radius-frame-lg and --frame-pad-lg, not --radius-card/--blk-pad: this
       is a device bezel holding a screen and its control bar, not a card, for
       the same reason Carousel.astro's `.pcar__frame` is not a `.surface`.
       See both tokens in tokens.css for the full argument. Same pixel values
       as before (24px; clamp(16px, 2.5vw, 40px)), so nothing renders
       differently, this only moves the numbers into the named frame scale. */
    border-radius: var(--radius-frame-lg);
    padding: var(--frame-pad-lg);
    background: color-mix(in srgb, var(--c-panel) 85%, transparent);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.7);
    overflow: hidden;
  }

  /* 16:10 IS THE SHOT LADDER'S OWN RATIO. Every screen in Assets/shots/figma-v2
     is 2880x1800, so the stage matches the source and nothing is cropped by the
     object-fit below. A mismatch here is what made an earlier carousel overflow
     its caption bar. */
  .wt__stage {
    position: relative;
    aspect-ratio: 16 / 10;
    max-block-size: 640px;
    /* The aspect-ratio + max-block-size pair makes this size like a replaced
       element: its width is computed from the constrained height rather than
       stretching to fill `.wt`'s content box, so once that computed width is
       narrower than the parent (any viewport past the point max-block-size
       binds) the block sits flush at the inline-start edge unless told
       otherwise. margin-inline: auto is that instruction. Measured before this
       line existed: 1440px, `.wt` centre 720px, `.wt__stage` centre 653px, a
       67px miss — the homepage hero sitting visibly off-centre. */
    margin-inline: auto;
    border: 1px solid color-mix(in srgb, var(--c-text) 18%, transparent);
    border-radius: 16px;
    background: var(--c-floor);
    overflow: hidden;
  }

  .wt__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: scale(0.98);
    pointer-events: none;
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .wt__slide.is-active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  /* CONTAIN, NOT COVER, BECAUSE THE SET IS NO LONGER ONE SHAPE. The tour now
     carries 16:10 desktop, 4:3 tablet and portrait phone drawings. `cover`
     would crop a phone to a landscape strip and throw away the screen it is
     there to show; `contain` centres each one in the frame and lets the floor
     hold the space around it, which is how a device is shown rather than a
     texture. */
  .wt__slide img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  /* The caption sits ON the screen, over a ramp from transparent to the floor,
     which is what lets it be read without a panel of its own. */
  /* ── THE SCRIM IS BUILT FOR A LIGHT SCREENSHOT, WHICH IS THE WHOLE PROBLEM ─
   *
   * The concept ramps `transparent -> rgba(3,5,12,.95)` and it works there,
   * because in that file the caption sits over a dark frame. Every shot in
   * Assets/shots/figma-v2 is the LIGHT variant of the product — the owner's
   * decision of 2026-08-07, "i need my light mode carousels" — so the top of
   * that ramp lands white ink on a white UI. Read off the first build: the tag
   * and the title were sitting on the screenshot's own pale panel at nothing
   * like a readable ratio.
   *
   * So the ramp starts darkening sooner and finishes effectively opaque. The
   * first stop is still fully transparent, so the screen is not veiled where
   * there is no text; by the time any glyph starts it is past 70% of the floor,
   * and the last third is solid. The caption reads as a plate the screen slides
   * under, which is also closer to what the concept looks like than what a
   * literal copy of its values produced.
   */
  .wt__cap {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: clamp(40px, 6vw, 72px) clamp(16px, 2.5vw, 32px) clamp(16px, 2vw, 24px);
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--c-floor) 72%, transparent) 38%,
      color-mix(in srgb, var(--c-floor) 96%, transparent) 68%,
      var(--c-floor) 100%
    );
  }

  /* [R262-D-73 2026-08-08] This carried `.meta` and then hand-rolled a box on top
     of it — `display: inline-block`, its own padding, border, radius and fill.
     `check-treatments` counted that as a FIFTH label recipe, and it was right:
     labels.css defines `.meta` as "a bare line of provenance — a date, a reading
     time, a reference", while `.chip` is "a small pill stating a state or a
     category on an item". "Buyer · Requirement builder" is plainly the latter.

     So the class was wrong, not the styling. `.chip` already supplies
     inline-block, padding, a 1px border and a pill radius, so all of that is
     deleted here rather than restated. What stays is only what is genuinely this
     component's own: the tour accent hue and the 6px gap beneath.

     Colour is deliberately NOT part of any of the four recipes — labels.css says
     to set it at the call site, "where a teal verified chip and an orchid refused
     chip are the same object in two states". That is exactly what remains. */
  .wt__tag {
    margin: 0 0 6px;
    border-color: color-mix(in srgb, var(--c-tour-accent) 30%, transparent);
    background: color-mix(in srgb, var(--c-tour-accent) 15%, transparent);
    color: var(--c-tour-accent);
  }

  .wt__desc {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-h3);
    /* [R262-D-73] Was declared twice — `--lh-tight` then `--lh-body` — so the
       first was dead the moment it was written. `--lh-body` is the one that has
       always applied and is the correct value for a wrapping description, so the
       dead line is removed rather than the live one. */
    line-height: var(--lh-body);
    color: var(--c-text-muted);
    max-inline-size: 68ch;
  }

  .wt__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--stack-2);
    margin-block-start: var(--stack-3);
  }

  .wt__right {
    display: flex;
    align-items: center;
    gap: var(--stack-1);
  }

  /* 46px round, and it grows and fills teal on hover. The concept's own numbers;
     46 also clears the 44px target floor check-controls.js enforces. */
  .wt__nav {
    inline-size: 46px;
    block-size: 46px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--c-text) 20%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c-text) 8%, transparent);
    color: var(--c-text);
    cursor: pointer;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .wt__nav svg {
    inline-size: 1.1rem;
    block-size: 1.1rem;
  }

  @media (hover: hover) {
    .wt__nav:hover {
      background: var(--c-tour-accent);
      border-color: var(--c-tour-accent);
      color: var(--c-bg);
    }
  }

  .wt__nav:focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: 2px;
  }

  .wt__dots {
    display: flex;
    gap: 10px;
  }

  /* THE ELONGATING DOT IS THE CONCEPT'S SIGNATURE, and the BUTTON's OWN box is
     what check-render.js measures (`getBoundingClientRect()` on the element
     itself, not on a pseudo-element's hit area) — WCAG 2.5.8 is about the
     target a pointer or a screen reader's touch mode is given, and a
     transparent ::after that only pointer events can reach never was that
     target. So the button is the fixed-size, transparent, >=24px hit box, and
     the visible mark — 12px, elongating to 36px active, exactly the concept's
     numbers — is a separate inner element that can stay small without the
     button that carries it ever measuring small. Fixed at 36x24 in BOTH
     states, not just active, so the row never reflows as the mark grows and
     shrinks inside it. */
  .wt__dot {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 36px;
    block-size: 24px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: pointer;
  }

  .wt__dot-mark {
    display: block;
    inline-size: 12px;
    block-size: 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c-text) 20%, transparent);
    transition:
      inline-size var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .wt__dot.is-active .wt__dot-mark {
    inline-size: 36px;
    background: var(--c-tour-accent);
  }

  .wt__dot:focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: 3px;
  }

  .wt__pause {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-block-size: 44px;
    padding: 0 16px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    background: var(--c-card);
    color: var(--c-text-muted);
    font-family: var(--font-body);
    font-size: var(--t-micro);
    font-weight: 700;
    cursor: pointer;
  }

  .wt__pause[hidden] {
    display: none;
  }

  .wt__pause-icon {
    inline-size: 10px;
    block-size: 12px;
    border-inline: 3px solid currentColor;
    box-sizing: border-box;
  }

  .wt__pause.is-paused .wt__pause-icon {
    inline-size: 0;
    block-size: 0;
    border: 6px solid transparent;
    border-inline-start: 10px solid currentColor;
    border-inline-end: 0;
  }

  /* NOTHING CROSSFADES FOR A READER WHO ASKED FOR STILLNESS. The slide still
     changes — the carousel remains operable by arrow and dot — it simply
     changes instantly instead of dissolving. */
  @media (prefers-reduced-motion: reduce) {
    .wt__slide {
      transition: none;
      transform: none;
    }

    .wt__slide.is-active {
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .wt__controls {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>

<script>
  /*
   * The tour driver. Deliberately not Carousel.astro's: that component is a
   * single framed screenshot with a caption strip, and this one is a full-bleed
   * stage with an overlaid caption, dots that elongate and its own pause. What
   * they share is the CONTRACT, and it is the contract the gates measure:
   *
   *   1  never advances under prefers-reduced-motion
   *   2  a real pause control, revealed only once a timer is genuinely running
   *   3  pause actually stops it
   *   4  a reader's own choice ends autoplay for good
   *
   * 7 seconds, not the concept's unstated interval: each caption is a tag, a
   * title and a sentence, which is more than five seconds of reading, and WCAG
   * 2.2.2 treats anything over five as requiring the control that exists below.
   */
  const INTERVAL = 7000;

  for (const root of document.querySelectorAll<HTMLElement>('[data-wt]')) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.wt__slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.wt__dot'));
    const live = root.querySelector<HTMLElement>('[data-wt-live]');
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-wt-pause]');
    const pauseLabel = pauseBtn?.querySelector<HTMLElement>('[data-wt-pause-label]') ?? null;
    if (slides.length < 2) continue;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let timer: number | null = null;
    let abandoned = false;
    let paused = false;

    const show = (next: number, announce: boolean): void => {
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === index;
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      dots.forEach((d, i) => {
        const on = i === index;
        d.classList.toggle('is-active', on);
        d.setAttribute('aria-selected', on ? 'true' : 'false');
        d.tabIndex = on ? 0 : -1;
      });
      if (announce && live) live.textContent = dots[index]?.getAttribute('aria-label') ?? '';
    };

    const halt = (): void => {
      if (timer === null) return;
      window.clearInterval(timer);
      timer = null;
    };

    const run = (): void => {
      if (timer !== null || abandoned || paused || reduced.matches) return;
      timer = window.setInterval(() => show(index + 1, false), INTERVAL);
    };

    /** One-way. A reader who chooses a screen is not overruled by a timer. */
    const stop = (): void => {
      abandoned = true;
      halt();
      if (pauseBtn) pauseBtn.hidden = true;
    };

    root.querySelector('[data-wt-prev]')?.addEventListener('click', () => {
      stop();
      show(index - 1, true);
    });
    root.querySelector('[data-wt-next]')?.addEventListener('click', () => {
      stop();
      show(index + 1, true);
    });
    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        stop();
        show(i, true);
      }),
    );

    /* The ARIA tabs pattern: arrows move within one tab stop, and selecting as
       they move is what makes the dot row a control rather than a legend. */
    root.querySelector('.wt__dots')?.addEventListener('keydown', (event) => {
      const e = event as KeyboardEvent;
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      stop();
      show(index + (e.key === 'ArrowRight' ? 1 : -1), true);
      dots[index]?.focus();
    });

    if (pauseBtn && !reduced.matches) {
      pauseBtn.hidden = false;
      pauseBtn.addEventListener('click', () => {
        paused = !paused;
        if (paused) halt();
        else run();
        pauseBtn.setAttribute('aria-pressed', String(paused));
        pauseBtn.classList.toggle('is-paused', paused);
        if (pauseLabel) pauseLabel.textContent = paused ? 'Play' : 'Pause';
      });
    }

    /* Hover and background are SUSPENSIONS, not choices, so they resume. */
    root.addEventListener('pointerenter', halt);
    root.addEventListener('pointerleave', run);
    root.addEventListener('focusin', halt);
    root.addEventListener('focusout', run);
    document.addEventListener('visibilitychange', () =>
      document.visibilityState === 'hidden' ? halt() : run(),
    );

    /* Turning the preference ON stops the loop and withdraws the control. It
       never calls run(): a page a reader is already reading must not start
       animating under them. */
    if (typeof reduced.addEventListener === 'function') {
      reduced.addEventListener('change', () => {
        if (!reduced.matches) return;
        halt();
        if (pauseBtn) pauseBtn.hidden = true;
      });
    }

    run();
  }
</script>
