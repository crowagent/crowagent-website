---
/**
 * FinalCta — homepage section 6, "See it on your own tender."
 *
 * The page's only conversion block, and it deliberately offers two doors: a
 * high-commitment one (request access, book a demo) and a zero-commitment one
 * (the free calculator, and the methodology that backs it). The free row is the
 * only no-account route off this page, so it stays even though it sends people
 * away from the funnel — a reader with no next step leaves entirely.
 *
 * The two claims here ("Access is limited and by request", "Bring a live notice
 * and we will run it through the engine with you") are statements the company
 * makes about its own policy and service. They are unverifiable from outside,
 * but they are not claims about the market or about competitors, which is the
 * distinction that matters: a company may describe its own terms.
 *
 * ?enquiry=limited-access is a WIRE VALUE read by /contact to preselect the
 * subject. Not copy.
 */
import Button from '../ui/Button.astro';
---

<section class="fc" aria-labelledby="final-cta-title">
  <div class="fc__inner">
    <p class="fc__eyebrow">Ready when you are</p>
    <h2 class="fc__title" id="final-cta-title">See it on your own tender.</h2>
    <p class="fc__body">
      Bring a live notice and we will run it through the engine with you, end to end, on your
      own evidence. Access is limited and by request.
    </p>

    <div class="fc__actions">
      <Button href="/contact?enquiry=limited-access#contact-form">Request access</Button>
      <Button href="/contact" variant="secondary">Book a demo</Button>
    </div>

    <p class="fc__free">
      Or start with no account at all:
      <a href="/tools/ppn-002-calculator/">score a bid for social value, free</a>
      <span aria-hidden="true">·</span>
      <a href="/tools/ppn-002-calculator/methodology/">how the score is calculated</a>
    </p>
  </div>
</section>

<style>
  .fc { padding-block: var(--sec-pad-y); }

  .fc__inner {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .fc__eyebrow {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .fc__title {
    margin: 0;
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--c-text);
  }

  .fc__body {
    margin: var(--stack-2) 0 var(--sec-gap);
    max-width: 58ch;
    font-family: var(--font-body);
    font-size: var(--t-lede);
    line-height: 1.65;
    color: var(--c-text-sub);
  }

  .fc__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .fc__free {
    margin: var(--sec-gap) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.6rem;
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--c-text-muted);
  }

  .fc__free a {
    /* 44px target, WCAG 2.2. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--c-teal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .fc__free a:focus-visible { outline: 3px solid var(--c-teal); outline-offset: 3px; }
</style>
