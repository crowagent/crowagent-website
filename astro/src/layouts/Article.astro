---
/**
 * Article.astro — the blog post layout.
 *
 * A1 "Dark hero to light reading pane", Figma `183:3` on page
 * `Page — Blog article` (`183:2`), chosen by the owner from the six article
 * renders on 2026-08-02. See specs/DESIGN-DECISIONS.md section 6.
 *
 * THE HARD CUT IS THE WHOLE IDEA. A dark band carries the breadcrumb, the
 * headline and the byline; at a fixed point it stops dead and a light reading
 * pane begins, with a 1px teal hairline on the seam so the change reads as an
 * edit rather than as a rendering fault. It is not a gradient and must never
 * become one: a soft transition is what a mistake looks like.
 *
 * WHY A LIGHT PANE AT ALL, quoting the frame: long-form prose on a near-black
 * ground is the one place the dark theme costs the reader real comprehension,
 * and a light pane is the honest fix. The cost is that the page stops matching
 * the rest of the site below the fold, which is the trade the owner judged
 * from the render.
 *
 * THE BAND REVERSES AT THE FOOT. The related-articles rail below the pane is
 * dark, so the light pane is bracketed by the site rather than terminating it.
 * That reversal is what stops the pane reading as a different website; it is
 * load-bearing, not decoration.
 *
 * THE HERO STRADDLES THE CUT. 1000 x 562, a true 16:9, with 200px of it in the
 * dark band and 362px in the light pane. Bridging the cut is what ties the two
 * grounds together, and a hero that sits entirely inside either one loses the
 * effect. The straddle is expressed as a proportion of the hero's own width
 * (20%), so it holds at every viewport instead of only at 1440.
 *
 * ONE H1, the article headline. Heading hierarchy is h1 here, h2/h3 inside the
 * rendered Markdown body, and h2/h3 in the related rail, so no post emits two
 * h1s or skips a level.
 */
import Base from './Base.astro';
import ShareRow from '../components/blog/ShareRow.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import PostImage from '../components/blog/PostImage.astro';
import { blogPosting, breadcrumbs, faqPage } from '../lib/schema';
import type { FaqEntry } from '../lib/schema';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: string;
  readingTime?: number;
  /*
   * Question/answer pairs from the post's frontmatter. Optional because only
   * 5 of the 8 posts carry them; faqPage() returns an empty array for the
   * rest rather than an FAQPage with zero questions, which is a structured
   * data error rather than a neutral omission.
   */
  faq?: FaqEntry[];
}

const {
  title,
  description,
  path,
  image,
  publishedAt,
  updatedAt,
  category,
  readingTime,
  faq,
} = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

/*
 * Structured data is DERIVED here, not passed in by each route.
 *
 * This layout is the thing that knows a page is an article, so it is the thing
 * that should say so in JSON-LD. Every /blog entry gets BlogPosting and a
 * breadcrumb trail with no per-post work and nothing for an author to remember.
 *
 * A parity run against the legacy site caught all 8 ported posts emitting only
 * an Organization node where legacy emitted BlogPosting. That is live SEO
 * surface which would have been destroyed silently at cutover. Fixing it in the
 * layout rather than in 8 files is the difference between closing the gap and
 * closing it in a way that cannot reopen.
 */
const schema = [
  blogPosting({ title, description, path, publishDate: publishedAt, updatedDate: updatedAt, image }),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: title, path },
  ]),
  /*
   * FAQPage. Five legacy posts published one and the port dropped all five,
   * which a structured-data parity run caught (OA-24). The helper and the
   * frontmatter field both already existed; nothing ever connected them, so
   * the site kept passing every check while losing five rich results.
   */
  ...faqPage(faq),
];

/*
 * The share row and the related-articles rail are OWNED BY THIS LAYOUT, not by
 * the eight markdown files. Both existed on every legacy post and both were
 * lost by the port (OA-28); putting them here is what stops the next post from
 * shipping without them, and it is the same reasoning as the JSON-LD above.
 *
 * `path` is the route ("/blog/some-post"), so the slug is its last segment and
 * the canonical URL is the origin plus the path. Neither is passed in
 * separately: two sources for one identity is how a share link ends up
 * pointing at the wrong post.
 */
const slug = path.replace(/^\/blog\//, '').replace(/\/$/, '');
const canonicalUrl = `${SITE.origin}${path}`;
---

<Base
  title={`${title} | CrowAgent`}
  description={description}
  path={path}
  image={image}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  schema={schema}
>
  <article class="art">
    {/* ── The dark band ────────────────────────────────────────────────── */}
    <div class="art__band">
      <div class="art__glow" aria-hidden="true"></div>
      <div class="art__rails" aria-hidden="true"></div>

      <div class="art__band-inner">
        <div class="art__nav">
          {/*
            BACK TO BLOG PILL. On every legacy post and missing from the
            rebuild. The chevron is a drawn vector rather than a character:
            JetBrains Mono has no arrow glyphs, and an arrow character renders
            in it as a stray plus sign.
          */}
          <a class="art__pill" href="/blog">
            <svg
              class="art__chev"
              viewBox="0 0 6 10"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M5 1 1 5l4 4" />
            </svg>
            All guides
          </a>

          {/* Also on legacy and also missing. The BreadcrumbList JSON-LD above
              has been correct since the port; nothing on the page said the
              same thing to a reader. */}
          <nav class="art__crumb" aria-label="Breadcrumb">
            <ol>
              <li><a href="/blog">Blog</a></li>
              <li aria-current="page">{category}</li>
            </ol>
          </nav>
        </div>

        <p class="art__eyebrow">{category}</p>
        <h1>{title}</h1>
        <p class="art__meta">
          <time datetime={publishedAt.toISOString()}>{dateFormatter.format(publishedAt)}</time>
          {readingTime && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>{readingTime} min read</span>
            </>
          )}
          {updatedAt && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>Updated {dateFormatter.format(updatedAt)}</span>
            </>
          )}
        </p>
      </div>
    </div>

    {/* ── The light reading pane ───────────────────────────────────────── */}
    <div class="art__pane">
      <div class="art__hero">
        <PostImage
          slug={slug}
          credit
          priority
          sizes="(min-width: 1100px) 1000px, calc(100vw - 2.5rem)"
        />
      </div>

      <div class="art__col">
        {/* Under the byline and again at the foot, which is where both rows sit
            on the live post. Both are inside the pane, so both inherit its
            rebound colours; see the palette block in the stylesheet below. */}
        <ShareRow title={title} url={canonicalUrl} position="top" />
        <div class="article-body">
          <slot />
        </div>
        <ShareRow title={title} url={canonicalUrl} position="end" />
      </div>
    </div>
  </article>

  <RelatedPosts slug={slug} />
</Base>

<style>
  .art {
    /*
     * THE HERO GEOMETRY, ONCE. 1000px at 1440 is --measure x 25/29, and the
     * straddle is 20% of the hero's own width, which at that size is the 200px
     * the frame specifies. Both are proportions rather than fixed pixels, so
     * the hero keeps sitting exactly one fifth of its width above the cut at
     * every viewport.
     *
     * The 100% in --art-hero-w resolves against .art's width, and both places
     * it is used (the band's bottom padding, the hero's negative top margin)
     * have .art's width as their containing block, so the two cannot drift.
     * That is why .art__pane carries no inline padding of its own.
     */
    --art-hero-w: min(100% - 2 * var(--gutter), calc(var(--measure) * 25 / 29));
    --art-rise: calc(var(--art-hero-w) * 0.2);

    /*
     * THE SEAM COLOUR IS CAPTURED HERE, ON THE DARK SIDE, AND INHERITED DOWN.
     * The pane rebinds --c-teal to a darkened teal that is readable as a link
     * on #F5F6FA, so a seam written as var(--c-interactive) inside the pane resolves
     * to that darker value and the hairline goes grey. A custom property is
     * substituted where it is DECLARED, so declaring it out here freezes the
     * brand teal and carries it through the rebind untouched.
     */
    --art-seam: var(--c-teal);
  }

  /* ── Dark band ────────────────────────────────────────────────────────── */
  .art__band {
    position: relative;
    z-index: 0;
    /* The bottom padding is the straddle plus the gap the frame leaves between
       the byline and the top of the hero. */
    padding-block: var(--sec-pad-y-hero) calc(var(--art-rise) + var(--sec-gap));
  }

  .art__glow {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    /* Absolute px, not vh: a glow measured in viewport height is a different
       piece of light on every screen. */
    height: 820px;
    background-image: var(--grad-stage);
    pointer-events: none;
  }

  /* The two setting-out rails at the edges of the measure, fading at both ends
     so they read as construction lines rather than as the sides of a box. */
  .art__rails {
    position: absolute;
    inset-block: 0;
    inset-inline: max(var(--gutter), calc(50% - var(--measure) / 2 + var(--gutter)));
    pointer-events: none;
    border-inline: 1px solid var(--c-border);
    opacity: 0.55;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 90px, #000 calc(100% - 60px), transparent);
    mask-image: linear-gradient(180deg, transparent, #000 90px, #000 calc(100% - 60px), transparent);
  }

  @media (max-width: 899px) {
    .art__rails {
      display: none;
    }
  }

  .art__band-inner {
    position: relative;
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* Pill left, breadcrumb centred on the page. Three tracks rather than two so
     the breadcrumb centres on the MEASURE and not on the space the pill leaves
     behind it. */
  .art__nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--stack-1);
    margin-bottom: var(--sec-gap);
  }

  .art__pill {
    justify-self: start;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    background: var(--c-card);
    box-shadow: var(--gloss-inset);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-sub);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  /*
   * WCAG 2.2 target size without changing the drawn capsule. The frame's pill
   * is 158 x 38; growing it to 44 would break the composition, so the HIT AREA
   * is extended past the visible box instead. The pseudo-element is the target,
   * the capsule is the picture of it.
   */
  .art__pill::after {
    content: '';
    position: absolute;
    top: 50%;
    inset-inline: 0;
    height: 44px;
    transform: translateY(-50%);
  }

  .art__pill:hover {
    border-color: var(--c-border-glow);
    color: var(--c-text);
  }

  .art__pill:focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: 3px;
  }

  .art__chev {
    width: 6px;
    height: 10px;
    flex: none;
  }

  .art__crumb ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  /* The separator is generated, not typed, so it is never read out as content
     and never lands in the accessible name of the link beside it. */
  .art__crumb li + li::before {
    content: '/';
    margin-inline-end: 0.6rem;
    color: var(--c-border-glow);
  }

  .art__crumb a {
    color: var(--c-text-muted);
    text-decoration: none;
  }
  .art__crumb a:hover {
    color: var(--c-interactive);
  }
  .art__crumb a:focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: 3px;
  }

  /*
   * CENTRED HEAD BLOCK, GRADIENT EYEBROW — owner decision, 2026-08-02. The
   * canonical implementation is components/layout/Section.astro; this layout
   * builds its own head, so the same two rules are restated here.
   *
   * SCOPED ELEMENT BY ELEMENT. The prose column below is a sibling of this
   * block and must stay left: card content centres because a card is scanned,
   * prose stays left because prose is read. A text-align on a shared ancestor
   * is the exact mistake the legacy stylesheet made (sixteen element types
   * centred inside every section, then 138 per-element opt-outs across 24
   * pages to escape it).
   */
  .art__eyebrow,
  h1,
  .art__meta {
    text-align: center;
  }

  .art__eyebrow {
    display: block;
    width: fit-content;
    margin: 0 auto var(--stack-1);
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  /*
   * background-clip: text needs a transparent fill, and an inherited
   * -webkit-text-fill-color is what caused this site's invisible-text P0. The
   * @supports gate leaves a solid readable colour in any engine without
   * support, and the declaration reaches one short category label and nothing
   * else — never the article body.
   */
  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .art__eyebrow {
      background: var(--grad-spectrum);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }

  /*
   * --t-h1, unchanged. The frame draws this headline at about 44px, which is
   * --t-h2 at 1440; running it there would make the article headline exactly
   * the same size as the h2s in its own body, and dropping those a tier to
   * compensate would reopen the off-tier heading defect corrected sitewide on
   * 2026-08-02. So the scale wins over the frame here and the head reads
   * larger than the render. Reconciling the two means a --t-h1 that clamps
   * lower, which is a styles/tokens.css change this pass does not own.
   */
  h1 {
    font-family: var(--font-display);
    font-size: var(--t-h1);
    font-weight: var(--t-w-h1);
    line-height: 1.05;
    letter-spacing: -0.025em;
    /* The headline is centred, so its measure has to be centred too or a
       two-line headline sets ragged against the left of the band. */
    max-width: 20ch;
    margin: 0 auto var(--stack-2);
    color: var(--c-text);
  }

  .art__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    /* The byline sits in the head block, where a standfirst would, so it
       centres with it. text-align cannot do this on a flex container. */
    justify-content: center;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    margin: 0;
  }

  /* ══════════════════════════════════════════════════════════════════════
     THE LIGHT READING PANE, AND ITS PALETTE.

     The palette is applied by REBINDING the site's own token names on this one
     element rather than by writing a second set of rules. Custom properties
     inherit, so everything inside the pane — the prose, the share rows, the
     callouts — picks the light values up without knowing anything about the
     pane and without a single component being edited. ShareRow.astro in
     particular is untouched: it asks for --c-card and --c-border as it always
     did and gets white and a light rule.

     The four surface values are quoted from the approved frame. The link teal
     is not: brand --c-teal (#2DD4BF) on #F5F6FA measures 1.6:1 and is
     unreadable, so the pane uses a darkened teal from the same family at
     5.1:1. Body 11.8:1, muted 4.9:1, headings 19:1, all against #F5F6FA.

     WHERE THESE BELONG is styles/tokens.css, as a named light scope. They are
     literal here because the token file has no light palette at all and this
     pass does not own styles/. Reported to the owner.
     ══════════════════════════════════════════════════════════════════════ */
  .art__pane {
    --c-bg: #f5f6fa;
    --c-panel: #ffffff;
    --c-card: #ffffff;
    --c-card-hover: #ffffff;
    --c-text: #0b0e19;
    --c-text-sub: #2b3245;
    --c-text-muted: #626c82;
    --c-border: rgba(11, 14, 25, 0.12);
    --c-border-glow: rgba(15, 118, 110, 0.4);
    --c-teal: #0f766e;
    --c-teal-glow: rgba(15, 118, 110, 0.25);
    /* ── --c-interactive HAS TO BE REBOUND TOO, AND IT WAS NOT ────────────
     *
     * Added 2026-08-03. The pane rebinds eleven tokens so dark-surface values
     * cannot leak onto a light one, and --c-interactive was created LATER, on
     * the same day, when the interactive role was finally given a name. It was
     * not in the list because it did not exist when the list was written.
     *
     * Measured: unbound, it resolves to --c-cyan #22D3EE, which is 1.67:1 on
     * this pane's #F5F6FA. Nothing renders it as text in here today, so this is
     * a trap rather than a defect — the next person to write
     * `color: var(--c-interactive)` inside the pane gets text nobody can read,
     * and this codebase has shipped invisible text twice already.
     *
     * #0e7490 is 4.96:1 here. NOT the pane's --c-teal, even though that would
     * also pass at 5.07:1: ADR 0005 separates interactive from verified, and
     * collapsing them on one surface would put the separation back exactly
     * where it was before the token existed.
     *
     * THE GENERAL PROBLEM, worth stating because it will recur: a scoped
     * palette is a list, and a new token added anywhere else is missing from it
     * by default. Any token added to :root that can carry TEXT needs a line
     * here. */
    --c-interactive: #0e7490;

    /*
     * A four-step ladder at 4 to 7 percent, not the dark six-step ladder,
     * because a shadow on a light ground needs far less alpha to read. Same
     * fingerprint as the dark ladder: blur is 0.8 x Y, and Y roughly doubles
     * each step.
     */
    --gloss-inset: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    --shadow-card:
      0 3px 2.4px rgba(11, 14, 25, 0.04), 0 6px 4.8px rgba(11, 14, 25, 0.05),
      0 12px 9.6px rgba(11, 14, 25, 0.06), 0 24px 19.2px rgba(11, 14, 25, 0.07);
    --shadow-panel: var(--shadow-card);
    --blur-glass: none;

    position: relative;
    z-index: 1;
    background-color: var(--c-bg);
    color: var(--c-text-sub);
    padding-bottom: var(--sec-pad-y);
    /*
     * flow-root, and the whole straddle depends on it. The hero is this
     * element's first in-flow child and carries a negative top margin; without
     * a block formatting context that margin COLLAPSES OUT through the parent
     * and drags the pane up with it, so the picture and the cut move together
     * and the hero ends up sitting exactly on the seam with nothing above it.
     * Measured before the fix: 0px of the hero in the dark band against the
     * 200px the frame specifies. flow-root contains the margin without
     * clipping, which `overflow: hidden` would not — that would cut the top of
     * the hero off instead.
     */
    display: flow-root;
  }

  /*
   * THE SEAM. 1px of teal on the cut, top and bottom, so the change of ground
   * reads as an edit. It is a hard line by design; softening it into a
   * gradient is what a rendering fault looks like, and it is the one thing
   * about this layout that must not be "tidied".
   */
  .art__pane::before,
  .art__pane::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 1px;
    /*
     * Effectively flat, which is what the frame draws: full teal across the
     * measure with only the last few percent at each end fading out, so the
     * line does not butt hard into the window edge. An earlier version ramped
     * from 12% to 50% and, measured at the left of a 1440 viewport, the seam
     * was a pale grey line rather than a teal one for the first 170px.
     */
    background-image: linear-gradient(
      90deg,
      transparent,
      var(--art-seam) 4%,
      var(--art-seam) 96%,
      transparent
    );
  }
  .art__pane::before {
    top: 0;
  }
  .art__pane::after {
    bottom: 0;
  }

  /* The straddle. z-index puts the picture over the seam, which is the order
     the frame draws them in. */
  .art__hero {
    position: relative;
    z-index: 1;
    width: var(--art-hero-w);
    margin-inline: auto;
    margin-top: calc(var(--art-rise) * -1);
    margin-bottom: var(--sec-gap);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  /*
   * THE READING MEASURE: 684px, which is Vercel's long-form measure and the
   * one written on the approved frame. The alternative in the research was
   * Better Stack's 616px at 17/27.2; 684 was chosen because the frame chose
   * it, and because the pane's own type sits at 17px, where 684 gives roughly
   * 68 characters a line.
   *
   * Derived from --measure rather than written as a pixel value, the same way
   * tokens.css derives --measure-mid, --measure-band and --measure-prose, so
   * it scales with the page grid. The scale has no 684 stop of its own;
   * adding one means editing styles/tokens.css, which this pass does not own.
   * The gutter is added on top because on this site "the measure" is the outer
   * box, so 684 has to be the CONTENT width for the frame's figure to hold.
   */
  .art__col {
    max-width: calc(var(--measure) * 0.59 + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ── Prose ────────────────────────────────────────────────────────────── */

  /*
   * TAG MATCHES TIER. These ran one step below their own level — h2 at --t-h3,
   * h3 at --t-h4 — which is why the site had two different h2 sizes and, on
   * pages carrying both prose and a section heading, two on one page. An
   * article h2 is a section of the document and takes the section size.
   */
  .article-body :global(h2) {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 2.5rem 0 1rem;
    color: var(--c-text);
    scroll-margin-top: 6rem;
  }

  .article-body :global(h3) {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: var(--t-w-h3);
    line-height: 1.25;
    margin: 2rem 0 0.85rem;
    color: var(--c-text);
    scroll-margin-top: 6rem;
  }

  .article-body :global(p) {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.65;
    color: var(--c-text-sub);
    margin: 0 0 1.5rem;
  }

  /*
   * THE REVIEW-DATE LINE. Five of the eight posts open with an italic
   * "Last reviewed: 26 July 2026", which is metadata wearing a paragraph's
