---
/**
 * HOME 2.0, THE PREVIEW ROUTE.
 *
 * A proposal for the homepage, built as a SEPARATE route so the owner can read
 * it on localhost beside the live page before anything replaces it. Not one
 * existing file was edited to ship it: no component under
 * components/sections/, no stylesheet, and not a line of pages/index.astro.
 *
 * ── noindex, AND THE ONE SIDE EFFECT THAT SURVIVES IT ──────────────────────
 *
 * `noindex` puts `noindex, nofollow` on the page, which is what a proposal
 * needs. It does NOT keep the route out of the sitemap: scripts/build-sitemap.js
 * enumerates every built page carrying a canonical, and Seo.astro emits a
 * canonical unconditionally. So a deploy taken while this file exists publishes
 * `/home-2/` in sitemap.xml. That is recorded here rather than worked around,
 * because the fix is a decision about whether the route ships at all and not a
 * special case in a gate.
 *
 * ── THE GROUND LADDER IS INHERITED AND NOT DECLARED ────────────────────────
 *
 * styles/surfaces.css paints `#main-content > section:nth-of-type(odd)`
 * transparent and the even ones --c-bg, computed by the browser per document.
 * So the alternation below is a consequence of the ORDER and of nothing else,
 * and reordering these eight lines moves the grounds with them:
 *
 *   1  Hero2                 odd    floor, and the aurora paints it
 *   2  ProofStrip            even   --c-bg
 *   3  HowItRuns2            odd    floor
 *   4  ProductTour           even   --c-bg
 *   5  CaseStudies           odd    floor
 *   6  RefusalTrace          even   --c-bg
 *   7  IntegrationsMarquee   odd    floor
 *   8  FinalCta2             even   --c-bg
 *
 * ── THE ARRIVAL IS INHERITED TOO ───────────────────────────────────────────
 *
 * styles/motion.css lands the first child of <main> and arrives every one after
 * it, with no class and no opt-in, and it lands the hero's rows off `#hero-title`.
 * Hero2.astro's header comment records the exact DOM shape that depends on.
 * Nothing on this page declares a scroll timeline, and nothing defines its own
 * entrance, which is what scripts/check-motion.js requires.
 *
 * ── THE ONE SCRIPT, AND IT CANNOT BREAK THE PAGE ───────────────────────────
 *
 * `initMotion()` is the shared `data-lit` trigger in src/scripts/motion.ts, the
 * one observer check-motion.js records as allowed. It sets an attribute on
 * three wrappers as they come into view and returns before doing anything at
 * all under reduced motion. Every drawing on this page is complete, opaque and
 * at full contrast before it runs. If it 404s, throws or is blocked, the reader
 * gets the finished page and merely a still one.
 */
import Base from '../layouts/Base.astro';
import Hero2 from '../components/home2/Hero2.astro';
import ProofStrip from '../components/home2/ProofStrip.astro';
import HowItRuns2 from '../components/home2/HowItRuns2.astro';
import ProductTour from '../components/home2/ProductTour.astro';
import CaseStudies from '../components/home2/CaseStudies.astro';
import RefusalTrace from '../components/home2/RefusalTrace.astro';
import IntegrationsMarquee from '../components/home2/IntegrationsMarquee.astro';
import FinalCta2 from '../components/home2/FinalCta2.astro';

const title = 'Home 2.0 preview | CrowAgent';
const description =
  'A preview of the proposed CrowAgent homepage. Not indexed, and not the live page.';

const UPDATED = new Date('2026-09-03');
---

<Base title={title} description={description} path="/home-2" noindex updatedAt={UPDATED}>
  <Hero2 />
  <ProofStrip />
  <HowItRuns2 />
  <ProductTour />
  <CaseStudies />
  <RefusalTrace />
  <IntegrationsMarquee />
  <FinalCta2 />
</Base>

<script>
  import { initMotion } from '../scripts/motion';

  initMotion();
</script>
