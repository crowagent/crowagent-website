---
/**
 * Compare.astro — layout for /compare/crowmark-vs-*.
 *
 * The legacy pages rendered the article on a white band inside an otherwise
 * dark page. tokens.css is a single dark palette (see its header comment;
 * `color-scheme: dark` is set once, sitewide, in Base.astro), so there is no
 * light-surface token to reproduce that band with. The article renders on
 * the same dark surfaces as everywhere else in this rebuild (blog included)
 * rather than hardcoding a one-off light palette that would duplicate no
 * token and drift the moment tokens.css changes. This is a visual choice
 * only: no wording below is altered by it.
 */
import Base from './Base.astro';
import { SITE } from '../data/site';
import Button from '../components/ui/Button.astro';
import FinalCta from '../components/sections/FinalCta.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  ogDescription: string;
  articleDescription: string;
  path: string;
  publishedAt: Date;
  updatedAt?: Date;
  competitor: string;
  eyebrow: string;
  heroDescription: string;
  ogImage: string;
  ogImageAlt: string;
  ctaHeadline: string;
  ctaSubLine1: string;
  ctaSubLine2: string;
  faq: FaqItem[];
}

const {
  title,
  description,
  ogDescription,
  articleDescription,
  path,
  publishedAt,
  updatedAt,
  competitor,
  eyebrow,
  heroDescription,
  ogImage,
  ogImageAlt,
  ctaHeadline,
  ctaSubLine1,
  ctaSubLine2,
  faq,
} = Astro.props;

const canonical = new URL(path, SITE.origin).href;
const breadcrumbLabel = `CrowMark vs ${competitor}`;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const updatedLabel = `Updated ${dateFormatter.format(updatedAt ?? publishedAt)}`;
const isoDate = (d: Date) => d.toISOString().slice(0, 10);

const schema: Record<string, unknown>[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Compare', item: `${SITE.origin}/compare` },
      { '@type': 'ListItem', position: 3, name: breadcrumbLabel, item: canonical },
    ],
  },
  {
    '@type': 'Article',
    headline: title,
    description: articleDescription,
    datePublished: isoDate(publishedAt),
    dateModified: isoDate(updatedAt ?? publishedAt),
    image: new URL(ogImage, SITE.origin).href,
    author: { '@type': 'Organization', name: SITE.legalName, url: `${SITE.origin}/` },
    publisher: {
      '@type': 'Organization',
      name: SITE.legalName,
      logo: {
        '@type': 'ImageObject',
        url: 'https://crowagent.ai/Assets/brand/crowagent_wordmark_transparent_560x140.png?v=20260730',
      },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  },
];

if (faq.length) {
  schema.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}
---

<Base
  title={`${title} | CrowAgent`}
  description={description}
  ogTitle={title}
  ogDescription={ogDescription}
  twitterTitle={title}
  twitterDescription={ogDescription}
  path={path}
  image={ogImage}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  schema={schema}
>
  <main>
    <header class="cmp-hero">
      <div class="cmp-hero-inner">
        <nav aria-label="Breadcrumb" class="cmp-breadcrumb">
          <a href="/compare">Compare</a> <span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">{breadcrumbLabel}</span>
        </nav>
        <span class="cmp-eyebrow">{eyebrow}</span>
        <h1 class="cmp-h1"><span>CrowMark</span> <span class="accent">vs {competitor}</span></h1>
        <p class="cmp-hero-desc">{heroDescription}</p>
        <p class="cmp-updated">{updatedLabel}</p>
      </div>
    </header>

    <section class="cmp-article-section">
      <div class="cmp-body">
        <slot />
      </div>
    </section>

    {/*
      THE BAND BECAME THE CARD, 2026-08-03. This was one of five hand-written
      closing-CTA recipes on the site, each restating Section.astro's head block
      with its own heading size, measure and gutter. It now renders through
      FinalCta, which is the site's one CTA card, so the heading size, the
      measure, the centring, the eyebrow capsule and the action row all come
      from the same two components every other route uses.

      THE TWO SUB-LINES ARE JOINED INTO ONE STANDFIRST, and the <br /> and the
      `.accent` span on the second half are not reproduced. Section takes a
      plain string, and reproducing the markup would mean restating standfirst
      styles here — which is the duplication this change removes. The same
      decision, for the same reason, is already recorded in FinalCta.astro
      against the homepage's own `<span class="paid">`.
    */}
    <FinalCta id="compare-cta" title={ctaHeadline} standfirst={`${ctaSubLine1} ${ctaSubLine2}`}>
      <Button href="/pricing?product=mark" size="md">See pricing</Button>
      <Button href="/crowmark" variant="secondary" size="md">Explore CrowMark</Button>
    </FinalCta>
  </main>
</Base>

<style>
  /*
   * CENTRED HEAD BLOCK, GRADIENT EYEBROW — owner decision, 2026-08-02.
   * components/layout/Section.astro is the canonical implementation; this
   * layout builds its own hero, so the rules are restated here.
   *
   * The centring is on .cmp-hero and stops there. It must not reach
   * .cmp-article-section: that slot holds the comparison prose, the feature
   * tables and the "who should choose which" cards, all of which read left to
   * right and are styled in the is:global block below.
   */
  .cmp-hero {
    position: relative;
    padding: var(--sec-pad-y-hero) var(--gutter) var(--sec-pad-y-sm);
    text-align: center;
    overflow: hidden;
  }
  .cmp-hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 60%;
    z-index: -1;
    background: var(--grad-hero-glow);
    filter: blur(30px);
    opacity: 0.5;
  }
  .cmp-hero-inner {
    max-width: var(--measure);
    margin-inline: auto;
  }
  .cmp-breadcrumb {
    font-size: var(--t-body);
    color: var(--c-text-muted);
    margin: 0 0 var(--stack-2);
  }
  .cmp-breadcrumb a {
    /* WCAG 2.2 SC 2.5.8. Standalone navigation, not a link inside a sentence,
       so the inline exemption does not reach it. inline-flex so the box grows
       without moving the text or changing where the row wraps. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--c-text-muted);
    text-decoration: none;
  }
  .cmp-breadcrumb a:hover {
    color: var(--c-text);
  }
  .cmp-breadcrumb [aria-current='page'] {
    color: var(--c-text);
  }
  .cmp-eyebrow {
    display: inline-block;
    margin: 0 0 var(--stack-2);
    padding: 0.5rem 0.85rem;
    /* --c-border, not the two hardcoded teal rgba() values this rule carried.
       The capsule outline is the same one every eyebrow on the site now wears,
       and the colour comes from the gradient below rather than from a tinted
       fill. */
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  /*
   * background-clip: text needs a transparent fill, and an inherited
   * -webkit-text-fill-color is what caused this site's invisible-text P0. The
   * @supports gate leaves a solid readable colour where it is unsupported, and
   * the declaration reaches one short label and nothing else.
   */
  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .cmp-eyebrow {
      background: var(--grad-spectrum);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }
  .cmp-h1 {
    font-family: var(--font-display);
    font-size: var(--t-h1);
    font-weight: var(--t-w-h1);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin: 0 0 var(--stack-2);
  }
  .cmp-h1 .accent {
    color: var(--c-teal);
  }
  .cmp-hero-desc {
    max-width: var(--measure-prose);
    font-size: var(--t-lede);
    line-height: 1.6;
    color: var(--c-text-sub);
    /* The measure has to be centred too, or a centred standfirst sits left
       inside a centred head block. */
    margin: 0 auto var(--stack-2);
  }
  .cmp-updated {
    font-size: var(--t-body);
    color: var(--c-text-muted);
    margin: 0;
  }

  .cmp-article-section {
    padding: var(--sec-pad-y-sm) var(--gutter) var(--sec-pad-y);
  }
  .cmp-body {
    max-width: var(--measure);
    margin-inline: auto;
  }

  /* The .cmp-cta band and its five rules were deleted on 2026-08-03 when this
     layout moved to the shared FinalCta card. Nothing replaced them: the card,
     the head block, the measure and the action row are all owned by components
     now, which is the point. */
</style>

<style is:global>
  /* Targets markup rendered inside the <slot/> above (the compare article
     body, sourced verbatim from the legacy .cmp-body article-body block),
     which Astro scoped styles cannot reach because it is not written
     directly in this component's template. Same pattern as
     `.article-body :global(h2)` in Article.astro, just declared with
     is:global since there are many more selectors here. */
  .cmp-body .cmp-lead {
    font-size: var(--t-h4);
    line-height: 1.6;
    font-weight: 500;
    color: var(--c-text);
    margin: 0 0 var(--sec-gap);
  }
  .cmp-body h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--c-text);
    margin: 3rem 0 1.25rem;
    scroll-margin-top: 6rem;
  }
  /* --t-h3, not --t-h4. An h3 in the article body is a heading INSIDE a section
     (tokens.css), which is what --t-h3 is for; --t-h4 is the card tier and is
     kept for the choose cards and the FAQ rows below. Sizing a body h3 at the
     card tier is the same one-tier slip that styles/prose.css carried. */
  .cmp-body h3 {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: var(--t-w-h3);
    line-height: 1.25;
    color: var(--c-text);
    margin: 2.25rem 0 1rem;
  }
  .cmp-body p {
    font-size: var(--t-lede);
    line-height: 1.75;
    color: var(--c-text-sub);
    margin: 0 0 1.5rem;
  }
  .cmp-body ul,
  .cmp-body ol {
    font-size: var(--t-lede);
    line-height: 1.7;
    color: var(--c-text-sub);
    margin: 0 0 1.5rem;
    padding-inline-start: 1.4rem;
  }
  .cmp-body li {
    margin: 0 0 0.6rem;
  }
  .cmp-body a {
    color: var(--c-teal);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cmp-body a.cmp-relcard {
    text-decoration: none;
  }
  .cmp-body strong {
    color: var(--c-text);
    font-weight: 800;
  }
  .cmp-body .rt-hint {
    font-size: var(--t-micro);
    color: var(--c-text-muted);
    margin: 0 0 0.5rem;
  }

  .cmp-body .cmp-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 0 0 2.5rem;
    border: 1px solid var(--c-border);
    /* One radius for every bounded block in this column. The table scroller sat
       at 16px beside 20px cards. */
    border-radius: var(--radius-card);
  }
  .cmp-body .cmp-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 620px;
  }
  .cmp-body .cmp-table th,
  .cmp-body .cmp-table td {
    padding: 0.9rem 1.15rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--c-border);
    font-size: var(--t-body);
    line-height: 1.5;
  }
  .cmp-body .cmp-table thead th {
    font-family: var(--font-display);
    /* 0.72rem (11.52px) was in no scale. --t-micro is the label tier. */
    font-size: var(--t-micro);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text);
  }
  .cmp-body .cmp-table thead th.cmp-us-col {
    color: var(--c-teal);
  }
  .cmp-body .cmp-table tbody th {
    font-weight: 700;
    color: var(--c-text);
    white-space: normal;
  }
  .cmp-body .cmp-table td {
    color: var(--c-text-sub);
  }
  .cmp-body .cmp-table td.cmp-us {
    color: var(--c-text);
    font-weight: 600;
  }
  .cmp-body .cmp-table tbody tr:last-child th,
  .cmp-body .cmp-table tbody tr:last-child td {
    border-bottom: 0;
  }
  .cmp-body .cmp-yes {
    color: var(--c-teal);
    font-weight: 800;
  }
  .cmp-body .cmp-no {
    color: var(--c-text-muted);
  }

  .cmp-body .cmp-choose {
    display: grid;
    gap: 1.25rem;
    margin: 2rem 0 1rem;
  }
  @media (min-width: 768px) {
    .cmp-body .cmp-choose {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* NOTHING OF THE CARD IS STATED HERE ANY MORE. `rehypeContentCards` in
     astro.config.mjs attaches `surface surface--pad` to this class as the
     markdown is compiled, so border, radius, background, gloss, padding, hover
     and the centred content all come from the one recipe in
     styles/surfaces.css. The teal edge below is the only thing that is genuinely
     this card's own, and it wins because an `is:global` block is unlayered. */
  .cmp-body .cmp-choose-card.is-us {
    border-color: var(--c-teal);
  }
  .cmp-body .cmp-choose-card h3 {
    margin: 0 0 0.85rem;
    font-size: var(--t-h4);
  }
  .cmp-body .cmp-choose-card ul {
    margin: 0;
    font-size: var(--t-body);
  }
  .cmp-body .cmp-choose-card li {
    margin: 0 0 0.55rem;
  }

  /* Spacing only; `surface surface--pad` supplies the rest (see above). */
  .cmp-body .cmp-sources {
    margin: var(--sec-gap) 0 0;
  }
  .cmp-body .cmp-sources h2 {
    margin: 0 0 1rem;
    font-size: var(--t-h4);
  }
  .cmp-body .cmp-sources ol {
    margin: 0;
    font-size: var(--t-body);
  }
  .cmp-body .cmp-sources li {
    margin: 0 0 0.7rem;
  }
  .cmp-body .cmp-sources a {
    font-weight: 600;
    word-break: break-word;
  }

  .cmp-body .cmp-shot {
    margin: 2rem 0 2.75rem;
  }
  .cmp-body .cmp-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--c-border);
  }
  .cmp-body .cmp-shot figcaption {
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--c-text-sub);
    margin-top: 0.9rem;
  }

  .cmp-body .cmp-relgrid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-top: 1.5rem;
  }
  @media (min-width: 640px) {
    .cmp-body .cmp-relgrid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  /* Type and display only; `surface surface--pad` supplies the rest (see
     above), including the hover lift, which this link gets because it is an
     <a> carrying `surface`. */
  .cmp-body .cmp-relcard {
    display: block;
    color: var(--c-text);
    font-family: var(--font-display);
    font-weight: var(--t-w-h3);
    font-size: var(--t-body);
  }

  .cmp-body .cfaq {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  /* Border, radius and background come from `surface` in styles/surfaces.css,
     which names .cfaq details. The local --radius-panel override is gone: this
     is a glass card, not an opaque panel, and it was the only 16px block in the
     compare column. */
  .cmp-body .cfaq summary {
    cursor: pointer;
    list-style: none;
    padding: 1.35rem 1.5rem;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .cmp-body .cfaq summary::-webkit-details-marker {
    display: none;
  }
  /* --t-h4, the card tier. A question in an FAQ row is the row's heading; at
     --t-body it was the same size as the answer underneath it, which is the one
     thing a heading may never be. Eight of them on every compare page. */
  .cmp-body .cfaq summary h3 {
    margin: 0;
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
  }
  .cmp-body .cfaq summary::after {
    content: '+';
    font-weight: 800;
    color: var(--c-teal);
    transition: transform var(--dur) var(--ease);
  }
  .cmp-body .cfaq details[open] summary::after {
    transform: rotate(45deg);
  }
  .cmp-body .cfaq-a {
    padding: 0 1.5rem 1.35rem;
  }
  .cmp-body .cfaq-a p {
    margin: 0;
    font-size: var(--t-body);
  }

  @media (prefers-reduced-motion: reduce) {
    .cmp-body .cfaq summary::after { transition: none; }
  }
</style>
