---
/**
 * HOME 2.0: THE AURORA BACKDROP.
 *
 * Three blurred light fields on the floor colour with a noise grain over them,
 * behind the hero and behind nothing else. It is decorative, it is aria-hidden,
 * it is out of flow, and it takes no pointer events, so it can never move a box
 * or swallow a click.
 *
 * IT RIDES THE SHARED [data-field] RIG RATHER THAN DECLARING ITS OWN TIMELINE.
 * styles/tokens.css already owns the only scroll-driven parallax outside
 * styles/motion.css, bound to `[data-field]`, and scripts/check-motion.js FAILS
 * the build on an `animation-timeline` declared anywhere else. So the wrapper
 * carries `data-field` and sets `--par`, which is the per-section travel that
 * rig reads. That is the parallax, and it costs no new machinery.
 *
 * WHAT IS OVERRIDDEN, AND WHY IT IS SAFE. tokens.css also drifts
 * `[data-field] > b` on `m-drift`, which is a scale from 1.00 to 1.04 and
 * nothing else. The board asks for a drift that travels as well as breathes, so
 * the three fields take `au-drift-1/2/3` instead, at the same --m-drift period
 * and on the same three offset phases the shared rig uses. Both endpoints of
 * every one of those keyframes carry a non-zero translate, deliberately: a
 * keyframe that starts displaced and ends at rest is an ENTRANCE, which is the
 * pattern this repository has twice shipped as permanently invisible content,
 * and check-motion rule 2 is right to fail one. A field that drifts between two
 * displaced positions is a loop, not an arrival, and there is no rest state it
 * can be caught in because the element itself is never transformed.
 *
 * REDUCED MOTION IS STATIC, and it is static in the honest way: the drift lives
 * inside `prefers-reduced-motion: no-preference`, so with `reduce` the fields
 * simply sit where the stylesheet paints them, at full opacity, lighting the
 * hero exactly as they do at the midpoint of the loop.
 *
 * THE POINTER NUDGE USES `translate`, NOT `transform`. The drift owns
 * `transform` on the same element, and a second animation or rule on that
 * property would replace the first rather than compose with it. `translate` is
 * an independent property, so the two add up: the field breathes on its loop
 * and leans towards the cursor at the same time. It is desktop only, because a
 * touch pointer has no hover position to lean towards.
 */
interface Props {
  /** Scroll travel handed to the shared [data-field] parallax in tokens.css. */
  par?: string;
  class?: string;
}
const { par = '40px', class: className = '' } = Astro.props;
---

<div
  class:list={['au', className]}
  data-field
  aria-hidden="true"
  style={`--par: ${par}`}
>
  <b class="au__f au__f--violet" data-au-lead></b>
  <b class="au__f au__f--teal"></b>
  <b class="au__f au__f--pink"></b>
  <i class="au__grain"></i>
</div>

<style>
  .au {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background-color: var(--c-floor);
  }

  .au__f {
    position: absolute;
    border-radius: 50%;
    filter: blur(180px);
    mix-blend-mode: screen;
    will-change: transform;
  }

  /* Percentages, so the fields keep their relationship to the hero at every
     width instead of being pinned to one board's pixel positions. */
  .au__f--violet {
    inset-inline-start: -12%;
    inset-block-start: -34%;
    inline-size: 68%;
    block-size: 118%;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-violet-deep) 55%, transparent),
      transparent 66%
    );
    /* The pointer nudge. Rest is 0,0 and the script only ever writes a value
       inside the 24px cap, so the field cannot be pushed out of its own box. */
    translate: var(--au-nx, 0px) var(--au-ny, 0px);
  }

  .au__f--teal {
    inset-inline-end: -16%;
    inset-block-end: -46%;
    inline-size: 62%;
    block-size: 108%;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-teal) 28%, transparent),
      transparent 68%
    );
  }

  .au__f--pink {
    inset-inline-start: 34%;
    inset-block-start: 8%;
    inline-size: 46%;
    block-size: 82%;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-pink) 16%, transparent),
      transparent 70%
    );
  }

  /* 4 percent, which is the value on the board. The page already carries a
     6 percent grain fixed to the viewport in Base.astro, and this one is
     separate on purpose: it is masked to the hero and it is what stops a
     180px blur banding on an 8-bit panel. */
  .au__grain {
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    background-size: 160px 160px;
    opacity: 0.04;
  }

  @media (prefers-reduced-motion: no-preference) {
    .au__f {
      animation-duration: var(--m-drift);
      animation-timing-function: var(--m-ease-breath);
      animation-iteration-count: infinite;
      animation-direction: alternate;
    }

    .au__f--violet {
      animation-name: au-drift-1;
      transition: translate 0.3s var(--ease);
    }

    .au__f--teal {
      animation-name: au-drift-2;
      animation-delay: calc(-1 * var(--m-drift) / 3);
    }

    .au__f--pink {
      animation-name: au-drift-3;
      animation-delay: calc(-2 * var(--m-drift) / 3);
    }
  }

  /* Both ends of every loop are displaced. See the header note: a keyframe that
     resolves to the untransformed rest state is an entrance, and this is not
     one. Travel is 40px at the extreme and scale runs 1.00 to 1.08. */
  @keyframes au-drift-1 {
    from { transform: translate3d(-14px, 20px, 0) scale(1); }
    to   { transform: translate3d(14px, -20px, 0) scale(1.08); }
  }

  @keyframes au-drift-2 {
    from { transform: translate3d(16px, 18px, 0) scale(1.06); }
    to   { transform: translate3d(-16px, -22px, 0) scale(1); }
  }

  @keyframes au-drift-3 {
    from { transform: translate3d(-18px, -12px, 0) scale(1.04); }
    to   { transform: translate3d(18px, 16px, 0) scale(1.08); }
  }

  /* A 180px blur over a full-width field is a real paint cost on a phone, and
     the fields are half the size there anyway. */
  @media (max-width: 767px) {
    .au__f {
      filter: blur(90px);
    }
  }

  @media (forced-colors: active) {
    .au {
      display: none;
    }
  }
</style>

<script>
  /*
   * The pointer nudge, and the whole of it. No observer, no scroll listener and
   * nothing that can hide anything: if this module never loads, the field sits
   * at its rest translate of 0,0 and the hero is complete.
   */
  const CAP = 24;

  function initAurora(): void {
    if (typeof window.matchMedia !== 'function') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    const leads = Array.from(document.querySelectorAll<HTMLElement>('[data-au-lead]'));
    if (!leads.length) return;

    let queued = false;
    let nx = 0;
    let ny = 0;

    const flush = () => {
      queued = false;
      for (const lead of leads) {
        lead.style.setProperty('--au-nx', nx.toFixed(1) + 'px');
        lead.style.setProperty('--au-ny', ny.toFixed(1) + 'px');
      }
    };

    window.addEventListener(
      'pointermove',
      (event: PointerEvent) => {
        if (event.pointerType !== 'mouse') return;
        const w = window.innerWidth || 1;
        const h = window.innerHeight || 1;
        nx = ((event.clientX / w) * 2 - 1) * CAP;
        ny = ((event.clientY / h) * 2 - 1) * CAP;
        if (!queued) {
          queued = true;
          requestAnimationFrame(flush);
        }
      },
      { passive: true },
    );
  }

  initAurora();
</script>
