---
/**
 * Base.astro — the html shell every page renders through.
 *
 * Metadata is entirely delegated to Seo.astro (title, canonical, OG,
 * Twitter, JSON-LD @graph). This layout only owns the document skeleton
 * and the sitewide design tokens.
 */
import Seo from '../components/seo/Seo.astro';
import Nav from '../components/nav/Nav.astro';
import Footer from '../components/footer/Footer.astro';
import CommandPalette from '../components/nav/CommandPalette.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  /** Route path, e.g. "/blog/some-post". Passed straight through to Seo.astro. */
  path: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
}

const {
  title,
  description,
  path,
  image,
  type,
  publishedAt,
  updatedAt,
  noindex,
  schema,
  ogTitle,
  ogDescription,
  twitterTitle,
  twitterDescription,
} = Astro.props;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title={title}
      description={description}
      path={path}
      image={image}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      noindex={noindex}
      schema={schema}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      twitterTitle={twitterTitle}
      twitterDescription={twitterDescription}
    />
    <script is:inline>
      // Platform-aware Ctrl/Cmd-K badge (nav search affordance): stamp the OS
      // family on <html> synchronously, before <body> — and the nav's kbd
      // badge inside it — are parsed. Fixes a legacy bug where nav-inject.js
      // hardcoded a Mac "⌘K" badge for every visitor regardless of platform.
      // Running here (blocking, in <head>, before first paint) means the
      // correct label is already selected the first time the nav paints, so
      // there is no flash of the wrong label and no layout shift when it
      // "corrects" — CSS in Nav.astro shows only the matching span.
      (function () {
        try {
          var platform =
            (navigator.userAgentData && navigator.userAgentData.platform) ||
            navigator.platform ||
            navigator.userAgent ||
            '';
          if (/Mac|iPhone|iPad|iPod/.test(platform)) {
            document.documentElement.setAttribute('data-kbd-os', 'mac');
          }
        } catch (e) {
          /* default (no attribute) reads as "Ctrl K" — a safe fallback */
        }
      })();
    </script>
  </head>
  <body>
    {/*
      Skip link and <main> are BOTH required, and they are a pair. A parity run
      against the legacy site found every legacy page carries a skip link and a
      <main>, while all 8 ported blog posts had neither: the article rendered as
      a bare <article> with no landmark. A keyboard or screen-reader user had no
      way past the navigation, and a skip link without a <main> to target is
      worse than none because it silently goes nowhere.

      They live here rather than in each page layout so no future route can be
      added without them. That is the whole point of owning the shell.
    */}
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Nav currentPath={path} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--c-bg);
    color-scheme: dark;
    /*
     * THE HEADER IS STICKY, SO EVERY ANCHOR JUMP LANDS UNDERNEATH IT.
     * Measured: header 73px, and following the skip link put #main-content at
     * top: 0 — the first 73px of the page's own content sitting behind the
     * bar. The skip link is the one control whose entire purpose is to move a
     * keyboard user to the content, so it was the worst possible target.
     * WCAG 2.2 SC 2.4.11 Focus Not Obscured, which axe cannot detect: the
     * element is in the DOM, visible, focusable and correctly labelled, and it
     * is behind something.
     *
     * scroll-padding-top on the scroll container fixes EVERY jump at once —
     * skip link, fragment URLs arriving from search results, :target, the
     * command palette, and any anchor added later by someone who never reads
     * this file. It was previously handled by hand-written scroll-margin-top
     * on five specific selectors in three files, which covered prose headings
     * and nothing else.
     *
     * 96px is 73px of header plus 23px of breathing room, and matches the
     * value those five rules had already arrived at independently.
     */
    scroll-padding-top: 96px;
  }
  body {
    margin: 0;
    background: var(--c-bg);
    color: var(--c-text);
    font-family: var(--font-body);
    /* The orbs are positioned against the page, not the viewport. */
    position: relative;
    isolation: isolate;
  }

  /*
   * AMBIENT LAYER. Two soft colour fields behind the whole document, which is
   * what makes --c-card's translucency mean anything — until this existed the
   * cards were translucent over flat black, so the drift the token comment
   * describes had nothing to drift over.
   *
   * GLOBAL RATHER THAN PER-SECTION, on purpose. The visual layer went missing
   * in the first place because every ported section dropped it independently
   * and no single change looked wrong. Anchoring it to the layout means a new
   * page cannot forget it.
   *
   * pointer-events: none and z-index: -1 keep it entirely out of the way: it
   * cannot intercept a click, cannot take focus, and cannot cover content.
   * It carries no information, so it is invisible to assistive tech by being
   * a pseudo-element with no content.
   *
   * FIXED, NOT ABSOLUTE, and that is a bug fix rather than a preference. The
   * first version positioned these absolutely with `right: -20vw`, which
   * extended the scrollable width of the document and put horizontal overflow
   * on every page at 768 and 1440 — a defect the sitewide gate checks for at
   * three widths, caught before it shipped. Fixed positioning takes them out of
   * the layout entirely, so they cannot influence scrollWidth at any viewport,
   * and the field stays put while the content moves over it.
   *
   * (Editing note: the Tailwind parser pairs quote characters across this
   * stylesheet INCLUDING inside comments, so an odd number of apostrophes
   * fails the build with "Unterminated string" and a message quoting the text
   * that follows the stray one. Apostrophes are fine in pairs — there are
   * others above — but a single new one will break it. This paragraph is
   * worded without one for that reason.
   *
   * A second hazard, found 2026-08-02: a stray comment terminator had been left
   * immediately above this paragraph, closing the block early so every line
   * below it was handed to the CSS parser as declarations. That surfaced only
   * as an esbuild "Expected identifier but found whitespace" WARNING during
   * minification, and a warning does not fail the build, so it shipped. After
   * editing any comment in this file, check the build output for a
   * css-syntax-error rather than trusting the exit code.)
   */
  body::before,
  body::after {
    content: '';
    position: fixed;
    z-index: -1;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(40px);
  }

  /* Behind the hero, where the eye lands first. */
  body::before {
    top: -30vh;
    left: 50%;
    width: min(1100px, 110vw);
    height: min(1100px, 110vw);
    transform: translateX(-50%);
    background: var(--orb-violet);
    opacity: 0.5;
  }

  /* Lower and to one side, so the page does not read as symmetrical. */
  body::after {
    bottom: -35vh;
    right: -10vw;
    width: min(900px, 90vw);
    height: min(900px, 90vw);
    background: var(--orb-teal);
    opacity: 0.3;
  }

  /* A blurred 1100px field is a real paint cost on a phone, and it is
     decoration. Below the tablet breakpoint the page keeps its flat surface. */
  @media (max-width: 767px) {
    body::before,
    body::after { display: none; }
  }
  img,
  picture {
    max-width: 100%;
    height: auto;
  }

  /* Off-screen until focused, then a real, visible, high-contrast target.
     NOT display:none and NOT visibility:hidden — either removes it from the
     focus order entirely, which is the usual way this control is broken while
     appearing to be present in the markup. */
  .skip-link {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 999;
    transform: translateY(-120%);
    padding: 0.75rem 1.25rem;
    background: var(--c-teal);
    color: var(--c-bg);
    font-family: var(--font-body);
    font-weight: 700;
    text-decoration: none;
    border-bottom-right-radius: var(--radius-panel);
    transition: transform var(--dur) var(--ease);
  }
  .skip-link:focus-visible {
    transform: translateY(0);
    outline: 3px solid var(--c-text);
    outline-offset: 2px;
  }
  /* The target is programmatically focusable so focus actually lands there,
     but it must never draw a focus ring when reached by mouse or by scroll. */
  main:focus {
    outline: none;
  }
</style>
