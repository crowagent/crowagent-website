---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import Button from '../../components/ui/Button.astro';

const title = 'By Sector | CrowAgent';
const description =
  'See the statute behind your sector. CrowAgent helps UK teams find, win and evidence public sector tenders, cited to the regulation that applies to you.';
const path = '/sectors';

const sectorCards = [
  {
    accent: 'violet',
    name: 'Public-Sector Suppliers',
    say: 'PPN 002, dated February 2025 and mandatory from 1 October 2025, makes social value a scored 10% minimum weighting on in-scope central-government tenders.',
    href: '/crowmark',
  },
  {
    accent: 'teal',
    name: 'IT Managed Service Providers',
    say: 'Public-sector IT and managed-service tenders are scored on PPN 002 social value alongside technical fit and price.',
    href: '/crowmark',
  },
  {
    accent: 'teal',
    name: 'Professional Services',
    say: 'Framework and consultancy tenders reward a consistent, evidenced bid response.',
    href: '/crowmark',
  },
  {
    accent: 'violet',
    name: 'Construction',
    say: 'Public works bids score PPN 002 social value against a 10% minimum weighting.',
    href: '/sectors/construction',
  },
  {
    accent: 'violet',
    name: 'Facilities Management',
    say: 'FM tenders turn on TUPE, mobilisation and evidenced delivery against the published KPIs.',
    href: '/sectors/facilities',
  },
  {
    accent: 'violet',
    name: 'Highways',
    say: 'Term-maintenance and NEC4 contracts are scored on social value alongside price and capability.',
    href: '/sectors/highways',
  },
  {
    accent: 'violet',
    name: 'NHS Suppliers',
    say: 'Framework bids weigh PPN 002 social value alongside a track record of on-time, evidenced delivery.',
    href: '/crowmark',
  },
  {
    accent: 'teal',
    name: 'Education',
    say: 'Public-sector contracts expect a consistent, well-evidenced bid and a track record of on-time delivery.',
    href: '/sectors/education',
  },
  {
    accent: 'violet',
    name: 'Charities',
    say: 'Grant and tender bids are judged on PPN 002 social value, with reporting that has to stay lean.',
    href: '/crowmark',
  },
];

const schema = [
  {
    '@type': 'CollectionPage',
    name: 'Sectors',
    description: 'How CrowAgent serves UK teams by sector, cited to the statute that applies to each.',
    url: `${SITE.origin}/sectors`,
    publisher: { '@type': 'Organization', name: 'CrowAgent', url: `${SITE.origin}/` },
  },
];
---

<Base title={title} description={description} path={path} image="/Assets/og-image.png?v=20260730" schema={schema}>
  <main>
    <header class="sec-hero">
      <div class="sec-wrap">
        <span class="sec-eyebrow">By sector</span>
        <h1>The statute behind <span class="accent">your sector.</span></h1>
        <p class="sec-sub">
          Different rules, one product. See what decides whether you win the tender in your sector, and how CrowMark for
          Suppliers helps you answer it.
        </p>
      </div>
    </header>

    <section class="sec-band">
      <div class="sec-wrap">
        <div class="sec-head">
          <span class="sec-eyebrow-inline">Who we build for</span>
          <h2>Every sector is under its own clock.</h2>
          <p class="sec-head-lede">Nine UK sectors, each with its own bidding pressure. One line on the pressure, and how CrowMark answers it.</p>
        </div>
        <div class="sec-grid">
          {
            sectorCards.map((c) => (
              <div class="sec-card" data-accent={c.accent}>
                <div class="sec-verb">{c.name}</div>
                <p class="sec-say">{c.say}</p>
                <div class="sec-serves">
                  <a href={c.href}>CrowMark</a>
                </div>
              </div>
            ))
          }
        </div>

        <figure class="sec-shot">
          <picture>
            <source type="image/avif" srcset="/Assets/shots/dark/mark-analytics-hero.avif?v=20260731e" />
            <source type="image/webp" srcset="/Assets/shots/dark/mark-analytics-hero.webp?v=20260731e" />
            <img
              src="/Assets/shots/dark/mark-analytics-hero.png?v=20260731e"
              width="2480"
              height="1550"
              loading="lazy"
              decoding="async"
              alt="The CrowMark Analytics screen, headed bid performance, pipeline and social value insights, with a date range selector. Three summary tiles cover total contracts, social value delivered across won bids and evidence completion across committed measures. Under them sit two bar charts: Contracts by status, with columns for draft, profiling, evidence, won and lost, and Bids by sector, with columns for Facilities Management, Professional Services, Construction, Education, Healthcare, Technology and IT, and Transport. An average social value score trend chart begins below. Each chart has a CSV export button."
            />
          </picture>
          <figcaption>Bids and contracts grouped by sector in CrowMark Analytics, shown with a sample account. Every number on screen is that sample account&rsquo;s own data. It is not a customer result and not an outcome to expect.</figcaption>
        </figure>
      </div>
    </section>

    <section class="sec-band sec-light">
      <div class="sec-wrap">
        <div class="sec-head">
          <span class="sec-eyebrow-inline">How CrowMark works</span>
          <h2>Whatever your sector, the answer is cited.</h2>
          <p class="sec-head-lede">CrowMark reads the rules behind the tender, so every score, weighting and figure traces back to its source.</p>
        </div>
        <div class="sec-ledger">
          <div class="sec-lrow">
            <div class="sec-ref">CrowMark</div>
            <div class="sec-desc"><strong>Social value computed in code on the PPN 002 model</strong> at the 10% minimum weighting, over a curated catalogue of TOMs-aligned measures, with answers drafted from your own submitted bids.</div>
            <div class="sec-meta">Cabinet Office<br />February 2025 &middot; mandatory from 1 Oct 2025</div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec-final">
      <div class="sec-wrap">
        <span class="sec-eyebrow">Ready when you are</span>
        <h2>Find the work. Win it. <span class="accent">Prove you delivered.</span></h2>
        <p class="sec-final-sub">See how CrowMark fits your sector's bidding calendar.</p>
        <div class="sec-hero-cta">
          <Button href="/contact?enquiry=limited-access#contact-form" size="md">Request access</Button>
          <Button href="https://calendly.com/crowagent-platform/30min" variant="secondary" size="md">Book a demo</Button>
        </div>
        <div class="sec-final-links">
          <a href="/pricing">See pricing</a>
          <a href="mailto:hello@crowagent.ai">Ask a question</a>
          <span>Built by UK procurement and ML engineers</span>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .sec-wrap {
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  .sec-hero {
    position: relative;
    padding: clamp(96px, 13vw, 148px) 0 clamp(20px, 4vw, 44px);
    text-align: center;
    overflow: hidden;
  }
  .sec-hero::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -6%;
    width: 70vw;
    height: 44vw;
    transform: translateX(-50%);
    z-index: -1;
    background: radial-gradient(ellipse at center, var(--c-teal-glow), transparent 66%);
    filter: blur(20px);
    opacity: 0.5;
  }
  .sec-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--t-micro);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-teal);
  }
  .sec-eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-teal);
  }
  .sec-hero h1 {
    font-family: var(--font-display);
    font-size: var(--t-h1);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--c-text);
    max-width: 15ch;
    margin: 18px auto 0;
  }
  .sec-hero h1 .accent {
    color: var(--c-teal);
  }
  .sec-sub {
    margin: 22px auto 0;
    max-width: 56ch;
    color: var(--c-text-muted);
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    line-height: 1.6;
  }

  .sec-band {
    padding: clamp(48px, 7vh, 88px) 0;
  }
  .sec-band.sec-light {
    background: var(--c-panel);
  }
  .sec-head {
    margin-bottom: var(--sec-gap);
  }
  .sec-eyebrow-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--t-micro);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-teal);
    margin-bottom: 0.75rem;
  }
  .sec-eyebrow-inline::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-teal);
  }
  .sec-head h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin: 0 0 0.75rem;
    max-width: 32ch;
  }
  .sec-head-lede {
    color: var(--c-text-muted);
    font-size: var(--t-lede);
    max-width: 48ch;
    margin: 0;
  }

  .sec-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  .sec-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--c-border);
    background: var(--c-card);
    border-left: 3px solid var(--step-accent, var(--c-teal));
  }
  .sec-card[data-accent='violet'] {
    --step-accent: var(--c-violet);
  }
  .sec-card[data-accent='teal'] {
    --step-accent: var(--c-teal);
  }
  .sec-verb {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-h4);
    color: var(--c-text);
    margin-bottom: 0.6rem;
  }
  .sec-say {
    color: var(--c-text-sub);
    font-size: var(--t-body);
    line-height: 1.6;
    margin: 0;
  }
  .sec-serves {
    margin-top: auto;
    padding-top: 1.25rem;
  }
  .sec-serves a {
    font-family: var(--font-display);
    font-size: var(--t-micro);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-teal);
    text-decoration: none;
  }
  .sec-serves a:hover {
    text-decoration: underline;
  }

  .sec-shot {
    max-width: 960px;
    margin: 38px auto 0;
  }
  .sec-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--c-border);
  }
  .sec-shot figcaption {
    margin-top: 14px;
    color: var(--c-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    text-align: left;
  }

  .sec-ledger {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sec-lrow {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--c-border);
    background: var(--c-card);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .sec-lrow {
      grid-template-columns: 10rem 1fr 12rem;
      align-items: start;
    }
  }
  .sec-ref {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--c-teal);
  }
  .sec-desc {
    color: var(--c-text-sub);
    font-size: var(--t-body);
    line-height: 1.6;
  }
  .sec-desc strong {
    color: var(--c-text);
  }
  .sec-meta {
    color: var(--c-text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .sec-final {
    padding: var(--sec-pad-y) 0;
    text-align: center;
    background: var(--c-panel);
    border-top: 1px solid var(--c-border);
  }
  .sec-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 30px;
  }
  .sec-final h2 {
    font-family: var(--font-display);
    font-size: var(--t-h1);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin: 26px 0 0;
  }
  .sec-final h2 .accent {
    color: var(--c-teal);
  }
  .sec-final-sub {
    max-width: 42rem;
    margin: 1.25rem auto var(--sec-gap);
    color: var(--c-text-muted);
    font-size: var(--t-lede);
    line-height: 1.6;
  }
  .sec-final-links {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    font-size: var(--t-body);
    color: var(--c-text-muted);
  }
  .sec-final-links a {
    color: var(--c-text-muted);
  }
  .sec-final-links a:hover {
    color: var(--c-text);
  }
</style>
