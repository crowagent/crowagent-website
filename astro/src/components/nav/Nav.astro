---
/**
 * Nav.astro — the sitewide primary navigation.
 *
 * Renders from `src/data/nav.ts`. Fixed header, one dropdown per entry in
 * NAV.menus, mobile accordion menu, search affordance, Sign in + Request access
 * CTAs, as static server-rendered markup with a small client script for the
 * interactive parts.
 *
 * NO INJECTOR, NO SECOND STYLESHEET, AND THAT WAS CHECKED RATHER THAN ASSUMED.
 * The legacy site built its nav at runtime from `js/nav-inject.js` and styled it
 * from `nav-global-fix-2026-05-27.css`, a sheet nothing else on the site loaded.
 * Neither survives into this build: grepping astro/dist for both names returns
 * two hits and both are prose inside comments (this file's kbd note and the
 * Base.astro head script's), no <script src> and no <link> anywhere. This
 * component and NavDropdown.astro are the whole nav.
 *
 * ── ONE DROPDOWN MECHANISM, 2026-08-04 ──────────────────────────────────────
 *
 * The owner's decision to split Products into Products + Resources could have
 * been implemented by pasting the mega-menu block and its handlers a second
 * time. It was not. The dropdown moved into NavDropdown.astro and both menus
 * are instances of it, so there is one trigger, one panel, one set of key
 * bindings and one pointer behaviour. The reasoning is written out at the top
 * of that file; the short version is that a copied block is exactly the fork
 * pattern this site has spent the week unpicking.
 *
 * The mobile accordions are built from the SAME NAV.menus array, so a menu item
 * cannot exist on one breakpoint and not the other. It could before: the mobile
 * panel and the desktop panel were separate lists and had already drifted on
 * two rows.
 *
 * Deliberate behavioural inheritance from the legacy markup, kept: the Products
 * trigger there was an <a href="/crowmark"> that ALSO toggled the dropdown via a
 * separate chevron control, reconciled at runtime by ~150 lines of capture-phase
 * click/keydown interception (nav-inject.js 824-905) because it fought a second
 * legacy click handler in scripts.min.js. That handler does not exist here, so
 * the two-purpose trigger it was built to route around is not needed either.
 * Each trigger is a single <button>. The first row inside Products (/crowmark)
 * still covers the destination the old trigger link pointed at, so no route
 * becomes unreachable.
 */
import { NAV } from '../../data/nav';
import NavDropdown from './NavDropdown.astro';
import Button from '../ui/Button.astro';

interface Props {
  /** Current route path, e.g. "/crowmark". Drives aria-current highlighting. */
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(href: string): boolean {
  if (href.startsWith('#')) return false;
  const h = href.replace(/\/$/, '') || '/';
  const p = currentPath.replace(/\/$/, '') || '/';
  return p === h || (h !== '/' && p.startsWith(h));
}

function sectionActive(routes: readonly string[]): boolean {
  return routes.some((r) => isActive(r));
}

/**
 * Both breakpoints render from this, so the desktop panel and the mobile
 * accordion cannot disagree about what is in a menu. Resources is exposed in
 * the mobile menu exactly as Products is, because both come out of this one
 * loop rather than out of two hand-written blocks — which is how the two lists
 * drifted apart the last time.
 */
const menus = NAV.menus.map((menu) => ({
  menu,
  active: sectionActive(menu.activeRoutes),
  /** Flattened for mobile, where the column headings would be noise. */
  links: menu.columns.flatMap((col) => col.items),
}));
---

<header class="ca-nav" id="ca-nav">
  <nav class="ca-nav-row" aria-label="Main navigation">
    <a href={NAV.logo.href} class="ca-logo" aria-label={NAV.logo.ariaLabel}>
      <span class="ca-logo-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <defs>
            <linearGradient id="caMarkBlue-nav" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#60a5fa"></stop>
              <stop offset="1" stop-color="#2563eb"></stop>
            </linearGradient>
            <linearGradient id="caMarkTeal-nav" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#22c55e"></stop>
              <stop offset="1" stop-color="#3b82f6"></stop>
            </linearGradient>
          </defs>
          <rect x="4" y="4" width="56" height="56" rx="14" fill="#FCFDFF" stroke="rgba(15,23,42,.20)" stroke-width="1.5"></rect>
          <rect x="15" y="48.4" width="34" height="1.2" rx="0.6" fill="#94a3b8" opacity="0.35"></rect>
          <rect x="15" y="34.72" width="6" height="14.28" rx="2" fill="url(#caMarkBlue-nav)"></rect>
          <rect x="24.33" y="28.6" width="6" height="20.4" rx="2" fill="url(#caMarkBlue-nav)"></rect>
          <rect x="33.67" y="22.48" width="6" height="26.52" rx="2" fill="url(#caMarkTeal-nav)"></rect>
          <rect x="43" y="15" width="6" height="34" rx="2" fill="url(#caMarkTeal-nav)"></rect>
        </svg>
      </span>
      <span class="ca-logo-word">CrowAgent</span>
    </a>

    <div class="ca-nav-links">
      {menus.map(({ menu, active }) => <NavDropdown menu={menu} active={active} />)}
      {
        NAV.topLinks.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="ca-nav-actions">
      <button
        type="button"
        class="control ca-search-trigger"
        aria-label="Search (Ctrl K)"
        title="Search (Ctrl K)"
        data-cmdk-open
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <!--
          Platform-aware kbd badge (fixes a legacy bug): the old injector
          hardcoded "&#8984;K" (Mac Cmd) for every visitor even though its own
          key handler accepts both Ctrl and Cmd. Both labels are rendered up
          front so there is no post-hydration layout shift; a blocking inline
          script in Base.astro's <head> (runs before this markup paints) stamps
          `data-kbd-os="mac"` on <html> and CSS below shows only the matching
          label. Non-Mac (including the pre-JS default) sees "Ctrl K".
        -->
        <kbd class="ca-search-kbd" aria-hidden="true">
          <span class="ca-kbd-mac">&#8984;K</span><span class="ca-kbd-other">Ctrl K</span>
        </kbd>
      </button>
      {/* The Button component, not a second recipe. This was `ca-btn
          ca-btn-ghost`: a near-copy of `.btn` with 1.1rem padding against the
          component's 1.5rem, sitting directly beside a real `.btn` in the same
          header. Two button systems, sixteen pixels apart. */}
      {/* `target="_blank"`, not `external`. Both sign-in buttons passed a bare
          `external` until 2026-08-04 and Button has no such prop, so Astro
          dropped it: the rendered link carried neither target nor rel, while
          js/nav-inject.js:362 and :424 both ship
          `target="_blank" rel="noopener noreferrer"` on the same two links.
          A silently ignored prop, found by `astro check` and by nothing else.
          Button fills in rel="noopener noreferrer" whenever target is _blank. */}
      <Button href={NAV.actions.signIn.href} variant="secondary" size="sm" class="ca-nav-login" target="_blank">
        {NAV.actions.signIn.label}
      </Button>
      <Button href={NAV.actions.cta.href} size="sm" class="ca-nav-cta">{NAV.actions.cta.label}</Button>
    </div>

    <button type="button" class="ca-ham" id="nav-ham" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mob-menu">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<div class="ca-mob-menu" id="mob-menu" role="dialog" aria-label="Mobile navigation menu" aria-modal="true">
  <button type="button" class="ca-mob-close" aria-label="Close menu" data-mob-close>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>
  <nav class="ca-mob-nav" aria-label="Primary mobile navigation">
    {
      menus.map(({ menu, active, links }) => (
        <div class="ca-mob-acc">
          <button
            type="button"
            class="ca-mob-acc-trigger"
            aria-expanded="false"
            aria-controls={`mob-acc-${menu.id}`}
            data-active={active ? 'true' : undefined}
          >
            {menu.label}
            <svg class="ca-mob-acc-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>
          <div class="ca-mob-acc-panel" id={`mob-acc-${menu.id}`} hidden>
            {links.map((l) => (
              <a href={l.href} class="ca-mob-sublink" aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            ))}
          </div>
        </div>
      ))
    }
    {
      NAV.topLinks.map((l) => (
        <a href={l.href} class="ca-mob-toplink" aria-current={isActive(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <div class="ca-mob-ctas">
    {/* Same correction as the desktop sign-in above, and the same reason. */}
    <Button href={NAV.actions.signIn.href} variant="secondary" target="_blank">
      {NAV.actions.signIn.label}
    </Button>
    <Button href={NAV.actions.cta.href} size="md">{NAV.actions.cta.label}</Button>
  </div>
</div>

{/*
  THE HEADER'S CLIENT BEHAVIOUR IS IN src/scripts/nav.ts, AND IT IS NOT A
  <script> HERE ANY MORE.
  ---------------------------------------------------------------------------
  Not one line of it changed. It moved on 2026-08-04 under ADR 0010 because of
  where Astro put it, not because of what it did: a hoisted component script
  that compiles to one small chunk is INLINED into the document, so this block
  was written into all 44 documents identically — and with three others like
  it, 8,958 B a document and 384.9 KB of build that nothing could cache.

  It is now booted once from src/scripts/shell.ts, the single entry
  layouts/Base.astro carries, which compiles to one external hashed file that
  every route shares.

  A <script> ADDED BACK TO THIS FILE WOULD UNDO THAT, silently, and it would
  not be obvious in review — it would look like a component minding its own
  business. scripts/check-budgets.js fails the build if the same inline script
  body reappears across routes, so the guard is a gate rather than this note.
*/}

<style is:global>
  /* ══════════════════════════════════════════════════════════════════════════
     THE NAV'S INK — every interactive colour in the header, stated ONCE.
     ══════════════════════════════════════════════════════════════════════════

     WHAT WAS WRONG, MEASURED ON :8095 BEFORE THIS BLOCK EXISTED. Hovering the
     nav changed the HUE, and it changed it to two different hues in the same
     row of links:

       Pricing / Blog / FAQ / About   rgb(210,219,238) -> rgb(34,211,238)  cyan
       Products                       rgb(210,219,238) -> rgb(45,212,191)  teal
       dropdown rows                  rgb(255,255,255) -> rgb(255,255,255) nothing

     Three behaviours, because three different rules each decided for
     themselves: `.ca-nav-links > a:hover` picked --c-interactive,
     `.ca-dropdown-trigger:hover` picked --c-teal, and the dropdown rows painted
     `color: var(--c-text)` at rest so they were already at full white and had
     nowhere to go. The reference build on :8092 does none of that — it holds
     rgba(232,240,250,0.72) at rest and goes to rgb(255,255,255) on hover, on
     every link including the ones inside the panel. A brightness lift, no hue
     change, one behaviour.

     So this is not three fixed rules. It is one rule, and the reason the defect
     could exist at all is that there was no single owner for "what colour is a
     nav link". There is now, and a new nav control gets the behaviour by being
     in the list rather than by its author remembering.

     WHY is:global, WHICH IS THE ONE THING THAT NEEDS DEFENDING HERE. The
     dropdown rows are rendered by NavDropdown.astro, so Astro stamps them with
     that component's scope id, not this one's — a scoped rule written here
     would reach the top-level links and stop at the panel, which is precisely
     the half-a-nav fork this block exists to end. Every selector is anchored on
     `.ca-nav` or `.ca-mob-menu`, both of which exist only in this component, so
     "global" means unscoped, not unbounded.

     SPECIFICITY IS DELIBERATE AND THE ORDER MATTERS. The shared selector list
     sits inside :where(), which contributes nothing, so the rest state is
     (0,0,0), and the current-page and lit states are each exactly (0,1,0) —
     equal, decided by source order. Lit is written last, so hovering the link
     for the page you are already on still lifts it. That is not an accident of
     the cascade; it is the one ordering that makes hover mean the same thing
     everywhere.

     Longhand transition properties, never the shorthand, for the reason
     motion.css records: the shorthand also resets transition-delay and
     transition-behavior. Only `color` is transitioned — nothing here moves —
     and tokens.css already collapses --dur-fast to 0.01ms under
     prefers-reduced-motion, so this needs no media query of its own.

     THE NOTE THAT WAS HERE HAS BEEN ANSWERED, AND IS KEPT SO THE ANSWER CAN BE
     CHECKED. It read: "A NOTE FOR WHOEVER OWNS motion.css. Its transition floor
     and its focus ring are both scoped to `main`, so the header and the footer
     get neither. The ring is restated below for the nav, at the same three
     values, so it is the same ring rather than a fifth one. The footer still has
     the gap."

     Both scopes are gone now — the focus ring on 2026-08-04 and the transition
     floor with O-52 the same day — so the footer has neither gap. NOTHING IN
     THIS FILE CHANGED WITH EITHER, and that is the property worth stating rather
     than the fix: the rules above are Astro scoped styles, which are unlayered
     and outrank every cascade layer, so a widened floor at `:where()` zero
     specificity cannot reach a control the nav has already spoken for. The nav's
     transitions were measured byte-identical before and after. */

  :where(
    .ca-nav .ca-nav-links > a,
    .ca-nav .ca-dropdown-trigger,
    .ca-nav .ca-search-trigger,
    .ca-nav .ca-mega-item,
    .ca-mob-menu .ca-mob-toplink,
    .ca-mob-menu .ca-mob-acc-trigger,
    .ca-mob-menu .ca-mob-sublink
  ) {
    color: var(--c-text-sub);
    /* DECORATION IS OWNED HERE TOO, and it was not until 2026-08-04. Three
       later rules in this file each set `text-decoration: none` on one of the
       three link classes below — .ca-nav-links > a, .ca-mob-toplink and
       .ca-mob-sublink — which is the same three-rules-for-one-decision shape
       this block was written to end for colour, sitting one property along.
       It stopped mattering the moment the current-page state started drawing a
       rule: those three won on specificity and the rule never painted. So the
       rest state says `none` here, once, and the current-page state below is
       the only thing that draws. */
    text-decoration: none;
    transition-property: color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  /* The row description is the third step of the same ladder, not a separate
     decision: muted at rest, up to the resting ink when its row is under the
     cursor. It is inside this block rather than in NavDropdown.astro so that
     "what colour is nav text" has one answer in one place. */
  :where(.ca-nav .ca-mega-desc) {
    color: var(--c-text-muted);
    transition-property: color;
    transition-duration: var(--dur-fast);
    transition-timing-function: var(--ease);
  }

  /* WHERE YOU ARE is a state and it persists; hover is a lift and it does not.
     Two different jobs, so two different treatments — and one treatment each,
     not the cyan-for-links / teal-for-the-trigger split this replaces.

     ── AMENDED 2026-08-04, AND THE AMENDMENT IS THE POINT OF THE V6 PASS ─────

     This rule used to separate the two jobs BY HUE: current page took
     --c-interactive, which was cyan, and hover took --c-text, which is white.
     V6 moves --c-interactive to white. Read literally, that makes the two rules
     paint the same colour and the "where you are" state DISAPPEARS — a real
     collision, found by reading this block rather than by looking at a
     screenshot, and it would have shipped silently because both rules still
     resolve to a valid token.

     The fix is the variant's own logic rather than a carve-out. V6's idea is
     that white stops being only type and becomes a MATERIAL: white rules, white
     fills, white edges. So the current page keeps the interactive value and
     gains a white RULE under it, which persists; hover raises the ink and draws
     nothing. Two jobs, two treatments, one hue — which is a stronger separation
     than the old one, because a reader could always have missed a cyan/white
     difference and cannot miss a line that is either there or not.

     THE RULE IS DRAWN WITH text-decoration, NOT A BORDER OR A PSEUDO-ELEMENT.
     A border changes the box and would shift every other link in the row by a
     pixel; a pseudo-element would need a position on seven selectors across two
     menus, and the mobile links are full-width rows where a rule spanning the
     row would read as a divider. An underline tracks the TEXT, which is the
     thing that is current. --c-interactive is stated explicitly rather than
     inherited from `color` so that this stays true if the ink and the
     interactive value are ever unbound again. */
  :where(
    .ca-nav .ca-nav-links > a,
    .ca-mob-menu .ca-mob-toplink,
    .ca-mob-menu .ca-mob-sublink
  )[aria-current='page'],
  :where(
    .ca-nav .ca-dropdown-trigger,
    .ca-mob-menu .ca-mob-acc-trigger
  )[data-active='true'] {
    color: var(--c-interactive);
    text-decoration-color: var(--c-interactive);
    text-decoration-thickness: 2px;
  }

  /* THE LIFT. Full white, on every nav control including the ones inside a
     dropdown panel, matching the reference build. :focus-visible is in the same
     rule as :hover so a keyboard reader gets the identical feedback a mouse
     does, which is the half that was missing everywhere. */
  :where(
    .ca-nav .ca-nav-links > a,
    .ca-nav .ca-dropdown-trigger,
    .ca-nav .ca-search-trigger,
    .ca-nav .ca-mega-item,
    .ca-mob-menu .ca-mob-toplink,
    .ca-mob-menu .ca-mob-acc-trigger,
    .ca-mob-menu .ca-mob-sublink
  ):is(:hover, :focus-visible),
  :where(.ca-nav .ca-dropdown-trigger)[aria-expanded='true'] {
    color: var(--c-text);
  }

  :where(.ca-nav .ca-mega-item:hover, .ca-nav .ca-mega-item:focus-visible) .ca-mega-desc {
    color: var(--c-text-sub);
  }

  /* THE FOCUS RING FOR THE CHROME. motion.css states the site's ring once, for
     everything <main> contains, and the header is not inside <main> — so before
     this every link and button up here fell back to the user agent's, which on
     a dark translucent bar is close to invisible. Same three values as every
     other definition on the site, so this is the same ring. */
  :where(.ca-nav, .ca-mob-menu) :where(a, button):focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: 3px;
  }
</style>

<style>
  /* ── THE BAR'S FROST SITS ON A PSEUDO-ELEMENT, AND THAT IS NOT COSMETIC ────
   *
   * MEASURED DEFECT, found on 2026-08-04 while shooting the new Resources
   * panel. The mega-menu declares `backdrop-filter: var(--blur-glass)` and an
   * 82% background, and its computed style says `blur(16px) saturate(1.6)` — it
   * was drawing NO BLUR AT ALL. The homepage h1 read straight through the open
   * menu, which is the one outcome the comment on `.ca-mega` in
   * NavDropdown.astro names as genuinely bad.
   *
   * The cause is nesting. An element with `backdrop-filter` becomes a BACKDROP
   * ROOT for its descendants, and the panel is a descendant of this bar. So the
   * panel was filtering the bar's backdrop image rather than the page, and
   * outside the bar's own box there is nothing in it to blur. Proved both ways
   * on the real page: with this bar's filter neutralised at runtime the panel
   * frosts correctly; with it restored the hero text is legible through the
   * menu again.
   *
   * Moving the fill and the filter onto ::before fixes it because a backdrop
   * root is created by the element that CARRIES the property. The pseudo-
   * element is the backdrop root for itself alone, `.ca-nav` goes back to being
   * an ordinary box, and the panel inside it filters the page. The bar looks
   * identical — same fill, same filter, same stacking — which is the point.
   *
   * z-index: -1 is safe rather than lucky: this element is `position: sticky`
   * with `z-index: 100`, so it establishes a stacking context and the pseudo-
   * element cannot escape behind the page. The fill is the same
   * rgba(5, 7, 14, 0.72) it always was, now written against --c-bg (#05070E)
   * instead of as a literal. */
  .ca-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--c-border);
  }
  .ca-nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--c-bg) 72%, transparent);
    backdrop-filter: var(--blur-glass);
    -webkit-backdrop-filter: var(--blur-glass);
  }

  .ca-nav-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    max-width: 1440px;
    margin-inline: auto;
    padding: 0 clamp(1rem, 3vw, 2.5rem);
    min-block-size: 4.5rem;
  }

  .ca-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--c-text);
  }
  .ca-logo-mark svg {
    display: block;
    width: 32px;
    height: 32px;
  }
  .ca-logo-word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-body);
    color: var(--c-text);
  }

  .ca-nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Two dropdowns and four links now sit here rather than one and four, so
       the gap floor came down a notch to keep the row off the CTAs at 1024px.
       The clamp still opens back up to 1.75rem on a wide viewport. */
    gap: clamp(0.85rem, 1.8vw, 1.75rem);
  }
  .ca-nav-links > a {
    /* inline-flex so the box can be given a height at all: an inline box takes
       its height from line-height and ignores min-block-size entirely. */
    display: inline-flex;
    align-items: center;
    /* O-48. WCAG 2.2 target size on the top-level nav links.
       MIN-BLOCK-SIZE, NOT PADDING, and that is the whole content of the fix.
       --t-body is fluid, so a padding figure is a bet on the font size: the
       value that measured 44.0px at 1440 measured 43.4px at 1025, which is a
       target that passes on the viewport somebody checked and fails on the one
       they did not. A min-block-size is the requirement stated directly, and it
       holds at every size the clamp can produce.
       These links measured 39.1px. At 834 and 390 the nav is already fully
       compliant — the hamburger is 44x44 and none of the 16 mobile-menu
       elements is under — so this rule only ever changes the pointer viewports,
       which is where the shortfall was. Verified by injection before landing:
       the column width is byte-identical and nothing visible moves, because the
       row is 44px tall already on account of the dropdown triggers beside it. */
    min-block-size: 44px;
    font-family: var(--font-body);
    font-size: var(--t-body);
    font-weight: 600;
    padding: 0.4rem 0;
    white-space: nowrap;
  }
  /* Colour is not declared here. See the nav ink block above. */

  .ca-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* ── THE ELEVENTH COPY, FOLDED IN 2026-08-04 ────────────────────────────────
   *
   * A-52 consolidated ten hand-rolled control responses into styles/controls.css
   * and could not reach this one: the pass ran while another agent held this
   * file, so it was recorded as DEBT in scripts/check-controls.js and printed on
   * every run instead. This is that entry being paid.
   *
   * WHAT WENT: `background`, `border`, `cursor` and a `:hover` that brightened
   * the hairline to --c-border-glow. All four are what `control` in the class
   * list now says, and the hover rule was the one real rule-1 violation left in
   * the source — the shared treatment written out by hand, which is the only
   * reason it looked like a decision rather than a copy.
   *
   * WHAT STAYED, AND WHY IT IS NOT A FORK: geometry. controls.css owns the wash,
   * the hairline, the ink and the response, and deliberately owns no size, for
