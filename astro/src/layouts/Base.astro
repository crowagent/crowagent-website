---
/**
 * Base.astro — the html shell every page renders through.
 *
 * Metadata is entirely delegated to Seo.astro (title, canonical, OG,
 * Twitter, JSON-LD @graph). This layout only owns the document skeleton
 * and the sitewide design tokens.
 */
import Seo from '../components/seo/Seo.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  /** Route path, e.g. "/blog/some-post". Passed straight through to Seo.astro. */
  path: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
}

const {
  title,
  description,
  path,
  image,
  type,
  publishedAt,
  updatedAt,
  noindex,
  schema,
  ogTitle,
  ogDescription,
  twitterTitle,
  twitterDescription,
} = Astro.props;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title={title}
      description={description}
      path={path}
      image={image}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      noindex={noindex}
      schema={schema}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      twitterTitle={twitterTitle}
      twitterDescription={twitterDescription}
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--c-bg);
    color-scheme: dark;
  }
  body {
    margin: 0;
    background: var(--c-bg);
    color: var(--c-text);
    font-family: var(--font-body);
  }
  img,
  picture {
    max-width: 100%;
    height: auto;
  }
</style>
