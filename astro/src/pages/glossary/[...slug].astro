---
import { getCollection, render } from 'astro:content';
import Glossary from '../../layouts/Glossary.astro';

export async function getStaticPaths() {
  const pages = await getCollection('glossary');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const d = page.data;
---

<Glossary
  title={d.title}
  description={d.description}
  ogTitle={d.ogTitle}
  ogDescription={d.ogDescription}
  ogImage={d.ogImage}
  ogImageAlt={d.ogImageAlt}
  path={`/glossary/${page.id}`}
  termName={d.termName}
  termTagline={d.termTagline}
  heroDescription={d.heroDescription}
  definedTermDescription={d.definedTermDescription}
  sidebarKicker={d.sidebarKicker}
  sidebarTitle={d.sidebarTitle}
  sidebarBody={d.sidebarBody}
  sidebarHref={d.sidebarHref}
  sidebarCta={d.sidebarCta}
  productCardBody={d.productCardBody}
  readMoreHref={d.readMoreHref}
  readMoreLabel={d.readMoreLabel}
  readMoreBody={d.readMoreBody}
  ctaHeading={d.ctaHeading}
  ctaSub={d.ctaSub}
>
  <Content />
</Glossary>
