---
/**
 * Sector.astro — layout for /sectors/construction, education, facilities,
 * highways. Structure mirrors the legacy sector-steps-2026-07-30.css page:
 * hero, context prose (the <slot/>, sourced from Markdown), a 4-step "how
 * CrowMark helps" grid with one product screenshot, an FAQ accordion built
 * from `faq` (also the FAQPage JSON-LD source, so wording can't drift
 * between the two), and a closing CTA band.
 */
import Base from './Base.astro';
import { SITE } from '../data/site';
import Button from '../components/ui/Button.astro';
import FinalCta from '../components/sections/FinalCta.astro';

interface Step {
  accent: 'teal' | 'violet' | 'sky';
  verb: string;
  say: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  ogDescription: string;
  ogImageAlt: string;
  path: string;
  sectorLabel: string;
  heroTitleAccent: string;
  heroDescription: string;
  contextEyebrow: string;
  contextHeading: string;
  helpsHeading: string;
  steps: Step[];
  helpsIntro: string;
  figure: { avif: string; webp: string; png: string; width: number; height: number; alt: string; caption: string };
  faqHeading: string;
  finalCtaSub: string;
  faq: FaqItem[];
}

const {
  title,
  description,
  ogDescription,
  ogImageAlt,
  path,
  sectorLabel,
  heroTitleAccent,
  heroDescription,
  contextEyebrow,
  contextHeading,
  helpsHeading,
  steps,
  helpsIntro,
  figure,
  faqHeading,
  finalCtaSub,
  faq,
} = Astro.props;

const canonical = new URL(path, SITE.origin).href;
const ogImage = '/Assets/og/crowmark.png?v=20260730';

const schema: Record<string, unknown>[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Sectors', item: `${SITE.origin}/sectors` },
      { '@type': 'ListItem', position: 3, name: sectorLabel, item: canonical },
    ],
  },
];

if (faq.length) {
  schema.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}
---

<Base
  title={title}
  description={description}
  ogDescription={ogDescription}
  twitterTitle={title}
  twitterDescription={ogDescription}
  path={path}
  image={ogImage}
  schema={schema}
>
  <main>
    <header class="sec-hero">
      <div class="sec-wrap">
        <span class="sec-eyebrow">{sectorLabel}</span>
        <h1>Stronger bids for <span class="accent">{heroTitleAccent}</span></h1>
        <p class="sec-sub">{heroDescription}</p>
        <div class="sec-hero-cta">
          <Button href="/contact?enquiry=limited-access#contact-form" size="md">Request access</Button>
          <Button href="/crowmark" variant="secondary" size="md">Explore CrowMark</Button>
        </div>
      </div>
    </header>

    <section class="sec-band">
      <div class="sec-wrap">
        <div class="sec-head">
          <span class="sec-eyebrow-inline">{contextEyebrow}</span>
          <h2>{contextHeading}</h2>
        </div>
        <div class="sec-prose">
          <slot />
        </div>
      </div>
    </section>

    <section class="sec-band sec-light">
      <div class="sec-wrap">
        <div class="sec-head">
          <span class="sec-eyebrow-inline">How CrowMark helps</span>
          <h2>{helpsHeading}</h2>
        </div>
        <div class="sec-steps">
          {
            steps.map((step) => (
              <div class="sec-phase surface" data-accent={step.accent}>
                <div class="sec-verb">{step.verb}</div>
                <p class="sec-say">{step.say}</p>
              </div>
            ))
          }
        </div>
        <div class="sec-prose">
          <p>{helpsIntro}</p>
        </div>
        <figure class="sec-shot">
          <picture>
            <source type="image/avif" srcset={figure.avif} />
            <source type="image/webp" srcset={figure.webp} />
            <img src={figure.png} width={figure.width} height={figure.height} loading="lazy" decoding="async" alt={figure.alt} />
          </picture>
          <figcaption>{figure.caption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="sec-band sec-light" aria-labelledby="faq-h">
      <div class="sec-wrap">
        <div class="sec-head sec-head-center">
          <span class="sec-eyebrow-inline">Questions</span>
          <h2 id="faq-h">{faqHeading}</h2>
        </div>
        {/* `surface` on each row supplies the border, radius, background, gloss
            and hover. Without it these rows had a border-radius and nothing to
            round: no edge, no fill, no light, an accordion drawn entirely by
            its own text. */}
        <div class="sec-faq">
          {
            faq.map((f) => (
              <details class="surface">
                <summary>{f.question}</summary>
                <div class="sec-faq-a">{f.answer}</div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* THE BAND BECAME THE CARD, 2026-08-03 — see the note in Compare.astro. */}
    <FinalCta
      id="sector-cta"
      eyebrow="Ready when you are"
      title="Find the work. Win it. Prove you delivered."
      standfirst={finalCtaSub}
      links={[
        { label: 'See pricing', href: '/pricing' },
        { label: 'All sectors', href: '/sectors' },
      ]}
      note="Built by UK procurement and ML engineers"
    >
      <Button href="/contact?enquiry=limited-access#contact-form" size="md">Request access</Button>
      <Button href="https://calendly.com/crowagent-platform/30min" variant="secondary" size="md">
        Book a demo
      </Button>
    </FinalCta>
  </main>
</Base>

<style>
  .sec-wrap {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .sec-hero {
    position: relative;
    padding: var(--sec-pad-y-hero) 0 var(--sec-pad-y-sm);
    text-align: center;
    overflow: hidden;
  }
  .sec-hero::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -6%;
    width: 70vw;
    height: 44vw;
    transform: translateX(-50%);
    z-index: -1;
    background: var(--grad-hero-glow);
    filter: blur(20px);
    opacity: 0.5;
  }
  /*
   * EVERY EYEBROW IS A GRADIENT CAPSULE — owner decision, 2026-08-02. Both
   * eyebrow classes on this layout (.sec-eyebrow in the hero and the closing
   * band, .sec-eyebrow-inline in the section heads) resolve to the same shape
   * as components/layout/Section.astro, so the label reads identically here
   * and on every page built on that primitive.
   *
   * The 6px teal dot that used to precede these labels is gone with the
   * inline-flex it needed. It was the left-aligned answer to giving a bare
   * mono line something to start against; the capsule outline now does that
   * job, and a solid dot inside a gradient capsule reads as a stray artefact.
   *
   * THE COLOUR IS A SECOND SIGNAL, NEVER THE ONLY ONE: mono, letter-spaced,
   * uppercase, inside a visible outline. Remove all colour and it still reads
   * as an eyebrow. WCAG 1.4.1.
   */
  .sec-eyebrow,
  .sec-eyebrow-inline {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  /*
   * background-clip: text needs a transparent fill, and an inherited
   * -webkit-text-fill-color is what caused this site's invisible-text P0. The
   * @supports gate leaves a solid readable colour where it is unsupported, and
   * the declaration reaches these two short labels and nothing else.
   */
  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .sec-eyebrow,
    .sec-eyebrow-inline {
      background: var(--grad-spectrum);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }

  .sec-hero h1 {
    font-family: var(--font-display);
    font-size: var(--t-h1);
    font-weight: var(--t-w-h1);
    letter-spacing: -0.035em;
    line-height: 1.03;
    color: var(--c-text);
    max-width: 16ch;
    margin: 20px auto 0;
  }
  .sec-hero h1 .accent {
    color: var(--c-teal);
  }
  .sec-sub {
    margin: 22px auto 0;
    max-width: 60ch;
    color: var(--c-text-muted);
    /* --t-lede, the standfirst tier. This was a private clamp that resolved to
       19.2px against the 20.8px every other standfirst on the site uses. */
    font-size: var(--t-lede);
    line-height: 1.6;
  }
  .sec-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 30px;
  }

  .sec-band {
    padding: var(--sec-pad-y-sm) 0;
  }
  .sec-band.sec-light {
    background: var(--c-panel);
  }
  /*
   * CENTRED HEAD BLOCK — owner decision, 2026-08-02. Scoped to .sec-head,
   * which holds only the eyebrow and the h2. It must NOT reach .sec-prose,
   * .sec-steps, .sec-shot or .sec-faq: those are the sector context prose, the
   * four-step cards, a captioned screenshot and an accordion, and centring
   * them is the opt-out cascade this rule exists to avoid.
   */
  .sec-head {
    margin-bottom: var(--sec-gap);
    text-align: center;
  }
  /* Retained because the FAQ head still carries the class in markup. It now
     asks for what .sec-head already does, so it is a no-op rather than a
     conflict. */
  .sec-head-center {
    text-align: center;
  }
  .sec-eyebrow-inline {
    margin-bottom: 0.75rem;
  }
  .sec-head h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    letter-spacing: -0.02em;
    color: var(--c-text);
    /* The 32ch measure has to be centred too, or the heading sits left inside
       a centred head block. */
    margin: 0 auto;
    max-width: 32ch;
  }

  .sec-prose {
    max-width: var(--measure-prose);
    margin: 0 auto;
  }
  .sec-prose :global(p) {
    color: var(--c-text-sub);
    /* 1.06rem was in no scale; --t-lede is what long-form body copy takes in
       styles/prose.css and in .cmp-body. */
    font-size: var(--t-lede);
    line-height: 1.7;
    margin: 0 0 18px;
  }
  .sec-prose :global(a) {
    color: var(--c-teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .sec-steps {
    display: grid;
    gap: 1.25rem;
    margin-bottom: var(--sec-gap);
  }
  @media (min-width: 768px) {
    .sec-steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* Card treatment from `surface`; only the accent edge and padding are local. */
  .sec-phase {
    padding: var(--blk-pad);
    border-left: 3px solid var(--step-accent, var(--c-teal));
  }
  .sec-phase[data-accent='teal'] {
    --step-accent: var(--c-teal);
  }
  .sec-phase[data-accent='violet'] {
    --step-accent: var(--c-violet);
  }
  .sec-phase[data-accent='sky'] {
    --step-accent: var(--c-cyan);
  }
  .sec-verb {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-h4);
    color: var(--c-text);
    margin-bottom: 0.6rem;
  }
  .sec-say {
    color: var(--c-text-sub);
    font-size: var(--t-body);
    line-height: 1.6;
    margin: 0;
  }

  .sec-shot {
    max-width: var(--measure-mid);
    margin: 38px auto 0;
  }
  .sec-shot img {
    display: block;
    width: 100%;
    height: auto;
    /* Hardcoded 16px, in no scale and not even the panel token it looked like. */
    border-radius: var(--radius-card);
    border: 1px solid var(--c-border);
  }
  .sec-shot figcaption {
    margin-top: 14px;
    color: var(--c-text-muted);
    font-size: var(--t-body);
    line-height: 1.6;
    text-align: left;
  }

  .sec-faq {
    max-width: var(--measure-band);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  /* Radius, border, background and hover all come from `surface`. This rule
     used to set --radius-panel on an element that had no border and no
     background, so it rounded nothing. */
  .sec-faq summary {
    cursor: pointer;
    list-style: none;
    padding: var(--stack-2) var(--blk-pad);
    font-family: var(--font-display);
    font-weight: var(--t-w-h3);
    /* The row's heading, so the card tier — it was 1.06rem, within a pixel of
       the answer text underneath it. */
    font-size: var(--t-h4);
    line-height: 1.4;
    color: var(--c-text);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    min-height: 44px;
  }
  .sec-faq summary::-webkit-details-marker {
    display: none;
  }
  .sec-faq summary::after {
    content: '+';
    font-weight: 800;
    color: var(--c-teal);
    transition: transform var(--dur) var(--ease);
  }
  .sec-faq details[open] summary::after {
    transform: rotate(45deg);
  }
  .sec-faq-a {
    padding: 0 24px 22px;
    color: var(--c-text-sub);
    font-size: var(--t-body);
    line-height: 1.62;
  }

  /* --t-h1 is reserved for the hero (tokens.css); the homepage's own closing
     CTA renders through Section at --t-h2 / --t-w-h2. Matched to it. */

  @media (prefers-reduced-motion: reduce) {
    .sec-faq summary::after {
      transition: none;
    }
  }
</style>
