---
/**
 * Lifecycle — homepage section 2, "The whole lifecycle, not the easy half".
 *
 * A four-stage tab interface. The job of the section is to let a reader
 * self-select the stage they care about, and to show that the product covers
 * the post-award half most bid tools skip.
 *
 * CONTENT VISIBLE BY DEFAULT. Every panel renders unhidden, and the script
 * hides the inactive ones on init. If the script never runs the section is four
 * readable blocks stacked in order — worse looking, entirely usable. That is
 * the inverse of the pattern that once left 4 of 9 homepage sections
 * permanently invisible when an observer failed to fire, and it is why `hidden`
 * is applied by JS rather than authored into the markup.
 *
 * ONE SENTENCE IS DELIBERATELY NOT PORTED. The legacy pane 4 ends: "This is the
 * ground every other bid tool has already ceded." That is a sweeping, unsourced
 * claim about every competitor in the market — the same class of statement the
 * owner already had to strip from five compare pages ("Live, paid, and in daily
 * use"), and the same class as OA-01's "the only engine that sits on both
 * sides", which is why sections 3 and 5 are not ported at all.
 *
 * Removing it costs nothing: the pane's own first sentence already makes the
 * point in a defensible form, by describing what the product does after award
 * rather than asserting what every rival does not. Logged as OA-18.
 *
 * The National TOMs reference carries the hedge already published on /crowmark,
 * for the same reason it was applied to /crowmark-buyers and the calculator:
 * one engine should be described one way everywhere.
 */
interface Stage {
  tab: string;
  heading: string;
  body: string;
  cta: { label: string; href: string };
  note: { title: string; body: string };
  shot: { name: string; alt: string };
  accent: string;
}

const STAGES: Stage[] = [
  {
    tab: 'Discover',
    heading: 'Every UK tender, the day it lands',
    body: 'Around 40,000 notices a year from Contracts Finder and Find a Tender, read at source across central government, NHS trusts and local authorities, and scored against your own delivery record.',
    cta: { label: 'Explore discovery', href: '/crowmark' },
    note: {
      title: 'Tender fit scoring',
      body: 'Tell it what you bid for once, and every notice arrives already scored against your profile, so you spend the day on the ones that match.',
    },
    shot: {
      name: 'mark-discover-feed',
      alt: 'CrowMark Discover: live Find a Tender notices scored for fit, including an NHS integrated care board service and a North Ayrshire Council contract.',
    },
    accent: 'var(--c-teal)',
  },
  {
    tab: 'Answer',
    heading: 'Grounded answers, traceable line by line',
    body: "Drafts against the tender's own published criteria, grounded in your approved answer library and the statute behind the contract. Your team edits and approves; the engine does the load-bearing work.",
    cta: { label: 'Explore drafting', href: '/crowmark' },
    note: {
      title: 'Grounding disclosure on every answer',
      body: 'Every pound and percentage comes from a commitment you recorded, never invented, and a named human reviews and approves before you submit.',
    },
    shot: {
      name: 'mark-tender-questions',
      alt: 'CrowMark award question drafting, showing the disclosure that answers are grounded only in your own answer library, the published requirement and your confirmed commitments.',
    },
    accent: 'var(--c-cyan)',
  },
  {
    tab: 'Social value',
    heading: 'PPN 002 social value, priced and defensible',
    // Hedge matches /crowmark, /crowmark-buyers and the calculator.
    body: 'National TOMs measures mapped and monetised against published proxy values, aligned to National TOMs conventions rather than a full National TOMs implementation. The part of the bid most suppliers dread becomes a number an evaluator can audit and you can defend.',
    cta: { label: 'Explore social value', href: '/tools/ppn-002-calculator/' },
    note: {
      title: 'Both sides of the table',
      body: 'Authorities build the requirement with the same measures suppliers answer against, so the rubric and the response speak the same language.',
    },
    shot: {
      name: 'mark-social-value-pack',
      alt: 'Building a social value requirement pack: National TOMs measures with their published proxy values and a running estimate.',
    },
    accent: 'var(--c-violet)',
  },
  {
    tab: 'Deliver',
    heading: 'The contract does not end at award',
    // The legacy pane's closing competitor claim is deliberately omitted.
    body: 'Commitments carried into delivery, evidence gathered against them, and the reports an authority expects years later.',
    cta: { label: 'Explore delivery', href: '/crowmark' },
    note: {
      title: 'Section 52 duties, surfaced early',
      body: 'Above the £5m threshold the Procurement Act 2023 sets minimum KPIs, so what was promised has to be tracked and reported. Advisory, not legal advice.',
    },
    shot: {
      name: 'mark-evidence-tracker',
      alt: 'The CrowMark evidence tracker after award, showing the six stage bid suite, the reporting cadence and the monthly progress report control.',
    },
    accent: 'var(--c-orchid)',
  },
];
---

<section class="lc" aria-labelledby="lifecycle-title">
  <div class="lc__head">
    <p class="lc__eyebrow">One engine, end to end</p>
    <h2 class="lc__title" id="lifecycle-title">The whole lifecycle, not the easy half</h2>
    <p class="lc__standfirst">
      Discovery, qualification, drafting and post-award evidencing in one system, built on the
      Procurement Act 2023 and the National TOMs rather than bolted onto them.
    </p>
  </div>

  <div class="lc__grid">
    <div
      class="lc__rail"
      role="tablist"
      aria-label="Stages of the lifecycle"
      aria-orientation="vertical"
    >
      {
        STAGES.map((s, i) => (
          <button
            class="lc__tab"
            role="tab"
            id={`lc-tab-${i}`}
            aria-controls={`lc-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            style={`--accent: ${s.accent}`}
          >
            {s.tab}
          </button>
        ))
      }
    </div>

    <div class="lc__panels">
      {
        STAGES.map((s, i) => (
          <div
            class="lc__panel"
            role="tabpanel"
            id={`lc-panel-${i}`}
            aria-labelledby={`lc-tab-${i}`}
            tabindex="0"
            style={`--accent: ${s.accent}`}
          >
            <h3 class="lc__h">{s.heading}</h3>
            <p class="lc__body">{s.body}</p>
            <p class="lc__cta">
              <a href={s.cta.href}>
                {s.cta.label}
                <span class="visually-hidden"> — {s.heading}</span>
              </a>
            </p>

            <div class="lc__note">
              <p class="lc__note-t">{s.note.title}</p>
              <p class="lc__note-p">{s.note.body}</p>
            </div>

            <img
              class="lc__shot"
              src={`/Assets/shots/v2/${s.shot.name}.webp`}
              srcset={`/Assets/shots/v2/${s.shot.name}-sm.webp 1160w, /Assets/shots/v2/${s.shot.name}.webp 1880w`}
              sizes="(min-width: 1300px) 800px, (min-width: 900px) 58vw, 92vw"
              width="1880"
              height="860"
              loading="lazy"
              decoding="async"
              alt={s.shot.alt}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  /**
   * APG tabs pattern, vertical, with automatic activation and a roving
   * tabindex. Automatic activation is appropriate here because switching a
   * panel costs nothing — the markup is already in the document.
   */
  function initLifecycle() {
    const rail = document.querySelector<HTMLElement>('.lc__rail[role="tablist"]');
    if (!rail) return;
    const tabs = Array.from(rail.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) =>
      document.getElementById(t.getAttribute('aria-controls') ?? '')
    );
    if (!tabs.length || panels.some((p) => !p)) return;

    function select(index: number, moveFocus = true) {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        // Roving tabindex: exactly one tab is in the tab order at a time, so
        // Tab moves past the whole rail rather than through every stage.
        tab.tabIndex = on ? 0 : -1;
        panels[i]!.hidden = !on;
      });
      if (moveFocus) tabs[index].focus();
    }

    // Hidden state is applied HERE, not in the markup, so a script failure
    // leaves all four panels readable rather than the section empty.
    select(0, false);

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const key = (e as KeyboardEvent).key;
        let next = -1;
        if (key === 'ArrowDown' || key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (key === 'ArrowUp' || key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (key === 'Home') next = 0;
        else if (key === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        select(next);
      });
    });
  }

  initLifecycle();
</script>

<style>
  .lc { padding-block: var(--sec-pad-y); }

  .lc__head,
  .lc__grid {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .lc__eyebrow {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .lc__title {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--c-text);
  }

  .lc__standfirst {
    margin: var(--stack-2) 0 0;
    max-width: 62ch;
    font-family: var(--font-body);
    font-size: var(--t-lede);
    line-height: 1.65;
    color: var(--c-text-sub);
  }

  .lc__grid {
    margin-top: var(--sec-gap);
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }

  .lc__rail { display: flex; flex-direction: column; }

  .lc__tab {
    /* 52px, above the WCAG 2.2 target-size floor. */
    min-height: 52px;
    padding: 0 1rem;
    text-align: left;
    border: 0;
    border-left: 2px solid var(--c-border);
    background: transparent;
    color: var(--c-text-muted);
    font-family: var(--font-body);
    font-size: var(--t-body);
    font-weight: 600;
    cursor: pointer;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .lc__tab:hover { color: var(--c-text); }

  /* Selected state is carried by colour AND the rule weight AND aria-selected,
     never by colour alone. */
  .lc__tab[aria-selected='true'] {
    color: var(--c-text);
    border-left-color: var(--accent);
    border-left-width: 3px;
  }

  .lc__tab:focus-visible { outline: 3px solid var(--c-teal); outline-offset: -3px; }

  .lc__panel { min-width: 0; }
  .lc__panel[hidden] { display: none; }
  .lc__panel:focus-visible { outline: 3px solid var(--c-teal); outline-offset: 4px; }

  .lc__h {
    margin: 0 0 var(--stack-1);
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: var(--t-w-h3);
    line-height: 1.2;
    color: var(--c-text);
  }

  .lc__body {
    margin: 0 0 var(--stack-1);
    max-width: 64ch;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.75;
    color: var(--c-text-sub);
  }

  .lc__cta { margin: 0 0 var(--stack-2); }
  .lc__cta a {
    color: var(--accent);
    font-family: var(--font-body);
    font-size: var(--t-body);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .lc__cta a:focus-visible { outline: 3px solid var(--c-teal); outline-offset: 3px; }

  .lc__note {
    padding: var(--blk-pad);
    border-left: 2px solid var(--accent);
    background: var(--c-card);
    border-radius: 0 var(--radius-panel) var(--radius-panel) 0;
    max-width: 64ch;
  }

  .lc__note-t {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .lc__note-p {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text-sub);
  }

  .lc__shot {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--sec-gap);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-card);
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 899px) {
    .lc__grid { grid-template-columns: minmax(0, 1fr); }
    .lc__rail { flex-direction: row; flex-wrap: wrap; gap: 4px; }
    .lc__tab {
      border-left: 0;
      border-bottom: 2px solid var(--c-border);
      padding-inline: 0.85rem;
    }
    .lc__tab[aria-selected='true'] {
      border-left: 0;
      border-bottom-color: var(--accent);
      border-bottom-width: 3px;
    }
  }
</style>
