---
/**
 * HOME 2.0: WHAT IT REFUSED, AND WHAT THAT WON.
 *
 * Three cards plus a 55 percent peek of a fourth, on the same carousel the
 * product tour uses, at `fit="peek"`.
 *
 * ── THESE ARE ILLUSTRATIVE AND THE PAGE SAYS SO IN PRINT ───────────────────
 *
 * No customer is named, no win rate is claimed and no figure here is presented
 * as a result this company achieved. The caption under the row says
 * "Illustrative scenarios, not named customers", in the markup rather than in a
 * comment, because a disclaimer a reader cannot see is not a disclaimer. That
 * is the same rule pages/sources.astro applies to the reasoning trace's £27,000
 * and £108,000, both of which it records as illustrative placeholders.
 *
 * The contract values are the SHAPE of a procurement rather than a claim about
 * one: a highways framework, an NHS estates lot and a facilities contract at
 * plausible values. What each card actually asserts is what the ENGINE did,
 * which is a property of the product and is checkable.
 */
import Section from '../layout/Section.astro';
import Carousel2 from './Carousel2.astro';

interface Study {
  tag: string;
  title: string;
  body: string;
  accent: string;
}

const STUDIES: Study[] = [
  {
    tag: 'Highways framework',
    title: 'Highways maintenance, £4.2m',
    body: 'Refused three unsourced figures in the pricing narrative. The bid went out with 41 cited claims and nothing the panel could not check.',
    accent: 'var(--c-teal)',
  },
  {
    tag: 'NHS estates',
    title: 'NHS estates, £860k',
    body: 'Qualified out in 40 minutes. The weighting made the social value floor unreachable for a firm of this size, and a no here is a week returned.',
    accent: 'var(--c-violet)',
  },
  {
    tag: 'Facilities',
    title: 'Facilities, £2.1m',
    body: 'Every carbon figure traced to the 2025 SECR report. The evaluator asked for nothing further, because the source was already beside the number.',
    accent: 'var(--c-pink)',
  },
  {
    tag: 'Rail',
    title: 'Rail signalling, £11m',
    body: 'The fourth card sits half in view on purpose. A row that ends flush reads as a list that has finished, and this one has not.',
    accent: 'var(--c-amber)',
  },
];
---

<Section
  eyebrow="In the field"
  title="What it refused, and what that won."
  id="in-the-field"
  class="h2cs"
  bleed
>
  <Carousel2
    label="Illustrative scenarios"
    count={STUDIES.length}
    fit="peek"
    interval={6000}
    class="h2cs__car"
  >
    {
      STUDIES.map((s, i) => (
        <div
          class="h2cs__slide"
          role="group"
          aria-label={`${i + 1} of ${STUDIES.length}`}
          style={`--study-accent: ${s.accent}`}
        >
          <article class="surface surface--pad surface--row h2cs__card">
            <p class="meta h2cs__tag">{s.tag}</p>
            <h3 class="h2cs__title">{s.title}</h3>
            <p class="h2cs__body">{s.body}</p>
            <span class="h2cs__rule" aria-hidden="true" />
          </article>
        </div>
      ))
    }
  </Carousel2>

  <p class="h2cs__caption">Illustrative scenarios, not named customers.</p>
</Section>

<style>
  .h2cs__slide {
    display: flex;
  }

  .h2cs__card {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--stack-1);
  }

  .h2cs__tag {
    color: var(--c-text-muted);
  }

  .h2cs__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
    line-height: var(--lh-tight);
    color: var(--c-text);
  }

  .h2cs__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-caption);
    line-height: 1.6;
    color: var(--c-text-sub);
  }

  /* The accent is the only thing that differs between cards, and it is a rule
     at the foot rather than a tint on the fill, so every card keeps the one
     shared surface recipe. */
  .h2cs__rule {
    display: block;
    inline-size: 44px;
    block-size: 2px;
    margin-block-start: auto;
    padding-block-start: var(--space-4);
    border-block-end: 2px solid var(--study-accent, var(--c-teal));
  }

  .h2cs__caption {
    margin: var(--space-6) 0 0;
    padding-inline: var(--gutter);
    font-family: var(--font-body);
    font-size: var(--t-caption);
    color: var(--c-text-muted);
    text-align: center;
  }
</style>
